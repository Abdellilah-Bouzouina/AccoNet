    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useApp } from \'../context/AppContext\';\nimport { ProfessionalCard } from \'../components/ProfessionalCard\';\nimport { wilayas } from \'../data/mockData\';\nimport { \n  Building2, Users, Search, HelpCircle, ArrowLeft, ArrowRight, \n  MapPin, ClipboardCheck, ArrowUpRight, Check, Quote, Star, \n  Sparkles, FileText, Calendar, CloudLightning \n} from \'lucide-react\';\n\nexport const Landing: React.FC = () => {\n  const { t, tSpec, tObj, direction, language } = useLanguage();\n  const { allProfessionals } = useApp();\n  const navigate = useNavigate();\n\n  // Search form state\n  const [keyword, setKeyword] = useState(\'\');\n  const [selectedWilaya, setSelectedWilaya] = useState(\'0\');\n  const [selectedSpecialty, setSelectedSpecialty] = useState(\'\');\n\n  const handleSearchSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    navigate(`/search?keyword=${encodeURIComponent(keyword)}&wilaya=${selectedWilaya}&specialty=${selectedSpecialty}`);\n  };\n\n  const featuredPros = allProfessionals.slice(0, 4);\n\n  const specialtiesList = [\n    { key: \"certified-accountant\", icon: \"\342\234\250\" },\n    { key: \"chartered-accountant\", icon: \"\360\237\223\205\" },\n    { key: \"statutory-auditor\", icon: \"\360\237\223\202\" },\n    { key: \"tax-consultant\", icon: \"\360\237\223\212\" },\n    { key: \"judicial-expert\", icon: \"\360\237\217\233\357\270\217\" }\n  ];\n\n  const toolsTeaser = [\n    { key: \"ocrTitle\", desc: \"ocrDesc\", icon: Sparkles, color: \"bg-teal-50 text-brand-primary border-teal-200\" },\n    { key: \"g50SimTitle\", desc: \"g50SimDesc\", icon: FileText, color: \"bg-indigo-50 text-indigo-700 border-indigo-200\" },\n    { key: \"auditSimTitle\", desc: \"auditSimDesc\", icon: ClipboardCheck, color: \"bg-amber-50 text-amber-700 border-amber-200\" }\n  ];\n\n  const testimonialsList = [\n    { name: \"\330\261\331\212\330\247\330\266 \330\250\331\206 \331\212\330\271\331\202\331\210\330\250\", company: \"Dzair Tech Link LLC\", wil: { ar: \"\330\247\331\204\330\254\330\262\330\247\330\246\330\261\", fr: \"Alger\", en: \"Algiers\" }, rating: 5, comment: \"t1\" },\n    { name: \"\331\212\330\247\330\263\331\205\331\212\331\206 \330\250\331\204\331\202\330\247\330\263\331\205\", company: \"Belgourmet Bio Sarl\", wil: { ar: \"\330\247\331\204\330\250\331\204\331\212\330\257\330\251\", fr: \"Blida\", en: \"Blida\" }, rating: 5, comment: \"t2\" },\n    { name: \"\330\245\330\250\330\261\330\247\331\207\331\212\331\205 \330\250\331\210\330\247\331\204\330\264\330\271\331\212\330\261\", company: \"Pharmalife Est\", wil: { ar: \"\331\202\330\263\331\206\330\267\331\212\331\206\330\251\", fr: \"Constantine\", en: \"Constantine\" }, rating: 5, comment: \"t3\" },\n    { name: \"\330\263\331\205\331\212\330\261 \330\255\331\205\331\210\330\264\", company: \"Oran Logistique Express\", wil: { ar: \"\331\210\331\207\330\261\330\247\331\206\", fr: \"Oran\", en: \"Oran\" }, rating: 4.8, comment: \"t4\" },\n    { name: \"\331\206\330\254\331\212\330\250 \330\250\331\210\330\263\330\247\331\204\331\205\", company: \"S\303\251tif Plast Industrielle\", wil: { ar: \"\330\263\330\267\331\212\331\201\", fr: \"S\303\251tif\", en: \"S\303\251tif\" }, rating: 4.9, comment: \"t5\" },\n    { name: \"\331\201\330\247\330\267\331\205\330\251 \330\247\331\204\330\262\331\207\330\261\330\247\330\241 \330\271\331\212\330\263\331\211\", company: \"Kabylie Olive Agronome\", wil: { ar: \"\330\252\331\212\330\262\331\212 \331\210\330\262\331\210\", fr: \"Tizi Ouzou\", en: \"Tizi Ouzou\" }, rating: 5, comment: \"t6\" }\n  ];\n\n  return (\n    <div className=\"space-y-16 pb-16\" id=\"landing_page_viewport\">\n      \n      {/* 1. HERO SECTION WITH ARABIC ALGERIA DESIGNS */}\n      <section className=\"relative overflow-hidden bg-gradient-to-b from-brand-light/70 via-white to-brand-surface py-20 px-4 sm:px-6 lg:px-8\">\n        \n        {/* Subtle geometric pattern */}\n        <div className=\"absolute inset-0 opacity-[0.03] pointer-events-none\">\n          <div className=\"absolute top-10 left-10 w-48 h-48 rounded-full border-4 border-brand-primary\"></div>\n          <div className=\"absolute bottom-10 right-10 w-96 h-96 rounded-full border-12 border-brand-primary\"></div>\n        </div>\n\n        <div className=\"max-w-5xl mx-auto text-center space-y-8 relative z-10\">\n          \n          {/* Badge */}\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-primary/10 border border-brand-primary/20 text-brand-primary text-xs font-bold font-sans\">\n            <span className=\"flex h-2 w-2 rounded-full bg-brand-accent pulse-accent\"></span>\n            {t(\'brandSlogan\')}\n          </div>\n\n          <h1 className=\"text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-950 font-sans tracking-tight leading-tight max-w-4xl mx-auto\">\n            {t(\'heroTitle\')}\n          </h1>\n\n          <p className=\"text-base sm:text-lg text-gray-600 max-w-2xl mx-auto font-sans leading-relaxed\">\n            {t(\'heroSubtitle\')}\n          </p>\n\n          {/* Interactive Search Tool Bar */}\n          <form \n            onSubmit={handleSearchSubmit}\n            className=\"bg-white p-2.5 sm:p-4 rounded-2xl sm:rounded-full shadow-lg border border-gray-150 max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-3\"\n            id=\"hero_search_form\"\n          >\n            {/* Keyword Input */}\n            <div className=\"md:col-span-5 flex items-center gap-2 px-3 border-b md:border-b-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-gray-100 pb-3 md:pb-0\">\n              <Search className=\"w-5 h-5 text-brand-primary shrink-0\" />\n              <input \n                type=\"text\" \n                placeholder={t(\'heroSearchPlaceholder\')}\n                value={keyword}\n                onChange={(e) => setKeyword(e.target.value)}\n                className=\"w-full text-sm text-gray-700 bg-transparent focus:outline-none placeholder-gray-400\"\n                id=\"hero_keyword_input\"\n              />\n            </div>\n\n            {/* Wilaya Filter Dropdown */}\n            <div className=\"md:col-span-3 flex items-center gap-2 px-3 border-b md:border-b-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-gray-100 pb-3 md:pb-0\">\n              <MapPin className=\"w-4 h-4 text-brand-primary shrink-0\" />\n              <select\n                value={selectedWilaya}\n                onChange={(e) => setSelectedWilaya(e.target.value)}\n                className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none\"\n                id=\"hero_wilaya_input\"\n              >\n                <option value=\"0\">\360\237\223\215 {t(\'allWilayas\')}</option>\n                {wilayas.map((w) => (\n                  <option key={w.id} value={w.id}>{w.code} - {tObj(w.name)}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Specialty Filter Dropdown */}\n            <div className=\"md:col-span-2 flex items-center gap-2 px-3 pb-3 md:pb-0\">\n              <span className=\"text-sm\">\360\237\222\274</span>\n              <select\n                value={selectedSpecialty}\n                onChange={(e) => setSelectedSpecialty(e.target.value)}\n                className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none\"\n                id=\"hero_specialty_input\"\n              >\n                <option value=\"\">{t(\'allSpecialties\')}</option>\n                {specialtiesList.map((s) => (\n                  <option key={s.key} value={s.key}>{tSpec(s.key)}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Direct Submit Action Button */}\n            <button \n              type=\"submit\"\n              className=\"md:col-span-2 w-full py-3 bg-brand-primary hover:bg-brand-dark text-white text-sm font-semibold rounded-xl sm:rounded-full shadow-xs hover:shadow-md transition cursor-pointer flex items-center justify-center gap-1.5\"\n              id=\"hero_search_btn\"\n            >\n              <span>{t(\'searchBtn\')}</span>\n              {direction === \'rtl\' ? <ArrowLeft className=\"w-4 h-4\" /> : <ArrowRight className=\"w-4 h-4\" />}\n            </button>\n          </form>\n\n          {/* Core CTAs for Non-Search Path Navigation */}\n          <div className=\"flex flex-wrap justify-center gap-4 pt-4\">\n            <button \n              onClick={() => navigate(\'/search\')}\n              className=\"px-6 py-3 border-2 border-brand-primary text-brand-primary rounded-xl text-sm font-bold hover:bg-brand-light transition duration-150 cursor-pointer\"\n            >\n              \360\237\232\200 {t(\'findProButton\')}\n            </button>\n            <button \n              onClick={() => navigate(\'/register\')}\n              className=\"px-6 py-3 bg-brand-primary text-white hover:bg-brand-dark rounded-xl text-sm font-bold shadow-xs hover:shadow-md hover:-translate-y-0.5 transition cursor-pointer\"\n            >\n              \360\237\222\274 {t(\'joinAsProButton\')}\n            </button>\n          </div>\n\n        </div>\n      </section>\n\n      {/* 2. LIVE SEED STATISTICS STAT ROW */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-white rounded-3xl border border-gray-150 shadow-xs p-8 sm:p-10\">\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x rtl:md:divide-x-reverse divide-gray-100\">\n            \n            <div className=\"pt-6 md:pt-0\">\n              <p className=\"text-3xl sm:text-4xl font-extrabold text-brand-primary font-mono\">{t(\'statPros\')}</p>\n              <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wide mt-2\">{t(\'statProsSub\')}</p>\n            </div>\n            \n            <div className=\"pt-6 md:pt-0 md:px-4\">\n              <p className=\"text-3xl sm:text-4xl font-extrabold text-brand-primary font-mono\">{t(\'statWilayas\')}</p>\n              <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wide mt-2\">{t(\'statWilayasSub\')}</p>\n            </div>\n\n            <div className=\"pt-6 md:pt-0\">\n              <p className=\"text-3xl sm:text-4xl font-extrabold text-brand-primary font-mono\">{t(\'statBusinesses\')}</p>\n              <p className=\"text-xs font-bold text-gray-500 uppercase tracking-wide mt-2\">{t(\'statBusinessesSub\')}</p>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* 3. FEATURED ACCOUNTING SPECIALISTS */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center space-y-4 mb-10\">\n          <h2 className=\"text-2xl sm:text-3xl font-extrabold text-gray-950 font-sans tracking-tight\">\n            {t(\'featuredTitle\')}\n          </h2>\n          <p className=\"text-sm text-gray-600 max-w-2xl mx-auto\">\n            {t(\'featuredSubtitle\')}\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {featuredPros.map((pro) => (\n            <ProfessionalCard key={pro.id} professional={pro} />\n          ))}\n        </div>\n\n        <div className=\"text-center mt-10\">\n          <button \n            onClick={() => navigate(\'/search\')}\n            className=\"inline-flex items-center gap-1.5 px-6 py-2.5 bg-brand-primary text-white font-semibold rounded-xl text-sm hover:bg-brand-dark transition-transform hover:scale-105\"\n          >\n            <span>{t(\'findProButton\')}</span>\n            {direction === \'rtl\' ? <ArrowLeft className=\"w-4 h-4 text-white\" /> : <ArrowRight className=\"w-4 h-4 text-white\" />}\n          </button>\n        </div>\n      </section>\n\n      {/* 4. HOW IT WORKS SYSTEM */}\n      <section className=\"bg-brand-light/30 border-y border-brand-light/50 py-16\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          \n          <div className=\"text-center space-y-4 mb-12\">\n            <h2 className=\"text-2xl sm:text-3xl font-extrabold text-gray-950 font-sans tracking-tight\">\n              {t(\'howTitle\')}\n            </h2>\n            <p className=\"text-sm text-gray-600\">\n              {t(\'brandName\')} provides Algeria\'s most professional service pipeline.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8\">\n            \n            {/* Step 1 */}\n            <div className=\"bg-white p-6 rounded-2xl border border-gray-100 shadow-xs text-center space-y-3 relative\">\n              <span className=\"w-10 h-10 rounded-full bg-brand-light text-brand-primary font-mono font-bold flex items-center justify-center mx-auto text-sm\">1</span>\n              <h3 className=\"font-bold text-gray-901 text-sm\">{t(\'howStep1Title\')}</h3>\n              <p className=\"text-xs text-gray-500 leading-relaxed\">{t(\'howStep1Desc\')}</p>\n            </div>\n\n            {/* Step 2 */}\n            <div className=\"bg-white p-6 rounded-2xl border border-gray-100 shadow-xs text-center space-y-3\">\n              <span className=\"w-10 h-10 rounded-full bg-brand-light text-brand-primary font-mono font-bold flex items-center justify-center mx-auto text-sm\">2</span>\n              <h3 className=\"font-bold text-gray-901 text-sm\">{t(\'howStep2Title\')}</h3>\n              <p className=\"text-xs text-gray-500 leading-relaxed\">{t(\'howStep2Desc\')}</p>\n            </div>\n\n            {/* Step 3 */}\n            <div className=\"bg-white p-6 rounded-2xl border border-gray-100 shadow-xs text-center space-y-3\">\n              <span className=\"w-10 h-10 rounded-full bg-brand-light text-brand-primary font-mono font-bold flex items-center justify-center mx-auto text-sm\">3</span>\n              <h3 className=\"font-bold text-gray-901 text-sm\">{t(\'howStep3Title\')}</h3>\n              <p className=\"text-xs text-gray-500 leading-relaxed\">{t(\'howStep3Desc\')}</p>\n            </div>\n\n            {/* Step 4 */}\n            <div className=\"bg-white p-6 rounded-2xl border border-gray-100 shadow-xs text-center space-y-3\">\n              <span className=\"w-10 h-10 rounded-full bg-brand-light text-brand-primary font-mono font-bold flex items-center justify-center mx-auto text-sm\">4</span>\n              <h3 className=\"font-bold text-gray-901 text-sm\">{t(\'howStep4Title\')}</h3>\n              <p className=\"text-xs text-gray-500 leading-relaxed\">{t(\'howStep4Desc\')}</p>\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      {/* 5. DYNAMIC INTERACTIVE AI TOOLS PREVIEW CHIPS */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8 items-center bg-gray-950 text-white rounded-3xl p-8 sm:p-12 border border-gray-800 shadow-xl overflow-hidden relative\">\n          \n          <div className=\"absolute right-0 top-0 w-32 h-32 bg-brand-primary rounded-full filter blur-3xl opacity-15\"></div>\n\n          <div className=\"lg:col-span-1 space-y-5\">\n            <div className=\"inline-flex items-center gap-1 px-2.5 py-1 rounded bg-brand-primary/20 text-brand-light text-2xs font-extrabold uppercase\">\n              <CloudLightning className=\"w-3.5 h-3.5 text-brand-accent animate-bounce\" />\n              <span>Algerian Localization Core</span>\n            </div>\n            \n            <h2 className=\"text-2xl sm:text-3xl font-extrabold font-sans tracking-tight leading-tight\">\n              {t(\'toolsTitle\')}\n            </h2>\n            \n            <p className=\"text-gray-400 text-xs leading-relaxed\">\n              {t(\'toolsSubtitle\')}\n            </p>\n\n            <button \n              onClick={() => navigate(\'/tools\')}\n              className=\"px-5 py-2.5 bg-brand-primary hover:bg-brand-dark hover:border-brand-accent border border-transparent text-white text-xs font-bold rounded-xl shadow-xs transition cursor-pointer flex items-center gap-1.5\"\n            >\n              <span>{t(\'tryToolBtn\')}</span>\n              {direction === \'rtl\' ? <ArrowLeft className=\"w-4 h-4\" /> : <ArrowRight className=\"w-4 h-4\" />}\n            </button>\n          </div>\n\n          <div className=\"lg:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-4\">\n            {toolsTeaser.map((tool) => {\n              const Icon = tool.icon;\n              return (\n                <div \n                  key={tool.key}\n                  onClick={() => navigate(\'/tools\')}\n                  className=\"bg-white/5 border border-white/10 hover:border-brand-primary/50 rounded-2xl p-5 space-y-3 cursor-pointer hover:-translate-y-1 transition duration-200\"\n                >\n                  <div className=\"w-10 h-10 rounded-xl bg-brand-primary/20 flex items-center justify-center border border-brand-primary/30\">\n                    <Icon className=\"w-5 h-5 text-brand-accent\" />\n                  </div>\n                  <h3 className=\"font-bold text-white text-xs tracking-tight\">{t(tool.key)}</h3>\n                  <p className=\"text-[10px] text-gray-400 leading-normal line-clamp-3\">{t(tool.desc)}</p>\n                </div>\n              );\n            })}\n          </div>\n\n        </div>\n      </section>\n\n      {/* 6. TESTIMONIALS SECTION CAROUSEL / GRID */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        <div className=\"text-center space-y-4 mb-10\">\n          <h2 className=\"text-2xl sm:text-3xl font-extrabold text-gray-950 font-sans tracking-tight\">\n            \342\255\220 {t(\'tabReviews\')}\n          </h2>\n          <p className=\"text-sm text-gray-650 max-w-2xl mx-auto\">\n            Algerian SMEs and agricultural cooperatives speak about their success with AccoNet.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {testimonialsList.map((test) => (\n            <div \n              key={test.name}\n              className=\"bg-white border border-gray-150 rounded-2xl p-6 shadow-xs relative hover:shadow-md transition flex flex-col justify-between\"\n            >\n              <div>\n                {/* Quote header */}\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"flex gap-0.5 text-brand-accent\">\n                    {[1, 2, 3, 4, 5].map((s) => (\n                      <Star key={s} className=\"w-4 h-4 fill-brand-accent text-brand-accent\" />\n                    ))}\n                  </div>\n                  <Quote className=\"w-8 h-8 text-brand-primary/10 rotate-180\" />\n                </div>\n\n                <p className=\"text-gray-600 text-xs leading-relaxed italic mb-6\">\n                  \"{t(test.comment)}\"\n                </p>\n              </div>\n\n              <div className=\"flex items-center gap-3 pt-4 border-t border-gray-100\">\n                <div className=\"w-8 h-8 rounded-full bg-brand-light flex items-center justify-center font-bold text-brand-primary text-xs\">\n                  {test.name[0]}\n                </div>\n                <div>\n                  <h4 className=\"font-bold text-gray-901 text-xs\">{test.name}</h4>\n                  <p className=\"text-[10px] text-gray-400 font-sans\">{test.company} \342\200\242 {tObj(test.wil)}</p>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n\n      </section>\n\n    </div>\n  );\n};\n"
    }
