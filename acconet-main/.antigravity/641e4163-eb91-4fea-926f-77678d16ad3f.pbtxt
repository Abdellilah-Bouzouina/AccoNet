        lines {
          text: "    ar: \"\331\210\330\271\330\247\330\241 \330\254\330\250\330\247\331\212\330\251 TAP: \330\261\331\202\331\205 \330\243\330\271\331\205\330\247\331\204 \331\205\331\205\330\247\330\261\330\263\330\251 \330\247\331\204\331\206\330\264\330\247\330\267 \330\256\330\247\330\261\330\254 \330\247\331\204\330\261\330\263\331\210\331\205\","
