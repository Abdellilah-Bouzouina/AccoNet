        lines {
          text: "    ar: \"\330\243\330\250\330\261\330\262 \330\247\331\204\330\256\330\250\330\261\330\247\330\241 \330\247\331\204\331\205\330\252\330\247\330\255\331\212\331\206 \331\207\330\260\330\247 \330\247\331\204\330\243\330\263\330\250\331\210\330\271\","
