\210\331\206\331\212\330\252 \330\247\331\204\331\206\330\264\330\267\330\251 \330\247\331\204\331\205\330\244\331\203\330\257\330\251.\",\n    fr: \"G\303\251n\303\251r\303\251 sur la base des contrats sign\303\251s sur AccoNet.\",\n    en: \"Derived from formally signed engagement agreements via AccoNet.\"\n  },\n\n  // AI Tools page\n  aiToolsHeroTitle: {\n    ar: \"\330\264\330\247\330\264\330\247\330\252 \331\205\330\255\330\247\331\203\330\247\330\251 \330\247\331\204\330\243\330\257\331\210\330\247\330\252 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\331\212\330\251 \330\247\331\204\330\261\331\202\331\205\331\212\330\251\",\n    fr: \"Simulateurs comptables innovants (Showcase UI)\",\n    en: \"Interactive Accounting Simulators Showcase\"\n  },\n  aiToolsHeroSub: {\n    ar: \"\330\243\330\257\331\206\330\247\331\207 \331\206\331\205\331\210\330\260\330\254 \330\252\331\201\330\247\330\271\331\204\331\212 \331\204\330\243\330\257\331\210\330\247\330\252\331\206\330\247 \330\247\331\204\330\261\331\202\331\205\331\212\330\251 \330\247\331\204\331\205\330\257\331\205\330\254\330\251. \330\243\330\257\330\256\331\204 \331\205\330\271\330\267\331\212\330\247\330\252 \331\205\330\255\330\247\331\203\330\247\330\251 \331\204\330\252\330\254\330\261\330\250\330\251 \330\243\330\253\330\261 \330\247\331\204\330\260\331\203\330\247\330\241 \330\247\331\204\330\247\330\265\330\267\331\206\330\247\330\271\331\212 \331\205\330\271 \330\247\331\204\331\202\331\210\330\247\331\206\331\212\331\206 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212\330\251.\",\n    fr: \"Ins\303\251rez de fausses variables pour ex\303\251cuter et tester notre d\303\251monstrateur d\'automatisation fiscale en temps r\303\251el.\",\n    en: \"Insert sample dynamic values below to interact with and test our Algerian-tailored automation sandbox.\"\n  },\n  ocrTitle: {\n    ar: \"\331\205\330\255\331\204\331\204 \330\247\331\204\330\245\331\212\330\265\330\247\331\204\330\247\330\252 \330\247\331\204\330\260\331\203\331\212 (OCR Parser)\",\n    fr: \"Lecteur intelligent de re\303\247us (OCR)\",\n    en: \"Invoice Receipt Scanner (AI OCR)\"\n  },\n  ocrDesc: {\n    ar: \"\330\261\331\201\330\271 \330\247\331\204\331\201\331\210\330\247\330\252\331\212\330\261 \330\250\330\247\331\204\331\204\330\272\330\251 \330\247\331\204\330\271\330\261\330\250\331\212\330\251 \330\243\331\210 \330\247\331\204\331\201\330\261\331\206\330\263\331\212\330\251 \331\204\331\212\331\202\331\210\331\205 \330\247\331\204\330\260\331\203\330\247\330\241 \330\247\331\204\330\247\330\265\330\267\331\206\330\247\330\271\331\212 \330\250\330\247\330\263\330\252\330\256\330\261\330\247\330\254 \330\247\331\204\330\247\330\263\331\205\330\214 NIF\330\214 \331\210\331\205\330\271\330\257\331\204 TVA \331\210\330\253\330\250\330\252\331\207\330\247 \331\201\331\210\330\261\331\212\330\247\331\213.\",\n    fr: \"Extrayez automatiquement le NIF, le TVA et le total en soumettant un scan de facture alg\303\251rienne.\",\n    en: \"Submit PDF invoices in French or Arabic to extract Algerian NIF, VAT brackets, and final cash sums instantly.\"\n  },\n  g50SimTitle: {\n    ar: \"\331\205\330\263\330\247\330\271\330\257 \331\205\330\255\330\247\331\203\330\247\330\251 \330\252\330\265\330\261\331\212\330\255 G50 \330\247\331\204\330\260\331\203\331\212\",\n    fr: \"Assistant de Saisie de D\303\251claration G50\",\n    en: \"AccoNet G50 Smart Assistant\"\n  },\n  g50SimDesc: {\n    ar: \"\330\252\331\210\331\204\331\212\330\257 \330\252\331\204\331\202\330\247\330\246\331\212 \331\204\331\204\330\261\331\205\331\210\330\262 \330\247\331\204\330\254\330\250\330\247\330\246\331\212\330\251 \330\247\331\204\330\264\331\207\330\261\331\212\330\251 \331\210\331\205\330\250\330\247\331\204\330\272 TAP \331\210\330\247\331\204\330\261\330\263\331\210\331\205 \330\247\330\263\330\252\331\206\330\247\330\257\330\247\331\213 \331\204\330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\331\205\330\250\331\212\330\271\330\247\330\252 \331\210\330\247\331\204\331\205\330\264\330\252\330\261\331\212\330\247\330\252 \330\247\331\204\331\205\330\257\330\256\331\204\330\251.\",\n    fr: \"G\303\251n\303\251rez la simulation de vos droits de timbre, de TAP et de l\'IRG de vos fiches de paie.\",\n    en: \"Quickly simulate monthly Turnover Tax (TAP), Wage tax (IRG), and stamp taxes based on custom inputs.\"\n  },\n  auditSimTitle: {\n    ar: \"\331\205\330\257\331\202\331\202 \330\247\331\204\331\205\331\204\330\247\330\255\330\270\330\247\330\252 \331\210\330\247\331\204\330\255\330\263\330\247\330\250\330\247\330\252 \330\247\331\204\331\210\331\202\330\247\330\246\331\212\",\n    fr: \"D\303\251tecteur de Risques et Audit de Balance\",\n    en: \"Algerian Financial Balance Auditor\"\n  },\n  auditSimDesc: {\n    ar: \"\331\205\330\263\330\255 \331\205\331\212\330\262\330\247\331\206\331\212\330\252\331\203 \331\210\331\205\331\212\330\262\330\247\331\206 \330\247\331\204\331\205\330\261\330\247\330\254\330\271\330\251 \331\204\331\204\330\252\330\255\331\202\331\202 \331\205\331\206 \330\252\330\267\330\247\330\250\331\202\331\207\330\247 \331\205\330\271 \330\247\331\204\331\206\330\270\330\247\331\205 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\331\212 \330\247\331\204\331\205\330\247\331\204\331\212 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212 (SCF).\",\n    fr: \"Contr\303\264le automatique de votre balance comptable face aux exigences du SCF alg\303\251rien.\",\n    en: \"Automated scanner assessing your trial balance sheets against local SCF accounting standards.\"\n  },\n  executeSimulation: {\n    ar: \"\330\252\330\255\331\204\331\212\331\204 \331\210\330\252\331\210\331\204\331\212\330\257 \330\247\331\204\331\206\331\205\330\247\330\260\330\254\",\n    fr: \"Lancer la Simulation\",\n    en: \"Execute Simulation\"\n  },\n  simulatedOutput: {\n    ar: \"\330\247\331\204\331\205\330\256\330\261\330\254\330\247\330\252 \331\210\330\247\331\204\331\206\330\252\331\212\330\254\330\251 \330\247\331\204\331\205\330\255\331\210\330\263\330\250\330\251\",\n    fr: \"R\303\251sultat de la simulation\",\n    en: \"Simulated Report Outflow\"\n  },\n\n  // Auth pages\n  loginTitle: {\n    ar: \"\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\257\330\256\331\210\331\204 \330\245\331\204\331\211 \330\255\330\263\330\247\330\250\331\203 \331\201\331\212 \330\243\331\203\331\210\331\206\331\212\330\252\",\n    fr: \"Connexion \303\240 votre espace AccoNet\",\n    en: \"Sign In to Your AccoNet Account\"\n  },\n  registerTitle: {\n    ar: \"\330\245\331\206\330\264\330\247\330\241 \330\255\330\263\330\247\330\250 \330\254\330\257\331\212\330\257 \331\201\331\212 \330\243\331\203\331\210\331\206\331\212\330\252\",\n    fr: \"Cr\303\251er votre profil AccoNet\",\n    en: \"Create Your AccoNet Account\"\n  },\n  accountTypeLabel: {\n    ar: \"\330\243\331\206\330\252 \330\252\331\202\331\210\331\205 \330\250\330\247\331\204\330\252\330\263\330\254\331\212\331\204 \331\203\331\200:\",\n    fr: \"Vous vous inscrivez en tant que :\",\n    en: \"You are registering as:\"\n  },\n  isClientLabel: {\n    ar: \"\330\265\330\247\330\255\330\250 \330\264\330\261\331\203\330\251 / \331\205\330\263\331\212\330\261 (\330\243\330\250\330\255\330\253 \330\271\331\206 \331\205\330\255\330\247\330\263\330\250)\",\n    fr: \"Dirigeant d\'entreprise (cherche un expert)\",\n    en: \"Business/SME Director (Looking to Hire)\"\n  },\n  isProLabel: {\n    ar: \"\331\205\331\207\331\206\331\212 \331\205\330\271\330\252\331\205\330\257 \331\210\330\261\330\243\330\263 \331\205\330\247\331\204 \331\205\330\247\331\204\331\212 (\330\256\330\250\331\212\330\261)\",\n    fr: \"Professionnel de comptabilit\303\251 (offre des services)\",\n    en: \"Certified Accounting Professional (Offering Services)\"\n  },\n  fieldEmail: {\n    ar: \"\330\247\331\204\330\250\330\261\331\212\330\257 \330\247\331\204\330\245\331\204\331\203\330\252\330\261\331\210\331\206\331\212 \331\204\331\204\330\271\331\205\331\204\",\n    fr: \"Adresse e-mail professionnelle\",\n    en: \"Professional Email Address\"\n  },\n  fieldPassword: {\n    ar: \"\331\203\331\204\331\205\330\251 \330\247\331\204\331\205\330\261\331\210\330\261\",\n    fr: \"Mot de passe\",\n    en: \"Password\"\n  },\n  fieldCompanyName: {\n    ar: \"\330\247\330\263\331\205 \330\247\331\204\330\264\330\261\331\203\330\251 \331\210\330\247\331\204\331\205\330\244\330\263\330\263\330\251\",\n    fr: \"Nom de l\'entreprise\",\n    en: \"Corporate Entity Name\"\n  },\n  fieldWilaya: {\n    ar: \"\330\247\331\204\331\210\331\204\330\247\331\212\330\251 \330\247\331\204\331\205\331\202\330\261\",\n    fr: \"Wilaya du si\303\250ge principal\",\n    en: \"Primary Wilaya HQ\"\n  },\n  fieldSpecialty: {\n    ar: \"\330\247\331\204\330\252\330\256\330\265\330\265 \330\247\331\204\331\205\331\207\331\206\331\212 \330\247\331\204\330\261\330\246\331\212\330\263\331\212\",\n    fr: \"Sp\303\251cialit\303\251 comptable\",\n    en: \"Primary Specialty Scope\"\n  },\n  fieldAccreditation: {\n    ar: \"\330\261\331\202\331\205 \331\202\331\212\330\257 \330\247\331\204\330\247\330\271\330\252\331\205\330\247\330\257 \330\247\331\204\331\210\330\267\331\206\331\212\",\n    fr: \"Num\303\251ro d\'agr\303\251ment officiel\",\n    en: \"Official Accredit Register N\302\260\"\n  },\n  accNumPlaceholder: {\n    ar: \"\331\205\330\253\330\247\331\204: CNEC/2020/2210\",\n    fr: \"Ex: CNEC/2020/2210\",\n    en: \"Ex: CNEC/2020/2210\"\n  },\n  authSuccessHeading: {\n    ar: \"\331\205\330\261\330\255\330\250\330\247\331\213 \330\250\331\203 \331\201\331\212 \330\243\331\203\331\210\331\206\331\212\330\252!\",\n    fr: \"Bienvenue sur AccoNet !\",\n    en: \"Welcome to AccoNet!\"\n  },\n  authSuccessMsg: {\n    ar: \"\330\252\331\205 \331\205\330\255\330\247\331\203\330\247\330\251 \330\247\331\204\331\205\330\265\330\247\330\257\331\202\330\251 \331\210\330\247\331\204\330\257\330\256\331\210\331\204 \330\250\331\206\330\254\330\247\330\255 \331\204\330\257\331\210\330\247\330\271\331\212 \330\247\331\204\330\271\330\261\330\266 \330\247\331\204\330\252\331\202\330\257\331\212\331\205\331\212.\",\n    fr: \"La session simul\303\251e est initi\303\251e avec succ\303\250s pour la d\303\251monstration.\",\n    en: \"Simulated demonstration session successfully initialized. Welcome aboard.\"\n  },\n  dontHaveAccount: {\n    ar: \"\331\204\331\212\330\263 \331\204\330\257\331\212\331\203 \330\255\330\263\330\247\330\250\330\237\",\n    fr: \"Pas encore de compte ?\",\n    en: \"Don\'t have an account?\"\n  },\n  alreadyHaveAccount: {\n    ar: \"\331\204\330\257\331\212\331\203 \330\255\330\263\330\247\330\250 \330\250\330\247\331\204\331\201\330\271\331\204\330\237\",\n    fr: \"D\303\251j\303\240 inscrit ?\",\n    en: \"Already have an account?\"\n  },\n\n  // Interactive hire triggers & alerts\n  alertHireSuccessTitle: {\n    ar: \"\330\252\331\205 \330\245\330\261\330\263\330\247\331\204 \330\267\331\204\330\250 \330\247\331\204\330\252\331\210\330\270\331\212\331\201 \330\250\331\206\330\254\330\247\330\255!\",\n    fr: \"Demande d\'embauche transmise !\",\n    en: \"Hire Request Dispatched Successfully!\"\n  },\n  alertHireSuccessBody: {\n    ar: \"\331\204\331\202\330\257 \330\252\331\205 \330\245\330\261\330\263\330\247\331\204 \331\205\330\263\331\210\330\257\330\251 \330\247\331\204\330\271\331\202\330\257 \330\247\331\204\331\205\330\250\330\257\330\246\331\212\330\251 \331\210\331\202\331\212\331\205\330\252\331\207\330\247 \331\204\331\204\330\256\330\250\331\212\330\261. \330\263\331\212\331\202\331\210\331\205 \330\250\331\205\330\261\330\247\330\254\330\271\330\251 \330\267\331\204\330\250\331\203 \330\256\331\204\330\247\331\204 24 \330\263\330\247\330\271\330\251 \331\210\330\247\331\204\330\252\331\210\330\247\330\265\331\204 \331\205\330\271\331\203\331\205.\",\n    fr: \"Votre brouillon de contrat a \303\251t\303\251 envoy\303\251 \303\240 l\'expert. Il examinera votre proposition sous 24h.\",\n    en: \"Your draft engagement proposal has been dispatched. The expert will review and reply within 24 hours.\"\n  },\n  alertMessageSuccessTitle: {\n    ar: \"\330\252\331\205 \330\245\330\261\330\263\330\247\331\204 \330\247\331\204\330\261\330\263\330\247\331\204\330\251 \330\250\331\206\330\254\330\247\330\255!\",\n    fr: \"Message envoy\303\251 avec succ\303\250s !\",\n    en: \"Message Sent Successfully!\"\n  },\n  alertMessageSuccessBody: {\n    ar: \"\330\252\331\205 \330\252\330\263\331\204\331\212\331\205 \330\247\330\263\330\252\331\201\330\263\330\247\330\261\331\203 \331\204\330\265\331\206\330\257\331\210\331\202 \330\247\331\204\330\252\330\261\330\247\330\263\331\204 \330\247\331\204\330\263\330\261\331\212\330\271 \330\247\331\204\330\256\330\247\330\265 \330\250\330\247\331\204\330\256\330\250\331\212\330\261. \330\263\330\252\330\265\331\204\331\203 \330\247\331\204\330\245\330\264\330\271\330\247\330\261\330\247\330\252 \331\201\331\210\330\261 \330\247\331\204\330\261\330\257.\",\n    fr: \"Votre message est maintenant visible dans l\'espace de messagerie de l\'expert.\",\n    en: \"Your query has been sent to the expert\'s mailbox. You\'ll receive real-time updates as they respond.\"\n  },\n  closeBtn: {\n    ar: \"\330\245\330\272\331\204\330\247\331\202\",\n    fr: \"Fermer\",\n    en: \"Close\"\n  },\n  seeDemoDashboard: {\n    ar: \"\330\262\331\212\330\247\330\261\330\251 \331\204\331\210\330\255\330\251 \330\247\331\204\330\271\331\205\331\204 \330\247\331\204\330\252\330\254\330\261\331\212\330\250\331\212\330\251\",\n    fr: \"Visiter l\'espace de d\303\251monstration\",\n    en: \"Visit Demo Workspace Dashboard\"\n  },\n  allRightsReserved: {\n    ar: \"\330\254\331\205\331\212\330\271 \330\247\331\204\330\255\331\202\331\210\331\202 \331\205\330\255\331\201\331\210\330\270\330\251. \330\252\331\205 \330\252\330\265\331\205\331\212\331\205\331\207 \330\250\331\203\331\204 \331\201\330\256\330\261 \331\204\330\256\330\257\331\205\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212\330\251 \331\210\330\247\331\204\330\264\330\261\331\203\330\247\330\252 \330\247\331\204\330\265\330\247\330\271\330\257\330\251.\",\n    fr: \"Tous droits r\303\251serv\303\251s. Con\303\247u avec fiert\303\251 pour l\'administration et les PME en Alg\303\251rie.\",\n    en: \"All rights reserved. Styled with pride for Algerian entrepreneurs & finance agents.\"\n  }\n};\n"
    }
