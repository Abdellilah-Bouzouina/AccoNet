  file_change {
    absolute_path_uri: "file:///src/pages/Register.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useNavigate, Link } from \'react-router-dom\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useApp } from \'../context/AppContext\';\nimport { algerianWilayas } from \'../data/algerianWilayas\';\nimport { DocumentUpload } from \'../components/DocumentUpload\';\nimport { \n  Building2, UserCheck, ShieldCheck, Mail, Lock, \n  MapPin, Award, ArrowLeft, ArrowRight, X, UserPlus, \n  Phone, Globe, FileText, CheckCircle2, ChevronRight, Sliders, BadgeCheck, Scale \n} from \'lucide-react\';\n\nexport const Register: React.FC = () => {\n  const { t, tSpec, tObj, direction, language } = useLanguage();\n  const { setUserRole, setCurrentClient, setCurrentProfessional, triggerNotification } = useApp();\n  const navigate = useNavigate();\n\n  // Primary Pathway: \'client\' (Entreprise) vs \'professional\' (Mhni)\n  const [regRole, setRegRole] = useState<\'client\' | \'professional\'>(\'client\');\n\n  // Wizard active steps\n  // Path Professional: Steps 1, 2, 3, 4\n  // Path Client: Steps 1, 2, 3\n  const [currentStep, setCurrentStep] = useState(1);\n  const [registrationSuccess, setRegistrationSuccess] = useState<string | null>(null); // Reference ID on success\n\n  // ------------------------------------------\n  // FORM VARIABLES: PATH A & B COMMON/SPECIFIC\n  // ------------------------------------------\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [confirmPassword, setConfirmPassword] = useState(\'\');\n  const [fullName, setFullName] = useState(\'\'); // Professional full name or responsible contact name\n  const [phoneOperator, setPhoneOperator] = useState(\'06\'); // Mobilis 06, Djezzy 07, Ooredoo 05\n  const [phoneRest, setPhoneRest] = useState(\'\'); // remaining 8 digits\n  const [selectedWilayaId, setSelectedWilayaId] = useState<number>(16); // default Algiers (code 16)\n  \n  // PATH A (Professional) SPECIFICS\n  const [specialty, setSpecialty] = useState(\'certified-accountant\');\n  const [tableauNumber, setTableauNumber] = useState(\'\');\n  const [agreeCabinetNumber, setAgreeCabinetNumber] = useState(\'\');\n  const [yearsExperience, setYearsExperience] = useState(5);\n  const [languagesOfWork, setLanguagesOfWork] = useState({\n    ar: true,\n    fr: true,\n    en: false,\n    tamazight: false\n  });\n  \n  // Base64 document states for Professional\n  const [proDocs, setProDocs] = useState<{\n    cartePro: { name: string; size: string; data: string } | null;\n    identity: { name: string; size: string; data: string } | null;\n    attestationInsc: { name: string; size: string; data: string } | null;\n    decisionAgree: { name: string; size: string; data: string } | null;\n  }>({\n    cartePro: null,\n    identity: null,\n    attestationInsc: null,\n    decisionAgree: null\n  });\n\n  const [attestHonourPro, setAttestHonourPro] = useState(false);\n\n  // PATH B (Entreprise/Client) SPECIFICS\n  const [entityType, setEntityType] = useState(\'SARL\');\n  const [companyNameAR, setCompanyNameAR] = useState(\'\');\n  const [companyNameFR, setCompanyNameFR] = useState(\'\');\n  const [rcNumber, setRcNumber] = useState(\'\');\n  const [nifNumber, setNifNumber] = useState(\'\');\n  const [aiNumber, setAiNumber] = useState(\'\');\n  const [secteurActivite, setSecteurActivite] = useState(\'Tech & Num\303\251rique\');\n  const [regimeFiscal, setRegimeFiscal] = useState(\'R\303\251gime r\303\251el (IBS)\');\n\n  // Base64 document states for Client\n  const [clientDocs, setClientDocs] = useState<{\n    extraitRC: { name: string; size: string; data: string } | null;\n    carteNIF: { name: string; size: string; data: string } | null;\n    roleApure: { name: string; size: string; data: string } | null;\n    gerantId: { name: string; size: string; data: string } | null;\n    recepisseAssociation: { name: string; size: string; data: string } | null;\n    certificatStartup: { name: string; size: string; data: string } | null;\n  }>({\n    extraitRC: null,\n    carteNIF: null,\n    roleApure: null,\n    gerantId: null,\n    recepisseAssociation: null,\n    certificatStartup: null\n  });\n\n  const [attestHonourClient, setAttestHonourClient] = useState(false);\n\n  // Validation errors per step\n  const [stepErrors, setStepErrors] = useState<string | null>(null);\n\n  // Reset helper when toggling roles\n  const handleRoleToggle = (role: \'client\' | \'professional\') => {\n    setRegRole(role);\n    setCurrentStep(1);\n    setStepErrors(null);\n    setRegistrationSuccess(null);\n  };\n\n  // ------------------------------------------\n  // STEPPER ACTIONS & VALIDATION\n  // ------------------------------------------\n  const validateCurrentStep = (): boolean => {\n    setStepErrors(null);\n\n    // Validate email formatting\n    const parsedEmail = email.trim();\n    if (currentStep === 1) {\n      if (!fullName) {\n        setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\245\330\257\330\256\330\247\331\204 \330\247\331\204\330\247\330\263\331\205 \330\247\331\204\331\203\330\247\331\205\331\204.\' : \'Veuillez renseigner votre nom complet.\');\n        return false;\n      }\n      if (!parsedEmail || !parsedEmail.includes(\'@\')) {\n        setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\245\330\257\330\256\330\247\331\204 \330\250\330\261\331\212\330\257 \330\245\331\204\331\203\330\252\330\261\331\210\331\206\331\212 \331\205\331\207\331\206\331\212 \330\265\330\247\331\204\330\255.\' : \'Veuillez saisir un e-mail professionnel valide.\');\n        return false;\n      }\n      if (password.length < 8) {\n        setStepErrors(language === \'ar\' ? \'\331\203\331\204\331\205\330\251 \330\247\331\204\331\205\330\261\331\210\330\261 \331\212\330\254\330\250 \330\243\331\206 \331\204\330\247 \330\252\331\202\331\204 \330\271\331\206 8 \330\261\331\205\331\210\330\262.\' : \'Le mot de passe doit comporter au moins 8 caract\303\250res.\');\n        return false;\n      }\n      // Password complex verification\n      const hasNumber = /\\d/.test(password);\n      const hasSpecial = /[!@#$%^&*(),.?\":{}|<>]/.test(password);\n      if (!hasNumber || !hasSpecial) {\n        setStepErrors(\n          language === \'ar\' \n            ? \'\331\203\331\204\331\205\330\251 \330\247\331\204\331\205\330\261\331\210\330\261 \331\212\330\254\330\250 \330\243\331\206 \330\252\330\255\330\252\331\210\331\211 \330\271\331\204\331\211 \330\261\331\202\331\205 \331\210\330\247\330\255\330\257 \331\210\330\261\331\205\330\262 \330\256\330\247\330\265 \331\210\330\247\330\255\330\257 \330\271\331\204\331\211 \330\247\331\204\330\243\331\202\331\204.\' \n            : \'Le mot de passe doit contenir au moins un chiffre et un caract\303\250re sp\303\251cial.\'\n        );\n        return false;\n      }\n      if (password !== confirmPassword) {\n        setStepErrors(language === \'ar\' ? \'\331\203\331\204\331\205\330\252\330\247 \330\247\331\204\331\205\330\261\331\210\330\261 \330\272\331\212\330\261 \331\205\330\252\330\267\330\247\330\250\331\202\330\252\331\212\331\206.\' : \'Les mots de passe ne correspondent pas.\');\n        return false;\n      }\n      if (phoneRest.length < 7) {\n        setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\245\330\257\330\256\330\247\331\204 \330\261\331\202\331\205 \331\207\330\247\330\252\331\201 \330\254\330\262\330\247\330\246\330\261\331\212 \330\265\330\255\331\212\330\255.\' : \'Veuillez entrer un num\303\251ro de t\303\251l\303\251phone alg\303\251rien valide.\');\n        return false;\n      }\n    }\n\n    if (regRole === \'professional\') {\n      if (currentStep === 2) {\n        if (!tableauNumber) {\n          setStepErrors(language === \'ar\' ? \'\330\261\331\202\331\205 \330\247\331\204\331\202\331\212\330\257 \331\201\331\212 \330\247\331\204\330\254\330\257\331\210\331\204 \330\247\331\204\331\210\330\267\331\206\331\212 \330\245\331\204\330\262\330\247\331\205\331\212.\' : \"Le num\303\251ro d\'inscription au Tableau National de l\'Ordre est requis.\");\n          return false;\n        }\n      }\n      if (currentStep === 3) {\n        // Document step validation for Professional\n        if (!proDocs.cartePro) {\n          setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\252\330\255\331\205\331\212\331\204 \330\250\330\267\330\247\331\202\330\252\331\203 \330\247\331\204\331\205\331\207\331\206\331\212\330\251.\' : \'Veuillez t\303\251l\303\251verser votre Carte Professionnelle.\');\n          return false;\n        }\n        if (!proDocs.identity) {\n          setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\252\330\255\331\205\331\212\331\204 \331\210\330\253\331\212\331\202\330\251 \330\247\331\204\331\207\331\210\331\212\330\251 \330\247\331\204\330\264\330\256\330\265\331\212\330\251.\' : \"Veuillez t\303\251l\303\251verser votre Pi\303\250ce d\'Identit\303\251.\");\n          return false;\n        }\n        if (!proDocs.attestationInsc) {\n          setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\252\330\255\331\205\331\212\331\204 \330\264\331\207\330\247\330\257\330\251 \330\247\331\204\331\202\331\212\330\257 \331\201\331\212 \330\247\331\204\330\254\330\257\331\210\331\204 \330\247\331\204\331\210\330\267\331\206\331\212.\' : \"Veuillez t\303\251l\303\251verser votre Attestation d\'Inscription.\");\n          return false;\n        }\n      }\n    } else {\n      // Client Pathway\n      if (currentStep === 2) {\n        if (!companyNameFR && !companyNameAR) {\n          setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\245\330\257\330\256\330\247\331\204 \330\247\331\204\330\247\330\263\331\205 \330\247\331\204\330\252\330\254\330\247\330\261\331\212 \331\204\331\204\330\264\330\261\331\203\330\251.\' : \'Veuillez saisir la d\303\251nomination de votre entreprise.\');\n          return false;\n        }\n        if (!rcNumber) {\n          setStepErrors(language === \'ar\' ? \'\330\261\331\202\331\205 \330\247\331\204\330\263\330\254\331\204 \330\247\331\204\330\252\330\254\330\247\330\261\331\212 \330\245\331\204\330\262\330\247\331\205\331\212.\' : \"Le Num\303\251ro d\'inscription au Registre du Commerce (RC) est requis.\");\n          return false;\n        }\n        // RC structure check: XX/XXXXXX/XX or similar\n        if (!rcNumber.includes(\'/\')) {\n          setStepErrors(language === \'ar\' ? \'\330\252\331\206\330\263\331\212\331\202 \330\247\331\204\330\263\330\254\331\204 \330\247\331\204\330\252\330\254\330\247\330\261\331\212 \331\212\330\254\330\250 \330\243\331\206 \331\212\330\264\330\250\331\207 XX/XXXXXX/XX.\' : \"Le format du RC doit ressembler \303\240 XX/XXXXXX/XX (ex: 16/00-109432B18).\");\n          return false;\n        }\n        if (!nifNumber || nifNumber.length !== 15) {\n          setStepErrors(language === \'ar\' ? \'\330\261\331\202\331\205 \330\247\331\204\330\252\330\271\330\261\331\212\331\201 \330\247\331\204\330\254\330\250\330\247\330\246\331\212 (NIF) \331\212\330\254\330\250 \330\243\331\206 \331\212\330\252\331\203\331\210\331\206 \331\205\331\206 15 \330\261\331\202\331\205\330\247\331\213.\' : \"Le Num\303\251ro d\'Identification Fiscale (NIF) doit comporter exactement 15 chiffres.\");\n          return false;\n        }\n      }\n      if (currentStep === 3) {\n        // Document step validation for Client\n        if (!clientDocs.extraitRC) {\n          setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\252\330\255\331\205\331\212\331\204 \331\205\330\263\330\252\330\256\330\261\330\254 \330\247\331\204\330\263\330\254\331\204 \330\247\331\204\330\252\330\254\330\247\330\261\331\212 (RC).\' : \'Veuillez charger votre Extrait de Registre de Commerce (RC).\');\n          return false;\n        }\n        if (!clientDocs.carteNIF) {\n          setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\252\330\255\331\205\331\212\331\204 \330\250\330\267\330\247\331\202\330\251 \330\247\331\204\330\252\330\271\330\261\331\212\331\201 \330\247\331\204\330\254\330\250\330\247\330\246\331\212 (NIF).\' : \"Veuillez charger votre Carte d\'Immatriculation Fiscale (NIF).\");\n          return false;\n        }\n        if (!clientDocs.gerantId) {\n          setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\252\330\255\331\205\331\212\331\204 \331\207\331\210\331\212\330\251 \330\254\331\212\331\206\330\261\330\247\331\204 \330\247\331\204\331\205\330\263\331\212\330\261.\' : \"Veuillez charger la Pi\303\250ce d\'Identit\303\251 du g\303\251rant repr\303\251sentant l\303\251gal.\");\n          return false;\n        }\n        if (entityType === \'Association\' && !clientDocs.recepisseAssociation) {\n          setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\252\330\255\331\205\331\212\331\204 \330\261\330\256\330\265 \330\247\331\204\330\252\330\261\330\256\331\212\330\265 \330\247\331\204\330\256\330\247\330\265\330\251 \330\250\330\247\331\204\330\254\331\205\330\271\331\212\330\251.\' : \"Veuillez charger le R\303\251c\303\251piss\303\251 d\'agr\303\251ment de l\'association (Loi 12-06).\");\n          return false;\n        }\n        if (entityType === \'Startup labellis\303\251e\' && !clientDocs.certificatStartup) {\n          setStepErrors(language === \'ar\' ? \'\331\212\330\261\330\254\331\211 \330\252\330\255\331\205\331\212\331\204 \330\264\331\207\330\247\330\257\330\251 \330\271\331\204\330\247\331\205\330\251 \330\264\330\261\331\203\330\251 \331\206\330\247\330\264\330\246\330\251.\' : \"Veuillez charger votre Certificat de Label Startup DZ.\");\n          return false;\n        }\n      }\n    }\n\n    return true;\n  };\n\n  const handleNextStep = () => {\n    if (validateCurrentStep()) {\n      setCurrentStep(prev => prev + 1);\n    }\n  };\n\n  const handlePrevStep = () => {\n    setStepErrors(null);\n    setCurrentStep(prev => Math.max(prev - 1, 1));\n  };\n\n  // Final Action Handlers\n  const handleFinalSubmitPro = () => {\n    if (!attestHonourPro) {\n      setStepErrors(language === \'ar\' ? \'\331\212\330\254\330\250 \330\271\331\204\331\212\331\203 \330\252\330\243\331\203\331\212\330\257 \330\265\330\255\330\251 \330\247\331\204\331\210\330\253\330\247\330\246\331\202 \330\250\331\205\331\210\330\254\330\250 \330\247\331\204\331\202\330\247\331\206\331\210\331\206 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212.\' : \"Veuillez cocher l\'attestation sur l\'honneur pour continuer.\");\n      return;\n    }\n\n    // Success response construction\n    const referenceId = `ACC-PRO-${new Date().getFullYear()}-${Math.floor(10000 + Math.random() * 90000)}`;\n    setRegistrationSuccess(referenceId);\n\n    // Mount into App Context State\n    setUserRole(\'professional\');\n    setCurrentProfessional({\n      id: `p_reg_${Date.now()}`,\n      name: { ar: fullName, fr: fullName, en: fullName },\n      initials: fullName.substring(0, 2).toUpperCase(),\n      avatarBg: \"bg-indigo-700 text-white\",\n      specialty: specialty as any,\n      wilayaId: selectedWilayaId,\n      wilayaName: algerianWilayas.find(w => w.id === selectedWilayaId)?.name || { ar: \"\330\247\331\204\330\254\330\262\330\247\330\246\330\261\", fr: \"Alger\", en: \"Algiers\" },\n      rating: 5.0,\n      reviewCount: 0,\n      hourlyRate: specialty === \'certified-accountant\' ? 3500 : 7000,\n      available: true,\n      yearsExperience: yearsExperience,\n      accreditationNumber: tableauNumber,\n      completionRate: 100,\n      clientsServed: 0,\n      bio: {\n        ar: `\331\205\331\203\330\252\330\250 \331\205\330\271\330\252\331\205\330\257 \331\210\331\205\330\263\330\254\331\204. \330\247\331\204\331\204\330\272\330\247\330\252 \330\247\331\204\331\205\330\271\330\252\331\205\330\257\330\251: ${languagesOfWork.ar ? \'\330\247\331\204\330\271\330\261\330\250\331\212\330\251\' : \'\'} ${languagesOfWork.fr ? \'\330\247\331\204\331\201\330\261\331\206\330\263\331\212\330\251\' : \'\'}. \330\255\330\250\330\261\330\251 \331\205\331\205\330\252\330\257\330\251 \331\204\331\200 ${yearsExperience} \330\263\331\206\330\251.`,\n        fr: `Cabinet agr\303\251\303\251 actif sur la wilaya d\'inscription. Exp\303\251rience acquise de ${yearsExperience} ans.`,\n        en: `Licensed practice with over ${yearsExperience} years experience compliant with the National orders.`\n      },\n      services: [\n        {\n          title: { ar: \'\330\247\331\204\330\252\330\255\331\202\331\202 \331\210\330\247\331\204\331\205\330\267\330\247\330\250\331\202\330\251 \330\247\331\204\330\254\330\250\330\247\330\246\331\212\330\251 \330\247\331\204\330\257\331\210\330\261\331\212\330\251\', fr: \'V\303\251rification et conformit\303\251 fiscale r\303\251guli\303\250re\', en: \'Regular compliance auditing\' },\n          description: { ar: \'\330\266\331\205\330\247\331\206 \330\247\331\204\330\252\331\210\330\247\331\201\331\202 \330\247\331\204\330\252\330\247\331\205 \331\204\331\205\330\244\330\263\330\263\330\252\331\203\331\205 \331\205\330\271 \330\243\330\255\331\203\330\247\331\205 \331\202\331\210\330\247\331\206\331\212\331\206 \330\247\331\204\331\205\330\247\331\204\331\212\330\251 \331\210\330\247\331\204\330\266\330\261\330\247\330\246\330\250.\', fr: \'Audit r\303\251gulier de vos \303\251critures face aux exigences de l\\\'administration DGI.\', en: \'Standard monitoring of accounting registers\' },\n          price: \"15,000 DA\"\n        }\n      ],\n      reviews: [],\n      history: []\n    });\n\n    triggerNotification(\n      \"Dossier Professionnel Re\303\247u\",\n      `Dossier d\'agr\303\251ment de Me. ${fullName} soumis de fa\303\247on s\303\251curis\303\251e sous la r\303\251f ${referenceId}.`\n    );\n  };\n\n  const handleFinalSubmitClient = () => {\n    if (!attestHonourClient) {\n      setStepErrors(language === \'ar\' ? \'\331\212\330\254\330\250 \330\271\331\204\331\212\331\203 \330\252\330\243\331\203\331\212\330\257 \330\265\330\255\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \331\210\330\247\331\204\331\210\330\253\330\247\330\246\331\202 \330\250\331\205\331\210\330\254\330\250 \330\247\331\204\331\202\330\247\331\206\331\210\331\206.\' : \"Veuillez cocher l\'attestation sur l\'honneur pour soumettre.\");\n      return;\n    }\n\n    const referenceId = `ACC-CLI-${new Date().getFullYear()}-${Math.floor(10000 + Math.random() * 90000)}`;\n    setRegistrationSuccess(referenceId);\n\n    // Mount into App Context State\n    setUserRole(\'client\');\n    const compName = companyNameFR || companyNameAR;\n    setCurrentClient({\n      id: `c_reg_${Date.now()}`,\n      companyName: compName,\n      sector: { ar: secteurActivite, fr: secteurActivite, en: secteurActivite },\n      wilayaId: selectedWilayaId,\n      wilayaName: algerianWilayas.find(w => w.id === selectedWilayaId)?.name || { ar: \"\330\247\331\204\330\254\330\262\330\247\330\246\330\261\", fr: \"Alger\", en: \"Algiers\" },\n      logoInitials: compName.substring(0, 2).toUpperCase(),\n      avatarBg: \"bg-teal-700 text-white\",\n      NIF: nifNumber,\n      RC: rcNumber,\n      activeContracts: [],\n      pendingTasks: []\n    });\n\n    triggerNotification(\n      \"Inscription Entreprise Compl\303\251t\303\251e\",\n      `Profil de ${compName} valid\303\251 avec succ\303\250s. R\303\251f\303\251rence d\'enregistrement : ${referenceId}.`\n    );\n  };\n\n  // Stepper representation parameters\n  const proStepsDef = [\n    { num: 1, title: \'Compte Info\', titleAR: \'\331\205\330\271\331\204\331\210\331\205\330\247\330\252 \330\247\331\204\330\255\330\263\330\247\330\250\' },\n    { num: 2, title: \'Identit\303\251 Pro\', titleAR: \'\330\247\331\204\331\207\331\210\331\212\330\251 \330\247\331\204\331\205\331\207\331\206\331\212\330\251\' },\n    { num: 3, title: \'T\303\251l\303\251versements\', titleAR: \'\330\261\331\201\330\271 \330\247\331\204\331\210\330\253\330\247\330\246\331\202\' },\n    { num: 4, title: \'Validation\', titleAR: \'\330\247\331\204\330\252\330\255\331\202\331\202 \331\210\330\247\331\204\331\205\330\261\330\247\330\254\330\271\330\251\' }\n  ];\n\n  const clientStepsDef = [\n    { num: 1, title: \'Compte Info\', titleAR: \'\331\205\330\271\331\204\331\210\331\205\330\247\330\252 \330\247\331\204\330\255\330\263\330\247\330\250\' },\n    { num: 2, title: \'Soci\303\251t\303\251 Identit\303\251\', titleAR: \'\330\252\331\201\330\247\330\265\331\212\331\204 \330\247\331\204\331\205\330\244\330\263\330\263\330\251\' },\n    { num: 3, title: \'Documents L\303\251gaux\', titleAR: \'\330\252\330\255\331\205\331\212\331\204 \330\247\331\204\331\205\330\263\330\252\331\206\330\257\330\247\330\252\' }\n  ];\n\n  const activeStepsDef = regRole === \'professional\' ? proStepsDef : clientStepsDef;\n  const isLastWizardStep = currentStep === activeStepsDef.length;\n\n  return (\n    <div className=\"min-h-[calc(100vh-4rem)] flex flex-col lg:flex-row bg-[#FAF9F5] antialiased\" id=\"register_full_wizard\" dir={direction}>\n      \n      {/* 1. LEFT STICKY REGULAR SIDE PANEL (DESKTOP STEPPER AND BRAND BAR) */}\n      <div className=\"w-full lg:w-1/3 bg-[#0B1A16] text-white p-6 sm:p-10 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-[#0F6E56]/35 shrink-0 select-none\">\n        <div className=\"space-y-6\">\n          \n          {/* Logo link */}\n          <Link to=\"/\" className=\"inline-flex items-center space-x-2.5 rtl:space-x-reverse text-left\">\n            <span className=\"flex items-center justify-center w-8 h-8 rounded-none bg-white text-brand-primary font-bold text-lg border border-[#CFCFC4]\">\n              \330\243\n            </span>\n            <span className=\"text-xl font-serif font-semibold tracking-tight text-white\">\n              AccoNet <span className=\"text-brand-accent\">\330\243\331\203\331\210\331\206\331\212\330\252</span>\n            </span>\n          </Link>\n\n          {/* Stepper Shell Wrapper (Dynamic left side rendering) */}\n          {!registrationSuccess && (\n            <div className=\"hidden lg:block pt-8 space-y-7 text-left rtl:text-right\">\n              <span className=\"text-[9px] font-mono font-bold text-brand-accent uppercase tracking-widest block mb-4\">\n                {regRole === \'professional\' ? \'MHNI PROFILE ONBOARDING\' : \'ENTERPRISE ONBOARDING\'}\n              </span>\n\n              {activeStepsDef.map((st) => {\n                const isActive = st.num === currentStep;\n                const isCompleted = st.num < currentStep;\n\n                return (\n                  <div key={st.num} className=\"flex items-start gap-4\">\n                    {/* Circle Indicator */}\n                    <div className={`w-8 h-8 flex items-center justify-center shrink-0 border ${\n                      isActive \n                        ? \'border-brand-accent bg-[#0F6E56] text-white font-black\' \n                        : isCompleted\n                          ? \'border-emerald-500 bg-emerald-600/20 text-emerald-400\'\n                          : \'border-white/10 text-white/40\'\n                    }`}>\n                      {isCompleted ? \'\342\234\223\' : st.num}\n                    </div>\n\n                    {/* Step terms */}\n                    <div className=\"space-y-0.5\">\n                      <p className={`text-xs font-bold font-mono tracking-wide ${isActive ? \'text-white\' : \'text-white/50\'}`}>\n                        {st.title}\n                      </p>\n                      <p className={`text-[10px] font-bold ${isActive ? \'text-brand-accent\' : \'text-white/30\'}`}>\n                        {st.titleAR}\n                      </p>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          )}\n\n          {/* Stepper overview for Mobile rendering */}\n          {!registrationSuccess && (\n            <div className=\"block lg:hidden mt-2 p-3 bg-white/5 border border-white/10\">\n              <div className=\"flex justify-between text-xs font-mono text-gray-300\">\n                <span>\303\211tape {currentStep} sur {activeStepsDef.length}</span>\n                <span className=\"text-brand-accent font-bold\">\n                  {activeStepsDef[currentStep - 1]?.title} ({activeStepsDef[currentStep-1]?.titleAR})\n                </span>\n              </div>\n              <div className=\"w-full bg-white/10 h-1 mt-2 overflow-hidden rounded-none\">\n                <div \n                  className=\"bg-brand-accent h-full transition-all duration-300\"\n                  style={{ width: `${(currentStep / activeStepsDef.length) * 100}%` }}\n                ></div>\n              </div>\n            </div>\n          )}\n\n        </div>\n\n        {/* Footnote */}\n        <div className=\"pt-6 border-t border-white/10 text-[10px] text-gray-400 font-mono space-y-1.5 text-left rtl:text-right\">\n          <p className=\"font-bold flex items-center gap-1 text-[#F59E0B]\">\n            <Scale className=\"w-3.5 h-3.5\" />\n            <span>LOI INDUSTRIELLE & CODE CIVIL</span>\n          </p>\n          <p className=\"leading-relaxed\">\n            D\303\251p\303\264t crypt\303\251. Tous les dossiers sont confront\303\251s au registre national du Minist\303\250re des Finances & Tableaux de l\'ONEC, de l\'ONCC et de l\'ONCA.\n          </p>\n        </div>\n      </div>\n\n      {/* 2. RIGHT DYNAMIC WIZARD ACTION SHEET */}\n      <div className=\"flex-1 flex flex-col justify-between min-w-0\" id=\"wizard_interaction_area\">\n\n        {/* Tab Switching Selector (Visible only in initial Step 1) */}\n        {!registrationSuccess && currentStep === 1 && (\n          <div className=\"bg-white border-b border-[#CFCFC4] px-6 py-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3\">\n            <div>\n              <p className=\"text-[9px] font-mono font-bold text-gray-400 uppercase tracking-widest\">{t(\'accountTypeLabel\')}</p>\n              <h2 className=\"text-xs text-gray-700 font-mono mt-0.5\">Choisissez le profil adapt\303\251 \303\240 votre activit\303\251 sur la plateforme AccoNet.</h2>\n            </div>\n\n            <div className=\"flex gap-2 p-1 bg-[#FAF9F5] border border-[#CFCFC4] select-none shrink-0\">\n              <button\n                type=\"button\"\n                onClick={() => handleRoleToggle(\'client\')}\n                className={`px-4 py-2 cursor-pointer text-xs font-bold uppercase transition flex items-center gap-2 ${\n                  regRole === \'client\' \n                    ? \'bg-white text-brand-primary border border-[#CFCFC4] font-black\' \n                    : \'text-gray-500 hover:text-gray-950\'\n                }`}\n              >\n                <Building2 className=\"w-4 h-4 text-[#0F6E56]\" />\n                <span>{language === \'ar\' ? \'\330\247\331\204\331\205\330\244\330\263\330\263\330\251 / \330\247\331\204\330\264\330\261\331\203\330\251\' : \'Entreprise (Client)\'}</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => handleRoleToggle(\'professional\')}\n                className={`px-4 py-2 cursor-pointer text-xs font-bold uppercase transition flex items-center gap-2 ${\n                  regRole === \'professional\' \n                    ? \'bg-white text-indigo-700 border border-[#CFCFC4] font-black\' \n                    : \'text-gray-500 hover:text-gray-950\'\n                }`}\n              >\n                <UserCheck className=\"w-4 h-4 text-indigo-700\" />\n                <span>{language === \'ar\' ? \'\330\247\331\204\331\205\331\207\331\206\331\212 / \330\247\331\204\331\205\331\203\330\252\330\250\' : \'Professionnel (Cabinet)\'}</span>\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Wizard Central Content Panel */}\n        <div className=\"p-6 sm:p-10 lg:p-16 max-w-4xl w-full mx-auto flex-1 overflow-y-auto\">\n          \n          {/* Success screen placeholder */}\n          {registrationSuccess ? (\n            <div className=\"bg-white border border-[#CFCFC4] p-8 sm:p-12 text-center text-left rtl:text-right space-y-6 animate-fade-in shadow-xs\" id=\"reg_success_pane\">\n              \n              <div className=\"w-16 h-16 bg-emerald-50 border border-emerald-200 flex items-center justify-center mx-auto rounded-full\">\n                <BadgeCheck className=\"w-10 h-10 text-emerald-600\" />\n              </div>\n\n              <div className=\"space-y-2\">\n                <span className=\"px-2.5 py-1 bg-brand-primary/10 border border-brand-primary/20 text-[#0F6E56] text-[10px] font-mono font-bold uppercase tracking-widest\">\n                  {language === \'ar\' ? \'\330\252\331\205 \330\247\330\263\330\252\331\204\330\247\331\205 \330\247\331\204\331\205\331\204\331\201 \330\250\331\206\330\254\330\247\330\255\' : \'Dossier Enregistr\303\251 avec Succ\303\250s\'}\n                </span>\n                <h1 className=\"text-2xl sm:text-3xl font-serif font-black text-gray-901 tracking-tight\">\n                  {language === \'ar\' ? \'\330\252\331\205 \330\261\331\201\330\271 \330\267\331\204\330\250 \330\247\331\204\330\247\331\206\330\266\331\205\330\247\331\205 \331\210\330\247\331\204\330\252\330\255\331\202\331\202\' : \'Demande d\\\'adh\303\251sion soumise !\'}\n                </h1>\n                \n                <p className=\"text-xs text-gray-500 max-w-xl mx-auto font-sans leading-relaxed\">\n                  {language === \'ar\' \n                    ? \'\330\252\331\205 \330\252\330\263\330\254\331\212\331\204 \331\205\331\204\331\201 \330\247\331\204\330\263\330\254\331\204 \331\210\331\210\330\253\330\247\330\246\331\202 \330\247\331\204\330\247\330\271\330\252\331\205\330\247\330\257 \330\247\331\204\330\256\330\247\330\265\330\251 \330\250\331\203\331\205 \330\250\330\257\331\202\330\251 \331\201\331\212 \331\205\330\256\330\262\331\206 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212 \330\247\331\204\331\205\330\264\331\201\330\261. \330\263\330\252\330\252\331\205 \331\205\330\267\330\247\330\250\331\202\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \331\205\330\271 \330\263\330\254\331\204\330\247\330\252 \330\247\331\204\331\207\331\212\330\246\330\247\330\252 \330\247\331\204\331\210\330\267\331\206\331\212\330\251 (ONEC/ONCC) \330\256\331\204\330\247\331\204 48 \330\263\330\247\330\271\330\251.\' \n                    : \"Votre dossier est en cours de v\303\251rification. Vous recevrez une notification d\'activation r\303\251glementaire sous 48 heures ouvrables.\"}\n                </p>\n              </div>\n\n              {/* Reference ID Block */}\n              <div className=\"bg-[#FAF9F5] border border-[#CFCFC4] p-4 max-w-md mx-auto\">\n                <p className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">R\303\211F\303\211RENCE DU DOSSIER D\\\'AGR\303\211MENT</p>\n                <p className=\"text-xl font-mono font-black text-[#0F6E56] mt-1 tracking-wider select-all\">{registrationSuccess}</p>\n              </div>\n\n              <div className=\"max-w-xs mx-auto pt-4 space-y-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => navigate(regRole === \'professional\' ? \'/dashboard/professional\' : \'/dashboard/client\')}\n                  className=\"w-full py-2.5 bg-brand-primary hover:bg-[#085041] hover:scale-[1.01] text-white text-[10px] font-mono uppercase tracking-widest transition cursor-pointer font-bold shadow-xs flex items-center justify-center gap-1.5\"\n                >\n                  <span>Acc\303\251der \303\240 ma d\303\251mo imm\303\251diate</span>\n                  <ArrowRight className=\"w-4 h-4 shrink-0\" />\n                </button>\n                <Link to=\"/\" className=\"block text-xs font-bold text-gray-400 hover:text-gray-900 font-mono\">\n                  Retourner \303\240 l\'accueil\n                </Link>\n              </div>\n\n            </div>\n          ) : (\n            <div className=\"space-y-8\">\n              \n              {/* Central Title */}\n              <div className=\"pb-4 border-b border-[#EBEBE5]\">\n                <h1 className=\"text-xl sm:text-2xl font-serif font-bold text-gray-950 tracking-tight flex items-center gap-2\">\n                  <UserPlus className=\"w-6 h-6 text-[#0F6E56]\" />\n                  <span>\n                    {regRole === \'professional\' \n                      ? `Rejoindre en tant que Professionnel (${activeStepsDef[currentStep-1]?.title})`\n                      : `Cr\303\251er votre Espace Entreprises (${activeStepsDef[currentStep-1]?.title})`\n                    }\n                  </span>\n                </p>\n                <p className=\"text-[11px] text-[#0F6E56] font-mono font-extrabold uppercase mt-1 tracking-wider\">\n                  Algeria Legal Compliance Platform (\330\243\331\203\331\210\331\206\331\212\330\252 \330\247\331\204\330\254\330\262\330\247\330\246\330\261)\n                </p>\n              </div>\n\n              {/* STEP ERRORS DISPLAYER */}\n              {stepErrors && (\n                <div className=\"p-4 bg-red-500/5 border border-red-400/50 text-red-800 text-xs font-mono leading-relaxed text-left rtl:text-right whitespace-pre-line flex items-start gap-2 animate-[shake_0.3s_ease]\">\n                  <X className=\"w-5 h-5 shrink-0 text-red-650 cursor-pointer\" onClick={() => setStepErrors(null)} />\n                  <div>\n                    <span className=\"font-bold underline uppercase block mb-1\">Erreur de saisie / \330\256\330\267\330\243 \331\201\331\212 \330\247\331\204\330\252\330\255\331\202\331\202</span>\n                    <p>{stepErrors}</p>\n                  </div>\n                </div>\n              )}\n\n              {/* ------------------------------------------\n                  STEP 1: ACCOUNT INFO (BOTH ROLES)\n                  ------------------------------------------ */}\n              {currentStep === 1 && (\n                <div className=\"space-y-5 animate-fade-in\">\n                  <h3 className=\"text-xs font-bold uppercase font-mono tracking-widest text-[#0F6E56]\">\n                    \303\211tape 1 \342\200\224 Informations d\'authentification obligatoires\n                  </h3>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5 text-left rtl:text-right\">\n                    \n                    {/* Full Name */}\n                    <div className=\"space-y-1.5 col-span-1 sm:col-span-2\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        {regRole === \'professional\' ? \"Nom complet de l\'Expert (\330\247\331\204\331\206\330\263\330\250 \331\210\330\247\331\204\331\204\331\202\330\250)\" : \"Nom et pr\303\251nom du responsable l\303\251gal (\330\247\331\204\331\206\330\263\330\250 \331\210\330\247\331\204\331\204\331\202\330\250 \331\204\331\204\331\205\330\263\331\212\330\261)\"}\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <input \n                        type=\"text\" \n                        required\n                        placeholder={regRole === \'professional\' ? \"ex: Me. Lamine Bouhired\" : \"ex: Karim Haddad\"}\n                        value={fullName}\n                        onChange={(e) => setFullName(e.target.value)}\n                        className=\"w-full border border-[#CFCFC4] rounded-none px-3 py-2.5 text-xs text-gray-800 bg-white focus:outline-none focus:border-brand-primary font-serif font-bold\"\n                      />\n                    </div>\n\n                    {/* Email address */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        E-mail professionnel (\330\247\331\204\330\250\330\261\331\212\330\257 \330\247\331\204\330\245\331\204\331\203\330\252\330\261\331\210\331\206\331\212 \331\204\331\204\330\271\331\205\331\204)\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <div className=\"relative border border-[#CFCFC4] rounded-none bg-white px-3 py-2 flex items-center gap-2 focus-within:border-[#0F6E56]\">\n                        <Mail className=\"w-4 h-4 text-brand-primary shrink-0\" />\n                        <input \n                          type=\"email\" \n                          required\n                          placeholder=\"direction@cabinet.dz\"\n                          value={email}\n                          onChange={(e) => setEmail(e.target.value)}\n                          className=\"w-full text-xs text-gray-750 bg-transparent focus:outline-none focus:ring-0\"\n                        />\n                      </div>\n                    </div>\n\n                    {/* Phone Number with Algerian flag prefix operator selector */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        Num\303\251ro de T\303\251l\303\251phone (\330\261\331\202\331\205 \330\247\331\204\331\207\330\247\330\252\331\201 \330\247\331\204\330\254\331\210\330\247\331\204)\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <div className=\"flex border border-[#CFCFC4] rounded-none bg-white focus-within:border-brand-primary\">\n                        \n                        {/* Operator select prefix */}\n                        <div className=\"bg-[#FAF9F5]/85 border-r border-[#CFCFC4] px-2.5 flex items-center gap-1 shrink-0 select-none\">\n                          <span className=\"text-[13px]\" title=\"Alg\303\251rie\">\360\237\207\251\360\237\207\277</span>\n                          <span className=\"text-[10px] font-mono font-bold text-gray-600\">+213</span>\n                          <select\n                            value={phoneOperator}\n                            onChange={(e) => setPhoneOperator(e.target.value)}\n                            className=\"bg-transparent text-xs font-mono font-bold text-gray-700 outline-none cursor-pointer\"\n                          >\n                            <option value=\"06\">06 (Mobilis)</option>\n                            <option value=\"07\">07 (Djezzy)</option>\n                            <option value=\"05\">05 (Ooredoo)</option>\n                          </select>\n                        </div>\n\n                        <input \n                          type=\"text\" \n                          required\n                          maxLength={8}\n                          placeholder=\"54859012\"\n                          value={phoneRest}\n                          onChange={(e) => setPhoneRest(e.target.value.replace(/\\D/g, \'\'))}\n                          className=\"w-full text-xs font-mono tracking-widest text-gray-750 bg-transparent py-2 px-3 focus:outline-none\"\n                        />\n                      </div>\n                      <span className=\"text-[9px] text-gray-400 font-mono\">Format exig\303\251: +213 [Oper] [8 chiffres]</span>\n                    </div>\n\n                    {/* Password */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        Mot de passe s\303\251curis\303\251 (\331\203\331\204\331\205\330\251 \330\247\331\204\331\205\330\261\331\210\330\261)\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <div className=\"relative border border-[#CFCFC4] rounded-none bg-white px-3 py-2 flex items-center gap-2 focus-within:border-[#0F6E56]\">\n                        <Lock className=\"w-4 h-4 text-brand-primary shrink-0\" />\n                        <input \n                          type=\"password\" \n                          required\n                          placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                          value={password}\n                          onChange={(e) => setPassword(e.target.value)}\n                          className=\"w-full text-xs text-gray-750 bg-transparent focus:outline-none\"\n                        />\n                      </div>\n                    </div>\n\n                    {/* Confirm Password */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        Confirmer le mot de passe (\330\252\330\243\331\203\331\212\330\257 \331\203\331\204\331\205\330\251 \330\247\331\204\331\205\330\261\331\210\330\261)\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <div className=\"relative border border-[#CFCFC4] rounded-none bg-white px-3 py-2 flex items-center gap-2 focus-within:border-[#0F6E56]\">\n                        <Lock className=\"w-4 h-4 text-brand-primary shrink-0\" />\n                        <input \n                          type=\"password\" \n                          required\n                          placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                          value={confirmPassword}\n                          onChange={(e) => setConfirmPassword(e.target.value)}\n                          className=\"w-full text-xs text-gray-750 bg-transparent focus:outline-none\"\n                        />\n                      </div>\n                    </div>\n\n                    {/* Wilaya of Practice / Siege */}\n                    <div className=\"space-y-1.5 col-span-1 sm:col-span-2\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        {regRole === \'professional\' ? \'Wilaya d\\\'exercice principale (\331\210\331\204\330\247\331\212\330\251 \331\205\331\205\330\247\330\261\330\263\330\251 \330\247\331\204\331\205\331\207\331\206\330\251)\' : \'Wilaya du si\303\250ge social de l\\\'entreprise (\331\210\331\204\330\247\331\212\330\251 \330\247\331\204\331\205\331\202\330\261 \330\247\331\204\330\247\330\254\330\252\331\205\330\247\330\271\331\212 \331\204\331\204\331\205\330\244\330\263\330\263\330\251)\'}\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <div className=\"relative border border-[#CFCFC4] rounded-none bg-white px-3 py-2 flex items-center gap-2 focus-within:border-[#0F6E56]\">\n                        <MapPin className=\"w-4 h-4 text-brand-primary shrink-0\" />\n                        <select\n                          value={selectedWilayaId}\n                          onChange={(e) => setSelectedWilayaId(Number(e.target.value))}\n                          className=\"w-full bg-transparent text-xs text-gray-750 outline-none cursor-pointer font-serif font-black\"\n                        >\n                          {algerianWilayas.map((w) => (\n                            <option key={w.id} value={w.id}>\n                              {w.code} \342\200\224 {w.name.fr} ({w.name.ar})\n                            </option>\n                          ))}\n                        </select>\n                      </div>\n                    </div>\n\n                  </div>\n\n                </div>\n              )}\n\n              {/* ------------------------------------------\n                  STEP 2 (PROFESSIONAL ONLY): PROFESSIONAL IDENTITY\n                  ------------------------------------------ */}\n              {currentStep === 2 && regRole === \'professional\' && (\n                <div className=\"space-y-6 animate-fade-in text-left rtl:text-right\">\n                  <h3 className=\"text-xs font-bold uppercase font-mono tracking-widest text-indigo-700\">\n                    \303\211tape 2 \342\200\224 Identit\303\251 de l\'agrement & Sp\303\251cialit\303\251 l\303\251gale\n                  </h3>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\n                    \n                    {/* Specialty dropdown */}\n                    <div className=\"space-y-1.5 col-span-1 sm:col-span-2\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        Sp\303\251cialit\303\251 & Ordre National (\330\247\331\204\330\252\330\256\330\265\330\265 \330\247\331\204\331\205\331\207\331\206\331\212 \331\210\330\247\331\204\331\207\331\212\330\246\330\251 \330\247\331\204\331\202\330\247\331\206\331\210\331\206\331\212\330\251)\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <select\n                        value={specialty}\n                        onChange={(e) => setSpecialty(e.target.value)}\n                        className=\"w-full border border-[#CFCFC4] rounded-none px-3 py-2.5 bg-white text-xs font-bold text-gray-750 focus:outline-none focus:border-indigo-600 cursor-pointer font-serif\"\n                      >\n                        <option value=\"certified-accountant\">Expert-Comptables (Agr\303\251\303\251 par l\'ONEC)</option>\n                        <option value=\"statutory-auditor\">Commissaire aux Comptes (Agr\303\251\303\251 par l\'ONCC)</option>\n                        <option value=\"chartered-accountant\">Comptable Agr\303\251\303\251 (Inscrit au Tableau de l\'ONCA)</option>\n                        <option value=\"judicial-expert\">Expert Judiciaire Comptable (Pr\303\250s les Cours de Justice)</option>\n                        <option value=\"tax-consultant\">Conseiller Fiscal Ind\303\251pendant (DGI Affili\303\251)</option>\n                        <option value=\"actuaire\">Actuaire Certifi\303\251 (Membre de l\'AAA)</option>\n                      </select>\n                    </div>\n\n                    {/* Registration number Tableau National */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        Num\303\251ro d\'inscription au Tableau (\330\261\331\202\331\205 \330\247\331\204\331\202\331\212\330\257 \330\250\330\247\331\204\330\254\330\257\331\210\331\204 \330\247\331\204\331\210\330\267\331\206\331\212)\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <input \n                        type=\"text\" \n                        required\n                        placeholder={\n                          specialty.includes(\'statutory\') \n                            ? \"ex: CC-09-0118 (ONCC)\" \n                            : \"ex: EC-16-0042 (ONEC)\"\n                        }\n                        value={tableauNumber}\n                        onChange={(e) => setTableauNumber(e.target.value)}\n                        className=\"w-full border border-[#CFCFC4] rounded-none px-3 py-2 text-xs font-mono text-gray-800 bg-white focus:outline-none focus:border-indigo-600 uppercase\"\n                      />\n                      <span className=\"text-[9px] text-[#F59E0B] font-mono block\">Format officiel exig\303\251 par l\'Ordonnance minist\303\251rielle.</span>\n                    </div>\n\n                    {/* Agr\303\251ment minist\303\251riel number */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        Num\303\251ro d\'agr\303\251ment minist\303\251riel (\330\261\331\202\331\205 \330\247\331\204\330\245\330\271\330\252\331\205\330\247\330\257 \330\247\331\204\331\210\330\262\330\247\330\261\331\212 \342\200\224 \330\245\331\206 \331\210\330\254\330\257)\n                      </label>\n                      <input \n                        type=\"text\" \n                        placeholder=\"ex: MIN-FIN/2014/1982\"\n                        value={agreeCabinetNumber}\n                        onChange={(e) => setAgreeCabinetNumber(e.target.value)}\n                        className=\"w-full border border-[#CFCFC4] rounded-none px-3 py-2 text-xs font-mono text-gray-800 bg-white focus:outline-none focus:border-indigo-600 uppercase\"\n                      />\n                    </div>\n\n                    {/* Experience slider slider: 1\342\200\22340 years */}\n                    <div className=\"space-y-2 col-span-1 sm:col-span-2 p-4 bg-white border border-[#CFCFC4]\">\n                      <div className=\"flex justify-between items-center\">\n                        <label className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                          Ann\303\251es d\'Exp\303\251rience effective (\330\263\331\206\331\210\330\247\330\252 \330\247\331\204\330\256\330\250\330\261\330\251 \330\247\331\204\331\205\331\207\331\206\331\212\330\251)\n                        </label>\n                        <span className=\"px-2.5 py-0.5 bg-indigo-50 border border-indigo-200 text-indigo-800 font-mono font-bold text-xs\">\n                          {yearsExperience} Ans / \330\263\331\206\331\210\330\247\330\252\n                        </span>\n                      </div>\n                      <input \n                        type=\"range\" \n                        min={1} \n                        max={40} \n                        value={yearsExperience}\n                        onChange={(e) => setYearsExperience(Number(e.target.value))}\n                        className=\"w-full accent-indigo-700 cursor-pointer h-1 bg-[#EBEBE5]\"\n                      />\n                      <div className=\"flex justify-between text-[9px] text-gray-400 font-mono\">\n                        <span>1 An (Comptable junior)</span>\n                        <span>40 Ans (S\303\251niorit\303\251 supr\303\252me)</span>\n                      </div>\n                    </div>\n\n                    {/* Langues de travail Checklist */}\n                    <div className=\"space-y-2 col-span-1 sm:col-span-2\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest mb-1\">\n                        Langues de travail (\331\204\330\272\330\247\330\252 \330\252\330\263\331\212\331\212\330\261 \330\247\331\204\331\205\330\271\330\247\331\205\331\204\330\247\330\252 \331\210\330\245\330\265\330\257\330\247\330\261 \330\247\331\204\330\252\331\202\330\247\330\261\331\212\330\261 SCF)\n                      </label>\n                      \n                      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n                        \n                        <label className=\"p-3 bg-white border border-[#CFCFC4] flex items-center gap-2.5 cursor-pointer hover:bg-gray-50\">\n                          <input \n                            type=\"checkbox\" \n                            checked={languagesOfWork.ar}\n                            onChange={(e) => setLanguagesOfWork(prev => ({ ...prev, ar: e.target.checked }))}\n                            className=\"accent-indigo-700 cursor-pointer\"\n                          />\n                          <span className=\"text-xs font-serif font-black text-gray-900\">Arabe (\330\247\331\204\330\271\330\261\330\250\331\212\330\251)</span>\n                        </label>\n\n                        <label className=\"p-3 bg-white border border-[#CFCFC4] flex items-center gap-2.5 cursor-pointer hover:bg-gray-50\">\n                          <input \n                            type=\"checkbox\" \n                            checked={languagesOfWork.fr}\n                            onChange={(e) => setLanguagesOfWork(prev => ({ ...prev, fr: e.target.checked }))}\n                            className=\"accent-indigo-700 cursor-pointer\"\n                          />\n                          <span className=\"text-xs font-serif font-black text-gray-905\">Fran\303\247ais</span>\n                        </label>\n\n                        <label className=\"p-3 bg-white border border-[#CFCFC4] flex items-center gap-2.5 cursor-pointer hover:bg-gray-50\">\n                          <input \n                            type=\"checkbox\" \n                            checked={languagesOfWork.en}\n                            onChange={(e) => setLanguagesOfWork(prev => ({ ...prev, en: e.target.checked }))}\n                            className=\"accent-indigo-700 cursor-pointer\"\n                          />\n                          <span className=\"text-xs font-sans font-bold text-gray-905\">English</span>\n                        </label>\n\n                        <label className=\"p-3 bg-white border border-[#CFCFC4] flex items-center gap-2.5 cursor-pointer hover:bg-gray-50\">\n                          <input \n                            type=\"checkbox\" \n                            checked={languagesOfWork.tamazight}\n                            onChange={(e) => setLanguagesOfWork(prev => ({ ...prev, tamazight: e.target.checked }))}\n                            className=\"accent-indigo-700 cursor-pointer\"\n                          />\n                          <span className=\"text-xs font-serif font-black text-gray-905\">Tamazight</span>\n                        </label>\n\n                      </div>\n                    </div>\n\n                  </div>\n                </div>\n              )}\n\n              {/* ------------------------------------------\n                  STEP 2 (CLIENT ONLY): BUSINESS IDENTITY\n                  ------------------------------------------ */}\n              {currentStep === 2 && regRole === \'client\' && (\n                <div className=\"space-y-6 animate-fade-in text-left rtl:text-right\">\n                  <h3 className=\"text-xs font-bold uppercase font-mono tracking-widest text-[#0F6E56]\">\n                    \303\211tape 2 \342\200\224 Identit\303\251 de la Sarl / Eurl / Institution et R\303\251f\303\251rences L\303\251gales\n                  </h3>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\n                    \n                    {/* Entity type dropdowns */}\n                    <div className=\"space-y-1.5 col-span-1 sm:col-span-2\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        Forme juridique de l\'entit\303\251 (\330\247\331\204\330\264\331\203\331\204 \330\247\331\204\331\202\330\247\331\206\331\210\331\206\331\212 \331\204\331\204\331\205\330\244\330\263\330\263\330\251)\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <select\n                        value={entityType}\n                        onChange={(e) => setEntityType(e.target.value)}\n                        className=\"w-full border border-[#CFCFC4] rounded-none px-3 py-2.5 bg-white text-xs font-bold font-serif text-gray-800 focus:outline-none focus:border-brand-primary cursor-pointer\"\n                      >\n                        <option value=\"SARL\">SARL (Soci\303\251t\303\251 \303\240 Responsabilit\303\251 Limit\303\251e)</option>\n                        <option value=\"EURL\">EURL (Entreprise Unipersonnelle \303\240 Responsabilit\303\251 Limit\303\251e)</option>\n                        <option value=\"SPA\">SPA (Soci\303\251t\303\251 par Actions)</option>\n                        <option value=\"SNC\">SNC (Soci\303\251t\303\251 en Nom Collectif)</option>\n                        <option value=\"Auto-entrepreneur\">Auto-entrepreneur (R\303\251gime fiscal simplifi\303\251)</option>\n                        <option value=\"Association\">Association \303\240 but non lucratif (Loi 12-06)</option>\n                        <option value=\"Startup labellis\303\251e\">Startup labellis\303\251e (DZ Startup label MESRS)</option>\n                        <option value=\"EPA / EPIC\">\303\211tablissement Public (EPA / EPIC)</option>\n                      </select>\n                    </div>\n\n                    {/* D\303\251nomination sociale in Arabic + French */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        D\303\251nomination Sociale en lettres Latines (\330\247\330\263\331\205 \330\247\331\204\330\264\330\261\331\203\330\251 \330\250\330\247\331\204\331\201\330\261\331\206\330\263\331\212\330\251)\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <input \n                        type=\"text\" \n                        required\n                        placeholder=\"ex: SARL Mitidja Agro Industrie\"\n                        value={companyNameFR}\n                        onChange={(e) => setCompanyNameFR(e.target.value)}\n                        className=\"w-full border border-[#CFCFC4] rounded-none px-3 py-2 text-xs text-gray-800 bg-white focus:outline-none focus:border-brand-primary font-serif font-black\"\n                      />\n                    </div>\n\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        \330\247\330\263\331\205 \330\247\331\204\330\264\330\261\331\203\330\251 \330\250\330\247\331\204\331\204\330\272\330\251 \330\247\331\204\330\271\330\261\330\250\331\212\330\251 (\330\247\331\204\330\271\331\206\331\210\330\247\331\206 \330\247\331\204\330\247\330\254\330\252\331\205\330\247\330\271\331\212)\n                      </label>\n                      <input \n                        type=\"text\" \n                        placeholder=\"\331\205\330\253\330\247\331\204: \330\264.\330\260.\331\205.\331\205 \331\205\330\252\331\212\330\254\330\251 \331\204\331\204\330\265\331\206\330\247\330\271\330\247\330\252 \330\247\331\204\330\262\330\261\330\247\330\271\331\212\330\251\"\n                        value={companyNameAR}\n                        onChange={(e) => setCompanyNameAR(e.target.value)}\n                        className=\"w-full border border-[#CFCFC4] rounded-none px-3 py-2 text-xs text-gray-800 bg-white focus:outline-none focus:border-brand-primary font-serif font-black text-right\"\n                        dir=\"rtl\"\n                      />\n                    </div>\n\n                    {/* Registre de commerce number XX/XXXXXX/XX */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        Num\303\251ro de Registre du Commerce RC (\330\261\331\202\331\205 \330\247\331\204\330\263\330\254\331\204 \330\247\331\204\330\252\330\254\330\247\330\261\331\212)\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <input \n                        type=\"text\" \n                        required\n                        placeholder=\"ex: 16/00-0142578-B26\"\n                        value={rcNumber}\n                        onChange={(e) => setRcNumber(e.target.value)}\n                        className=\"w-full border border-[#CFCFC4] rounded-none px-3 py-2 text-xs font-mono text-gray-800 bg-white focus:outline-none focus:border-brand-primary\"\n                      />\n                      <span className=\"text-[9px] text-gray-400 font-mono\">Format requis par le CNRC : Wilaya/Code-Num\303\251ro-Ann\303\251e</span>\n                    </div>\n\n                    {/* NIF: 15 digits */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        Num\303\251ro d\'Identification Fiscale NIF (\330\261\331\202\331\205 \330\247\331\204\330\252\330\271\330\261\331\212\331\201 \330\247\331\204\330\254\330\250\330\247\330\246\331\212)\n                        <span className=\"text-red-500\"> *</span>\n                      </label>\n                      <input \n                        type=\"text\" \n                        required\n                        maxLength={15}\n                        placeholder=\"ex: 001612054789412\"\n                        value={nifNumber}\n                        onChange={(e) => setNifNumber(e.target.value.replace(/\\D/g, \'\'))}\n                        className=\"w-full border border-[#CFCFC4] rounded-none px-3 py-2 text-xs font-mono tracking-widest text-gray-800 bg-white focus:outline-none focus:border-brand-primary\"\n                      />\n                      <span className=\"text-[9px] text-[#0F6E56] font-mono block\">Doit faire exactement 15 chiffres r\303\250glementaires (DGI).</span>\n                    </div>\n\n                    {/* AI Optional */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        Num\303\251ro d\'Article d\'Imposition AI (\330\261\331\202\331\205 \330\247\331\204\331\205\330\247\330\257\330\251 \330\247\331\204\330\266\330\261\331\212\330\250\331\212\330\251 \342\200\224 \330\247\330\256\330\252\331\212\330\247\330\261\331\212)\n                      </label>\n                      <input \n                        type=\"text\" \n                        placeholder=\"ex: 16032481056\"\n                        value={aiNumber}\n                        onChange={(e) => setAiNumber(e.target.value)}\n                        className=\"w-full border border-[#CFCFC4] rounded-none px-3 py-2 text-xs font-mono text-gray-800 bg-white focus:outline-none focus:border-brand-primary\"\n                      />\n                    </div>\n\n                    {/* Activity Sectors */}\n                    <div className=\"space-y-1.5\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                        Secteur d\'Activit\303\251 principale (\331\202\330\267\330\247\330\271 \330\247\331\204\331\206\330\264\330\247\330\267 \330\247\331\204\330\261\330\246\331\212\330\263\331\212)\n                      </label>\n                      <select\n                        value={secteurActivite}\n                        onChange={(e) => setSecteurActivite(e.target.value)}\n                        className=\"w-full border border-[#CFCFC4] rounded-none p-2 bg-white text-xs text-gray-750 focus:outline-none focus:border-[#0F6E56] cursor-pointer font-serif font-black\"\n                      >\n                        <option value=\"Commerce de d\303\251tail\">Commerce de d\303\251tail (\330\252\330\254\330\247\330\261\330\251 \330\247\331\204\330\252\330\254\330\262\330\246\330\251)</option>\n                        <option value=\"Commerce de gros\">Commerce de gros (\330\252\330\254\330\247\330\261\330\251 \330\247\331\204\330\254\331\205\331\204\330\251)</option>\n                        <option value=\"BTP / Construction\">BTP & Construction (\330\247\331\204\330\250\331\206\330\247\330\241 \331\210\330\247\331\204\330\243\330\264\330\272\330\247\331\204 \330\247\331\204\330\271\330\247\331\205\330\251)</option>\n                        <option value=\"Agriculture & Elevage\">Agriculture & \303\211levage (\330\247\331\204\331\201\331\204\330\247\330\255\330\251 \331\210\330\247\331\204\330\265\331\206\330\247\330\271\330\247\330\252 \330\247\331\204\330\272\330\260\330\247\330\246\331\212\330\251)</option>\n                        <option value=\"Industrie / Manufacturing\">Industrie transformatrice (\330\265\331\206\330\247\330\271\330\251 \330\252\330\255\331\210\331\212\331\204\331\212\330\251)</option>\n                        <option value=\"Tech & Num\303\251rique\">Tech & Num\303\251rique (\330\250\330\261\331\205\330\254\331\212\330\247\330\252 \331\210\330\247\330\250\330\252\331\203\330\247\330\261 \330\263\330\255\330\247\330\250\331\212)</option>\n                        <option value=\"Services administratifs\">Services professionnels (\330\256\330\257\331\205\330\247\330\252 \330\252\330\254\330\247\330\261\331\212\330\251 \331\210\330\247\330\263\330\252\330\264\330\247\330\261\331\212\330\251)</option>\n                        <option value=\"Import-Export\">Import-Export (\330\247\330\263\330\252\331\212\330\261\330\247\330\257 \331\210\330\252\330\265\330\257\331\212\330\261)</option>\n                        <option value=\"Tourisme & H\303\264tellerie\">Tourisme & H\303\264tellerie (\330\263\331\212\330\247\330\255\330\251 \331\210\331\201\331\206\330\247\330\257\331\202)</option>\n                      </select>\n                    </div>\n\n                    {/* R\303\251gime Fiscal selection */}\n                    <div className=\"space-y-1.5 col-span-1 sm:col-span-2\">\n                      <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest mb-1\">\n                        R\303\251gime Fiscal applicable (\330\247\331\204\331\206\330\270\330\247\331\205 \330\247\331\204\330\254\330\250\330\247\330\246\331\212 \330\247\331\204\331\205\330\252\330\250\330\271)\n                      </label>\n                      \n                      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                        \n                        <label className=\"p-3 bg-white border border-[#CFCFC4] flex items-start gap-2.5 cursor-pointer hover:bg-gray-50\">\n                          <input \n                            type=\"radio\" \n                            name=\"regime_fisc\"\n                            checked={regimeFiscal === \'R\303\251gime r\303\251el (IBS)\'}\n                            onChange={() => setRegimeFiscal(\'R\303\251gime r\303\251el (IBS)\')}\n                            className=\"accent-brand-primary cursor-pointer mt-0.5\"\n                          />\n                          <div className=\"space-y-1 text-left rtl:text-right\">\n                            <span className=\"text-xs font-serif font-black text-gray-900 block leading-tight\">R\303\251gime R\303\251el (IBS)</span>\n                            <span className=\"text-[9px] text-gray-400 font-mono block\">Bilan complet obligatoire, d\303\251claration G50</span>\n                          </div>\n                        </label>\n\n                        <label className=\"p-3 bg-white border border-[#CFCFC4] flex items-start gap-2.5 cursor-pointer hover:bg-gray-50\">\n                          <input \n                            type=\"radio\" \n                            name=\"regime_fisc\"\n                            checked={regimeFiscal === \'R\303\251gime simplifi\303\251 (IRG)\'}\n                            onChange={() => setRegimeFiscal(\'R\303\251gime simplified (IRG)\')}\n                            className=\"accent-brand-primary cursor-pointer mt-0.5\"\n                          />\n                          <div className=\"space-y-1 text-left rtl:text-right\">\n                            <span className=\"text-xs font-serif font-black text-gray-900 block leading-tight\">R\303\251gime Simplifi\303\251</span>\n                            <span className=\"text-[9px] text-gray-400 font-mono block\">Souscription comptabilit\303\251 simplification</span>\n                          </div>\n                        </label>\n\n                        <label className=\"p-3 bg-white border border-[#CFCFC4] flex items-start gap-2.5 cursor-pointer hover:bg-gray-50\">\n                          <input \n                            type=\"radio\" \n                            name=\"regime_fisc\"\n                            checked={regimeFiscal === \'R\303\251gime IFU (Imp\303\264t Forfait Unique)\'}\n                            onChange={() => setRegimeFiscal(\'R\303\251gime IFU (Imp\303\264t Forfait Unique)\')}\n                            className=\"accent-brand-primary cursor-pointer mt-0.5\"\n                          />\n                          <div className=\"space-y-1 text-left rtl:text-right\">\n                            <span className=\"text-xs font-serif font-black text-gray-900 block leading-tight\">Auto-entrepreneur (IFU)</span>\n                            <span className=\"text-[9px] text-gray-400 font-mono block\">CA inf\303\251rieur \303\240 30M DA, imp\303\264t unique de 5%</span>\n                          </div>\n                        </label>\n\n                      </div>\n\n                    </div>\n\n                  </div>\n                </div>\n              )}\n\n              {/* ------------------------------------------\n                  STEP 3 (PROFESSIONAL ONLY): DOCUMENT UPLOAD\n                  ------------------------------------------ */}\n              {currentStep === 3 && regRole === \'professional\' && (\n                <div className=\"space-y-6 animate-fade-in text-left rtl:text-right\" id=\"pro_doc_upload_step\">\n                  <div>\n                    <h3 className=\"text-xs font-bold uppercase font-mono tracking-widest text-[#0F6E56]\">\n                      \303\211tape 3 \342\200\224 Dossier d\'agr\303\251ment num\303\251ris\303\251 obligatoire\n                    </h3>\n                    <p className=\"text-[11px] text-[#F59E0B] font-mono mt-1 pr-1 border-l-2 border-[#F59E0B]\">\n                      \342\232\240\357\270\217 \331\203\331\204 \330\247\331\204\331\210\330\253\330\247\330\246\331\202 \331\205\330\267\331\204\331\210\330\250\330\251 \342\200\224 \330\247\331\204\330\252\330\255\331\202\331\202 \330\245\331\204\330\262\330\247\331\205\331\212 \331\202\330\250\331\204 \330\252\331\201\330\271\331\212\331\204 \330\247\331\204\330\255\330\263\330\247\330\250 \331\205\331\206 \331\205\330\265\330\247\331\204\330\255 \330\243\331\203\331\210\331\206\331\212\330\252 \330\247\331\204\330\261\331\202\330\247\330\250\331\212\330\251 \331\204\331\204\330\255\330\257 \331\205\331\206 \330\247\331\204\330\252\330\262\331\210\331\212\330\261.\n                    </p>\n                  </div>\n\n                  {/* Wizard 4-grid documents block interface */}\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6 p-5 border border-[#CFCFC4] bg-[#FAF9F5]/30\">\n                    \n                    <DocumentUpload \n                      label=\"Carte Professionnelle ONEC / ONCC / ONCA\"\n                      labelAR=\"\330\247\331\204\330\250\330\267\330\247\331\202\330\251 \330\247\331\204\331\205\331\207\331\206\331\212\330\251 \331\204\331\204\331\207\331\212\330\246\330\251 \330\247\331\204\331\210\330\267\331\206\331\212\330\251\"\n                      description=\"Certificat d\'agr\303\251ment actif d\303\251livr\303\251 par l\'ordre (ex: cartonn\303\251e ou plastique)\"\n                      required={true}\n                      acceptedTypes={[\'pdf\', \'jpg\', \'png\']}\n                      maxSizeMB={5}\n                      legalTooltip=\"Art 12 de la loi 10-01 r\303\251gissant l\'exercice comptable\"\n                      onUpload={(file, base64) => setProDocs(prev => ({ ...prev, cartePro: { name: file.name, size: `${(file.size/1024).toFixed(1)} KB`, data: base64 } }))}\n                      onRemove={() => setProDocs(prev => ({ ...prev, cartePro: null }))}\n                    />\n\n                    <DocumentUpload \n                      label=\"Pi\303\250ce d\'Identit\303\251 Nationale\"\n                      labelAR=\"\330\247\331\204\331\207\331\210\331\212\330\251 \330\247\331\204\331\210\330\267\331\206\331\212\330\251 (\330\250\330\267\330\247\331\202\330\251 \330\250\331\212\331\210\331\205\330\252\330\261\331\212\330\251 \330\243\331\210 \330\254\331\210\330\247\330\262 \330\263\331\201\330\261)\"\n                      description=\"Carte d\'identit\303\251 CIN recto-verso ou premi\303\250re page du passeport\"\n                      required={true}\n                      acceptedTypes={[\'pdf\', \'jpg\', \'png\']}\n                      maxSizeMB={5}\n                      onUpload={(file, base64) => setProDocs(prev => ({ ...prev, identity: { name: file.name, size: `${(file.size/1024).toFixed(1)} KB`, data: base64 } }))}\n                      onRemove={() => setProDocs(prev => ({ ...prev, identity: null }))}\n                    />\n\n                    <DocumentUpload \n                      label=\"Attestation d\'Inscription au Tableau National\"\n                      labelAR=\"\330\264\331\207\330\247\330\257\330\251 \330\247\331\204\331\202\331\212\330\257 \330\250\330\254\330\257\331\210\331\204 \330\247\331\204\331\205\331\206\330\270\331\205\330\251 \330\247\331\204\331\210\330\267\331\206\331\212\330\251 \331\204\331\204\331\205\330\255\330\247\330\263\330\250\331\212\331\206\"\n                      description=\"Fiche d\'exercice de l\'exercice en cours\"\n                      required={true}\n                      acceptedTypes={[\'pdf\']}\n                      maxSizeMB={5}\n                      legalTooltip=\"N\303\251cessaire pour synchroniser votre liasse fiscale avec la Direction Sp\303\251ciale des Imp\303\264ts (DGI).\"\n                      onUpload={(file, base64) => setProDocs(prev => ({ ...prev, attestationInsc: { name: file.name, size: `${(file.size/1024).toFixed(1)} KB`, data: base64 } }))}\n                      onRemove={() => setProDocs(prev => ({ ...prev, attestationInsc: null }))}\n                    />\n\n                    <DocumentUpload \n                      label=\"D\303\251cision d\'Agr\303\251ment Minist\303\251riel (Optionnel)\"\n                      labelAR=\"\331\202\330\261\330\247\330\261 \330\247\331\204\330\247\330\271\330\252\331\205\330\247\330\257 \330\247\331\204\330\265\330\247\330\257\330\261 \331\205\331\206 \331\210\330\262\330\247\330\261\330\251 \330\247\331\204\331\205\330\247\331\204\331\212\330\251\"\n                      description=\"D\303\251cision minist\303\251rielle d\'autorisation d\'ouverture\"\n                      required={false}\n                      acceptedTypes={[\'pdf\']}\n                      maxSizeMB={5}\n                      onUpload={(file, base64) => setProDocs(prev => ({ ...prev, decisionAgree: { name: file.name, size: `${(file.size/1024).toFixed(1)} KB`, data: base64 } }))}\n                      onRemove={() => setProDocs(prev => ({ ...prev, decisionAgree: null }))}\n                    />\n\n                  </div>\n\n                  {/* 3/4 documents charg\303\251s progress tracker status indicator bar */}\n                  <div className=\"bg-white border p-4 flex items-center justify-between gap-4 font-mono select-none\">\n                    <span className=\"text-[10px] text-gray-400 uppercase tracking-wider font-bold\">Rapport du dossier d\'agr\303\251ment</span>\n                    \n                    {(() => {\n                      const uploadedCount = [proDocs.cartePro, proDocs.identity, proDocs.attestationInsc, proDocs.decisionAgree].filter(Boolean).length;\n                      return (\n                        <div className=\"flex items-center gap-3 shrink-0\">\n                          <span className=\"text-xs font-bold text-indigo-700\">{uploadedCount} / 4 Charg\303\251s</span>\n                          <div className=\"w-24 bg-gray-100 h-2\">\n                            <div className=\"bg-indigo-700 h-full transition-all duration-200\" style={{ width: `${(uploadedCount/4)*100}%` }}></div>\n                          </div>\n                        </div>\n                      );\n                    })()}\n                  </div>\n\n                </div>\n              )}\n\n              {/* ------------------------------------------\n                  STEP 3 (CLIENT ONLY): CLIENT DOCUMENT UPLOAD\n                  ------------------------------------------ */}\n              {currentStep === 3 && regRole === \'client\' && (\n                <div className=\"space-y-6 animate-fade-in text-left rtl:text-right\" id=\"client_doc_upload_step\">\n                  <div>\n                    <h3 className=\"text-xs font-bold uppercase font-mono tracking-widest text-[#0F6E56]\">\n                      \303\211tape 3 \342\200\224 Dossier L\303\251gal de Constitution de l\'Entreprise\n                    </h3>\n                    <p className=\"text-[11px] text-[#0F6E56] font-mono mt-1 pr-1 border-l-2 border-[#0F6E56]\">\n                      \342\234\223 Pi\303\250ces justificatives requises sous format \303\251lectronique pour s\303\251curiser les futurs contrats B2B ou liasse fiscale de cl\303\264ture.\n                    </p>\n                  </div>\n\n                  {/* Custom list of uploaders tailored to Algerian context */}\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6 p-5 border border-[#CFCFC4] bg-[#FAF9F5]/30\">\n                    \n                    <DocumentUpload \n                      label=\"Extrait du Registre de Commerce (RC)\"\n                      labelAR=\"\331\205\330\263\330\252\330\256\330\261\330\254 \330\247\331\204\330\263\330\254\331\204 \330\247\331\204\330\252\330\254\330\247\330\261\331\212 \331\203\331\210\330\257 \330\263\330\261\331\212\"\n                      description=\"Copie certifi\303\251e conforme du RC d\303\251livr\303\251 par le CNRC datant de moins de 3 mois\"\n                      required={true}\n                      acceptedTypes={[\'pdf\', \'jpg\', \'png\']}\n                      maxSizeMB={5}\n                      legalTooltip=\"Le Registre du Commerce est la pi\303\250ce ma\303\256tresse l\303\251gale d\'existence des soci\303\251t\303\251s marchandes en Alg\303\251rie.\"\n                      onUpload={(file, base64) => setClientDocs(prev => ({ ...prev, extraitRC: { name: file.name, size: `${(file.size/1024).toFixed(1)} KB`, data: base64 } }))}\n                      onRemove={() => setClientDocs(prev => ({ ...prev, extraitRC: null }))}\n                    />\n\n                    <DocumentUpload \n                      label=\"Carte d\'Immatriculation Fiscale (NIF)\"\n                      labelAR=\"\330\250\330\267\330\247\331\202\330\251 \330\247\331\204\330\252\330\271\330\261\331\212\331\201 \330\247\331\204\330\254\330\250\330\247\330\246\331\212 \330\247\331\204\331\205\331\205\331\206\331\210\330\255\330\251 \331\205\331\206 \330\247\331\204\330\266\330\261\330\247\330\246\330\250\"\n                      description=\"Num\303\251ro d\'Identification Fiscale d\303\251livr\303\251 par le CDI/CPI local\"\n                      required={true}\n                      acceptedTypes={[\'pdf\', \'jpg\', \'png\']}\n                      maxSizeMB={5}\n                      onUpload={(file, base64) => setClientDocs(prev => ({ ...prev, carteNIF: { name: file.name, size: `${(file.size/1024).toFixed(1)} KB`, data: base64 } }))}\n                      onRemove={() => setClientDocs(prev => ({ ...prev, carteNIF: null }))}\n                    />\n\n                    <DocumentUpload \n                      label=\"Extrait de R\303\264le Apur\303\251 (Recommand\303\251)\"\n                      labelAR=\"\330\254\330\257\331\210\331\204 \330\247\331\204\330\266\330\261\330\247\330\246\330\250 \330\247\331\204\331\205\330\265\331\201\331\211 (\330\263\330\247\330\261\331\212 \330\247\331\204\331\205\331\201\330\271\331\210\331\204)\"\n                      description=\"Attestation d\'absence de dette fiscale exigible pour march\303\251s\"\n                      required={false}\n                      acceptedTypes={[\'pdf\']}\n                      maxSizeMB={5}\n                      legalTooltip=\"Obligatoire pour la souscription aux march\303\251s ou la lev\303\251e de devises selon le d\303\251cret de r\303\251gulation des transactions financi\303\250res.\"\n                      onUpload={(file, base64) => setClientDocs(prev => ({ ...prev, roleApure: { name: file.name, size: `${(file.size/1024).toFixed(1)} KB`, data: base64 } }))}\n                      onRemove={() => setClientDocs(prev => ({ ...prev, roleApure: null }))}\n                    />\n\n                    <DocumentUpload \n                      label=\"Pi\303\250ce d\'identit\303\251 du g\303\251rant\"\n                      labelAR=\"\331\207\331\210\331\212\330\251 \331\205\331\205\330\253\331\204 \330\247\331\204\330\264\330\261\331\203\330\251 \330\247\331\204\331\202\330\247\331\206\331\210\331\206\331\212\"\n                      description=\"Carte Nationale CIN biom\303\251trique ou passeport en cours\"\n                      required={true}\n                      acceptedTypes={[\'pdf\', \'jpg\', \'png\']}\n                      maxSizeMB={5}\n                      onUpload={(file, base64) => setClientDocs(prev => ({ ...prev, gerantId: { name: file.name, size: `${(file.size/1024).toFixed(1)} KB`, data: base64 } }))}\n                      onRemove={() => setClientDocs(prev => ({ ...prev, gerantId: null }))}\n                    />\n\n                    {/* Conditional Upload zone: Association - Recepisse */}\n                    {entityType === \'Association\' && (\n                      <div className=\"col-span-1 sm:col-span-2\">\n                        <DocumentUpload \n                          label=\"R\303\251c\303\251piss\303\251 d\'agr\303\251ment de l\'association (Loi 12-06)\"\n                          labelAR=\"\331\210\330\265\331\204 \330\247\330\271\330\252\331\205\330\247\330\257 \330\247\331\204\330\254\331\205\330\271\331\212\330\251 \330\247\331\204\331\205\330\271\330\252\331\205\330\257\"\n                          description=\"Agr\303\251ment de l\'association d\303\251livr\303\251 par les services administratifs de la wilaya\"\n                          required={true}\n                          acceptedTypes={[\'pdf\']}\n                          maxSizeMB={5}\n                          onUpload={(file, base64) => setClientDocs(prev => ({ ...prev, recepisseAssociation: { name: file.name, size: `${(file.size/1024).toFixed(1)} KB`, data: base64 } }))}\n                          onRemove={() => setClientDocs(prev => ({ ...prev, recepisseAssociation: null }))}\n                        />\n                      </div>\n                    )}\n\n                    {/* Conditional Upload zone: Startup - Certificat Label */}\n                    {entityType === \'Startup labellis\303\251e\' && (\n                      <div className=\"col-span-1 sm:col-span-2\">\n                        <DocumentUpload \n                          label=\"Certificat officiel du Label Startup DZ\"\n                          labelAR=\"\330\264\331\207\330\247\330\257\330\251 \330\247\331\204\330\255\330\265\331\210\331\204 \330\271\331\204\331\211 \330\271\331\204\330\247\331\205\330\251 \331\205\330\244\330\263\330\263\330\251 \331\206\330\247\330\264\330\246\330\251\"\n                          description=\"D\303\251livr\303\251 par le Minist\303\250re d\303\251l\303\251gu\303\251 charg\303\251 de l\'\303\211conomie de la Connaissance et des Startups\"\n                          required={true}\n                          acceptedTypes={[\'pdf\', \'jpg\', \'png\']}\n                          maxSizeMB={5}\n                          onUpload={(file, base64) => setClientDocs(prev => ({ ...prev, certificatStartup: { name: file.name, size: `${(file.size/1024).toFixed(1)} KB`, data: base64 } }))}\n                          onRemove={() => setClientDocs(prev => ({ ...prev, certificatStartup: null }))}\n                        />\n                      </div>\n                    )}\n\n                  </div>\n\n                  {/* Summary Checklist before submission */}\n                  <div className=\"bg-white border p-5 space-y-4 shadow-3xs text-left rtl:text-right\">\n                    <span className=\"text-[10px] font-mono font-bold text-[#0F6E56] uppercase tracking-wider block\">Engagement de probit\303\251 l\303\251gale</span>\n                    \n                    <label className=\"flex gap-2.5 cursor-pointer text-xs leading-relaxed select-none text-gray-700 font-sans\">\n                      <input \n                        type=\"checkbox\" \n                        checked={attestHonourClient}\n                        onChange={(e) => setAttestHonourClient(e.target.checked)}\n                        className=\"accent-brand-primary cursor-pointer mt-0.5 shrink-0\"\n                        id=\"client_attest_honour_check\"\n                      />\n                      <span>\n                        {language === \'ar\'\n                          ? \'\330\243\330\264\331\207\330\257 \330\271\331\204\331\211 \330\247\331\204\330\264\330\261\331\201 \330\250\330\265\330\255\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \331\210\330\247\331\204\331\210\330\253\330\247\330\246\331\202 \330\247\331\204\331\205\331\202\330\257\331\205\330\251\330\214 \331\210\330\250\330\243\331\206\331\207\330\247 \330\243\330\265\331\204\331\212\330\251 \331\210\331\205\330\267\330\247\330\250\331\202\330\251 \331\204\331\210\330\247\331\202\330\271 \330\247\331\204\331\205\330\255\331\204 \331\210\330\247\331\204\330\264\330\261\331\203\330\251 \331\210\331\201\331\202 \330\247\331\204\331\202\330\247\331\206\331\210\331\206 \330\247\331\204\330\254\331\206\330\247\330\246\331\212 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212 \330\247\331\204\331\205\330\252\330\271\331\204\331\202 \330\250\330\247\331\204\330\252\330\262\331\210\331\212\330\261 \331\210\330\247\330\263\330\252\330\256\330\257\330\247\331\205 \330\247\331\204\331\205\330\262\331\210\330\261.\'\n                          : \'J\\\'atteste sur l\\\'honneur que les informations fournies sont exactes et que les documents t\303\251l\303\251vers\303\251s sont authentiques, conform\303\251ment \303\240 l\\\'article 222 du Code P\303\251nal alg\303\251rien relatif au faux et usage de faux.\'}\n                      </span>\n                    </label>\n                  </div>\n\n                </div>\n              )}\n\n              {/* ------------------------------------------\n                  STEP 4 (PROFESSIONAL ONLY): REVIEW & SUBMIT\n                  ------------------------------------------ */}\n              {currentStep === 4 && regRole === \'professional\' && (\n                <div className=\"space-y-6 animate-fade-in text-left rtl:text-right\" id=\"pro_review_step\">\n                  <h3 className=\"text-xs font-bold uppercase font-mono tracking-widest text-[#0F6E56]\">\n                    \303\211tape 4 \342\200\224 R\303\251capitulatif et validation du dossier\n                  </h3>\n\n                  {/* Summary card with core state representations */}\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                    \n                    <div className=\"bg-white border border-[#CFCFC4] p-5 space-y-3.5 shadow-3xs\">\n                      <span className=\"text-[10px] font-mono text-gray-400 uppercase tracking-wider block\">IDENIT\303\211 & COMPTE</span>\n                      <div className=\"space-y-2 text-xs\">\n                        <p><strong className=\"text-gray-400\">Nom complet/\330\247\331\204\331\205\331\203\330\252\330\250 :</strong> {fullName}</p>\n                        <p><strong className=\"text-gray-400\">E-mail :</strong> {email}</p>\n                        <p><strong className=\"text-gray-400\">T\303\251l\303\251phone d\'exercice :</strong> +213 {phoneOperator}{phoneRest}</p>\n                        <p><strong className=\"text-gray-400\">Wilaya principale :</strong> {algerianWilayas.find(w => w.id === selectedWilayaId)?.name.fr}</p>\n                      </div>\n                    </div>\n\n                    <div className=\"bg-white border border-[#CFCFC4] p-5 space-y-3.5 shadow-3xs\">\n                      <span className=\"text-[10px] font-mono text-gray-400 uppercase tracking-wider block\">CREDENTIELS RECOUP\303\211S</span>\n                      <div className=\"space-y-2 text-xs\">\n                        <p><strong className=\"text-gray-400\">Titre :</strong> {specialty.toUpperCase()}</p>\n                        <p><strong className=\"text-gray-400\">Num\303\251ro de registre Tableau :</strong> <span className=\"font-mono text-brand-primary font-bold\">{tableauNumber}</span></p>\n                        <p><strong className=\"text-gray-400\">Agr\303\251ment fiscal :</strong> {agreeCabinetNumber || \'Non applicable\'}</p>\n                        <p><strong className=\"text-gray-400 text-xs\">S\303\251niorit\303\251 d\'exercice :</strong> {yearsExperience} Ans d\'exp\303\251rience</p>\n                      </div>\n                    </div>\n\n                  </div>\n\n                  {/* Document checksum verification list with green checks */}\n                  <div className=\"bg-white border border-[#CFCFC4] p-5 space-y-3 shadow-3xs\">\n                    <span className=\"text-[10px] font-mono text-gray-400 uppercase tracking-wider block\">INDEX DE VERIFIABILT\303\211 DU DOSSIER (ONCC CHECK)</span>\n                    \n                    <div className=\"space-y-2.5\">\n                      <div className=\"flex items-center justify-between text-xs font-mono p-2 bg-[#FAF9F5]/80\">\n                        <span className=\"flex items-center gap-1.5 font-bold\"><CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" /> Carte Professionnelle</span>\n                        <span className=\"text-gray-500 text-[10px] truncate max-w-xs\">{proDocs.cartePro?.name}</span>\n                      </div>\n                      <div className=\"flex items-center justify-between text-xs font-mono p-2 bg-[#FAF9F5]/80\">\n                        <span className=\"flex items-center gap-1.5 font-bold\"><CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" /> Carte Nationale CIN</span>\n                        <span className=\"text-gray-500 text-[10px] truncate max-w-xs\">{proDocs.identity?.name}</span>\n                      </div>\n                      <div className=\"flex items-center justify-between text-xs font-mono p-2 bg-[#FAF9F5]/80\">\n                        <span className=\"flex items-center gap-1.5 font-bold\"><CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" /> Fiche d\'inscription au Tableau</span>\n                        <span className=\"text-gray-500 text-[10px] truncate max-w-xs\">{proDocs.attestationInsc?.name}</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Algerian article code check */}\n                  <div className=\"bg-white border p-5 space-y-4 shadow-3xs\">\n                    <span className=\"text-[10px] font-mono font-bold text-indigo-700 uppercase tracking-wider block\">D\303\251claration de conformit\303\251 p\303\251nale</span>\n                    \n                    <label className=\"flex gap-2.5 cursor-pointer text-xs leading-relaxed select-none text-gray-700 font-sans\">\n                      <input \n                        type=\"checkbox\" \n                        checked={attestHonourPro}\n                        onChange={(e) => setAttestHonourPro(e.target.checked)}\n                        className=\"accent-indigo-700 cursor-pointer mt-0.5 shrink-0\"\n                        id=\"pro_attest_honour_check\"\n                      />\n                      <span>\n                        {language === \'ar\'\n                          ? \'\330\243\330\264\331\207\330\257 \330\271\331\204\331\211 \330\247\331\204\330\264\330\261\331\201 \330\250\330\265\330\255\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \331\210\330\247\331\204\331\210\330\253\330\247\330\246\331\202 \330\247\331\204\331\205\331\202\330\257\331\205\330\251\330\214 \331\210\330\250\330\243\331\206\331\207\330\247 \330\243\330\265\331\204\331\212\330\251 \331\210\331\205\330\267\330\247\330\250\331\202\330\251 \331\204\331\204\331\210\330\247\331\202\330\271 \330\247\331\204\331\205\331\207\331\206\331\212 \330\252\331\205\330\247\330\264\331\212\330\247\331\213 \331\205\330\271 \330\247\331\204\331\205\330\247\330\257\330\251 222 \331\205\331\206 \331\202\330\247\331\206\331\210\331\206 \330\247\331\204\330\271\331\202\331\210\330\250\330\247\330\252 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212 \330\247\331\204\331\205\330\252\330\271\331\204\331\202 \330\250\330\247\331\204\331\201\331\210\330\262 \331\210\330\247\330\263\330\252\330\271\331\205\330\247\331\204 \330\247\331\204\331\205\330\262\331\210\330\261.\'\n                          : \'J\\\'atteste sur l\\\'honneur que les informations fournies sont exactes et que les documents t\303\251l\303\251vers\303\251s sont authentiques, conform\303\251ment \303\240 l\\\'article 222 du Code P\303\251nal alg\303\251rien relatif au faux et usage de faux.\'}\n                      </span>\n                    </label>\n                  </div>\n\n                </div>\n              )}\n\n            </div>\n          )}\n\n        </div>\n\n        {/* 3. WIZARD STEPPERS CONTROLLERS ACTION BUTTONS BAR */}\n        {!registrationSuccess && (\n          <div className=\"bg-white border-t border-[#CFCFC4] px-6 py-4 flex justify-between items-center select-none shrink-0\" id=\"wizard_buttons_bar\">\n            \n            {/* Back Button */}\n            <button\n              type=\"button\"\n              disabled={currentStep === 1}\n              onClick={handlePrevStep}\n              className={`px-4 py-2 text-xs font-mono font-bold uppercase transition flex items-center gap-1 hover:bg-gray-50 border ${\n                currentStep === 1 \n                  ? \'border-gray-100 text-gray-300 pointer-events-none\' \n                  : \'border-[#CFCFC4] text-gray-700 cursor-pointer\'\n              }`}\n            >\n              <ArrowLeft className=\"w-4 h-4 shrink-0\" />\n              <span>Pr\303\251c\303\251dent</span>\n            </button>\n\n            {/* Stepper position tracker on central bar */}\n            <div className=\"hidden sm:flex items-center gap-1.5\">\n              {activeStepsDef.map((st) => (\n                <div \n                  key={st.num}\n                  className={`w-2.5 h-2.5 rounded-none ${st.num === currentStep ? \'bg-[#0F6E56]\' : \'bg-gray-200\'}`}\n                ></div>\n              ))}\n            </div>\n\n            {/* Next / Submit Button */}\n            {isLastWizardStep ? (\n              <button\n                type=\"button\"\n                onClick={regRole === \'professional\' ? handleFinalSubmitPro : handleFinalSubmitClient}\n                className={`px-6 py-2 bg-emerald-700 hover:bg-emerald-800 hover:scale-[1.01] text-white text-[10px] font-mono font-bold uppercase tracking-widest transition cursor-pointer shadow-xs`}\n                id=\"wizard_final_save_btn\"\n              >\n                <span>Soumettre le Dossier</span>\n              </button>\n            ) : (\n              <button\n                type=\"button\"\n                onClick={handleNextStep}\n                className=\"px-6 py-2 bg-brand-primary hover:bg-[#085041] hover:scale-[1.01] text-white text-[10px] font-mono font-bold uppercase tracking-widest transition cursor-pointer shadow-xs flex items-center gap-1\"\n                id=\"wizard_next_step_btn\"\n              >\n                <span>Suivant</span>\n                <ArrowRight className=\"w-4 h-4 shrink-0\" />\n              </button>\n            )}\n\n          </div>\n        )}\n\n      </div>\n\n    </div>\n  );\n};\n"
    }
    diff {
      end_line: 301
      unified_diff {
        lines {
          text: "import React, { useState } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import { useNavigate, Link } from \'react-router-dom\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import { useLanguage } from \'../context/LanguageContext\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
