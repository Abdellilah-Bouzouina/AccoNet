        }
        lines {
          text: "      fr: \"Consultante fiscale \303\240 Blida. J\'oriente les industries agroalimentaires et manufacturi\303\250res de la Mitidja face aux fr\303\251quents changements des lois de finances.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
