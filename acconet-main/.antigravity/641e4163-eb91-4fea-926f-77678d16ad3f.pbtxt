    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef } from \'react\';\nimport { UploadCloud, FileText, CheckCircle2, AlertTriangle, Eye, Trash2, HelpCircle } from \'lucide-react\';\n\nexport interface DocumentUploadProps {\n  label: string;\n  labelAR: string;\n  description: string;\n  required: boolean;\n  acceptedTypes: string[]; // e.g. [\'pdf\', \'jpg\', \'png\']\n  maxSizeMB: number; // e.g. 5\n  legalTooltip?: string; // legal reason/basis\n  onUpload: (file: File, base64: string) => void;\n  onRemove: () => void;\n}\n\nexport const DocumentUpload: React.FC<DocumentUploadProps> = ({\n  label,\n  labelAR,\n  description,\n  required,\n  acceptedTypes,\n  maxSizeMB,\n  legalTooltip,\n  onUpload,\n  onRemove\n}) => {\n  const [isDragOver, setIsDragOver] = useState(false);\n  const [isUploading, setIsUploading] = useState(false);\n  const [uploadProgress, setUploadProgress] = useState(0);\n  const [fileDetails, setFileDetails] = useState<{ name: string; size: string; isImage: boolean; previewUrl?: string } | null>(null);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n  const [showTooltip, setShowTooltip] = useState(false);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const normalizeExtensions = acceptedTypes.map(t => t.toLowerCase());\n\n  const handleFileSubmission = (file: File) => {\n    setErrorMessage(null);\n    \n    // 1. Validate File Size\n    const fileSizeMB = file.size / (1024 * 1024);\n    if (fileSizeMB > maxSizeMB) {\n      setErrorMessage(`Fichier trop volumineux. Maximum ${maxSizeMB}MB. (\330\247\331\204\331\205\331\204\331\201 \331\203\330\250\331\212\330\261 \330\254\330\257\330\247\331\213. \330\247\331\204\330\255\330\257 \330\247\331\204\330\243\331\202\330\265\331\211 ${maxSizeMB} \331\205\331\212\330\272\330\247\330\250\330\247\331\212\330\252)`);\n      return;\n    }\n\n    // 2. Validate File Type / Extension\n    const fileExtension = file.name.split(\'.\').pop()?.toLowerCase() || \'\';\n    if (!normalizeExtensions.includes(fileExtension)) {\n      const allowedText = acceptedTypes.join(\', \').toUpperCase();\n      setErrorMessage(`Format non accept\303\251. ${allowedText} uniquement. (\330\247\331\204\330\265\331\212\330\272\330\251 \330\272\331\212\330\261 \331\205\331\202\330\250\331\210\331\204\330\251. \331\212\330\263\331\205\330\255 \330\250\331\200 ${allowedText} \331\201\331\202\330\267)`);\n      return;\n    }\n\n    // 3. Simulate Upload process with progress bar\n    setIsUploading(true);\n    setUploadProgress(10);\n    \n    const interval = setInterval(() => {\n      setUploadProgress(prev => {\n        if (prev >= 100) {\n          clearInterval(interval);\n          return 100;\n        }\n        return prev + 30;\n      });\n    }, 150);\n\n    // Read file as Base64 helper\n    const reader = new FileReader();\n    reader.onload = (e) => {\n      const base64 = e.target?.result as string;\n      setTimeout(() => {\n        setIsUploading(false);\n        const sizeString = (file.size / 1024 < 1024) \n          ? `${(file.size / 1024).toFixed(1)} KB` \n          : `${(file.size / (1024 * 1024)).toFixed(2)} MB`;\n        \n        const isImg = [\'jpg\', \'jpeg\', \'png\'].includes(fileExtension);\n        setFileDetails({\n          name: file.name,\n          size: sizeString,\n          isImage: isImg,\n          previewUrl: isImg ? base64 : undefined\n        });\n        \n        onUpload(file, base64);\n      }, 500); // minor aesthetic buffer\n    };\n    reader.readAsDataURL(file);\n  };\n\n  const handleDragOver = (e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragOver(true);\n  };\n\n  const handleDragLeave = () => {\n    setIsDragOver(false);\n  };\n\n  const handleDrop = (e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDragOver(false);\n    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {\n      handleFileSubmission(e.dataTransfer.files[0]);\n    }\n  };\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.files && e.target.files.length > 0) {\n      handleFileSubmission(e.target.files[0]);\n    }\n  };\n\n  const triggerFileSelect = () => {\n    fileInputRef.current?.click();\n  };\n\n  const handleRemove = () => {\n    setFileDetails(null);\n    setErrorMessage(null);\n    setIsUploading(false);\n    setUploadProgress(0);\n    onRemove();\n  };\n\n  return (\n    <div className=\"flex flex-col text-left rtl:text-right w-full font-sans\" id={`uploader_${label.replace(/\\s+/g, \'_\')}`}>\n      {/* Label and descriptive header */}\n      <div className=\"flex justify-between items-start mb-2.5\">\n        <div>\n          <span className=\"block text-xs font-serif font-bold text-gray-950\">\n            {label} {required && <span className=\"text-red-500\">*</span>}\n          </span>\n          <span className=\"block text-[11px] font-medium text-brand-primary/95 mt-0.5\">\n            {labelAR} {required && <span className=\"text-red-500\">*</span>}\n          </span>\n          <p className=\"text-[10px] text-gray-400 mt-1 font-sans\">{description}</p>\n        </div>\n\n        {legalTooltip && (\n          <div className=\"relative shrink-0\">\n            <button \n              type=\"button\"\n              className=\"text-[#0F6E56] hover:text-[#085041] p-1 focus:outline-none\"\n              onMouseEnter={() => setShowTooltip(true)}\n              onMouseLeave={() => setShowTooltip(false)}\n              onClick={() => setShowTooltip(!showTooltip)}\n            >\n              <HelpCircle className=\"w-4 h-4 cursor-pointer\" />\n            </button>\n            {showTooltip && (\n              <div className=\"absolute right-0 top-6 z-20 w-56 p-2.5 bg-gray-900 border border-gray-800 text-[10px] text-gray-100 leading-normal shadow-lg\">\n                <p>{legalTooltip}</p>\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n\n      {/* Uploading Progress Bar State */}\n      {isUploading && (\n        <div className=\"border border-[#CFCFC4] bg-[#FAF9F5] p-5 text-center space-y-3\">\n          <UploadCloud className=\"w-6 h-6 text-brand-primary animate-bounce mx-auto\" />\n          <p className=\"text-[11px] font-mono text-gray-500\">Chargement du fichier en cours... {uploadProgress}%</p>\n          <div className=\"w-full bg-[#EBEBE5] h-1.5 rounded-none overflow-hidden\">\n            <div className=\"bg-brand-primary h-full transition-all duration-150\" style={{ width: `${uploadProgress}%` }}></div>\n          </div>\n        </div>\n      )}\n\n      {/* Success File Loaded State */}\n      {!isUploading && fileDetails && (\n        <div className=\"border border-emerald-500/50 bg-emerald-50/20 p-4 flex items-center justify-between gap-3 shadow-2xs antialiased\">\n          <div className=\"flex items-center gap-3 min-w-0\">\n            {fileDetails.isImage && fileDetails.previewUrl ? (\n              <div className=\"w-[80px] h-[80px] border border-[#CFCFC4] overflow-hidden bg-white shrink-0 relative flex items-center justify-center\">\n                <img \n                  referrerPolicy=\"no-referrer\"\n                  src={fileDetails.previewUrl} \n                  alt=\"Aper\303\247u document\" \n                  className=\"w-full h-full object-cover\" \n                />\n              </div>\n            ) : (\n              <div className=\"w-[80px] h-[80px] border border-[#CFCFC4] bg-white shrink-0 flex items-center justify-center\">\n                <FileText className=\"w-9 h-9 text-brand-primary\" />\n              </div>\n            )}\n            \n            <div className=\"min-w-0\">\n              <p className=\"text-xs font-mono font-bold text-gray-800 truncate\" title={fileDetails.name}>\n                {fileDetails.name}\n              </p>\n              <p className=\"text-[10px] font-mono text-gray-400 mt-1\">{fileDetails.size}</p>\n              <div className=\"flex items-center gap-1.5 mt-2 text-emerald-700\">\n                <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                <span className=\"text-[9px] font-mono uppercase tracking-wide font-bold\">CHARG\303\211 / \330\252\331\205 \330\247\331\204\330\252\330\255\331\205\331\212\331\204</span>\n              </div>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={handleRemove}\n            className=\"p-1 px-2.5 text-[10px] font-mono uppercase text-red-600 hover:bg-red-50 border border-red-250 cursor-pointer flex items-center gap-1 shrink-0\"\n          >\n            <Trash2 className=\"w-3.5 h-3.5\" />\n            <span>Supprimer</span>\n          </button>\n        </div>\n      )}\n\n      {/* Empty Upload Zone and Error state */}\n      {!isUploading && !fileDetails && (\n        <div\n          onDragOver={handleDragOver}\n          onDragLeave={handleDragLeave}\n          onDrop={handleDrop}\n          onClick={triggerFileSelect}\n          className={`border-2 border-dashed p-6 text-center cursor-pointer transition flex flex-col items-center justify-center gap-3.5 min-h-[140px] ${\n            errorMessage \n              ? \'border-red-400 bg-red-50/10 hover:bg-red-50/25\' \n              : isDragOver\n                ? \'border-[#0F6E56] bg-[#0F6E56]/5\'\n                : \'border-[#CFCFC4] bg-[#FAF9F5]/30 hover:bg-[#FAF9F5]/70 hover:border-brand-primary\'\n          }`}\n        >\n          <input \n            type=\"file\" \n            ref={fileInputRef} \n            onChange={handleFileChange} \n            className=\"hidden\" \n            accept={acceptedTypes.map(type => `.${type}`).join(\',\')}\n          />\n          \n          <UploadCloud className={`w-8 h-8 ${errorMessage ? \'text-red-500\' : \'text-brand-primary/60\'}`} />\n          \n          <div className=\"space-y-1\">\n            <p className=\"text-xs text-gray-700 leading-normal\">\n              <span className=\"font-bold underline text-[#0F6E56]\">Faites glisser</span> ou <span className=\"font-bold underline text-[#0F6E56]\">cliquez pour charger</span>\n            </p>\n            <p className=\"text-[10px] text-gray-400 font-mono tracking-wide uppercase\">\n              {normalizeExtensions.join(\', \').toUpperCase()} \342\200\224 Max {maxSizeMB}MB\n            </p>\n          </div>\n        </div>\n      )}\n\n      {/* Specific error container */}\n      {errorMessage && (\n        <div className=\"mt-2 text-[10px] text-red-700 bg-red-50/50 border border-red-200 px-3 py-2 flex items-start gap-1.5 leading-relaxed\">\n          <AlertTriangle className=\"w-3.5 h-3.5 shrink-0 mt-0.5 text-red-500\" />\n          <p>{errorMessage}</p>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
