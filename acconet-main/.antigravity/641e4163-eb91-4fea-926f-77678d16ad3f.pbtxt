    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useApp } from \'../context/AppContext\';\nimport { ProfessionalCard } from \'../components/ProfessionalCard\';\nimport { algerianWilayas } from \'../data/algerianWilayas\';\nimport { OrderBadge } from \'../components/OrderBadge\';\nimport { \n  Building2, Users, Search, HelpCircle, ArrowLeft, ArrowRight, \n  MapPin, ClipboardCheck, ArrowUpRight, Check, Quote, Star, \n  Sparkles, FileText, Calendar, CloudLightning, ShieldCheck, Cpu,\n  BookmarkCheck, Activity, GraduationCap, FileCheck\n} from \'lucide-react\';\n\nexport const Landing: React.FC = () => {\n  const { t, tSpec, tObj, direction, language } = useLanguage();\n  const { allProfessionals, triggerNotification } = useApp();\n  const navigate = useNavigate();\n\n  // Search form state\n  const [keyword, setKeyword] = useState(\'\');\n  const [selectedWilaya, setSelectedWilaya] = useState(\'0\');\n  const [selectedSpecialty, setSelectedSpecialty] = useState(\'\');\n\n  const handleSearchSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    navigate(`/search?keyword=${encodeURIComponent(keyword)}&wilaya=${selectedWilaya}&specialty=${selectedSpecialty}`);\n  };\n\n  const featuredPros = allProfessionals.slice(0, 4);\n\n  const specialtiesList = [\n    { key: \"certified-accountant\", icon: \"\360\237\222\216\" },\n    { key: \"chartered-accountant\", icon: \"\360\237\217\233\357\270\217\" },\n    { key: \"statutory-auditor\", icon: \"\360\237\223\221\" },\n    { key: \"tax-consultant\", icon: \"\342\232\226\357\270\217\" },\n    { key: \"judicial-expert\", icon: \"\360\237\224\216\" }\n  ];\n\n  // Specific Testimonial with real Algerian company types\n  interface LocalTestimonial {\n    type: string;\n    location: string;\n    needed: string;\n    quoteFR: string;\n    quoteAR: string;\n    author: string;\n    stars: number;\n  }\n\n  const algerianEditorialTestimonials: LocalTestimonial[] = [\n    {\n      type: \"SARL de BTP\",\n      location: \"Tizi Ouzou\",\n      needed: \"Quarterly G50 & CNAS\",\n      quoteFR: \"Gr\303\242ce \303\240 notre comptable agr\303\251\303\251 trouv\303\251 sur AccoNet, l\'\303\251tablissement trimestriel de nos G50 et d\303\251clarations de chantiers CNAS est devenu un processus fluide. Z\303\251ro retard de cotisation.\",\n      quoteAR: \"\330\250\331\201\330\266\331\204 \330\247\331\204\331\205\330\255\330\247\330\263\330\250 \330\247\331\204\331\205\330\271\330\252\331\205\330\257 \330\247\331\204\330\260\331\212 \331\210\330\254\330\257\331\206\330\247\331\207 \331\201\331\212 \330\243\331\203\331\210\331\206\331\212\330\252\330\214 \330\243\330\265\330\250\330\255 \330\245\330\271\330\257\330\247\330\257 \330\252\330\265\330\261\331\212\330\255\330\247\330\252 G50 \331\210\330\247\331\204\330\247\330\264\330\252\330\261\330\247\331\203\330\247\330\252 \330\247\331\204\330\263\331\206\331\210\331\212\330\251 \331\204\331\204\330\266\331\205\330\247\331\206 \330\247\331\204\330\247\330\254\330\252\331\205\330\247\330\271\331\212 \331\204\331\204\330\271\331\205\330\247\331\204 \331\210\330\247\331\204\331\210\330\261\330\264\330\247\330\252 \331\205\330\263\330\252\331\202\330\261\330\247\331\213 \331\210\330\256\330\247\331\204\331\212\330\247\331\213 \331\205\331\206 \330\243\331\212 \330\272\330\261\330\247\331\205\330\247\330\252 \330\252\330\243\330\267\331\212\330\261.\",\n      author: \"Mr. Omar Ait-Ali\",\n      stars: 5\n    },\n    {\n      type: \"Startup labellis\303\251e (Alger Tech Hub)\",\n      location: \"Alger\",\n      needed: \"Exon\303\251ration & Comptabilit\303\251 SCF\",\n      quoteFR: \"Titulaire du label Startup DZ, nous cherchions un expert connaissant parfaitement la loi de finances 2026. L\'accompagnement sur notre liasse fiscale a \303\251t\303\251 au-del\303\240 de nos attentes.\",\n      quoteAR: \"\330\250\330\265\331\201\330\252\331\206\330\247 \330\264\330\261\331\203\330\251 \331\206\330\247\330\264\330\246\330\251 \330\255\330\247\330\265\331\204\330\251 \330\271\331\204\331\211 \330\247\331\204\330\271\331\204\330\247\331\205\330\251\330\214 \331\210\330\254\330\257\331\206\330\247 \330\256\330\250\331\212\330\261\330\247\331\213 \331\205\330\252\331\205\331\203\331\206\330\247\331\213 \331\205\331\206 \331\202\330\247\331\206\331\210\331\206 \330\247\331\204\331\205\330\247\331\204\331\212\330\251 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212 \331\210\331\205\330\262\330\247\331\212\330\247 \330\247\331\204\330\245\330\271\331\201\330\247\330\241 \331\204\331\204\330\264\330\261\331\203\330\247\330\252 \330\247\331\204\331\206\330\247\330\264\330\246\330\251 \331\205\331\205\330\247 \330\263\331\207\331\204 \330\257\331\205\330\254 \330\255\330\263\330\247\330\250\330\247\330\252\331\206\330\247 \330\247\331\204\331\205\330\247\331\204\331\212\330\251 \330\250\331\206\330\254\330\247\330\255.\",\n      author: \"Yasmine K.\",\n      stars: 5\n    },\n    {\n      type: \"Association sportive\",\n      location: \"Oran\",\n      needed: \"Commissariat aux comptes obligatoire\",\n      quoteFR: \"Conform\303\251ment \303\240 la Loi 12-06, la d\303\251signation d\'un commissaire aux comptes \303\251tait requise pour certifier nos subventions. Nous avons trouv\303\251 un auditeur rigoureux sous 48h.\",\n      quoteAR: \"\331\210\331\201\331\202\330\247\331\213 \331\204\331\205\331\202\330\252\330\266\331\212\330\247\330\252 \331\202\330\247\331\206\331\210\331\206 \330\247\331\204\330\254\331\205\330\271\331\212\330\247\330\252 12-06\330\214 \331\203\330\247\331\206 \331\205\331\206 \330\247\331\204\330\266\330\261\331\210\330\261\331\212 \330\252\330\271\331\212\331\212\331\206 \331\205\330\255\330\247\331\201\330\270 \330\255\330\263\330\247\330\250\330\247\330\252 \331\204\331\204\331\205\330\265\330\247\330\257\331\202\330\251 \330\271\331\204\331\211 \331\205\331\212\330\262\330\247\331\206\331\212\330\252\331\206\330\247 \331\210\330\247\331\204\331\205\330\263\330\247\330\271\330\257\330\247\330\252. \331\210\330\254\330\257\331\206\330\247 \331\205\330\257\331\202\331\202\330\247\331\213 \331\205\330\271\330\252\331\205\330\257\330\247\331\213 \331\201\331\212 \331\210\331\207\330\261\330\247\331\206 \330\250\331\203\331\204 \330\263\331\204\330\247\330\263\330\251.\",\n      author: \"Brahim S.\",\n      stars: 5\n    },\n    {\n      type: \"Auto-entrepreneur (Constantine)\",\n      location: \"Constantine\",\n      needed: \"IFU r\303\251gime simple - 5% CA\",\n      quoteFR: \"Avec ma carte d\'auto-entrepreneur, j\'avais des doutes sur l\'imp\303\264t forfaitaire unique. Un conseiller m\'a \303\251clair\303\251 sur place pour d\303\251clarer mon imp\303\264t annuel de fa\303\247on optimale.\",\n      quoteAR: \"\331\205\330\271 \330\255\330\265\331\210\331\204\331\212 \330\271\331\204\331\211 \330\250\330\267\330\247\331\202\330\251 \330\247\331\204\331\205\331\202\330\247\331\210\331\204 \330\247\331\204\330\260\330\247\330\252\331\212\330\214 \331\210\330\247\330\254\331\207\330\252\331\206\331\212 \330\252\330\263\330\247\330\244\331\204\330\247\330\252 \330\250\330\256\330\265\331\210\330\265 \330\247\331\204\330\266\330\261\331\212\330\250\330\251 \330\247\331\204\330\254\330\262\330\247\331\201\331\212\330\251 \330\247\331\204\331\210\330\255\331\212\330\257\330\251 (IFU) \330\247\331\204\331\205\331\202\330\257\330\261\330\251 \330\250\331\200 5\331\252. \331\210\330\254\331\207\331\206\331\212 \331\205\330\263\330\252\330\264\330\247\330\261 \330\254\330\250\330\247\330\246\331\212 \331\207\331\206\330\247 \331\210\330\265\330\255\330\255 \330\256\330\267\330\251 \330\247\331\204\330\252\330\265\330\261\331\212\330\255 \330\247\331\204\330\263\331\206\331\210\331\212.\",\n      author: \"Halim G.\",\n      stars: 5\n    },\n    {\n      type: \"Importateur de machines\",\n      location: \"Annaba\",\n      needed: \"TVA + TAP + Droits de douane\",\n      quoteFR: \"La gestion d\'importation implique des d\303\251clarations douani\303\250res et l\'\303\251tablissement des fiches d\'activit\303\251 professionnelle (TAP) complexes. Cabinet d\'une rigueur absolue.\",\n      quoteAR: \"\330\247\331\204\330\247\330\263\330\252\331\212\330\261\330\247\330\257 \331\212\330\263\331\204\330\252\330\262\331\205 \331\201\330\255\330\265\330\247\331\213 \331\205\330\271\331\202\330\257\330\247\331\213 \331\204\331\204\330\261\330\263\331\210\331\205 \330\247\331\204\330\254\331\205\330\261\331\203\331\212\330\251 \331\210\330\261\330\263\331\205 \330\247\331\204\331\206\330\264\330\247\330\267 \330\247\331\204\331\205\331\207\331\206\331\212 \331\210\330\252\330\271\330\257\331\212\331\204\330\247\330\252 \330\247\331\204\331\202\331\212\331\205\330\251 \330\247\331\204\331\205\330\266\330\247\331\201\330\251. \330\247\331\204\331\205\331\203\330\252\330\250 \330\247\331\204\330\260\331\212 \330\252\330\271\330\247\331\202\330\257\331\206\330\247 \331\205\330\271\331\207 \331\202\330\257\331\205 \331\205\330\263\330\252\331\210\331\211 \330\271\330\247\331\204\331\212\330\247\331\213 \331\205\331\206 \330\247\331\204\330\257\331\202\330\251 \330\247\331\204\331\202\330\247\331\206\331\210\331\206\331\212\330\251.\",\n      author: \"Mourad S.\",\n      stars: 5\n    },\n    {\n      type: \"EPIC Municipale\",\n      location: \"Blida\",\n      needed: \"Certification annuelle obligatoire\",\n      quoteFR: \"Notre \303\251tablissement public industriel et commercial requiert un audit pluriannuel pour soumissionner aux appels d\'offres d\'\303\211tat. Collaboration irr\303\251prochable.\",\n      quoteAR: \"\331\203\331\205\330\244\330\263\330\263\330\251 \330\271\331\205\331\210\331\205\331\212\330\251 \330\260\330\247\330\252 \330\267\330\247\330\250\330\271 \330\265\331\206\330\247\330\271\331\212 \331\210\330\252\330\254\330\247\330\261\331\212\330\214 \331\206\330\255\330\252\330\247\330\254 \331\205\330\265\330\247\330\257\331\202\330\251 \330\263\331\206\331\210\331\212\330\251 \330\265\330\247\330\261\331\205\330\251 \330\271\331\204\331\211 \331\205\331\212\330\262\330\247\331\206\331\212\330\247\330\252\331\206\330\247 \331\204\331\204\331\205\330\264\330\247\330\261\331\203\330\251 \331\201\331\212 \330\247\331\204\331\205\331\206\330\247\331\202\330\265\330\247\330\252 \330\247\331\204\330\255\331\203\331\210\331\205\331\212\330\251. \330\247\331\204\331\205\330\252\330\247\330\250\330\271\330\251 \331\203\330\247\331\206\330\252 \331\205\330\253\330\247\331\204\331\212\330\251 \331\205\330\271 \331\205\331\203\330\252\330\250 \331\205\330\255\330\247\331\201\330\270\330\251 \330\247\331\204\330\255\330\263\330\247\330\250\330\247\330\252.\",\n      author: \"Me. Sofiane Benamara\",\n      stars: 5\n    }\n  ];\n\n  const handleContactSofi = () => {\n    triggerNotification(\"Prise de Contact\", \"Votre demande d\'information a \303\251t\303\251 transmise \303\240 Me. Sofiane Benamara. Il vous r\303\251pondra sous 24h ouvrables.\");\n  };\n\n  return (\n    <div className=\"space-y-16 md:space-y-24 pb-20 bg-[#FAF9F5]\" id=\"landing_page_viewport\">\n      \n      {/* 1. UPGRADED: SPLIT LTR/RTL SPLIT LAYOUT HERO */}\n      <section className=\"relative overflow-hidden bg-[#FAF9F5] border-b border-[#D5D5CD] py-14 md:py-24 px-4 sm:px-6 lg:px-8\">\n        <div className=\"max-w-7xl mx-auto\">\n          \n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n            \n            {/* LEFT COLUMN (55% on desktop): EDITORIAL TYPOGRAPHY */}\n            <div className=\"lg:col-span-7 space-y-6 md:space-y-8 text-left rtl:text-right\">\n              \n              <div className=\"space-y-3\">\n                <span className=\"inline-block px-3 py-1 bg-brand-primary/10 border border-brand-primary/25 text-[#0F6E56] text-xs font-mono font-bold uppercase tracking-wider\">\n                  \331\205\331\206\330\265\330\251 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\330\251 \330\247\331\204\330\261\331\202\331\205\331\212\330\251 \330\247\331\204\330\243\331\210\331\204\331\211 \342\200\242 AccoNet\n                </span>\n                \n                <h1 className=\"text-3xl sm:text-4xl md:text-5xl lg:text-5.5xl font-serif font-black text-gray-901 leading-[1.12] tracking-tight\">\n                  \330\261\330\250\330\267 \330\247\331\204\331\205\330\244\330\263\330\263\330\247\330\252 <br />\n                  \330\250\330\243\331\201\330\266\331\204 \330\247\331\204\331\205\331\207\331\206\331\212\331\212\331\206 \330\247\331\204\331\205\330\271\330\252\331\205\330\257\331\212\331\206\n                </h1>\n\n                <p className=\"text-sm sm:text-base text-gray-600 max-w-lg leading-relaxed rtl:leading-loose\">\n                  \331\204\330\247 \331\205\330\262\331\212\330\257 \331\205\331\206 \330\247\331\204\330\252\331\206\331\202\331\204. \331\203\331\204 \330\256\330\257\331\205\330\247\330\252 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\330\251\330\214 \330\245\330\271\330\257\330\247\330\257 \331\205\331\212\330\262\330\247\331\206\331\212\330\251 SCF \330\247\331\204\330\263\331\206\331\210\331\212\330\251\330\214 \331\210\330\247\331\204\330\266\330\261\330\247\330\246\330\250 \330\247\331\204\330\271\330\247\331\204\331\202\330\251 \331\201\331\212 \331\205\331\203\330\247\331\206 \331\210\330\247\330\255\330\257 \331\205\330\271 \330\243\331\201\330\266\331\204 \331\205\331\203\330\247\330\252\330\250 \330\247\331\204\330\256\330\250\330\261\330\251 \330\247\331\204\331\210\330\267\331\206\331\212\330\251.\n                </p>\n              </div>\n\n              {/* Action buttons side-by-side */}\n              <div className=\"flex flex-wrap gap-3 select-none\">\n                <button \n                  onClick={() => navigate(\'/search\')}\n                  className=\"px-6 py-3.5 bg-brand-primary hover:bg-[#085041] hover:scale-[1.01] text-white font-mono text-[11px] font-bold uppercase tracking-wider transition cursor-pointer flex items-center gap-1.5 shadow-xs\"\n                >\n                  <span>Trouver un expert \342\206\222</span>\n                </button>\n                <button \n                  onClick={() => navigate(\'/register\')}\n                  className=\"px-6 py-3.5 bg-white border border-[#CFCFC4] hover:bg-gray-50 text-gray-800 font-mono text-[11px] font-bold uppercase tracking-wider transition cursor-pointer\"\n                >\n                  <span>Je suis professionnel</span>\n                </button>\n              </div>\n\n              {/* 3 small trust stats */}\n              <div className=\"pt-6 border-t border-[#EBEBE5] flex flex-wrap gap-6 items-center text-xs font-mono text-gray-500\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 bg-[#0F6E56]\"></span>\n                  <strong>248 Experts Agr\303\251\303\251s</strong>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 bg-[#0F6E56]\"></span>\n                  <strong>48 Wilayas d\'Alg\303\251rie</strong>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 bg-[#0F6E56]\"></span>\n                  <strong>1,200 Entreprises Actives</strong>\n                </div>\n              </div>\n\n            </div>\n\n            {/* RIGHT COLUMN (45% on desktop): FLOATING MINI-DASHBOARD CARD */}\n            <div className=\"lg:col-span-5 flex flex-col items-center\">\n              \n              <div className=\"w-full max-w-sm bg-white border border-[#CFCFC4] p-6 shadow-xs relative text-left rtl:text-right space-y-5\">\n                \n                {/* Header state */}\n                <div className=\"flex justify-between items-center pb-3 border-b border-[#EBEBE5]\">\n                  <span className=\"text-[10px] font-mono text-gray-400 uppercase tracking-widest\">Active Consultant Card</span>\n                  <span className=\"px-2 py-0.5 bg-emerald-50 text-emerald-800 border border-emerald-200 text-[9px] font-mono uppercase font-black\">\n                    ONEC VERIFIED\n                  </span>\n                </div>\n\n                {/* Profile Snapshot */}\n                <div className=\"flex items-start gap-4\">\n                  <div className=\"w-12 h-12 bg-teal-50 text-[#0F6E56] font-bold shrink-0 flex items-center justify-center font-serif text-lg border border-teal-150\">\n                    SB\n                  </div>\n                  <div className=\"space-y-1\">\n                    <div className=\"flex items-center gap-1\">\n                      <h3 className=\"font-serif font-black text-gray-901 text-sm sm:text-base\">Sofiane Benamara</h3>\n                      <span className=\"text-emerald-600 font-bold\" title=\"Inscrit National Verified\">\342\234\223</span>\n                    </div>\n                    \n                    <p className=\"text-[11px] font-mono text-indigo-700 font-bold uppercase tracking-wider\">Expert Comptable \342\200\224 ONEC</p>\n                    <p className=\"text-[10px] text-gray-400 font-sans\">Secteur principal : Alger, Wilaya 16</p>\n                  </div>\n                </div>\n\n                {/* Stars and statistics */}\n                <div className=\"grid grid-cols-2 gap-4 border-y border-[#FAF9F5] py-3.5 text-xs text-gray-600 font-mono\">\n                  <div className=\"space-y-0.5\">\n                    <span className=\"text-[9px] text-gray-400 block uppercase\">EVALUATION</span>\n                    <span className=\"flex items-center gap-1 font-bold text-gray-900 leading-none\">\n                      <Star className=\"w-3.5 h-3.5 text-[#F59E0B] fill-[#F59E0B]\" /> 4.9 / 5.0\n                    </span>\n                  </div>\n                  <div className=\"space-y-0.5 border-l rtl:border-l-0 rtl:border-r border-gray-150 pl-3 rtl:pl-0 rtl:pr-3\">\n                    <span className=\"text-[9px] text-gray-400 block uppercase font-bold\">SENIORITE</span>\n                    <span className=\"font-bold text-gray-950\">12 ans d\'exp.</span>\n                  </div>\n                </div>\n\n                {/* Pricing and Availability */}\n                <div className=\"flex justify-between items-center\">\n                  <div className=\"flex items-center gap-1 text-[11px] font-mono text-emerald-800 bg-emerald-50 border border-emerald-250 px-2.5 py-0.5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse\"></span>\n                    <span>Disponible imm\303\251diatement</span>\n                  </div>\n                  <span className=\"text-xs font-mono font-black text-gray-950\">45 000 DA/mois</span>\n                </div>\n\n                {/* CTA */}\n                <button\n                  type=\"button\"\n                  onClick={handleContactSofi}\n                  className=\"w-full py-2.5 bg-gray-910 text-white font-mono text-[10px] font-bold uppercase tracking-widest hover:bg-black transition cursor-pointer text-center\"\n                >\n                  Contacter l\'expert\n                </button>\n\n              </div>\n\n              {/* Small proof labels below card */}\n              <div className=\"flex flex-wrap justify-center items-center gap-4 mt-4 text-xs font-mono text-gray-400\">\n                <span className=\"flex items-center gap-1\">\360\237\233\241\357\270\217 \342\234\223 V\303\251rifi\303\251 ONEC</span>\n                <span className=\"flex items-center gap-1\">\360\237\223\213 \342\234\223 Documents certifi\303\251s</span>\n                <span className=\"flex items-center gap-1\">\360\237\244\235 \342\234\223 Contrat s\303\251curis\303\251</span>\n              </div>\n\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      {/* 2. RESEARCH STATISTICS CAROUSEL */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"p-8 bg-[#FBFBF8] border border-[#CFCFC4] grid grid-cols-1 md:grid-cols-4 gap-6 text-center\">\n          <div className=\"space-y-1\">\n            <span className=\"text-[9px] font-mono uppercase text-gray-450 block font-bold\">Couverture Nationale</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-[#0F6E56]\">48 Wilayas</p>\n            <p className=\"text-[10px] text-gray-400 font-sans\">Du Nord au grand Sud alg\303\251rien</p>\n          </div>\n          <div className=\"space-y-1 border-t md:border-t-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-[#E2E1D9] pt-4 md:pt-0\">\n            <span className=\"text-[9px] font-mono uppercase text-gray-450 block font-bold\">Tableaux Nationaux</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-gray-950\">ONEC & ONCC</p>\n            <p className=\"text-[10px] text-gray-400 font-sans\">V\303\251rification automatique obligatoire</p>\n          </div>\n          <div className=\"space-y-1 border-t md:border-t-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-[#E2E1D9] pt-4 md:pt-0\">\n            <span className=\"text-[9px] font-mono uppercase text-[#0F6E56] block font-bold\">R\303\251glementation Officielle</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-gray-950\">SCF & G50</p>\n            <p className=\"text-[10px] text-gray-400 font-sans\">Syst\303\250me Comptable Financier respect\303\251</p>\n          </div>\n          <div className=\"space-y-1 border-t md:border-t-0 border-[#E2E1D9] pt-4 md:pt-0\">\n            <span className=\"text-[9px] font-mono uppercase text-gray-450 block font-bold\">D\303\251p\303\264t s\303\251curis\303\251</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-gray-950\">Article 222 CP</p>\n            <p className=\"text-[10px] text-gray-400 font-sans\">Dossiers d\'agr\303\251ment int\303\250gres crypt\303\251s</p>\n          </div>\n        </div>\n      </section>\n\n      {/* 3. ASYMMETRIC SEARCH TERMINAL BLOCK */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-white border border-[#CFCFC4] p-5.5 sm:p-7 shadow-xs relative\">\n          <div className=\"absolute -top-3 left-4 rtl:left-auto rtl:right-4 bg-gray-950 px-2 py-0.5 text-[9px] font-mono text-[#E1F5EE] uppercase tracking-wider\">\n            Recherche de Partenaire Judiciaire / Fiscal / Comptable\n          </div>\n          \n          <form \n            onSubmit={handleSearchSubmit}\n            className=\"grid grid-cols-1 md:grid-cols-12 gap-3\"\n            id=\"hero_search_form\"\n          >\n            {/* Keyword Search Input */}\n            <div className=\"md:col-span-4 flex items-center gap-2 px-2.5 py-2 border border-[#EBEBE5]\">\n              <Search className=\"w-4 h-4 text-[#0F6E56] shrink-0\" />\n              <input \n                type=\"text\" \n                placeholder=\"ex : G50, bilan SCF, liasse fiscale...\"\n                value={keyword}\n                onChange={(e) => setKeyword(e.target.value)}\n                className=\"w-full text-xs text-gray-850 bg-transparent focus:outline-none placeholder-gray-400\"\n              />\n            </div>\n\n            {/* Wilaya Picker */}\n            <div className=\"md:col-span-3 flex items-center gap-1.5 px-2.5 py-2 border border-[#EBEBE5]\">\n              <MapPin className=\"w-3.5 h-3.5 text-[#0F6E56] shrink-0\" />\n              <select\n                value={selectedWilaya}\n                onChange={(e) => setSelectedWilaya(e.target.value)}\n                className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none cursor-pointer font-serif\"\n              >\n                <option value=\"0\">\360\237\223\215 Toutes les wilayas (48)</option>\n                {algerianWilayas.map((w) => (\n                  <option key={w.id} value={w.id}>{w.code} - {w.name.fr} ({w.name.ar})</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Specialty Dropdown */}\n            <div className=\"md:col-span-3 flex items-center gap-1.5 px-2.5 py-2 border border-[#EBEBE5]\">\n              <span className=\"text-xs shrink-0 select-none\">\360\237\222\274</span>\n              <select\n                value={selectedSpecialty}\n                onChange={(e) => setSelectedSpecialty(e.target.value)}\n                className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none cursor-pointer\"\n              >\n                <option value=\"\">{t(\'allSpecialties\')}</option>\n                {specialtiesList.map((s) => (\n                  <option key={s.key} value={s.key}>{tSpec(s.key)}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Direct Action */}\n            <button \n              type=\"submit\"\n              className=\"md:col-span-2 w-full py-2 bg-brand-primary hover:bg-[#085041] hover:scale-[1.01] text-white text-[10px] font-mono uppercase tracking-widest transition cursor-pointer flex items-center justify-center gap-1 font-bold\"\n            >\n              <span>Rechercher</span>\n              {direction === \'rtl\' ? <ArrowLeft className=\"w-3.5 h-3.5\" /> : <ArrowRight className=\"w-3.5 h-3.5\" />}\n            </button>\n          </form>\n        </div>\n      </section>\n\n      {/* 4. FEATURED COMPTABLES AND AUDITORS */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-10 text-left rtl:text-right\">\n          <div>\n            <span className=\"text-[10px] font-mono uppercase tracking-wider text-gray-400\">AccorNet Directory</span>\n            <h2 className=\"text-2xl sm:text-3xl font-serif font-semibold text-gray-950 tracking-tight mt-1\">\n              Profils Vedettes de l\'Ordre National\n            </h2>\n          </div>\n          <p className=\"text-xs sm:text-sm text-gray-500 max-w-lg leading-relaxed\">\n            Membres actifs confirm\303\251s. Chaque professionnel dispose d\'un profil d\'exercice avec num\303\251ro d\'accr\303\251ditation v\303\251rifi\303\251 et avis d\'entrepreneurs locaux.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {featuredPros.map((pro) => (\n            <ProfessionalCard key={pro.id} professional={pro} />\n          ))}\n        </div>\n      </section>\n\n      {/* 5. EDITORIAL ALGERIAN TESTIMONIALS SECTION */}\n      <section className=\"bg-white border-y border-[#CFCFC4] py-16 md:py-20\" id=\"testimonials_editorial_block\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n          \n          <div className=\"text-center space-y-3 max-w-2xl mx-auto\">\n            <span className=\"text-[10px] font-mono text-indigo-700 uppercase tracking-widest block font-bold\">Retour d\'exp\303\251rience des structures locales</span>\n            <h2 className=\"text-2xl sm:text-3xl font-serif font-semibold text-gray-950 tracking-tight\">\n              T\303\251moignages et cas d\'usage r\303\251glementaires\n            </h2>\n            <p className=\"text-xs text-gray-500 font-sans leading-relaxed\">\n              De l\'audit obligatoire des associations sportives \303\240 Oran, \303\240 la fiscalit\303\251 des startups labellis\303\251es \303\240 Alger. D\303\251couvrez pourquoi les entreprises alg\303\251riennes font confiance \303\240 nos partenaires.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-6\">\n            {algerianEditorialTestimonials.map((test, index) => (\n              <div \n                key={index}\n                className=\"bg-[#FAF9F5]/30 border border-[#CFCFC4] hover:border-brand-primary p-6 space-y-4 text-left rtl:text-right flex flex-col justify-between\"\n              >\n                <div className=\"space-y-3\">\n                  <div className=\"flex justify-between items-center pb-2 border-b border-gray-150\">\n                    <span className=\"text-[10px] font-mono text-gray-400 uppercase tracking-widest font-bold\">\n                      {test.type}\n                    </span>\n                    <span className=\"px-2 py-0.5 bg-[#E1F5EE] border border-emerald-150 text-[#0F6E56] text-[8px] font-mono\">\n                      {test.location} / {test.needed}\n                    </span>\n                  </div>\n\n                  <p className=\"text-gray-700 text-xs leading-relaxed italic\">\n                    \"{language === \'ar\' ? test.quoteAR : test.quoteFR}\"\n                  </p>\n                </div>\n\n                <div className=\"flex items-center gap-2.5 pt-3 border-t border-gray-150/50\">\n                  <div className=\"w-7 h-7 bg-brand-primary text-white font-serif font-black flex items-center justify-center text-xs\">\n                    {test.author[0]}\n                  </div>\n                  <div>\n                    <h4 className=\"font-serif font-bold text-gray-901 text-xs\">{test.author}</h4>\n                    <p className=\"text-[8px] text-gray-400 font-mono\">Contrat AccoNet V\303\251rifi\303\251</p>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n\n        </div>\n      </section>\n\n      {/* 6. IMMERSIVE SANDBOX DECORATOR */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-[#0B1A16] text-white p-8 sm:p-12 border border-[#0F6E56]/40 relative overflow-hidden\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10\">\n            \n            <div className=\"lg:col-span-6 space-y-4 text-left rtl:text-right\">\n              <span className=\"px-2.5 py-0.5 bg-brand-accent/20 border border-brand-accent/45 text-brand-accent text-[9px] font-mono uppercase tracking-wider\">\n                Simulations fiscales alg\303\251riennes \342\200\224 Bac \303\240 Sable\n              </span>\n              <h2 className=\"text-2xl sm:text-3xl font-serif font-bold tracking-tight\">\n                Simulez des calculations TVA, TAP et liasse SCF\n              </h2>\n              <p className=\"text-gray-300 text-xs leading-relaxed font-sans\">\n                V\303\251rifiez la conformit\303\251 de votre balance comptable face aux exigences du Syst\303\250me Comptable Financier (SCF) et g\303\251n\303\251rez des estimations de droits d\'enregistrement.\n              </p>\n              <button \n                onClick={() => navigate(\'/tools\')}\n                className=\"px-5 py-3 bg-[#0F6E56] hover:bg-[#085041] border border-transparent text-white text-[10px] uppercase font-mono font-bold tracking-widest transition cursor-pointer\"\n              >\n                Acc\303\251der aux simulateurs \342\206\222\n              </button>\n            </div>\n\n            <div className=\"lg:col-span-6 border border-white/10 p-5 bg-white/5 space-y-4\">\n              <div className=\"flex items-center gap-11 text-xs text-[#E1F5EE] border-b border-white/10 pb-2\">\n                <span className=\"font-mono\">WIDGET: ESTIMATEUR DE RETRACTATION JIBAYATIC</span>\n                <span className=\"text-[9px] bg-white/10 px-1 text-gray-300 font-mono\">SANDBOX ACTIVE</span>\n              </div>\n              \n              <div className=\"font-mono text-[11px] text-gray-300 space-y-1.5 leading-normal\">\n                <p>\360\237\222\241 <span className=\"font-bold\">Base d\'assiette TAP :</span> CA TTC du mois d\'exercice</p>\n                <p>\360\237\223\212 <span className=\"font-bold\">TVA standard :</span> 19% (Taux normal d\'importation/services)</p>\n                <p>\360\237\223\211 <span className=\"font-bold\">P\303\251nalit\303\251 cumulable (CPF) :</span> 10% syst\303\251matique + 3% majoration par mois</p>\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n    </div>\n  );\n};\n"
    }
