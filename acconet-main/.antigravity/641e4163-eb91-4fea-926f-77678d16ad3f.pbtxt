        }
        lines {
          text: "    fr: \"Comment fonctionne AccoNet ?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    en: \"How does AccoNet work?\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  howStep1Title: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ar: \"1. \330\255\330\257\330\257 \330\247\330\255\330\252\331\212\330\247\330\254\331\203 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\331\212\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    fr: \"1. D\303\251crivez votre besoin\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    en: \"1. Describe Your Accounting Need\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  howStep1Desc: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ar: \"\330\247\330\256\330\252\330\261 \331\206\331\210\330\271 \330\247\331\204\330\256\330\257\331\205\330\251 \330\247\331\204\330\252\331\212 \330\252\330\250\330\255\330\253 \330\271\331\206\331\207\330\247: \330\252\330\271\330\250\330\246\330\251 G50 \330\264\331\207\330\261\331\212\330\251\330\214 \330\252\330\257\331\202\331\212\331\202 \330\255\330\263\330\247\330\250\330\247\330\252\330\214 \330\243\331\210 \331\205\330\261\330\247\331\201\331\202\330\251 \330\254\330\250\330\247\330\246\331\212\330\251 \331\210\331\202\330\247\331\206\331\210\331\206\331\212\330\251.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    fr: \"Choisissez le service requis: tenue de comptes, liasse fiscale, r\303\251gularisation d\'imp\303\264ts.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    en: \"Select the required services: monthly bookkeeping, final fiscal return, tax regularizations.\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  howStep2Title: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ar: \"2. \331\202\330\247\330\261\331\206 \330\250\331\212\331\206 \330\247\331\204\330\256\330\250\330\261\330\247\330\241 \330\247\331\204\331\205\330\271\330\252\331\205\330\257\331\212\331\206\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    fr: \"2. Comparez les experts\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    en: \"2. Compare Verified Experts\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  howStep2Desc: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ar: \"\330\252\330\265\331\201\330\255 \331\205\331\203\330\247\330\252\330\250 \330\247\331\204\330\256\330\250\330\261\330\251 \330\247\331\204\330\255\331\202\331\212\331\202\331\212\330\251\330\214 \331\202\330\247\330\261\331\206 \330\252\331\203\331\204\331\201\330\251 \330\247\331\204\330\263\330\247\330\271\330\251\330\214 \330\263\331\206\331\210\330\247\330\252 \330\247\331\204\330\256\330\250\330\261\330\251\330\214 \330\247\331\204\331\205\330\261\330\247\330\254\330\271\330\247\330\252\330\214 \331\210\330\243\330\271\330\257\330\247\330\257 \331\205\331\204\331\201\330\247\330\252 \330\247\331\204\330\271\331\205\331\204\330\247\330\241 \330\247\331\204\330\263\330\247\330\250\331\202\330\251.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    fr: \"Parcourez les agr\303\251ments r\303\251els, les tarifs horaires, les ann\303\251es d\'exp\303\251rience et les avis de clients.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
