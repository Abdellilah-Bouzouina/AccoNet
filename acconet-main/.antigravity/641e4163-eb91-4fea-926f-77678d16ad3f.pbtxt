          text: "    ar: \"\330\252\330\255\331\202\331\202 \331\205\331\206 \330\263\331\204\330\247\331\205\330\251 \330\247\331\204\331\205\331\212\330\262\330\247\331\206\331\212\330\251 \330\247\331\204\330\257\331\201\330\252\330\261\331\212\330\251 \330\243\331\205\330\247\331\205 \331\205\330\252\330\267\331\204\330\250\330\247\330\252 \330\247\331\204\331\205\331\206\330\270\331\205\330\251 \330\247\331\204\331\210\330\267\331\206\331\212\330\251 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212\330\251 \331\204\331\204\331\205\330\255\330\247\330\263\330\250\330\251 \331\210\330\247\330\255\330\263\330\250 \331\205\330\250\330\247\331\204\330\272 \330\247\331\204\330\261\330\263\331\210\331\205 \330\250\331\206\331\202\330\261\330\251 \331\210\330\247\330\255\330\257\330\251.\","
