    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  const activeLinkClass = (path: string) => {\n    const isActive = location.pathname === path;\n    return isActive \n      ? \"text-brand-primary font-bold border-b-2 border-brand-primary pb-1\"\n      : \"text-gray-600 hover:text-brand-primary transition-colors duration-150\";\n  };\n\n  const userDisplayName = () => {\n    if (userRole === \'client\' && currentClient) {\n      return currentClient.companyName;\n    }\n    if (userRole === \'professional\' && currentProfessional) {\n      // Just take the name of the active language\n      return currentProfessional.name[language] || currentProfessional.name.en;\n    }\n    if (userRole === \'admin\') {\n      return \'DGI General Auditor / Admin\';\n    }\n    return \'\';\n  };\n\n  return (\n    <nav className=\"sticky top-0 z-50 glass shadow-classic\" id=\"main_navbar\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex justify-between h-16 items-center\">\n          \n          {/* Logo & Slogan */}\n          <div className=\"flex items-center space-x-2 rtl:space-x-reverse\">\n            <Link to=\"/\" className=\"flex items-center space-x-2 rtl:space-x-reverse\" id=\"logo_link\">\n              <span className=\"flex items-center justify-center w-10 h-10 rounded-xl bg-brand-primary text-white font-black text-xl shadow-md cursor-pointer hover:scale-105 transition-transform\">\n                \330\243\n              </span>\n              <div className=\"flex flex-col\">\n                <span className=\"text-xl font-bold tracking-tight text-gray-900 font-sans leading-none\">\n                  {t(\'brandName\')}\n                </span>\n                <span className=\"text-[10px] text-brand-primary font-bold font-sans mt-0.5\">\n                  Algeria\n                </span>\n              </div>\n            </Link>\n          </div>\n\n          {/* Desktop Navigation Links */}\n          <div className=\"hidden md:flex items-center space-x-6 lg:space-x-8 rtl:space-x-reverse text-sm font-medium\">\n            <Link to=\"/search\" className={activeLinkClass(\'/search\')} id=\"nav_search\">\n              <span className=\"flex items-center gap-1.5\">\n                <Search className=\"w-4 h-4\" />\n                {t(\'findProButton\')}\n              </span>\n            </Link>\n            \n            <Link to=\"/tools\" className={activeLinkClass(\'/tools\')} id=\"nav_tools\">\n              <span className=\"flex items-center gap-1.5\">\n                <Cpu className=\"w-4 h-4\" />\n                {t(\'toolsLink\')}\n              </span>\n            </Link>\n\n            {userRole === \'client\' && (\n              <Link to=\"/dashboard/client\" className={activeLinkClass(\'/dashboard/client\')} id=\"nav_client_dash\">\n                <span className=\"flex items-center gap-1.5\">\n                  <LayoutDashboard className=\"w-4 h-4\" />\n                  {t(\'dashboardSidebarTitle\')} ({t(\'isClientLabel\').split(\' \')[0]})\n                </span>\n              </Link>\n            )}\n\n            {userRole === \'professional\' && (\n              <Link to=\"/dashboard/professional\" className={activeLinkClass(\'/dashboard/professional\')} id=\"nav_pro_dash\">\n                <span className=\"flex items-center gap-1.5\">\n                  <CheckSquare className=\"w-4 h-4\" />\n                  {t(\'dashboardSidebarTitle\')} ({t(\'isProLabel\').split(\' \')[0]})\n                </span>\n              </Link>\n            )}\n\n            {userRole === \'admin\' && (\n              <Link to=\"/dashboard/admin\" className={activeLinkClass(\'/dashboard/admin\')} id=\"nav_admin_dash\">\n                <span className=\"flex items-center gap-1.5 text-amber-700\">\n                  <LayoutDashboard className=\"w-4 h-4 text-amber-600\" />\n                  Admin Panel\n                </span>\n              </Link>\n            )}\n          </div>\n\n          {/* Desktop Actions & Languages Switcher */}\n          <div className=\"hidden md:flex items-center space-x-4 rtl:space-x-reverse\">\n            \n            {/* Custom Interactive Multi-language Switcher */}\n            <div className=\"relative\">\n              <button \n                onClick={() => setLangDropdownOpen(!langDropdownOpen)}\n                className=\"flex items-center gap-1.5 px-3 py-1.5 border border-gray-200 rounded-lg text-sm font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 transition duration-150 cursor-pointer\"\n                id=\"language_picker_button\"\n              >\n                <Languages className=\"w-4 h-4 text-brand-primary\" />\n                <span className=\"uppercase\">{language}</span>\n              </button>\n\n              {langDropdownOpen && (\n                <div \n                  className={`absolute mt-2 w-32 glass rounded-2xl shadow-classic py-1 z-50 overflow-hidden ${direction === \'rtl\' ? \'left-0\' : \'right-0\'}`}\n                  id=\"lang_dropdown\"\n                >\n                  <button \n                    onClick={() => handleLanguageChange(\'ar\')}\n                    className={`flex w-full items-center px-4 py-2 text-sm text-right rtl:text-right hover:bg-brand-light hover:text-brand-primary justify-between cursor-pointer ${language === \'ar\' ? \'font-bold text-brand-primary\' : \'text-gray-700\'}`}\n                  >\n                    <span>\330\247\331\204\330\271\330\261\330\250\331\212\330\251</span>\n                    <span>\360\237\207\251\360\237\207\277</span>\n                  </button>\n                  <button \n                    onClick={() => handleLanguageChange(\'fr\')}\n                    className={`flex w-full items-center px-4 py-2 text-sm text-left hover:bg-brand-light hover:text-brand-primary justify-between cursor-pointer ${language === \'fr\' ? \'font-bold text-brand-primary\' : \'text-gray-700\'}`}\n                  >\n                    <span>Fran\303\247ais</span>\n                    <span>\360\237\207\253\360\237\207\267</span>\n                  </button>\n                  <button \n                    onClick={() => handleLanguageChange(\'en\')}\n                    className={`flex w-full items-center px-4 py-2 text-sm text-left hover:bg-brand-light hover:text-brand-primary justify-between cursor-pointer ${language === \'en\' ? \'font-bold text-brand-primary\' : \'text-gray-700\'}`}\n                  >\n                    <span>English</span>\n                    <span>\360\237\207\254\360\237\207\247</span>\n                  </button>\n                </div>\n              )}\n            </div>\n\n            {/* Auth section */}\n            {userRole === \'guest\' ? (\n              <div className=\"flex items-center space-x-2 rtl:space-x-reverse\">\n                <Link \n                  to=\"/login\" \n                  className=\"px-4 py-2 border border-brand-primary text-brand-primary rounded-xl text-sm font-medium hover:bg-brand-light transition duration-150\"\n                  id=\"navbar_login_btn\"\n                >\n                  {t(\'loginLink\')}\n                </Link>\n                <Link \n                  to=\"/register\" \n                  className=\"px-4 py-2 bg-brand-primary text-white hover:bg-brand-dark rounded-xl text-sm font-semibold shadow-xs hover:shadow-md transition duration-150\"\n                  id=\"navbar_register_btn\"\n                >\n                  {t(\'registerLink\')}\n                </Link>\n              </div>\n            ) : (\n              <div className=\"flex items-center space-x-3 rtl:space-x-reverse border-l rtl:border-l-0 rtl:border-r pl-3 rtl:pl-0 rtl:pr-3 border-gray-200\">\n                <div className=\"flex flex-col items-end rtl:items-start text-xs\">\n                  <span className=\"font-semibold text-gray-950 max-w-[120px] truncate\" title={userDisplayName()}>\n                    {userDisplayName()}\n                  </span>\n                  <span className=\"text-gray-400 font-mono text-[10px]\">\n                    {userRole === \'client\' ? \'Business Suite\' : userRole === \'admin\' ? \'Platform Control\' : \'Cabinet Pro\'}\n                  </span>\n                </div>\n                \n                {/* Visual Avatar */}\n                <div className=\"w-8 h-8 rounded-full bg-brand-light border border-brand-primary flex items-center justify-center font-bold text-brand-primary text-xs\">\n                  {userRole === \'client\' ? \'DT\' : userRole === \'admin\' ? \'AD\' : \'SB\'}\n                </div>\n\n                <button \n                  onClick={handleLogout}\n                  className=\"p-1 px-2 border border-red-200 hover:bg-red-50 text-red-600 rounded-lg text-xs cursor-pointer transition flex items-center gap-1\"\n                  title={t(\'logout\')}\n                  id=\"navbar_logout_btn\"\n                >\n                  <LogOut className=\"w-3.5 h-3.5\" />\n                  <span className=\"hidden lg:inline\">{t(\'logout\')}</span>\n                </button>\n              </div>\n            )}\n\n          </div>\n\n          {/* Mobile hamburger menu button */}\n          <div className=\"flex items-center md:hidden space-x-2 rtl:space-x-reverse\">\n            \n            {/* Quick Lang swap for Mobile */}\n            <button \n              onClick={() => setLanguage(language === \'ar\' ? \'fr\' : language === \'fr\' ? \'en\' : \'ar\')}\n              className=\"px-2 py-1 bg-gray-50 text-gray-600 rounded-lg text-xs border border-gray-200\"\n              title=\"Change Language\"\n            >\n              <span className=\"uppercase font-semibold\">{language}</span>\n            </button>\n\n            <button\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2 rounded-lg text-gray-500 hover:text-brand-primary hover:bg-gray-100 focus:outline-none\"\n              id=\"mobile_hamburger\"\n            >\n              {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n            </button>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Mobile Menu Panel */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden bg-white border-t border-gray-100 px-4 pt-2 pb-4 space-y-3 shadow-inner\" id=\"mobile_menu\">\n          <Link \n            to=\"/search\" \n            onClick={() => setMobileMenuOpen(false)}\n            className=\"block px-3 py-2 rounded-lg text-base font-medium text-gray-700 hover:bg-brand-light hover:text-brand-primary\"\n            id=\"mobile_search_link\"\n          >\n            {t(\'findProButton\')}\n          </Link>\n          <Link \n            to=\"/tools\" \n            onClick={() => setMobileMenuOpen(false)}\n            className=\"block px-3 py-2 rounded-lg text-base font-medium text-gray-700 hover:bg-brand-light hover:text-brand-primary\"\n            id=\"mobile_tools_link\"\n          >\n            {t(\'toolsLink\')}\n          </Link>\n\n          {userRole === \'client\' && (\n            <Link \n              to=\"/dashboard/client\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"block px-3 py-2 rounded-lg text-base font-medium text-gray-700 hover:bg-brand-light hover:text-brand-primary\"\n            >\n              {t(\'dashboardSidebarTitle\')} (Client)\n            </Link>\n          )}\n\n          {userRole === \'professional\' && (\n            <Link \n              to=\"/dashboard/professional\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"block px-3 py-2 rounded-lg text-base font-medium text-gray-700 hover:bg-brand-light hover:text-brand-primary\"\n            >\n              {t(\'dashboardSidebarTitle\')} (Pro)\n            </Link>\n          )}\n\n          {userRole === \'admin\' && (\n            <Link \n              to=\"/dashboard/admin\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"block px-3 py-2 rounded-lg text-base font-medium text-amber-700 hover:bg-amber-50\"\n            >\n              Admin Dashboard Panel\n            </Link>\n          )}\n\n          {/* Languages selection inside mobile drawer */}\n          <div className=\"pt-2 border-t border-gray-100\">\n            <p className=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2\">{t(\'about\')}</p>\n            <div className=\"grid grid-cols-3 gap-2\">\n              <button \n                onClick={() => handleLanguageChange(\'ar\')}\n                className={`py-1.5 text-xs rounded-lg border text-center cursor-pointer ${language === \'ar\' ? \'bg-brand-primary text-white border-brand-primary\' : \'bg-gray-50 text-gray-600 border-gray-200\'}`}\n              >\n                \330\247\331\204\330\271\330\261\330\250\331\212\330\251\n              </button>\n              <button \n                onClick={() => handleLanguageChange(\'fr\')}\n                className={`py-1.5 text-xs rounded-lg border text-center cursor-pointer ${language === \'fr\' ? \'bg-brand-primary text-white border-brand-primary\' : \'bg-gray-50 text-gray-600 border-gray-200\'}`}\n              >\n                Fran\303\247ais\n              </button>\n              <button \n                onClick={() => handleLanguageChange(\'en\')}\n                className={`py-1.5 text-xs rounded-lg border text-center cursor-pointer ${language === \'en\' ? \'bg-brand-primary text-white border-brand-primary\' : \'bg-gray-50 text-gray-600 border-gray-200\'}`}\n              >\n                English\n              </button>\n            </div>\n          </div>\n\n          {/* Authenticated user vs Guest inside mobile drawer */}\n          <div className=\"pt-4 border-t border-gray-200\">\n            {userRole === \'guest\' ? (\n              <div className=\"grid grid-cols-2 gap-2\">\n                <Link \n                  to=\"/login\" \n                  onClick={() => setMobileMenuOpen(false)}\n                  className=\"py-2 text-center border border-brand-primary text-brand-primary rounded-xl text-sm font-medium\"\n                >\n                  {t(\'loginLink\')}\n                </Link>\n                <Link \n                  to=\"/register\" \n                  onClick={() => setMobileMenuOpen(false)}\n                  className=\"py-2 text-center bg-brand-primary text-white rounded-xl text-sm font-medium\"\n                >\n                  {t(\'registerLink\')}\n                </Link>\n              </div>\n            ) : (\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center space-x-3 rtl:space-x-reverse p-2 bg-gray-55 rounded-lg\">\n                  <div className=\"w-8 h-8 rounded-full bg-brand-light flex items-center justify-center font-bold text-brand-primary text-xs\">\n                    {userRole === \'client\' ? \'DT\' : userRole === \'admin\' ? \'AD\' : \'SB\'}\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-bold text-gray-900\">{userDisplayName()}</p>\n                    <p className=\"text-[10px] text-gray-400 uppercase font-mono\">{userRole}</p>\n                  </div>\n                </div>\n                <button \n                  onClick={handleLogout}\n                  className=\"w-full py-2 flex items-center justify-center gap-2 border border-red-200 text-red-610 hover:bg-red-50 rounded-xl text-sm font-medium cursor-pointer\"\n                >\n                  <LogOut className=\"w-4 h-4\" />\n                  {t(\'logout\')}\n                </button>\n              </div>\n            )}\n          </div>\n        </div>\n      )}"
      replacement_content: "  const activeLinkClass = (path: string) => {\n    const isActive = location.pathname === path;\n    return isActive \n      ? \"text-brand-primary font-bold border-b-2 border-brand-primary pb-1 transition duration-150\"\n      : \"text-slate-400 hover:text-brand-primary transition-colors duration-150\";\n  };\n\n  const userDisplayName = () => {\n    if (userRole === \'client\' && currentClient) {\n      return currentClient.companyName;\n    }\n    if (userRole === \'professional\' && currentProfessional) {\n      // Just take the name of the active language\n      return currentProfessional.name[language] || currentProfessional.name.en;\n    }\n    if (userRole === \'admin\') {\n      return \'DGI General Auditor / Admin\';\n    }\n    return \'\';\n  };\n\n  return (\n    <nav className=\"sticky top-0 z-50 glass border-b border-white/5 shadow-classic\" id=\"main_navbar\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex justify-between h-14 items-center\">\n          \n          {/* Logo & Slogan */}\n          <div className=\"flex items-center space-x-2 rtl:space-x-reverse\">\n            <Link to=\"/\" className=\"flex items-center space-x-2.5 rtl:space-x-reverse\" id=\"logo_link\">\n              <span className=\"flex items-center justify-center w-8 h-8 rounded-lg bg-brand-primary/10 text-brand-primary font-black text-lg border border-brand-primary/20 hover:scale-105 transition-transform duration-250\">\n                \330\243\n              </span>\n              <div className=\"flex flex-col\">\n                <span className=\"text-base font-bold tracking-tight text-white font-sans leading-none\">\n                  {t(\'brandName\')}\n                </span>\n                <span className=\"text-[9px] text-brand-primary font-mono tracking-widest uppercase mt-0.5\">\n                  Fintech d\'Alg\303\251rie\n                </span>\n              </div>\n            </Link>\n          </div>\n\n          {/* Desktop Navigation Links */}\n          <div className=\"hidden md:flex items-center space-x-6 lg:space-x-8 rtl:space-x-reverse text-xs font-semibold uppercase tracking-wider\">\n            <Link to=\"/search\" className={activeLinkClass(\'/search\')} id=\"nav_search\">\n              <span className=\"flex items-center gap-1.5\">\n                <Search className=\"w-3.5 h-3.5\" />\n                {t(\'findProButton\')}\n              </span>\n            </Link>\n            \n            <Link to=\"/tools\" className={activeLinkClass(\'/tools\')} id=\"nav_tools\">\n              <span className=\"flex items-center gap-1.5\">\n                <Cpu className=\"w-3.5 h-3.5\" />\n                {t(\'toolsLink\')}\n              </span>\n            </Link>\n\n            {userRole === \'client\' && (\n              <Link to=\"/dashboard/client\" className={activeLinkClass(\'/dashboard/client\')} id=\"nav_client_dash\">\n                <span className=\"flex items-center gap-1.5\">\n                  <LayoutDashboard className=\"w-3.5 h-3.5\" />\n                  {t(\'dashboardSidebarTitle\')} ({t(\'isClientLabel\').split(\' \')[0]})\n                </span>\n              </Link>\n            )}\n\n            {userRole === \'professional\' && (\n              <Link to=\"/dashboard/professional\" className={activeLinkClass(\'/dashboard/professional\')} id=\"nav_pro_dash\">\n                <span className=\"flex items-center gap-1.5\">\n                  <CheckSquare className=\"w-3.5 h-3.5\" />\n                  {t(\'dashboardSidebarTitle\')} ({t(\'isProLabel\').split(\' \')[0]})\n                </span>\n              </Link>\n            )}\n\n            {userRole === \'admin\' && (\n              <Link to=\"/dashboard/admin\" className={activeLinkClass(\'/dashboard/admin\')} id=\"nav_admin_dash\">\n                <span className=\"flex items-center gap-1.5 text-amber-500\">\n                  <LayoutDashboard className=\"w-3.5 h-3.5 text-amber-500\" />\n                  Admin Panel\n                </span>\n              </Link>\n            )}\n          </div>\n\n          {/* Desktop Actions & Languages Switcher */}\n          <div className=\"hidden md:flex items-center space-x-4 rtl:space-x-reverse\">\n            \n            {/* Custom Interactive Multi-language Switcher */}\n            <div className=\"relative\">\n              <button \n                onClick={() => setLangDropdownOpen(!langDropdownOpen)}\n                className=\"flex items-center gap-1.5 px-2.5 py-1.5 border border-white/10 rounded-lg text-xs font-semibold text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 transition duration-150 cursor-pointer\"\n                id=\"language_picker_button\"\n              >\n                <Languages className=\"w-3.5 h-3.5 text-brand-primary\" />\n                <span className=\"uppercase\">{language}</span>\n              </button>\n\n              {langDropdownOpen && (\n                <div \n                  className={`absolute mt-2 w-32 glass rounded-xl shadow-classic py-1 z-50 overflow-hidden ${direction === \'rtl\' ? \'left-0\' : \'right-0\'}`}\n                  id=\"lang_dropdown\"\n                >\n                  <button \n                    onClick={() => handleLanguageChange(\'ar\')}\n                    className={`flex w-full items-center px-3 py-1.5 text-xs text-right rtl:text-right hover:bg-brand-light hover:text-brand-primary justify-between cursor-pointer ${language === \'ar\' ? \'font-bold text-brand-primary bg-white/5\' : \'text-slate-300\'}`}\n                  >\n                    <span>\330\247\331\204\330\271\330\261\330\250\331\212\330\251</span>\n                    <span>\360\237\207\251\360\237\207\277</span>\n                  </button>\n                  <button \n                    onClick={() => handleLanguageChange(\'fr\')}\n                    className={`flex w-full items-center px-3 py-1.5 text-xs text-left hover:bg-brand-light hover:text-brand-primary justify-between cursor-pointer ${language === \'fr\' ? \'font-bold text-brand-primary bg-white/5\' : \'text-slate-300\'}`}\n                  >\n                    <span>Fran\303\247ais</span>\n                    <span>\360\237\207\253\360\237\207\267</span>\n                  </button>\n                  <button \n                    onClick={() => handleLanguageChange(\'en\')}\n                    className={`flex w-full items-center px-3 py-1.5 text-xs text-left hover:bg-brand-light hover:text-brand-primary justify-between cursor-pointer ${language === \'en\' ? \'font-bold text-brand-primary bg-white/5\' : \'text-slate-300\'}`}\n                  >\n                    <span>English</span>\n                    <span>\360\237\207\254\360\237\207\247</span>\n                  </button>\n                </div>\n              )}\n            </div>\n\n            {/* Auth section */}\n            {userRole === \'guest\' ? (\n              <div className=\"flex items-center space-x-2 rtl:space-x-reverse\">\n                <Link \n                  to=\"/login\" \n                  className=\"px-3.5 py-1.5 border border-slate-700 text-slate-300 rounded-lg text-xs font-semibold hover:border-brand-primary hover:text-brand-primary hover:bg-white/5 transition duration-150\"\n                  id=\"navbar_login_btn\"\n                >\n                  {t(\'loginLink\')}\n                </Link>\n                <Link \n                  to=\"/register\" \n                  className=\"px-3.5 py-1.5 bg-brand-primary text-slate-950 hover:bg-brand-dark rounded-lg text-xs font-bold transition duration-150 shadow-xs hover:shadow-glow\"\n                  id=\"navbar_register_btn\"\n                >\n                  {t(\'registerLink\')}\n                </Link>\n              </div>\n            ) : (\n              <div className=\"flex items-center space-x-3 rtl:space-x-reverse border-l rtl:border-l-0 rtl:border-r pl-3 rtl:pl-0 rtl:pr-3 border-white/10\">\n                <div className=\"flex flex-col items-end rtl:items-start text-xs\">\n                  <span className=\"font-semibold text-slate-200 max-w-[120px] truncate animate-pulse\" title={userDisplayName()}>\n                    {userDisplayName()}\n                  </span>\n                  <span className=\"text-slate-400 font-mono text-[9px] tracking-wider uppercase\">\n                    {userRole === \'client\' ? \'Business Suite\' : userRole === \'admin\' ? \'Platform Control\' : \'Cabinet Pro\'}\n                  </span>\n                </div>\n                \n                {/* Visual Avatar */}\n                <div className=\"w-7 h-7 rounded-lg bg-brand-primary/25 border border-brand-primary/40 flex items-center justify-center font-bold text-brand-primary text-[10px]\">\n                  {userRole === \'client\' ? \'DT\' : userRole === \'admin\' ? \'AD\' : \'SB\'}\n                </div>\n\n                <button \n                  onClick={handleLogout}\n                  className=\"p-1 px-2 border border-rose-500/20 hover:bg-rose-500/10 text-rose-400 rounded-lg text-xs cursor-pointer transition flex items-center gap-1\"\n                  title={t(\'logout\')}\n                  id=\"navbar_logout_btn\"\n                >\n                  <LogOut className=\"w-3 h-3\" />\n                  <span className=\"hidden lg:inline text-[10px] uppercase font-semibold\">{t(\'logout\')}</span>\n                </button>\n              </div>\n            )}\n\n          </div>\n\n          {/* Mobile hamburger menu button */}\n          <div className=\"flex items-center md:hidden space-x-2 rtl:space-x-reverse\">\n            \n            {/* Quick Lang swap for Mobile */}\n            <button \n              onClick={() => setLanguage(language === \'ar\' ? \'fr\' : language === \'fr\' ? \'en\' : \'ar\')}\n              className=\"px-2 py-1 bg-white/5 text-slate-300 rounded-lg text-xs border border-white/10\"\n              title=\"Change Language\"\n            >\n              <span className=\"uppercase font-semibold\">{language}</span>\n            </button>\n\n            <button\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-1.5 rounded-lg text-slate-400 hover:text-brand-primary hover:bg-white/5 focus:outline-none\"\n              id=\"mobile_hamburger\"\n            >\n              {mobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n            </button>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Mobile Menu Panel */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden bg-brand-secondary border-t border-white/5 px-4 pt-2 pb-4 space-y-3 shadow-2xl\" id=\"mobile_menu\">\n          <Link \n            to=\"/search\" \n            onClick={() => setMobileMenuOpen(false)}\n            className=\"block px-3 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:bg-white/5 hover:text-white\"\n            id=\"mobile_search_link\"\n          >\n            {t(\'findProButton\')}\n          </Link>\n          <Link \n            to=\"/tools\" \n            onClick={() => setMobileMenuOpen(false)}\n            className=\"block px-3 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:bg-white/5 hover:text-white\"\n            id=\"mobile_tools_link\"\n          >\n            {t(\'toolsLink\')}\n          </Link>\n\n          {userRole === \'client\' && (\n            <Link \n              to=\"/dashboard/client\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"block px-3 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:bg-white/5 hover:text-white\"\n            >\n              {t(\'dashboardSidebarTitle\')} (Client)\n            </Link>\n          )}\n\n          {userRole === \'professional\' && (\n            <Link \n              to=\"/dashboard/professional\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"block px-3 py-2 rounded-lg text-sm font-semibold text-slate-300 hover:bg-white/5 hover:text-white\"\n            >\n              {t(\'dashboardSidebarTitle\')} (Pro)\n            </Link>\n          )}\n\n          {userRole === \'admin\' && (\n            <Link \n              to=\"/dashboard/admin\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"block px-3 py-2 rounded-lg text-sm font-semibold text-amber-500 hover:bg-amber-950/25\"\n            >\n              Admin Dashboard Panel\n            </Link>\n          )}\n\n          {/* Languages selection inside mobile drawer */}\n          <div className=\"pt-2 border-t border-white/5\">\n            <p className=\"text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2\">{t(\'about\')}</p>\n            <div className=\"grid grid-cols-3 gap-2\">\n              <button \n                onClick={() => handleLanguageChange(\'ar\')}\n                className={`py-1.5 text-xs rounded-xl border text-center cursor-pointer ${language === \'ar\' ? \'bg-brand-primary text-slate-950 border-brand-primary\' : \'bg-white/5 text-slate-300 border-white/10\'}`}\n              >\n                \330\247\331\204\330\271\330\261\330\250\331\212\330\251\n              </button>\n              <button \n                onClick={() => handleLanguageChange(\'fr\')}\n                className={`py-1.5 text-xs rounded-xl border text-center cursor-pointer ${language === \'fr\' ? \'bg-brand-primary text-slate-950 border-brand-primary\' : \'bg-white/5 text-slate-300 border-white/10\'}`}\n              >\n                Fran\303\247ais\n              </button>\n              <button \n                onClick={() => handleLanguageChange(\'en\')}\n                className={`py-1.5 text-xs rounded-xl border text-center cursor-pointer ${language === \'en\' ? \'bg-brand-primary text-slate-950 border-brand-primary\' : \'bg-white/5 text-slate-300 border-white/10\'}`}\n              >\n                English\n              </button>\n            </div>\n          </div>\n\n          {/* Authenticated user vs Guest inside mobile drawer */}\n          <div className=\"pt-4 border-t border-white/5\">\n            {userRole === \'guest\' ? (\n              <div className=\"grid grid-cols-2 gap-2\">\n                <Link \n                  to=\"/login\" \n                  onClick={() => setMobileMenuOpen(false)}\n                  className=\"py-1.5 text-center border border-slate-700 text-slate-300 rounded-xl text-xs font-semibold\"\n                >\n                  {t(\'loginLink\')}\n                </Link>\n                <Link \n                  to=\"/register\" \n                  onClick={() => setMobileMenuOpen(false)}\n                  className=\"py-1.5 text-center bg-brand-primary text-slate-950 rounded-xl text-xs font-semibold\"\n                >\n                  {t(\'registerLink\')}\n                </Link>\n              </div>\n            ) : (\n              <div className=\"space-y-2\">\n                <div className=\"flex items-center space-x-3 rtl:space-x-reverse p-2 bg-white/5 rounded-xl\">\n                  <div className=\"w-8 h-8 rounded-lg bg-brand-primary/20 flex items-center justify-center font-bold text-brand-primary text-xs\">\n                    {userRole === \'client\' ? \'DT\' : userRole === \'admin\' ? \'AD\' : \'SB\'}\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-bold text-slate-200\">{userDisplayName()}</p>\n                    <p className=\"text-[9px] text-slate-400 uppercase font-mono\">{userRole}</p>\n                  </div>\n                </div>\n                <button \n                  onClick={handleLogout}\n                  className=\"w-full py-1.5 flex items-center justify-center gap-2 border border-rose-500/20 text-rose-400 hover:bg-rose-500/10 rounded-xl text-xs font-semibold cursor-pointer\"\n                >\n                  <LogOut className=\"w-3.5 h-3.5\" />\n                  {t(\'logout\')}\n                </button>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </nav>"
