  file_change {
    absolute_path_uri: "file:///src/pages/Register.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useNavigate, Link } from \'react-router-dom\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useApp, UserRole } from \'../context/AppContext\';\nimport { wilayas } from \'../data/mockData\';\nimport { \n  Building2, UserCheck, ShieldCheck, Mail, Lock, \n  MapPin, Award, ArrowLeft, ArrowRight, X \n} from \'lucide-react\';\n\nexport const Register: React.FC = () => {\n  const { t, tSpec, tObj, direction } = useLanguage();\n  const { setUserRole, setCurrentClient, setCurrentProfessional, triggerNotification } = useApp();\n  const navigate = useNavigate();\n\n  // Active path: client vs professional\n  const [regRole, setRegRole] = useState<\'client\' | \'professional\'>(\'client\');\n\n  // Multi-fields State variables\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [entityName, setEntityName] = useState(\'\');\n  const [selectedWilaya, setSelectedWilaya] = useState<number>(16); // Algiers\n\n  // Professional Additional Fields\n  const [specialty, setSpecialty] = useState(\'certified-accountant\');\n  const [accreditNum, setAccreditNum] = useState(\'\');\n\n  const handleRegisterSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!email || !password || !entityName) return;\n\n    if (regRole === \'client\') {\n      setUserRole(\'client\');\n      setCurrentClient({\n        id: `c_custom_reg_${Date.now()}`,\n        companyName: entityName,\n        sector: { ar: \"\330\256\330\257\331\205\330\247\330\252 \330\252\330\254\330\247\330\261\331\212\330\251 \331\210\331\205\331\202\330\247\331\210\331\204\330\247\330\252\", fr: \"Services commerciaux\", en: \"Commercial services\" },\n        wilayaId: selectedWilaya,\n        wilayaName: wilayas.find((w) => w.id === selectedWilaya)?.name || { ar: \"\330\247\331\204\330\254\330\262\330\247\330\246\330\261\", fr: \"Alger\", en: \"Algiers\" },\n        logoInitials: entityName.substring(0, 2).toUpperCase(),\n        avatarBg: \"bg-teal-700 text-white\",\n        NIF: \"0019\" + Math.floor(Math.random() * 10000000000), // Random NIF code\n        RC: \"16/00-\" + Math.floor(Math.random() * 100000) + \"B26\",\n        activeContracts: [],\n        pendingTasks: []\n      });\n\n      triggerNotification(\n        t(\'authSuccessHeading\'),\n        `Successfully registered as Business SME: ${entityName}. Welcome to AccoNet!`\n      );\n      navigate(\'/dashboard/client\');\n    } else {\n      setUserRole(\'professional\');\n      setCurrentProfessional({\n        id: `p_custom_reg_${Date.now()}`,\n        name: { ar: entityName, fr: entityName, en: entityName },\n        initials: entityName.substring(0, 2).toUpperCase(),\n        avatarBg: \"bg-indigo-800 text-white\",\n        specialty: specialty as any,\n        wilayaId: selectedWilaya,\n        wilayaName: wilayas.find((w) => w.id === selectedWilaya)?.name || { ar: \"\330\247\331\204\330\254\330\262\330\247\330\246\330\261\", fr: \"Alger\", en: \"Algiers\" },\n        rating: 5.0,\n        reviewCount: 0,\n        hourlyRate: 5000,\n        available: true,\n        yearsExperience: 5,\n        accreditationNumber: accreditNum || \"CNEC/2026/001\",\n        completionRate: 100,\n        clientsServed: 0,\n        bio: {\n          ar: `\331\205\331\203\330\252\330\250 \330\247\331\204\330\256\330\250\331\212\330\261 ${entityName} \331\205\330\271\330\252\331\205\330\257 \331\204\331\205\330\267\330\247\330\250\331\202\330\251 \330\247\331\204\331\204\331\210\330\247\330\246\330\255 \330\247\331\204\331\202\330\247\331\206\331\210\331\206\331\212\330\251 \331\210\330\247\331\204\330\266\330\261\330\247\330\246\330\250 \331\201\331\212 \331\210\331\204\330\247\331\212\330\251 ${selectedWilaya}.`,\n          fr: `Cabinet de Me. ${entityName} agr\303\251\303\251 par le conseil national pour vos liasses de cl\303\264ture fiscales.`,\n          en: `Professional office of Mr/Ms ${entityName} accredited by the board. Specialized in local compliance.`\n        },\n        services: [],\n        reviews: [],\n        history: []\n      });\n\n      triggerNotification(\n        t(\'authSuccessHeading\'),\n        `Successfully registered as ${tSpec(specialty)}: Me. ${entityName}. Welcome to AccoNet!`\n      );\n      navigate(\'/dashboard/professional\');\n    }\n  };\n\n  return (\n    <div className=\"min-h-[calc(100vh-4rem)] flex items-stretch animate-fade-in\" id=\"register_panel_viewport\">\n      \n      {/* LEFT STATIC PANEL - SPLIT THEME */}\n      <div className=\"hidden lg:flex lg:w-1/2 bg-brand-dark text-white p-16 flex-col justify-between relative overflow-hidden\">\n        \n        {/* Subtle decorative geometric overlay */}\n        <div className=\"absolute inset-0 opacity-10 pointer-events-none\">\n          <div className=\"absolute top-20 right-20 w-80 h-80 rounded-full border-12 border-brand-accent\"></div>\n          <div className=\"absolute bottom-20 left-20 w-48 h-48 rounded-full border-4 border-white\"></div>\n        </div>\n\n        <div className=\"space-y-2 relative z-10\">\n          <Link to=\"/\" className=\"flex items-center space-x-2.5 rtl:space-x-reverse\">\n            <span className=\"flex items-center justify-center w-10 h-10 rounded-xl bg-white text-brand-primary font-black text-xl shadow-md\">\n              \330\243\n            </span>\n            <span className=\"text-2xl font-bold tracking-tight text-white font-sans\">\n              AccoNet <span className=\"text-brand-accent\">\330\243\331\203\331\210\331\206\331\212\330\252</span>\n            </span>\n          </Link>\n          <p className=\"text-xs text-brand-light font-mono leading-none tracking-wider uppercase pt-1\">Algeria</p>\n        </div>\n\n        <div className=\"space-y-4 relative z-10\">\n          <h2 className=\"text-3xl font-extrabold leading-tight\">\n            Connecting companies with authorized financial leaders across Algerian territory.\n          </h2>\n          <p className=\"text-gray-300 text-xs leading-relaxed max-w-md\">\n            Easily manage quarterly VAT, trade declarations, social CNAS audits, and financial statements directly via an interactive trilingual dashboard.\n          </p>\n        </div>\n\n        <div className=\"text-xs text-brand-light/70 flex items-center gap-2 relative z-10\">\n          <ShieldCheck className=\"w-5 h-5 text-brand-accent\" />\n          <span>Legally complaint with the Algerian Ordre des Experts Comptables (ONEC)</span>\n        </div>\n\n      </div>\n\n      {/* RIGHT REGISTER DYNAMIC FORM PANEL */}\n      <div className=\"w-full lg:w-1/2 bg-white flex flex-col justify-center px-6 py-10 sm:px-12 lg:px-20 overflow-y-auto\">\n        <div className=\"max-w-md w-full mx-auto space-y-6\">\n          \n          <div className=\"space-y-2\">\n            <h1 className=\"text-2xl font-black text-gray-950 font-sans tracking-tight\">\n              {t(\'registerTitle\')}\n            </h1>\n            <p className=\"text-xs text-gray-400 font-mono uppercase tracking-wider\">CREATING NEW DIGITAL CREDENTIALS</p>\n          </div>\n\n          {/* TWO PATHWAYS SELECTOR SWITCH TABS */}\n          <div className=\"space-y-2\">\n            <label className=\"text-xs font-bold text-gray-400 uppercase\">{t(\'accountTypeLabel\')}</label>\n            <div className=\"grid grid-cols-2 gap-2 bg-gray-50 border border-gray-150 rounded-xl p-1 text-center\">\n              \n              <button\n                type=\"button\"\n                onClick={() => setRegRole(\'client\')}\n                className={`py-2.5 rounded-lg cursor-pointer text-xs font-bold transition duration-150 flex flex-col items-center justify-center gap-1.5 ${regRole === \'client\' ? \'bg-white text-brand-primary shadow-xs border border-gray-150\' : \'text-gray-500 hover:text-gray-901\'}`}\n              >\n                <Building2 className=\"w-4 h-4 text-brand-primary\" />\n                <span className=\"leading-tight text-[11px]\">{t(\'isClientLabel\').split(\' \')[0]}</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setRegRole(\'professional\')}\n                className={`py-2.5 rounded-lg cursor-pointer text-xs font-bold transition duration-150 flex flex-col items-center justify-center gap-1.5 ${regRole === \'professional\' ? \'bg-white text-indigo-700 shadow-xs border border-gray-150\' : \'text-gray-500 hover:text-gray-901\'}`}\n              >\n                <UserCheck className=\"w-4 h-4 text-indigo-700\" />\n                <span className=\"leading-tight text-[11px]\">{t(\'isProLabel\').split(\' \')[0]}</span>\n              </button>\n\n            </div>\n          </div>\n\n          {/* REGISTER ACTION FORM */}\n          <form onSubmit={handleRegisterSubmit} className=\"space-y-3\">\n            \n            {/* Conditional labels based on role */}\n            <div className=\"space-y-1\">\n              <label className=\"text-[10px] font-bold text-gray-400 uppercase\">\n                {regRole === \'client\' ? t(\'fieldCompanyName\') : \"Full Name / Office Name\"}\n              </label>\n              <input \n                type=\"text\" \n                required\n                placeholder={regRole === \'client\' ? \"e.g. Sarl Chlef Agro Services\" : \"e.g. Me. Yazid Harbi\"}\n                value={entityName}\n                onChange={(e) => setEntityName(e.target.value)}\n                className=\"w-full border border-gray-250 rounded-xl px-3 py-2 text-xs text-gray-750 bg-gray-50 focus:outline-none focus:border-brand-primary focus:bg-white\"\n                id=\"reg_name_input\"\n              />\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-[10px] font-bold text-gray-400 uppercase\">{t(\'fieldEmail\')}</label>\n              <div className=\"relative border border-gray-250 rounded-xl bg-gray-50 px-3 py-2 flex items-center gap-2 focus-within:border-brand-primary focus-within:bg-white transition\">\n                <Mail className=\"w-4 h-4 text-brand-primary shrink-0\" />\n                <input \n                  type=\"email\" \n                  required\n                  placeholder=\"admin@cabinet.dz\"\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none\"\n                  id=\"reg_email_input\"\n                />\n              </div>\n            </div>\n\n            <div className=\"space-y-1\">\n              <label className=\"text-[10px] font-bold text-gray-400 uppercase\">{t(\'fieldPassword\')}</label>\n              <div className=\"relative border border-gray-250 rounded-xl bg-gray-50 px-3 py-2 flex items-center gap-2 focus-within:border-brand-primary focus-within:bg-white transition\">\n                <Lock className=\"w-4 h-4 text-brand-primary shrink-0\" />\n                <input \n                  type=\"password\" \n                  required\n                  placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none\"\n                  id=\"reg_password_input\"\n                />\n              </div>\n            </div>\n\n            {/* General Primary Wilaya HQ Picker */}\n            <div className=\"space-y-1\">\n              <label className=\"text-[10px] font-bold text-gray-400 uppercase block\">{t(\'fieldWilaya\')}</label>\n              <div className=\"relative border border-gray-250 rounded-xl bg-gray-50 px-3 py-2 flex items-center gap-2 focus-within:border-brand-primary focus-within:bg-white transition\">\n                <MapPin className=\"w-4 h-4 text-brand-primary shrink-0\" />\n                <select\n                  value={selectedWilaya}\n                  onChange={(e) => setSelectedWilaya(Number(e.target.value))}\n                  className=\"w-full bg-transparent text-xs text-gray-700 focus:outline-none\"\n                  id=\"reg_wilaya_input\"\n                >\n                  {wilayas.map((w) => (\n                    <option key={w.id} value={w.id}>{w.code} - {tObj(w.name)}</option>\n                  ))}\n                </select>\n              </div>\n            </div>\n\n            {/* DYNAMIC ADDITIONAL FIELDS FOR THE PROFESSIONAL OPTION TAB */}\n            {regRole === \'professional\' && (\n              <div className=\"space-y-3.5 p-4 bg-indigo-50/50 border border-indigo-100 rounded-2xl animate-fade-in\" id=\"pro_additional_reg_fields\">\n                <p className=\"text-[10px] uppercase font-bold text-indigo-800 tracking-wider font-mono\">Specialist Qualifications</p>\n                \n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3.5\">\n                  <div className=\"space-y-1\">\n                    <label className=\"text-[10px] font-bold text-gray-400 uppercase\">{t(\'fieldSpecialty\')}</label>\n                    <select\n                      value={specialty}\n                      onChange={(e) => setSpecialty(e.target.value)}\n                      className=\"w-full border border-gray-200 rounded-lg px-2 py-1.5 bg-white text-xs text-gray-751 focus:outline-none focus:border-brand-primary\"\n                    >\n                      <option value=\"certified-accountant\">{tSpec(\"certified-accountant\")}</option>\n                      <option value=\"chartered-accountant\">{tSpec(\"chartered-accountant\")}</option>\n                      <option value=\"statutory-auditor\">{tSpec(\"statutory-auditor\")}</option>\n                      <option value=\"tax-consultant\">{tSpec(\"tax-consultant\")}</option>\n                      <option value=\"judicial-expert\">{tSpec(\"judicial-expert\")}</option>\n                    </select>\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <label className=\"text-[10px] font-bold text-gray-400 uppercase\">{t(\'fieldAccreditation\')}</label>\n                    <div className=\"relative border border-gray-200 rounded-lg bg-white px-2 py-1.5 flex items-center gap-1.5\">\n                      <Award className=\"w-3.5 h-3.5 text-indigo-700 shrink-0\" />\n                      <input \n                        type=\"text\" \n                        required\n                        placeholder={t(\'accNumPlaceholder\')}\n                        value={accreditNum}\n                        onChange={(e) => setAccreditNum(e.target.value)}\n                        className=\"w-full text-xs text-gray-750 bg-transparent focus:outline-none\"\n                      />\n                    </div>\n                  </div>\n                </div>\n              </div>\n            )}\n\n            {/* Submit btn */}\n            <button\n              type=\"submit\"\n              className=\"w-full py-3 bg-brand-primary hover:bg-brand-dark text-white text-xs font-bold rounded-xl shadow-xs hover:shadow-md cursor-pointer transition flex items-center justify-center gap-1.5\"\n              id=\"reg_submit_btn\"\n            >\n              <span>{t(\'registerLink\')}</span>\n              {direction === \'rtl\' ? <ArrowLeft className=\"w-4 h-4\" /> : <ArrowRight className=\"w-4 h-4\" />}\n            </button>\n\n          </form>\n\n          {/* BACK TO LOGIN */}\n          <p className=\"text-xs text-gray-500 text-center font-sans\">\n            {t(\'alreadyHaveAccount\')}{\' \'}\n            <Link to=\"/login\" className=\"text-brand-primary font-bold hover:underline\" id=\"reg_to_login_link\">\n              {t(\'loginLink\')}\n            </Link>\n          </p>\n\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
    }
