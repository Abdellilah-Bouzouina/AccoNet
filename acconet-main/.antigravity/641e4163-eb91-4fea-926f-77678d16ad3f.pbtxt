fied List\n            </span>\n          </div>\n\n          <h5 className=\"font-serif font-bold text-xs text-gray-900 mt-1.5 leading-snug\">\n            {detail.fullName}\n          </h5>\n          <h6 className=\"font-serif font-black text-[11px] text-brand-primary mt-1\">\n            {detail.fullNameAR}\n          </h6>\n        </div>\n      </div>\n\n      <div className=\"pt-2 text-[10px] text-gray-500 font-mono space-y-1 border-t border-gray-100\">\n        <p>\342\232\226\357\270\217 <span className=\"font-bold\">Base l\303\251gale :</span> {detail.legalBasis}</p>\n        <p>\360\237\223\210 <span className=\"font-bold\">Membres inscrits :</span> {detail.memberCount}</p>\n        \n        {detail.website && (\n          <a \n            href={`https://${detail.website}`} \n            target=\"_blank\" \n            referrerPolicy=\"no-referrer\"\n            rel=\"noopener noreferrer\" \n            className=\"inline-flex items-center gap-0.5 text-brand-primary font-bold hover:underline mt-1\"\n          >\n            <span>{detail.website}</span>\n            <ArrowUpRight className=\"w-2.5 h-2.5\" />\n          </a>\n        )}\n      </div>\n    </div>\n  );\n};\n"
