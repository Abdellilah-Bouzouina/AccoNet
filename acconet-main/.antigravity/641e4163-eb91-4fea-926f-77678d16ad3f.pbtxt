    replacement_chunks {
      target_content: "  return (\n    <div className=\"space-y-16 md:space-y-24 pb-20 bg-[#FAF9F5]\" id=\"landing_page_viewport\">\n      \n      {/* 1. UPGRADED: SPLIT LTR/RTL SPLIT LAYOUT HERO */}\n      <section className=\"relative overflow-hidden bg-[#FAF9F5] border-b border-[#D5D5CD] py-14 md:py-24 px-4 sm:px-6 lg:px-8\">\n        <div className=\"max-w-7xl mx-auto\">\n          \n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n            \n            {/* LEFT COLUMN (55% on desktop): EDITORIAL TYPOGRAPHY */}\n            <div className=\"lg:col-span-7 space-y-6 md:space-y-8 text-left rtl:text-right\">\n              \n              <div className=\"space-y-3\">\n                <span className=\"inline-block px-3 py-1 bg-brand-primary/10 border border-brand-primary/25 text-[#0F6E56] text-xs font-mono font-bold uppercase tracking-wider\">\n                  {t(\'heroBadgeText\')}\n                </span>\n                \n                <h1 className=\"text-3xl sm:text-4xl md:text-5xl lg:text-5.5xl font-serif font-black text-gray-910 leading-[1.12] tracking-tight\">\n                  {t(\'heroTitle\')}\n                </h1>\n\n                <p className=\"text-sm sm:text-base text-gray-600 max-w-lg leading-relaxed rtl:leading-loose\">\n                  {t(\'heroSubtitle\')}\n                </p>\n              </div>\n\n              {/* Action buttons side-by-side */}\n              <div className=\"flex flex-wrap gap-3 select-none\">\n                <button \n                  onClick={() => navigate(\'/search\')}\n                  className=\"px-6 py-3.5 bg-brand-primary hover:bg-[#085041] hover:scale-[1.01] text-white font-mono text-[11px] font-bold uppercase tracking-wider transition cursor-pointer flex items-center gap-1.5 shadow-xs\"\n                >\n                  <span>{t(\'findProButton\')} \342\206\222</span>\n                </button>\n                <button \n                  onClick={() => navigate(\'/register\')}\n                  className=\"px-6 py-3.5 bg-white border border-[#CFCFC4] hover:bg-gray-50 text-gray-800 font-mono text-[11px] font-bold uppercase tracking-wider transition cursor-pointer\"\n                >\n                  <span>{t(\'joinAsProButton\')}</span>\n                </button>\n              </div>\n\n              {/* 3 small trust stats */}\n              <div className=\"pt-6 border-t border-[#EBEBE5] flex flex-wrap gap-6 items-center text-xs font-mono text-gray-500\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 bg-[#0F6E56]\"></span>\n                  <strong>{t(\'statPros\')}</strong>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 bg-[#0F6E56]\"></span>\n                  <strong>{t(\'statWilayas\')}</strong>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 bg-[#0F6E56]\"></span>\n                  <strong>{t(\'statBusinesses\')}</strong>\n                </div>\n              </div>\n\n            </div>\n\n            {/* RIGHT COLUMN (45% on desktop): FLOATING MINI-DASHBOARD CARD */}\n            <div className=\"lg:col-span-5 flex flex-col items-center\">\n              \n              <div className=\"w-full max-w-sm glass rounded-3xl p-6 shadow-classic relative text-left rtl:text-right space-y-5 hover:shadow-glow transition-all duration-300\">\n                \n                {/* Header state */}\n                <div className=\"flex justify-between items-center pb-3 border-b border-[#EBEBE5]\">\n                  <span className=\"text-[10px] font-mono text-gray-400 uppercase tracking-widest\">{t(\'heroConsultantCard\')}</span>\n                  <span className=\"px-2.5 py-0.5 bg-emerald-50 text-emerald-800 border border-emerald-200 text-[9px] font-mono uppercase font-black\">\n                    ONEC VERIFIED\n                  </span>\n                </div>\n\n                {/* Profile Snapshot */}\n                <div className=\"flex items-start gap-4\">\n                  <div className=\"w-12 h-12 bg-teal-50 text-[#0F6E56] font-bold shrink-0 flex items-center justify-center font-serif text-lg border border-teal-150\">\n                    SB\n                  </div>\n                  <div className=\"space-y-1\">\n                    <div className=\"flex items-center gap-1\">\n                      <h3 className=\"font-serif font-black text-gray-910 text-sm sm:text-base\">Sofiane Benamara</h3>\n                      <span className=\"text-emerald-600 font-bold\" title=\"Inscrit National Verified\">\342\234\223</span>\n                    </div>\n                    \n                    <p className=\"text-[11px] font-mono text-indigo-700 font-bold uppercase tracking-wider\">{tSpec(\'certified-accountant\')} \342\200\224 ONEC</p>\n                    <p className=\"text-[10px] text-gray-400 font-sans\">{t(\'fieldWilaya\').split(\' \')[0]} : Alger, Wilaya 16</p>\n                  </div>\n                </div>\n\n                {/* Stars and statistics */}\n                <div className=\"grid grid-cols-2 gap-4 border-y border-[#FAF9F5] py-3.5 text-xs text-gray-600 font-mono\">\n                  <div className=\"space-y-0.5\">\n                    <span className=\"text-[9px] text-gray-400 block uppercase\">{t(\'rating\')}</span>\n                    <span className=\"flex items-center gap-1 font-bold text-gray-900 leading-none\">\n                      <Star className=\"w-3.5 h-3.5 text-[#F59E0B] fill-[#F59E0B]\" /> 4.9 / 5.0\n                    </span>\n                  </div>\n                  <div className=\"space-y-0.5 border-l rtl:border-l-0 rtl:border-r border-gray-150 pl-3 rtl:pl-0 rtl:pr-3\">\n                    <span className=\"text-[9px] text-gray-400 block uppercase font-bold\">{t(\'seniority\')}</span>\n                    <span className=\"font-bold text-gray-950\">{t(\'seniorityYears\')}</span>\n                  </div>\n                </div>\n\n                {/* Pricing and Availability */}\n                <div className=\"flex justify-between items-center\">\n                  <div className=\"flex items-center gap-1 text-[11px] font-mono text-emerald-800 bg-emerald-50 border border-emerald-250 px-2.5 py-0.5\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse\"></span>\n                    <span>{t(\'availableImmediately\')}</span>\n                  </div>\n                  <span className=\"text-xs font-mono font-black text-gray-950\">{t(\'fortyFiveThousand\')}</span>\n                </div>\n\n                {/* CTA */}\n                <button\n                  type=\"button\"\n                  onClick={handleContactSofi}\n                  className=\"w-full py-2.5 bg-gray-910 text-white font-mono text-[10px] font-bold uppercase tracking-widest hover:bg-black transition cursor-pointer text-center\"\n                >\n                  {t(\'contactTheExpert\')}\n                </button>\n\n              </div>\n\n              {/* Small proof labels below card */}\n              <div className=\"flex flex-wrap justify-center items-center gap-4 mt-4 text-xs font-mono text-gray-400\">\n                <span className=\"flex items-center gap-1\">{t(\'verifiedOnec\')}</span>\n                <span className=\"flex items-center gap-1\">{t(\'certifiedDocs\')}</span>\n                <span className=\"flex items-center gap-1\">{t(\'securedContract\')}</span>\n              </div>\n\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      {/* 2. RESEARCH STATISTICS CAROUSEL */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"p-8 glass rounded-3xl border border-[#CFCFC4] grid grid-cols-1 md:grid-cols-4 gap-6 text-center shadow-classic\">\n          <div className=\"space-y-1\">\n            <span className=\"text-[9px] font-mono uppercase text-gray-450 block font-bold\">{t(\'nationalCoverage\')}</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-[#0F6E56]\">{t(\'nationalCoverageTitle\')}</p>\n            <p className=\"text-[10px] text-gray-400 font-sans\">{t(\'fromNorthToSouth\')}</p>\n          </div>\n          <div className=\"space-y-1 border-t md:border-t-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-[#E2E1D9] pt-4 md:pt-0\">\n            <span className=\"text-[9px] font-mono uppercase text-gray-450 block font-bold\">{t(\'nationalBoards\')}</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-gray-950\">ONEC & ONCC</p>\n            <p className=\"text-[10px] text-gray-400 font-sans\">{t(\'automaticCheckRequired\')}</p>\n          </div>\n          <div className=\"space-y-1 border-t md:border-t-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-[#E2E1D9] pt-4 md:pt-0\">\n            <span className=\"text-[9px] font-mono uppercase text-[#0F6E56] block font-bold\">{t(\'scfG50Compliance\')}</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-gray-950\">SCF & G50</p>\n            <p className=\"text-[10px] text-gray-400 font-sans\">{t(\'scfG50ComplianceSub\')}</p>\n          </div>\n          <div className=\"space-y-1 border-t md:border-t-0 border-[#E2E1D9] pt-4 md:pt-0\">\n            <span className=\"text-[9px] font-mono uppercase text-gray-450 block font-bold\">{t(\'certifiedAdmission\')}</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-gray-950\">Article 222 CP</p>\n            <p className=\"text-[10px] text-gray-400 font-sans\">{t(\'certifiedAdmissionSub\')}</p>\n          </div>\n        </div>\n      </section>\n\n      {/* 3. ASYMMETRIC SEARCH TERMINAL BLOCK */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"glass rounded-3xl border border-[#CFCFC4]/80 p-5.5 sm:p-7 shadow-classic relative overflow-hidden\">\n          <div className=\"absolute -top-3 left-4 rtl:left-auto rtl:right-4 bg-gray-950 px-2 py-0.5 text-[9px] font-mono text-[#E1F5EE] uppercase tracking-wider\">\n            {t(\'searchTerminalHeading\')}\n          </div>\n          \n          <form \n            onSubmit={handleSearchSubmit}\n            className=\"grid grid-cols-1 md:grid-cols-12 gap-3\"\n            id=\"hero_search_form\"\n          >\n            {/* Keyword Search Input */}\n            <div className=\"md:col-span-4 flex items-center gap-2 px-2.5 py-2 border border-[#EBEBE5] rounded-xl bg-white/50\">\n              <Search className=\"w-4 h-4 text-[#0F6E56] shrink-0\" />\n              <input \n                type=\"text\" \n                placeholder={t(\'searchPlaceholderInput\')}\n                value={keyword}\n                onChange={(e) => setKeyword(e.target.value)}\n                className=\"w-full text-xs text-gray-850 bg-transparent focus:outline-none placeholder-gray-400\"\n              />\n            </div>\n\n            {/* Wilaya Picker */}\n            <div className=\"md:col-span-3 flex items-center gap-1.5 px-2.5 py-2 border border-[#EBEBE5] rounded-xl bg-white/50\">\n              <MapPin className=\"w-3.5 h-3.5 text-[#0F6E56] shrink-0\" />\n              <select\n                value={selectedWilaya}\n                onChange={(e) => setSelectedWilaya(e.target.value)}\n                className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none cursor-pointer font-serif\"\n              >\n                <option value=\"0\">{t(\'allWilayasLabel\')}</option>\n                {algerianWilayas.map((w) => (\n                  <option key={w.id} value={w.id}>{w.code} - {w.name.fr} ({w.name.ar})</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Specialty Dropdown */}\n            <div className=\"md:col-span-3 flex items-center gap-1.5 px-2.5 py-2 border border-[#EBEBE5] rounded-xl bg-white/50\">\n              <span className=\"text-xs shrink-0 select-none\">\360\237\222\274</span>\n              <select\n                value={selectedSpecialty}\n                onChange={(e) => setSelectedSpecialty(e.target.value)}\n                className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none cursor-pointer\"\n                id=\"landing_specialty_select\"\n              >\n                <option value=\"\">{t(\'allSpecialties\')}</option>\n                {specialtiesList.map((s) => (\n                  <option key={s.key} value={s.key}>{tSpec(s.key)}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Direct Action */}\n            <button \n              type=\"submit\"\n              className=\"md:col-span-2 w-full py-2 bg-brand-primary hover:bg-[#085041] hover:scale-[1.01] text-white text-[10px] font-mono uppercase tracking-widest transition cursor-pointer flex items-center justify-center gap-1 font-bold rounded-xl\"\n            >\n              <span>{t(\'searchBtnText\')}</span>\n              {direction === \'rtl\' ? <ArrowLeft className=\"w-3.5 h-3.5\" /> : <ArrowRight className=\"w-3.5 h-3.5\" />}\n            </button>\n          </form>\n        </div>\n      </section>\n\n      {/* 4. FEATURED COMPTABLES AND AUDITORS */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-10 text-left rtl:text-right\">\n          <div>\n            <span className=\"text-[10px] font-mono uppercase tracking-wider text-gray-400\">AccorNet Directory</span>\n            <h2 className=\"text-2xl sm:text-3xl font-serif font-semibold text-gray-950 tracking-tight mt-1\">\n              {t(\'featuredProsHeading\')}\n            </h2>\n          </div>\n          <p className=\"text-xs sm:text-sm text-gray-500 max-w-lg leading-relaxed\">\n            {t(\'featuredProsSub\')}\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {featuredPros.map((pro) => (\n            <ProfessionalCard key={pro.id} professional={pro} />\n          ))}\n        </div>\n      </section>\n\n      {/* 5. EDITORIAL ALGERIAN TESTIMONIALS SECTION */}\n      <section className=\"bg-white border-y border-[#CFCFC4] py-16 md:py-20\" id=\"testimonials_editorial_block\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n          \n          <div className=\"text-center space-y-3 max-w-2xl mx-auto\">\n            <span className=\"text-[10px] font-mono text-indigo-700 uppercase tracking-widest block font-bold\">{t(\'feedbackLocalEntities\')}</span>\n            <h2 className=\"text-2xl sm:text-3xl font-serif font-semibold text-gray-950 tracking-tight\">\n              {t(\'testimonialsEditoHeading\')}\n            </h2>\n            <p className=\"text-xs text-gray-500 font-sans leading-relaxed\">\n              {t(\'testimonialsEditoSub\')}\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-6\">\n            {algerianEditorialTestimonials.map((test, index) => (\n              <div \n                key={index}\n                className=\"glass rounded-2xl hover:border-brand-primary p-6 space-y-4 text-left rtl:text-right flex flex-col justify-between shadow-classic hover:shadow-glow transition-all duration-300\"\n              >\n                <div className=\"space-y-3\">\n                  <div className=\"flex justify-between items-center pb-2 border-b border-gray-150\">\n                    <span className=\"text-[10px] font-mono text-gray-400 uppercase tracking-widest font-bold\">\n                      {test.type}\n                    </span>\n                    <span className=\"px-2 py-0.5 bg-[#E1F5EE] border border-emerald-150 text-[#0F6E56] text-[8px] font-mono\">\n                      {test.location} / {test.needed}\n                    </span>\n                  </div>\n\n                  <p className=\"text-gray-700 text-xs leading-relaxed italic\">\n                    \"{language === \'ar\' ? test.quoteAR : test.quoteFR}\"\n                  </p>\n                </div>\n\n                <div className=\"flex items-center gap-2.5 pt-3 border-t border-gray-150/50\">\n                  <div className=\"w-7 h-7 bg-brand-primary text-white font-serif font-black flex items-center justify-center text-xs\">\n                    {test.author[0]}\n                  </div>\n                  <div>\n                    <h4 className=\"font-serif font-bold text-gray-901 text-xs\">{test.author}</h4>\n                    <p className=\"text-[8px] text-gray-400 font-mono\">{t(\'verifiedContractLabel\')}</p>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n\n        </div>\n      </section>\n\n      {/* 6. IMMERSIVE SANDBOX DECORATOR */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-[#0B1A16] text-white p-8 sm:p-12 border border-[#0F6E56]/40 rounded-3xl relative overflow-hidden shadow-2xl\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10\">\n            \n            <div className=\"lg:col-span-6 space-y-4 text-left rtl:text-right\">\n              <span className=\"px-2.5 py-0.5 bg-brand-accent/20 border border-brand-accent/45 text-brand-accent text-[9px] font-mono uppercase tracking-wider\">\n                {t(\'sandboxHeading\')}\n              </span>\n              <h2 className=\"text-2xl sm:text-3xl font-serif font-bold tracking-tight\">\n                {t(\'sandboxMainHeading\')}\n              </h2>\n              <p className=\"text-gray-300 text-xs leading-relaxed font-sans\">\n                {t(\'sandboxSubHeading\')}\n              </p>\n              <button \n                onClick={() => navigate(\'/tools\')}\n                className=\"px-5 py-3 bg-[#0F6E56] hover:bg-[#085041] border border-transparent text-white text-[10px] uppercase font-mono font-bold tracking-widest transition cursor-pointer rounded-xl\"\n              >\n                {t(\'sandboxButton\')}\n              </button>\n            </div>\n\n            <div className=\"lg:col-span-6 glass-dark p-6 rounded-2xl space-y-4\">\n              <div className=\"flex items-center gap-11 text-xs text-[#E1F5EE] border-b border-white/10 pb-2\">\n                <span className=\"font-mono\">{t(\'widgetSmeHeading\')}</span>\n                <span className=\"text-[9px] bg-white/10 px-1 text-gray-300 font-mono\">{t(\'sandboxActiveLabel\')}</span>\n              </div>\n              \n              <div className=\"font-mono text-[11px] text-gray-300 space-y-1.5 leading-normal\">\n                <p>\360\237\222\241 <span className=\"font-bold\">{t(\'baseTapText\').split(\' : \')[0]} :</span> {t(\'baseTapText\').split(\' : \')[1] || t(\'baseTapText\')}</p>\n                <p>\360\237\223\212 <span className=\"font-bold\">{t(\'vtaStandardText\').split(\' : \')[0]} :</span> {t(\'vtaStandardText\').split(\' : \')[1] || t(\'vtaStandardText\')}</p>\n                <p>\360\237\223\211 <span className=\"font-bold\">{t(\'penaltyText\').split(\' : \')[0]} :</span> {t(\'penaltyText\').split(\' : \')[1] || t(\'penaltyText\')}</p>\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n    </div>\n  );\n};"
      replacement_content: "  return (\n    <div className=\"space-y-16 md:space-y-24 pb-24 bg-[#0B1020] text-slate-100\" id=\"landing_page_viewport\">\n      \n      {/* 1. LUXURIOUS ASYMMETRIC FINTECH HERO */}\n      <section className=\"relative overflow-hidden pt-12 pb-20 md:py-32 px-4 sm:px-6 lg:px-8 border-b border-white/5\">\n        {/* Subtle Neon Glow effect */}\n        <div className=\"absolute top-0 left-1/4 -translate-x-1/2 w-96 h-96 bg-brand-primary/10 rounded-full blur-[120px] pointer-events-none\"></div>\n        <div className=\"absolute top-1/3 right-10 w-80 h-80 bg-indigo-505/10 rounded-full blur-[100px] pointer-events-none\"></div>\n        \n        <div className=\"max-w-7xl mx-auto relative z-10\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-16 items-center\">\n            \n            {/* LEFT COLUMN (55%): EDITORIAL TYPOGRAPHY */}\n            <div className=\"lg:col-span-7 space-y-6 md:space-y-8 text-left rtl:text-right\">\n              \n              <div className=\"space-y-4\">\n                <span className=\"inline-flex items-center gap-1.5 px-3 py-1 bg-brand-primary/10 border border-brand-primary/25 rounded-md text-brand-primary text-[10px] font-mono font-bold uppercase tracking-wider\">\n                  <Sparkles className=\"w-3 h-3 text-brand-primary animate-pulse\" />\n                  {t(\'heroBadgeText\')}\n                </span>\n                \n                <h1 className=\"text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif font-black text-white leading-[1.15] tracking-tight\">\n                  {t(\'heroTitle\')}\n                </h1>\n\n                <p className=\"text-sm sm:text-base text-slate-400 max-w-xl leading-relaxed rtl:leading-loose\">\n                  {t(\'heroSubtitle\')}\n                </p>\n              </div>\n\n              {/* Action buttons side-by-side */}\n              <div className=\"flex flex-wrap gap-4 select-none\">\n                <button \n                  onClick={() => navigate(\'/search\')}\n                  className=\"px-5 py-3.5 bg-brand-primary hover:bg-brand-dark hover:shadow-glow text-slate-950 font-mono text-[11px] font-bold uppercase tracking-wider transition-all duration-200 cursor-pointer flex items-center gap-1.5 rounded-lg\"\n                >\n                  <span>{t(\'findProButton\')}</span>\n                  {direction === \'rtl\' ? <ArrowLeft className=\"w-3.5 h-3.5\" /> : <ArrowRight className=\"w-3.5 h-3.5\" />}\n                </button>\n                <button \n                  onClick={() => navigate(\'/register\')}\n                  className=\"px-5 py-3.5 bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 text-slate-200 font-mono text-[11px] font-bold uppercase tracking-wider transition-all duration-200 cursor-pointer rounded-lg\"\n                >\n                  <span>{t(\'joinAsProButton\')}</span>\n                </button>\n              </div>\n\n              {/* Verified Trust stats with linear decoration */}\n              <div className=\"pt-8 border-t border-white/5 flex flex-wrap gap-6 items-center text-xs font-mono text-slate-400\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-brand-primary\"></span>\n                  <strong>{t(\'statPros\')}</strong>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-brand-primary\"></span>\n                  <strong>{t(\'statWilayas\')}</strong>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-brand-primary\"></span>\n                  <strong>{t(\'statBusinesses\')}</strong>\n                </div>\n              </div>\n\n            </div>\n\n            {/* RIGHT COLUMN (45%): PREMIUM COMPTABLE CARD HIGHLIGHT */}\n            <div className=\"lg:col-span-5 flex flex-col items-center\">\n              \n              <div className=\"w-full max-w-sm glass border border-white/10 rounded-2xl p-6 shadow-glow relative text-left rtl:text-right space-y-6 hover:border-brand-primary/20 transition-all duration-300\">\n                \n                {/* Header state */}\n                <div className=\"flex justify-between items-center pb-3 border-b border-white/5\">\n                  <span className=\"text-[9px] font-mono text-slate-400 uppercase tracking-widest\">{t(\'heroConsultantCard\')}</span>\n                  <span className=\"px-2.5 py-0.5 bg-teal-500/10 text-brand-primary border border-brand-primary/20 text-[9px] font-mono uppercase font-black rounded-md\">\n                    ONEC VERIFIED\n                  </span>\n                </div>\n\n                {/* Profile Snapshot */}\n                <div className=\"flex items-start gap-4\">\n                  <div className=\"w-12 h-12 bg-[#151C31] text-brand-primary font-bold shrink-0 flex items-center justify-center font-serif text-lg border border-white/10 rounded-xl\">\n                    SB\n                  </div>\n                  <div className=\"space-y-1\">\n                    <div className=\"flex items-center gap-1.5\">\n                      <h3 className=\"font-serif font-black text-white text-sm sm:text-base\">Sofiane Benamara</h3>\n                      <span className=\"text-brand-primary font-bold text-xs\" title=\"Inscrit National Verified\">\342\234\223</span>\n                    </div>\n                    \n                    <p className=\"text-[10px] font-mono text-brand-primary font-bold uppercase tracking-wider\">{tSpec(\'certified-accountant\')} \342\200\224 ONEC</p>\n                    <p className=\"text-[10px] text-slate-400 font-sans\">{t(\'fieldWilaya\').split(\' \')[0]} : Alger, Wilaya 16</p>\n                  </div>\n                </div>\n\n                {/* Stars and statistics */}\n                <div className=\"grid grid-cols-2 gap-4 border-y border-white/5 py-4 text-xs text-slate-300 font-mono\">\n                  <div className=\"space-y-0.5\">\n                    <span className=\"text-[9px] text-slate-500 block uppercase\">{t(\'rating\')}</span>\n                    <span className=\"flex items-center gap-1 font-bold text-white leading-none\">\n                      <Star className=\"w-3.5 h-3.5 text-amber-500 fill-amber-500\" /> 4.9 / 5.0\n                    </span>\n                  </div>\n                  <div className=\"space-y-0.5 border-l rtl:border-l-0 rtl:border-r border-white/5 pl-3 rtl:pl-0 rtl:pr-3\">\n                    <span className=\"text-[9px] text-slate-500 block uppercase font-bold\">{t(\'seniority\')}</span>\n                    <span className=\"font-bold text-white\">{t(\'seniorityYears\')}</span>\n                  </div>\n                </div>\n\n                {/* Pricing and Availability */}\n                <div className=\"flex justify-between items-center\">\n                  <div className=\"flex items-center gap-1.5 text-[10px] font-mono text-brand-primary bg-brand-primary/10 border border-brand-primary/20 px-2.5 py-1 rounded-md\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-brand-primary animate-pulse\"></span>\n                    <span>{t(\'availableImmediately\')}</span>\n                  </div>\n                  <span className=\"text-xs font-mono font-black text-white\">{t(\'fortyFiveThousand\')}</span>\n                </div>\n\n                {/* CTA */}\n                <button\n                  type=\"button\"\n                  onClick={handleContactSofi}\n                  className=\"w-full py-2.5 bg-brand-primary hover:bg-brand-dark hover:shadow-glow text-slate-950 font-mono text-[10px] font-bold uppercase tracking-widest transition-all duration-200 rounded-lg cursor-pointer text-center\"\n                >\n                  {t(\'contactTheExpert\')}\n                </button>\n\n              </div>\n\n              {/* Trust labels below hero card */}\n              <div className=\"flex flex-wrap justify-center items-center gap-4 mt-5 text-[10px] font-mono text-slate-500\">\n                <span className=\"flex items-center gap-1\">\342\234\223 {t(\'verifiedOnec\')}</span>\n                <span className=\"flex items-center gap-1\">\342\234\223 {t(\'certifiedDocs\')}</span>\n                <span className=\"flex items-center gap-1\">\342\234\223 {t(\'securedContract\')}</span>\n              </div>\n\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* 2. RESEARCH STATISTICS BOARD - NO BEIGE - DEEP FINTECH SURFACES */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"p-8 bg-[#12182B] border border-white/5 rounded-2xl grid grid-cols-1 md:grid-cols-4 gap-6 text-center shadow-classic\">\n          <div className=\"space-y-1.5\">\n            <span className=\"text-[9px] font-mono uppercase text-slate-400 block font-bold tracking-wider\">{t(\'nationalCoverage\')}</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-brand-primary\">{t(\'nationalCoverageTitle\')}</p>\n            <p className=\"text-[10px] text-slate-500 font-sans\">{t(\'fromNorthToSouth\')}</p>\n          </div>\n          <div className=\"space-y-1.5 border-t md:border-t-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-white/5 pt-4 md:pt-0\">\n            <span className=\"text-[9px] font-mono uppercase text-slate-400 block font-bold tracking-wider\">{t(\'nationalBoards\')}</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-white\">ONEC & ONCC</p>\n            <p className=\"text-[10px] text-slate-500 font-sans\">{t(\'automaticCheckRequired\')}</p>\n          </div>\n          <div className=\"space-y-1.5 border-t md:border-t-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-white/5 pt-4 md:pt-0\">\n            <span className=\"text-[9px] font-mono uppercase text-brand-primary block font-bold tracking-wider\">{t(\'scfG50Compliance\')}</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-white\">SCF & G50</p>\n            <p className=\"text-[10px] text-slate-500 font-sans\">{t(\'scfG50ComplianceSub\')}</p>\n          </div>\n          <div className=\"space-y-1.5 border-t md:border-t-0 border-white/5 pt-4 md:pt-0\">\n            <span className=\"text-[9px] font-mono uppercase text-slate-400 block font-bold tracking-wider\">{t(\'certifiedAdmission\')}</span>\n            <p className=\"text-2xl sm:text-3xl font-serif font-black text-white\">Article 222 CP</p>\n            <p className=\"text-[10px] text-slate-500 font-sans\">{t(\'certifiedAdmissionSub\')}</p>\n          </div>\n        </div>\n      </section>\n\n      {/* 3. PREMIUM MINIMAL SEARCH TERMINAL BAR */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"glass border border-white/10 p-5 sm:p-6 rounded-2xl shadow-glow relative overflow-hidden backdrop-blur-md\">\n          <div className=\"absolute top-0 right-10 w-48 h-48 bg-brand-primary/5 rounded-full blur-[80px] pointer-events-none\"></div>\n          \n          <form \n            onSubmit={handleSearchSubmit}\n            className=\"grid grid-cols-1 md:grid-cols-12 gap-4 relative z-10\"\n            id=\"hero_search_form\"\n          >\n            {/* Keyword Search Input */}\n            <div className=\"md:col-span-4 flex items-center gap-2 px-3 py-2 border border-white/10 rounded-xl bg-slate-900/40\">\n              <Search className=\"w-4 h-4 text-brand-primary shrink-0\" />\n              <input \n                type=\"text\" \n                placeholder={t(\'searchPlaceholderInput\')}\n                value={keyword}\n                onChange={(e) => setKeyword(e.target.value)}\n                className=\"w-full text-xs text-white bg-transparent focus:outline-none placeholder-slate-500\"\n              />\n            </div>\n\n            {/* Wilaya Picker */}\n            <div className=\"md:col-span-3 flex items-center gap-1.5 px-3 py-2 border border-white/10 rounded-xl bg-slate-900/40\">\n              <MapPin className=\"w-3.5 h-3.5 text-brand-primary shrink-0\" />\n              <select\n                value={selectedWilaya}\n                onChange={(e) => setSelectedWilaya(e.target.value)}\n                className=\"w-full text-xs text-slate-350 bg-transparent focus:outline-none cursor-pointer\"\n              >\n                <option value=\"0\" className=\"bg-[#12182B] text-white\">{t(\'allWilayasLabel\')}</option>\n                {algerianWilayas.map((w) => (\n                  <option key={w.id} value={w.id} className=\"bg-[#12182B] text-white\">{w.code} - {w.name.fr} ({w.name.ar})</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Specialty Dropdown */}\n            <div className=\"md:col-span-3 flex items-center gap-1.5 px-3 py-2 border border-white/10 rounded-xl bg-slate-900/40\">\n              <span className=\"text-xs shrink-0 select-none\">\360\237\222\274</span>\n              <select\n                value={selectedSpecialty}\n                onChange={(e) => setSelectedSpecialty(e.target.value)}\n                className=\"w-full text-xs text-slate-350 bg-transparent focus:outline-none cursor-pointer\"\n              >\n                <option value=\"\" className=\"bg-[#12182B] text-white\">{t(\'allSpecialties\')}</option>\n                {specialtiesList.map((s) => (\n                  <option key={s.key} value={s.key} className=\"bg-[#12182B] text-white\">{tSpec(s.key)}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Direct Action */}\n            <button \n              type=\"submit\"\n              className=\"md:col-span-2 w-full py-2 bg-brand-primary hover:bg-brand-dark text-slate-950 text-[10px] font-mono uppercase tracking-widest transition duration-205 cursor-pointer flex items-center justify-center gap-1.5 font-bold rounded-xl\"\n            >\n              <span>{t(\'searchBtnText\')}</span>\n              {direction === \'rtl\' ? <ArrowLeft className=\"w-3.5 h-3.5\" /> : <ArrowRight className=\"w-3.5 h-3.5\" />}\n            </button>\n          </form>\n        </div>\n      </section>\n\n      {/* 4. FEATURED COMPTABLES AND AUDITORS */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-10 text-left rtl:text-right\">\n          <div>\n            <span className=\"text-[10px] font-mono uppercase tracking-wider text-brand-primary\">AccoNet Directory</span>\n            <h2 className=\"text-2xl sm:text-3xl font-serif font-black text-white tracking-tight mt-1\">\n              {t(\'featuredProsHeading\')}\n            </h2>\n          </div>\n          <p className=\"text-xs sm:text-sm text-slate-400 max-w-lg leading-relaxed\">\n            {t(\'featuredProsSub\')}\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {featuredPros.map((pro) => (\n            <ProfessionalCard key={pro.id} professional={pro} />\n          ))}\n        </div>\n      </section>\n\n      {/* 5. EDITORIAL ALGERIAN TESTIMONIALS SECTION - PREMIUM DARK SURFACE */}\n      <section className=\"bg-[#12182B] border-y border-white/5 py-16 md:py-24\" id=\"testimonials_editorial_block\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12\">\n          \n          <div className=\"text-center space-y-3 max-w-2xl mx-auto\">\n            <span className=\"text-[10px] font-mono text-brand-primary uppercase tracking-widest block font-bold\">{t(\'feedbackLocalEntities\')}</span>\n            <h2 className=\"text-2xl sm:text-3xl font-serif font-black text-white tracking-tight\">\n              {t(\'testimonialsEditoHeading\')}\n            </h2>\n            <p className=\"text-xs text-slate-400 font-sans leading-relaxed\">\n              {t(\'testimonialsEditoSub\')}\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-6\">\n            {algerianEditorialTestimonials.map((test, index) => (\n              <div \n                key={index}\n                className=\"bg-[#151C31] border border-white/5 hover:border-brand-primary/20 rounded-xl p-6 space-y-5 text-left rtl:text-right flex flex-col justify-between shadow-classic hover:shadow-glow transition-all duration-300\"\n              >\n                <div className=\"space-y-4\">\n                  <div className=\"flex justify-between items-center pb-2 border-b border-white/5\">\n                    <span className=\"text-[10px] font-mono text-slate-400 uppercase tracking-widest font-bold\">\n                      {test.type}\n                    </span>\n                    <span className=\"px-2 py-0.5 bg-brand-primary/10 border border-brand-primary/20 text-brand-primary text-[8px] font-mono rounded\">\n                      {test.location}\n                    </span>\n                  </div>\n\n                  <p className=\"text-slate-300 text-xs leading-relaxed italic\">\n                    \"{language === \'ar\' ? test.quoteAR : test.quoteFR}\"\n                  </p>\n                </div>\n\n                <div className=\"flex items-center gap-2.5 pt-4 border-t border-white/5\">\n                  <div className=\"w-8 h-8 rounded-lg bg-brand-primary/20 text-brand-primary font-serif font-black flex items-center justify-center text-xs border border-brand-primary/25\">\n                    {test.author[0]}\n                  </div>\n                  <div>\n                    <h4 className=\"font-serif font-bold text-slate-200 text-xs\">{test.author}</h4>\n                    <p className=\"text-[8px] text-slate-500 font-mono uppercase tracking-wider\">{test.needed}</p>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n\n        </div>\n      </section>\n\n      {/* 6. IMMERSIVE SANDBOX DECORATOR */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-[#12182B] text-white p-8 sm:p-12 border border-white/5 rounded-2xl relative overflow-hidden shadow-2xl\">\n          <div className=\"absolute top-0 right-1/4 -translate-y-1/2 w-64 h-64 bg-brand-primary/10 rounded-full blur-[90px] pointer-events-none\"></div>\n          \n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10\">\n            \n            <div className=\"lg:col-span-6 space-y-5 text-left rtl:text-right\">\n              <span className=\"inline-block px-2.5 py-0.5 bg-amber-500/10 border border-amber-500/25 text-amber-400 text-[9px] font-mono uppercase tracking-wider rounded\">\n                {t(\'sandboxHeading\')}\n              </span>\n              <h2 className=\"text-2xl sm:text-3xl font-serif font-black tracking-tight\">\n                {t(\'sandboxMainHeading\')}\n              </h2>\n              <p className=\"text-slate-400 text-xs leading-relaxed font-sans\">\n                {t(\'sandboxSubHeading\')}\n              </p>\n              <button \n                onClick={() => navigate(\'/tools\')}\n                className=\"px-5 py-3.5 bg-brand-primary text-slate-950 hover:bg-brand-dark hover:shadow-glow text-[10px] uppercase font-mono font-bold tracking-widest transition duration-150 cursor-pointer rounded-lg\"\n              >\n                {t(\'sandboxButton\')}\n              </button>\n            </div>\n\n            <div className=\"lg:col-span-6 glass-dark p-6 rounded-xl space-y-4 border border-white/5\">\n              <div className=\"flex items-center justify-between text-xs text-brand-primary border-b border-white/5 pb-2\">\n                <span className=\"font-mono tracking-wider\">{t(\'widgetSmeHeading\')}</span>\n                <span className=\"text-[9px] bg-brand-primary/10 border border-brand-primary/20 px-1.5 text-brand-primary rounded font-mono uppercase\">{t(\'sandboxActiveLabel\')}</span>\n              </div>\n              \n              <div className=\"font-mono text-[11px] text-slate-350 space-y-2 leading-normal\">\n                <p>\360\237\222\241 <span className=\"font-bold text-white\">{t(\'baseTapText\').split(\' : \')[0]} :</span> {t(\'baseTapText\').split(\' : \')[1] || t(\'baseTapText\')}</p>\n                <p>\360\237\223\212 <span className=\"font-bold text-white\">{t(\'vtaStandardText\').split(\' : \')[0]} :</span> {t(\'vtaStandardText\').split(\' : \')[1] || t(\'vtaStandardText\')}</p>\n                <p>\360\237\223\211 <span className=\"font-bold text-white\">{t(\'penaltyText\').split(\' : \')[0]} :</span> {t(\'penaltyText\').split(\' : \')[1] || t(\'penaltyText\')}</p>\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n    </div>\n  );\n};"
    }
    instruction: "Redesign Landing.tsx to integrate a premium dark-fintech visual identity with glow accents and refined editorial typography"
  }
}
