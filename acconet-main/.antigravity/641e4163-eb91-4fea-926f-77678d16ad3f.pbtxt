        lines {
          text: "    ar: \"\330\261\331\201\330\271 \330\247\331\204\331\201\331\210\330\247\330\252\331\212\330\261 \330\250\330\247\331\204\331\204\330\272\330\251 \330\247\331\204\330\271\330\261\330\250\331\212\330\251 \330\243\331\210 \330\247\331\204\331\201\330\261\331\206\330\263\331\212\330\251 \331\204\331\212\331\202\331\210\331\205 \330\247\331\204\330\260\331\203\330\247\330\241 \330\247\331\204\330\247\330\265\330\267\331\206\330\247\330\271\331\212 \330\250\330\247\330\263\330\252\330\256\330\261\330\247\330\254 \330\247\331\204\330\247\330\263\331\205\330\214 NIF\330\214 \331\210\331\205\330\271\330\257\331\204 TVA \331\210\330\253\330\250\330\252\331\207\330\247 \331\201\331\210\330\261\331\212\330\247\331\213.\","
