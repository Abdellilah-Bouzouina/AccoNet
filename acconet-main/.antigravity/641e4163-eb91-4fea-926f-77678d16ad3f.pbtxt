  file_change {
    absolute_path_uri: "file:///src/pages/ProfessionalDashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useApp } from \'../context/AppContext\';\nimport { \n  Briefcase, Users, DollarSign, Star, Calendar, \n  CheckSquare, ArrowUpRight, TrendingUp, RefreshCw, Layers \n} from \'lucide-react\';\nimport { clients } from \'../data/mockData\';\n\nexport const ProfessionalDashboard: React.FC = () => {\n  const { t, tObj, tSpec } = useLanguage();\n  const { \n    currentProfessional, contracts, tasks, \n    updateTaskStatus \n  } = useApp();\n\n  // Active inbox tab filters: Todo, In-Progress, Done\n  const [activeTaskTab, setActiveTaskTab] = useState<\'todo\' | \'in-progress\' | \'done\'>(\'todo\');\n\n  const pro = currentProfessional || {\n    id: \"p1\",\n    name: { ar: \"\330\263\331\201\331\212\330\247\331\206 \330\250\331\206 \330\271\331\205\330\247\330\261\", fr: \"Sofiane Benamara\", en: \"Sofiane Benamara\" },\n    specialty: \"certified-accountant\",\n    rating: 4.9,\n    accreditationNumber: \"CNEC/2012/948\"\n  };\n\n  // Filter lists for our current simulated professional (\'p1\' or \'p2\')\n  const proContracts = contracts.filter((c) => c.professionalId === pro.id);\n  const activeContractIds = proContracts.map((c) => c.id);\n  const proTasks = tasks.filter((tk) => activeContractIds.includes(tk.contractId));\n\n  // Count metrics\n  const activeClientsCount = new Set(proContracts.map((c) => c.clientId)).size;\n  const pendingTasksList = proTasks.filter((tk) => tk.status === activeTaskTab);\n\n  const totalEarnings = proContracts.reduce((sum, c) => sum + (c.status === \'active\' ? c.value / 12 : 0), 0); // Simulated monthly yield\n\n  // Mock earnings progression dataset\n  const monthlyEarningsProgress = [\n    { month: \"Jan 2026\", value: 140000, max: 250000 },\n    { month: \"Feb 2026\", value: 180000, max: 250000 },\n    { month: \"Mar 2026\", value: 215000, max: 250000 },\n    { month: \"Apr 2026\", value: 245000, max: 250000 },\n    { month: \"May 2026\", value: Math.round(totalEarnings) || 250000, max: 250000, active: true },\n  ];\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\" id=\"pro_dashboard_view\">\n      \n      {/* Welcome Header */}\n      <div className=\"bg-gradient-to-r from-teal-950/90 to-brand-primary border border-brand-primary/40 rounded-3xl p-6 sm:p-8 mb-8 text-white\">\n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n          <div className=\"space-y-1\">\n            <span className=\"text-[10px] font-bold text-brand-accent uppercase tracking-widest font-mono\">\n              ALGERE COMPLIANCE CABINET WORKSPACE\n            </span>\n            <h1 className=\"text-2xl font-extrabold font-sans tracking-tight leading-tight\">\n              {t(\'proWelcome\')} <span className=\"text-brand-accent\">{tObj(pro.name)}</span>\n            </h1>\n            <p className=\"text-xs text-teal-200\">\n              {tSpec(pro.specialty)} \342\200\242 Accredited Registration: <span className=\"font-mono text-brand-accent font-bold\">{pro.accreditationNumber}</span>\n            </p>\n          </div>\n\n          <div className=\"px-4 py-2 bg-white/10 rounded-2xl flex items-center gap-2 border border-white/15\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-brand-accent animate-ping\"></span>\n            <span className=\"text-xs font-semibold text-brand-light\">Cabinets Active Control Deck</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Stats row */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8\">\n        \n        {/* Active Clients */}\n        <div className=\"bg-white border border-gray-150 p-6 rounded-2xl shadow-3xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 bg-teal-50 text-brand-primary rounded-xl flex items-center justify-center shrink-0\">\n            <Users className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-bold text-gray-400 uppercase leading-none\">{t(\'proStatsClients\')}</p>\n            <p className=\"text-2xl font-black text-brand-primary font-mono mt-1\">{activeClientsCount}</p>\n          </div>\n        </div>\n\n        {/* Total Tasks Pending */}\n        <div className=\"bg-white border border-gray-150 p-6 rounded-2xl shadow-3xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 bg-amber-50 text-brand-accent rounded-xl flex items-center justify-center shrink-0\">\n            <CheckSquare className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-bold text-gray-400 uppercase leading-none\">Global Tasks Attached</p>\n            <p className=\"text-2xl font-black text-brand-accent font-mono mt-1\">\n              {proTasks.filter((t) => t.status !== \'done\').length}\n            </p>\n          </div>\n        </div>\n\n        {/* Monthly Earnings Estimate */}\n        <div className=\"bg-white border border-gray-150 p-6 rounded-2xl shadow-3xs flex items-center gap-4 col-span-1\">\n          <div className=\"w-12 h-12 bg-indigo-50 text-indigo-700 rounded-xl flex items-center justify-center shrink-0\">\n            <DollarSign className=\"w-6 h-6\" />\n          </div>\n          <div className=\"flex-1\">\n            <p className=\"text-[10px] font-bold text-gray-400 uppercase leading-none\">{t(\'proStatsEarnings\')}</p>\n            <p className=\"text-[17px] font-black text-indigo-700 font-mono mt-1\">\n              {Math.round(totalEarnings).toLocaleString()} DZD\n            </p>\n          </div>\n        </div>\n\n        {/* Direct Peer Rating */}\n        <div className=\"bg-white border border-gray-150 p-6 rounded-2xl shadow-3xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 bg-amber-50 text-brand-accent rounded-xl flex items-center justify-center shrink-0\">\n            <Star className=\"w-6 h-6 fill-brand-accent text-brand-accent\" />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-bold text-gray-400 uppercase leading-none\">AccoNet Approved Rating</p>\n            <p className=\"text-2xl font-black text-gray-950 font-mono mt-1\">{pro.rating}</p>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Grid Layout panels */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* Left column (col-span-8) - Task inbox, customizable tabs */}\n        <div className=\"lg:col-span-8 space-y-6\">\n          \n          {/* Detailed Task Inbox Board */}\n          <div className=\"bg-white border border-gray-150 rounded-2xl p-6 shadow-xs space-y-6\">\n            \n            <div className=\"flex flex-col sm:flex-row justify-between sm:items-center gap-4\">\n              <h2 className=\"font-bold text-gray-950 text-sm flex items-center gap-2\">\n                <Briefcase className=\"w-4.5 h-4.5 text-brand-primary\" />\n                {t(\'taskInboxTitle\')}\n              </h2>\n\n              {/* Task statuses interactive switcher triggers */}\n              <div className=\"flex bg-gray-50 border border-gray-200 rounded-xl p-1 text-xs self-start\">\n                <button\n                  onClick={() => setActiveTaskTab(\'todo\')}\n                  className={`px-3 py-1.5 rounded-lg cursor-pointer transition font-bold uppercase ${activeTaskTab === \'todo\' ? \'bg-white text-brand-primary shadow-xs\' : \'text-gray-500 hover:text-gray-900\'}`}\n                >\n                  Todo ({proTasks.filter((t) => t.status === \'todo\').length})\n                </button>\n                <button\n                  onClick={() => setActiveTaskTab(\'in-progress\')}\n                  className={`px-3 py-1.5 rounded-lg cursor-pointer transition font-bold uppercase ${activeTaskTab === \'in-progress\' ? \'bg-white text-brand-primary shadow-xs\' : \'text-gray-500 hover:text-gray-900\'}`}\n                >\n                  In Progress ({proTasks.filter((t) => t.status === \'in-progress\').length})\n                </button>\n                <button\n                  onClick={() => setActiveTaskTab(\'done\')}\n                  className={`px-3 py-1.5 rounded-lg cursor-pointer transition font-bold uppercase ${activeTaskTab === \'done\' ? \'bg-white text-brand-primary shadow-xs\' : \'text-gray-500 hover:text-gray-900\'}`}\n                >\n                  Done ({proTasks.filter((t) => t.status === \'done\').length})\n                </button>\n              </div>\n            </div>\n\n            {/* Task list container */}\n            <div className=\"space-y-3\">\n              {pendingTasksList.length > 0 ? (\n                pendingTasksList.map((tk) => {\n                  const clientInfo = clients.find((c) => c.activeContracts.includes(tk.contractId));\n                  return (\n                    <div \n                      key={tk.id}\n                      className=\"border border-gray-150 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-gray-55/40 hover:border-brand-primary/40 transition\"\n                    >\n                      <div className=\"space-y-1.5\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"text-[9px] uppercase font-bold px-1.5 py-0.5 rounded bg-white border border-gray-250 text-gray-500 font-mono\">\n                            {tk.type}\n                          </span>\n                          {clientInfo && (\n                            <span className=\"text-[10px] text-brand-primary font-bold\">\n                              \360\237\217\242 {clientInfo.companyName}\n                            </span>\n                          )}\n                        </div>\n\n                        <p className=\"text-xs font-bold text-gray-900\">\n                          {tObj(tk.title)}\n                        </p>\n\n                        <p className=\"text-[10px] text-gray-400\">\n                          Milestone Limit: <strong className=\"font-mono text-gray-600\">{tk.deadline}</strong>\n                        </p>\n                      </div>\n\n                      {/* State modifications - click options */}\n                      <div className=\"flex gap-2 text-xs\">\n                        {tk.status !== \'todo\' && (\n                          <button\n                            onClick={() => updateTaskStatus(tk.id, \'todo\')}\n                            className=\"px-2.5 py-1 border border-gray-250 hover:bg-gray-50 text-gray-600 rounded-lg text-[10px] cursor-pointer\"\n                          >\n                            Set Todo\n                          </button>\n                        )}\n                        {tk.status !== \'in-progress\' && (\n                          <button\n                            onClick={() => updateTaskStatus(tk.id, \'in-progress\')}\n                            className=\"px-2.5 py-1 border border-indigo-200 hover:bg-indigo-50 text-indigo-700 rounded-lg text-[10px] cursor-pointer\"\n                          >\n                            Set Active\n                          </button>\n                        )}\n                        {tk.status !== \'done\' && (\n                          <button\n                            onClick={() => updateTaskStatus(tk.id, \'done\')}\n                            className=\"px-2.5 py-1 bg-brand-primary hover:bg-brand-dark text-white rounded-lg text-[10px] cursor-pointer font-bold\"\n                          >\n                            \342\234\223 Validate Task\n                          </button>\n                        )}\n                      </div>\n\n                    </div>\n                  );\n                })\n              ) : (\n                <div className=\"text-center py-10 border border-dashed border-gray-200 rounded-xl text-gray-450\">\n                  <p className=\"text-xs leading-relaxed\">\n                    No matching filings currently recorded inside {activeTaskTab.toUpperCase()} section.\n                  </p>\n                </div>\n              )}\n            </div>\n\n          </div>\n\n        </div>\n\n        {/* Right column (col-span-4) - Earnings chart progress & active contracts */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          \n          {/* CUSTOM BEAUTIFUL REVENUE PROGRESS BARS */}\n          <div className=\"bg-white border border-gray-150 rounded-2xl p-6 shadow-xs space-y-4\">\n            <h2 className=\"font-bold text-gray-950 text-sm flex items-center gap-1.5 pb-2 border-b border-gray-100\">\n              <TrendingUp className=\"w-5 h-5 text-brand-primary shrink-0\" />\n              {t(\'earningsBarChartTitle\')}\n            </h2>\n\n            <div className=\"space-y-4 pt-2\">\n              {monthlyEarningsProgress.map((m) => (\n                <div key={m.month} className=\"space-y-1\">\n                  <div className=\"flex justify-between items-center text-xs\">\n                    <span className={`font-semibold ${m.active ? \'text-brand-primary font-bold\' : \'text-gray-500\'}`}>\n                      {m.month} {m.active && \'\342\200\242 Active\'}\n                    </span>\n                    <span className=\"font-mono font-bold text-gray-905\">{m.value.toLocaleString()} DZD</span>\n                  </div>\n                  \n                  {/* Progress bar */}\n                  <div className=\"w-full bg-gray-100 rounded-full h-2.5 overflow-hidden\">\n                    <div \n                      className={`h-full rounded-full transition-all duration-300 ${m.active ? \'bg-brand-primary animate-pulse\' : \'bg-gray-400\'}`}\n                      style={{ width: `${(m.value / m.max) * 100}%` }}\n                    ></div>\n                  </div>\n                </div>\n              ))}\n            </div>\n\n            <p className=\"text-[10px] text-gray-400 text-center leading-normal\">\n              {t(\'earningsMockDisclaimer\')}\n            </p>\n          </div>\n\n          {/* Connected Contract agreements */}\n          <div className=\"bg-white border border-gray-150 rounded-2xl p-6 shadow-xs space-y-4\">\n            <h2 className=\"font-bold text-gray-950 text-sm flex items-center gap-1.5\">\n              <Layers className=\"w-4.5 h-4.5 text-brand-primary shrink-0\" />\n              Active SME Engagements\n            </h2>\n\n            <div className=\"space-y-3 text-xs\">\n              {proContracts.map((c) => {\n                const conClient = clients.find((cl) => cl.id === c.clientId);\n                return (\n                  <div key={c.id} className=\"p-3 bg-gray-55/40 border border-gray-100 rounded-xl space-y-2\">\n                    <div className=\"flex justify-between items-center\">\n                      <strong className=\"text-gray-900\">{tObj(c.title).substring(0, 30)}...</strong>\n                      <span className=\"text-[9px] px-1.5 py-0.5 rounded bg-teal-50 border border-teal-200 text-teal-700 font-bold font-mono\">\n                        {c.status}\n                      </span>\n                    </div>\n\n                    {conClient && (\n                      <p className=\"text-xs text-gray-500\">\n                        Client: <strong className=\"text-gray-800\">{conClient.companyName}</strong> ({tObj(conClient.wilayaName)})\n                      </p>\n                    )}\n\n                    <div className=\"flex justify-between text-[10px] text-gray-400 font-mono\">\n                      <span>Value: {c.value.toLocaleString()} DZD</span>\n                      <span>Range: {c.startDate}</span>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
    }
