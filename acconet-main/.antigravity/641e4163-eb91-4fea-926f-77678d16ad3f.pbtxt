          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ar: \"3. \330\252\330\271\330\247\331\202\330\257 \331\203\331\204\331\212\330\247\331\213 \330\250\330\243\331\205\330\247\331\206\","
