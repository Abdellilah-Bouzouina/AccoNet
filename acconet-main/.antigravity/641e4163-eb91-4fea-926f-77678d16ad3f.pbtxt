        lines {
          text: "      quoteAR: \"\330\250\330\265\331\201\330\252\331\206\330\247 \330\264\330\261\331\203\330\251 \331\206\330\247\330\264\330\246\330\251 \330\255\330\247\330\265\331\204\330\251 \330\271\331\204\331\211 \330\247\331\204\330\271\331\204\330\247\331\205\330\251\330\214 \331\210\330\254\330\257\331\206\330\247 \330\256\330\250\331\212\330\261\330\247\331\213 \331\205\330\252\331\205\331\203\331\206\330\247\331\213 \331\205\331\206 \331\202\330\247\331\206\331\210\331\206 \330\247\331\204\331\205\330\247\331\204\331\212\330\251 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212 \331\210\331\205\330\262\330\247\331\212\330\247 \330\247\331\204\330\245\330\271\331\201\330\247\330\241 \331\204\331\204\330\264\330\261\331\203\330\247\330\252 \330\247\331\204\331\206\330\247\330\264\330\246\330\251 \331\205\331\205\330\247 \330\263\331\207\331\204 \330\257\331\205\330\254 \330\255\330\263\330\247\330\250\330\247\330\252\331\206\330\247 \330\247\331\204\331\205\330\247\331\204\331\212\330\251 \330\250\331\206\330\254\330\247\330\255.\","
