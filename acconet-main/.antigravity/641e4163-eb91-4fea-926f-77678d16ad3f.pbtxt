        lines {
          text: "      ar: \"\331\205\330\263\330\252\330\264\330\247\330\261\330\251 \330\254\330\250\330\247\330\246\331\212\330\251 \331\205\330\252\330\256\330\265\330\265\330\251 \331\201\331\212 \330\247\331\204\330\252\330\264\330\261\331\212\330\271\330\247\330\252 \330\247\331\204\330\254\330\250\330\247\330\246\331\212\330\251 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212\330\251 \331\210\330\247\331\204\330\254\331\205\330\247\330\261\331\203 \331\210\330\247\331\204\331\205\331\206\330\247\330\262\330\271\330\247\330\252 \331\201\331\212 \330\247\331\204\330\272\330\261\330\250 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212. \330\243\330\263\330\247\330\271\330\257 \330\247\331\204\330\264\330\261\331\203\330\247\330\252 \331\201\331\212 \330\252\331\202\331\204\331\212\331\204 \330\247\331\204\330\243\330\256\330\267\330\247\330\241 \330\247\331\204\330\254\330\250\330\247\330\246\331\212\330\251 \331\210\330\245\330\254\330\261\330\247\330\241 \330\271\331\205\331\204\331\212\330\247\330\252 \330\247\331\204\330\252\330\257\331\202\331\212\331\202 \330\247\331\204\331\210\331\202\330\247\330\246\331\212.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      fr: \"Conseill\303\250re fiscale sp\303\251cialis\303\251e en droit fiscal alg\303\251rien, douanes et contentieux dans l\'Ouest alg\303\251rien. J\'aide les entreprises \303\240 minimiser les risques fiscaux par des audits pr\303\251ventifs.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
