  file_change {
    absolute_path_uri: "file:///src/pages/ClientDashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useApp } from \'../context/AppContext\';\nimport { \n  Building2, Users, FileText, CheckCircle2, AlertTriangle, \n  MapPin, Calendar, CreditCard, ChevronRight, Send, ArrowUpRight \n} from \'lucide-react\';\nimport { professionals } from \'../data/mockData\';\n\nexport const ClientDashboard: React.FC = () => {\n  const { t, tObj, tSpec } = useLanguage();\n  const { \n    currentClient, contracts, tasks, \n    updateTaskStatus, addTask \n  } = useApp();\n\n  // Dialog to append a task on the fly\n  const [newTaskTitle, setNewTaskTitle] = useState(\'\');\n  const [selectedContractId, setSelectedContractId] = useState(\'\');\n\n  // Filter lists for our current simulated client (\'c1\')\n  const clientContracts = contracts.filter((c) => c.clientId === (currentClient?.id || \'c1\'));\n  const activeContractIds = clientContracts.map((c) => c.id);\n  const clientTasks = tasks.filter((tk) => activeContractIds.includes(tk.contractId));\n\n  // Count stats\n  const activeContractsCount = clientContracts.length;\n  const pendingTasksCount = clientTasks.filter((tk) => tk.status !== \'done\').length;\n  const completedTasksCount = clientTasks.filter((tk) => tk.status === \'done\').length;\n\n  // New task submit\n  const handleAddTaskSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newTaskTitle || !selectedContractId) return;\n\n    addTask({\n      id: `tk_custom_cl_${Date.now()}`,\n      contractId: selectedContractId,\n      title: { ar: newTaskTitle, fr: newTaskTitle, en: newTaskTitle },\n      deadline: new Date(Date.now() + 7 * 864 * 1000).toISOString().split(\'T\')[0], // 7 Days from now\n      status: \'todo\',\n      type: \'bookkeeping\'\n    });\n\n    setNewTaskTitle(\'\');\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\" id=\"client_dashboard_wrapper\">\n      \n      {/* Welcome Header */}\n      <div className=\"bg-gradient-to-r from-brand-primary/10 to-brand-light/30 border border-brand-primary/20 rounded-3xl p-6 sm:p-8 mb-8\">\n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n          <div className=\"space-y-1\">\n            <span className=\"text-[10px] font-bold text-brand-primary uppercase tracking-widest font-mono\">\n              ALGERIA CORPORATE PORTAL\n            </span>\n            <h1 className=\"text-2xl font-extrabold text-gray-950 font-sans tracking-tight\">\n              {t(\'clientWelcome\')} <span className=\"text-brand-primary\">{currentClient?.companyName || \'Dzair Tech Link\'}</span>\n            </h1>\n            <p className=\"text-xs text-gray-500\">\n              HQ: {tObj(currentClient?.wilayaName)} \342\200\242 NIF: <span className=\"font-mono\">{currentClient?.NIF}</span>\n            </p>\n          </div>\n\n          <div className=\"px-4 py-2 bg-white border border-gray-150 rounded-2xl flex items-center gap-2\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-teal-500 animate-ping\"></span>\n            <span className=\"text-xs font-semibold text-gray-700\">SCF Compliance Live Connection</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Stats row */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8\">\n        \n        {/* Active contracts */}\n        <div className=\"bg-white border border-gray-150 p-6 rounded-2xl shadow-3xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 bg-teal-50 text-brand-primary rounded-xl flex items-center justify-center shrink-0\">\n            <Building2 className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-bold text-gray-400 uppercase leading-none\">{t(\'activeContractsLabel\')}</p>\n            <p className=\"text-2xl font-black text-brand-primary font-mono mt-1\">{activeContractsCount}</p>\n          </div>\n        </div>\n\n        {/* Pending tasks */}\n        <div className=\"bg-white border border-gray-150 p-6 rounded-2xl shadow-3xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 bg-amber-50 text-brand-accent rounded-xl flex items-center justify-center shrink-0\">\n            <FileText className=\"w-6 h-6 animate-pulse\" />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-bold text-gray-400 uppercase leading-none\">{t(\'dashboardTasksActive\')}</p>\n            <p className=\"text-2xl font-black text-brand-accent font-mono mt-1\">{pendingTasksCount}</p>\n          </div>\n        </div>\n\n        {/* Done tasks */}\n        <div className=\"bg-white border border-gray-150 p-6 rounded-2xl shadow-3xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 bg-green-50 text-green-700 rounded-xl flex items-center justify-center shrink-0\">\n            <CheckCircle2 className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-bold text-gray-400 uppercase leading-none\">Completed filings</p>\n            <p className=\"text-2xl font-black text-green-700 font-mono mt-1\">{completedTasksCount}</p>\n          </div>\n        </div>\n\n        {/* Unread messages placeholder */}\n        <div className=\"bg-white border border-gray-150 p-6 rounded-2xl shadow-3xs flex items-center gap-4\">\n          <div className=\"w-12 h-12 bg-blue-50 text-blue-700 rounded-xl flex items-center justify-center shrink-0\">\n            <Users className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <p className=\"text-[10px] font-bold text-gray-400 uppercase leading-none\">Accredited Experts</p>\n            <p className=\"text-2xl font-black text-blue-700 font-mono mt-1\">\n              {new Set(clientContracts.map((c) => c.professionalId)).size}\n            </p>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Main Contents layout */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* Left column (col-span-8) - Contracts lists & Add Task form */}\n        <div className=\"lg:col-span-8 space-y-8\">\n          \n          {/* Contracts List */}\n          <div className=\"bg-white border border-gray-150 rounded-2xl p-6 shadow-xs space-y-6\">\n            <h2 className=\"font-bold text-gray-950 text-base flex items-center gap-2\">\n              <CheckCircle2 className=\"w-5 h-5 text-brand-primary\" />\n              {t(\'activeServiceContractsTitle\')}\n            </h2>\n\n            {clientContracts.length > 0 ? (\n              <div className=\"space-y-4\">\n                {clientContracts.map((con) => {\n                  const proInfo = professionals.find((p) => p.id === con.professionalId);\n                  return (\n                    <div key={con.id} className=\"border border-gray-100 rounded-xl p-5 hover:border-brand-primary/40 transition space-y-4 bg-gray-55/30\">\n                      \n                      {/* Contract Header */}\n                      <div className=\"flex flex-col sm:flex-row justify-between items-start gap-3\">\n                        <div>\n                          <h3 className=\"font-bold text-gray-900 text-sm leading-snug\">{tObj(con.title)}</h3>\n                          <p className=\"text-[10px] text-gray-400 font-mono mt-1\">CONTRACT Ref: {con.id}</p>\n                        </div>\n                        <span className=\"px-2.5 py-0.5 bg-teal-50 border border-teal-200 text-teal-700 text-[10px] font-semibold uppercase rounded\">\n                          {con.status}\n                        </span>\n                      </div>\n\n                      {/* Professional details */}\n                      {proInfo && (\n                        <div className=\"flex items-center gap-2.5 text-xs text-gray-500\">\n                          <div className={`w-6 h-6 rounded-full flex items-center justify-center font-bold text-[10px] ${proInfo.avatarBg}`}>\n                            {proInfo.initials}\n                          </div>\n                          <span>Cabinet Partner: <strong className=\"text-gray-800\">{tObj(proInfo.name)}</strong> ({tSpec(proInfo.specialty)})</span>\n                        </div>\n                      )}\n\n                      {/* Price & Dates row */}\n                      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 border-t border-gray-100/50 text-xs text-gray-500\">\n                        <div>\n                          <p className=\"text-[10px] text-gray-400 uppercase leading-none\">{t(\'contractValueLabel\')}</p>\n                          <p className=\"font-bold font-mono text-gray-900 mt-1\">{con.value.toLocaleString()} DZD</p>\n                        </div>\n                        <div>\n                          <p className=\"text-[10px] text-gray-400 uppercase leading-none\">Start Date</p>\n                          <p className=\"font-semibold text-gray-900 mt-1\">{con.startDate}</p>\n                        </div>\n                        <div>\n                          <p className=\"text-[10px] text-gray-400 uppercase leading-none\">Authorized until</p>\n                          <p className=\"font-semibold text-gray-950 mt-1\">{con.endDate}</p>\n                        </div>\n                      </div>\n\n                      {/* Progress Bar (Visual only, based on task ratio) */}\n                      <div className=\"space-y-1\">\n                        <div className=\"flex justify-between items-center text-[10px] text-gray-400\">\n                          <span>Task Progress ratio</span>\n                          <span className=\"font-semibold text-brand-primary\">\n                            {Math.round(\n                              (clientTasks.filter((tk) => tk.contractId === con.id && tk.status === \'done\').length / \n                              Math.max(1, clientTasks.filter((tk) => tk.contractId === con.id).length)) * 100\n                            )}%\n                          </span>\n                        </div>\n                        <div className=\"w-full bg-gray-200 rounded-full h-1.5 overflow-hidden\">\n                          <div \n                            className=\"bg-brand-primary h-full rounded-full transition-all duration-300\" \n                            style={{ \n                              width: `${\n                                (clientTasks.filter((tk) => tk.contractId === con.id && tk.status === \'done\').length / \n                                Math.max(1, clientTasks.filter((tk) => tk.contractId === con.id).length)) * 100\n                              }%` \n                            }}\n                          ></div>\n                        </div>\n                      </div>\n\n                    </div>\n                  );\n                })}\n              </div>\n            ) : (\n              <div className=\"text-center py-10 text-gray-400\">\n                <p className=\"text-xs\">No active accounting partnerships. Complete a search to hire an approved specialist.</p>\n              </div>\n            )}\n\n          </div>\n\n          {/* Interactive Fast Task Assignment */}\n          <div className=\"bg-white border border-gray-150 rounded-2xl p-6 shadow-xs\">\n            <h2 className=\"font-bold text-gray-950 text-sm flex items-center gap-2 mb-4\">\n              <Send className=\"w-4.5 h-4.5 text-brand-primary\" />\n              Direct Task Dispatch Center (Simulation)\n            </h2>\n\n            <form onSubmit={handleAddTaskSubmit} className=\"space-y-4\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-[10px] font-bold text-gray-400 uppercase mb-1\">Target Contract</label>\n                  <select\n                    required\n                    value={selectedContractId}\n                    onChange={(e) => setSelectedContractId(e.target.value)}\n                    className=\"w-full text-xs border border-gray-205 rounded-lg px-2.5 py-1.5 bg-gray-50 focus:outline-none focus:border-brand-primary focus:bg-white text-gray-700\"\n                  >\n                    <option value=\"\">Select accounting contract...</option>\n                    {clientContracts.map((c) => (\n                      <option key={c.id} value={c.id}>{tObj(c.title).substring(0, 40)}...</option>\n                    ))}\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-[10px] font-bold text-gray-400 uppercase mb-1\">Tax Filing / Task Title</label>\n                  <input \n                    type=\"text\"\n                    required\n                    placeholder=\"e.g. Audit G50 correction of May sales ledger\"\n                    value={newTaskTitle}\n                    onChange={(e) => setNewTaskTitle(e.target.value)}\n                    className=\"w-full text-xs border border-gray-205 rounded-lg px-2.5 py-1.5 bg-gray-50 focus:outline-none focus:border-brand-primary focus:bg-white text-gray-700\"\n                  />\n                </div>\n              </div>\n              <button \n                type=\"submit\"\n                className=\"px-4 py-2 bg-brand-primary hover:bg-brand-dark text-white rounded-lg text-xs font-bold transition duration-150 cursor-pointer\"\n              >\n                Assign Filing Work to Cabinet\n              </button>\n            </form>\n          </div>\n\n        </div>\n\n        {/* Right column (col-span-4) - COLOR CODED DEADLINES BOX & HISTORY */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          \n          {/* DEADLINES COLUMN */}\n          <div className=\"bg-white border border-gray-150 rounded-2xl p-6 shadow-xs space-y-5\">\n            <h2 className=\"font-bold text-gray-950 text-sm flex items-center gap-2 pb-3 border-b border-gray-100\">\n              <Calendar className=\"w-4.5 h-4.5 text-brand-accent animate-bounce\" />\n              {t(\'upcomingDeadlinesTitle\')}\n            </h2>\n\n            <div className=\"space-y-3\">\n              {clientTasks.map((tk) => {\n                const isOverdue = new Date(tk.deadline) < new Date();\n                const isFinished = tk.status === \'done\';\n\n                return (\n                  <div \n                    key={tk.id} \n                    className={`p-3.5 rounded-xl border flex flex-col gap-1.5 transition ${\n                      isFinished \n                        ? \'bg-green-50/50 border-green-200 text-green-800\' \n                        : isOverdue \n                          ? \'bg-red-50 border-red-200 text-red-900\' \n                          : \'bg-amber-50/50 border-amber-200 text-amber-900\'\n                    }`}\n                  >\n                    <div className=\"flex justify-between items-center\">\n                      <span className=\"text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded bg-white border border-gray-200 text-gray-500 font-mono\">\n                        {tk.type}\n                      </span>\n                      \n                      {/* State checkbox */}\n                      <button \n                        onClick={() => updateTaskStatus(tk.id, tk.status === \'done\' ? \'todo\' : \'done\')}\n                        className={`w-4.5 h-4.5 rounded border flex items-center justify-center cursor-pointer ${\n                          isFinished \n                            ? \'bg-green-600 border-green-600 text-white\' \n                            : \'bg-white border-gray-300 hover:border-brand-primary\'\n                        }`}\n                        title=\"Tick to simulate change of status\"\n                      >\n                        {isFinished && <CheckCircle2 className=\"w-3.5 h-3.5 text-white\" />}\n                      </button>\n                    </div>\n\n                    <p className=\"text-xs font-bold font-sans\">\n                      {tObj(tk.title)}\n                    </p>\n\n                    <div className=\"flex justify-between items-center text-[10px] pt-1 text-gray-500\">\n                      <span>Deadline due: <strong className=\"font-mono\">{tk.deadline}</strong></span>\n                      <span className=\"font-semibold uppercase text-[9px] px-1.5 py-0.5 rounded-md bg-white\">\n                        {tk.status}\n                      </span>\n                    </div>\n\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* SIMULATED ACTION FEED */}\n          <div className=\"bg-white border border-gray-150 rounded-2xl p-6 shadow-xs space-y-4\">\n            <h2 className=\"font-bold text-gray-950 text-sm flex items-center gap-2\">\n              <Users className=\"w-4.5 h-4.5 text-brand-primary\" />\n              {t(\'recentActionsLabel\')}\n            </h2>\n\n            <div className=\"space-y-3 font-sans text-xs\">\n              <div className=\"flex gap-2.5 items-start\">\n                <span className=\"w-2.5 h-2.5 bg-brand-primary rounded-full mt-1 shrink-0\"></span>\n                <div>\n                  <p className=\"text-gray-700\">Contract proposal sent to <strong>Layla Yakoubi</strong></p>\n                  <p className=\"text-[10px] text-gray-400 font-mono\">2026-05-20 14:02</p>\n                </div>\n              </div>\n              <div className=\"flex gap-2.5 items-start\">\n                <span className=\"w-2.5 h-2.5 bg-green-500 rounded-full mt-1 shrink-0\"></span>\n                <div>\n                  <p className=\"text-gray-700\">G50 tax receipt uploaded by <strong>Sofiane Benamara</strong></p>\n                  <p className=\"text-[10px] text-gray-400 font-mono\">2026-05-18 10:15</p>\n                </div>\n              </div>\n              <div className=\"flex gap-2.5 items-start\">\n                <span className=\"w-2.5 h-2.5 bg-indigo-500 rounded-full mt-1 shrink-0\"></span>\n                <div>\n                  <p className=\"text-gray-700\">Consultation established with <strong>Sarah Haddad</strong></p>\n                  <p className=\"text-[10px] text-gray-400 font-mono\">2026-05-10 11:30</p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
    }
