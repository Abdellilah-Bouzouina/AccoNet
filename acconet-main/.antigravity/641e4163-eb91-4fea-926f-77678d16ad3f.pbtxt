  file_change {
    absolute_path_uri: "file:///src/pages/ProfessionalDashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useApp } from \'../context/AppContext\';\nimport { \n  Briefcase, Users, DollarSign, Star, Calendar, \n  CheckSquare, ArrowUpRight, TrendingUp, RefreshCw, Layers,\n  Award, Shield, FileSpreadsheet\n} from \'lucide-react\';\nimport { clients } from \'../data/mockData\';\n\nexport const ProfessionalDashboard: React.FC = () => {\n  const { t, tObj, tSpec } = useLanguage();\n  const { \n    currentProfessional, contracts, tasks, \n    updateTaskStatus \n  } = useApp();\n\n  // Active inbox tab filters: Todo, In-Progress, Done\n  const [activeTaskTab, setActiveTaskTab] = useState<\'todo\' | \'in-progress\' | \'done\'>(\'todo\');\n\n  const pro = currentProfessional || {\n    id: \"p1\",\n    name: { ar: \"\330\263\331\201\331\212\330\247\331\206 \330\250\331\206 \330\271\331\205\330\247\330\261\", fr: \"Sofiane Benamara\", en: \"Sofiane Benamara\" },\n    specialty: \"certified-accountant\",\n    rating: 4.9,\n    accreditationNumber: \"CNEC/2012/948\"\n  };\n\n  // Filter lists for our current simulated professional (\'p1\' or \'p2\')\n  const proContracts = contracts.filter((c) => c.professionalId === pro.id);\n  const activeContractIds = proContracts.map((c) => c.id);\n  const proTasks = tasks.filter((tk) => activeContractIds.includes(tk.contractId));\n\n  // Count metrics\n  const activeClientsCount = new Set(proContracts.map((c) => c.clientId)).size;\n  const pendingTasksList = proTasks.filter((tk) => tk.status === activeTaskTab);\n\n  const totalEarnings = proContracts.reduce((sum, c) => sum + (c.status === \'active\' ? c.value / 12 : 0), 0); // Simulated monthly yield\n\n  // Mock earnings progression dataset\n  const monthlyEarningsProgress = [\n    { month: \"Jan 2026\", value: 140000, max: 250000 },\n    { month: \"Feb 2026\", value: 180000, max: 250000 },\n    { month: \"Mar 2026\", value: 215000, max: 250000 },\n    { month: \"Apr 2026\", value: 245000, max: 250000 },\n    { month: \"May 2026\", value: Math.round(totalEarnings) || 250000, max: 250000, active: true },\n  ];\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 space-y-8\" id=\"pro_dashboard_view\">\n      \n      {/* 1. WELCOME HEADER DECK */}\n      <div className=\"bg-[#0A1814] border border-[#0F6E56]/40 p-6 sm:p-8 text-white relative\">\n        <div className=\"absolute inset-0 bg-[radial-gradient(#0F6E56_1px,transparent_1px)] bg-[size:1.5rem_1.5rem] opacity-10\"></div>\n        \n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 relative z-10 text-left rtl:text-right\">\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center gap-1.5\">\n              <span className=\"px-2 py-0.5 bg-brand-primary/25 border border-[#0F6E56] text-brand-accent text-[8px] font-mono uppercase tracking-widest\">\n                Approved Cabinet Portal\n              </span>\n              <span className=\"text-[10px] font-mono text-gray-400\">REGISTRATION COMPLETED</span>\n            </div>\n            \n            <h1 className=\"text-2xl sm:text-3xl font-serif font-semibold tracking-tight leading-tight\">\n              {t(\'proWelcome\')} <span className=\"text-brand-accent italic font-normal\">{tObj(pro.name)}</span>\n            </h1>\n            \n            <p className=\"text-[11px] text-teal-150 font-sans flex flex-wrap items-center gap-x-3 gap-y-1\">\n              <span className=\"bg-white/5 border border-white/10 px-1.5 py-0.5\">{tSpec(pro.specialty)}</span>\n              <span className=\"text-gray-600 hidden sm:inline\">\342\200\242</span>\n              <span>Accreditation Board ID: <strong className=\"font-mono text-brand-accent\">{pro.accreditationNumber}</strong></span>\n            </p>\n          </div>\n\n          <div className=\"px-3.5 py-2 bg-white/5 border border-white/10 flex items-center gap-1.5 text-xs\">\n            <Shield className=\"w-4 h-4 text-brand-accent animate-pulse\" />\n            <span className=\"text-gray-300 font-mono text-[9px] uppercase tracking-wider\">Secure Audit Environment</span>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. STATS KPI BENCHMARKS */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\" id=\"stats_benchmarks_row\">\n        \n        {/* Active Clients */}\n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <span className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider\">{t(\'proStatsClients\')}</span>\n            <p className=\"text-2xl font-serif font-black text-brand-primary font-mono\">{activeClientsCount}</p>\n          </div>\n          <Users className=\"w-8 h-8 text-brand-primary/35\" />\n        </div>\n\n        {/* Global Tasks */}\n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <span className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider\">PENDING AUDITS</span>\n            <p className=\"text-2xl font-serif font-black text-brand-accent font-mono\">\n              {proTasks.filter((t) => t.status !== \'done\').length}\n            </p>\n          </div>\n          <CheckSquare className=\"w-8 h-8 text-brand-accent/35\" />\n        </div>\n\n        {/* Monthly Earnings / Pro-rata Yield */}\n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between col-span-1\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <span className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider\">{t(\'proStatsEarnings\')}</span>\n            <p className=\"text-xl font-serif font-black text-emerald-800 font-mono leading-tight\">\n              {Math.round(totalEarnings).toLocaleString()} <span className=\"text-xs\">DZD</span>\n            </p>\n          </div>\n          <DollarSign className=\"w-8 h-8 text-emerald-800/35\" />\n        </div>\n\n        {/* Score */}\n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <span className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider\">RATING SCORE</span>\n            <p className=\"text-2xl font-serif font-black text-indigo-900 font-mono\">{pro.rating} / 5.0</p>\n          </div>\n          <Award className=\"w-8 h-8 text-indigo-900/35\" />\n        </div>\n\n      </div>\n\n      {/* 3. CORE DESK GRIDS */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* Left Column (col-span-8) - Task inbox & operations */}\n        <div className=\"lg:col-span-8 space-y-6\">\n          \n          <div className=\"bg-white border border-[#CFCFC4] p-6 space-y-6\">\n            \n            {/* Inbox header with localized tab options */}\n            <div className=\"flex flex-col sm:flex-row justify-between sm:items-center gap-4 pb-4 border-b border-[#EBEBE5]\">\n              <div className=\"text-left rtl:text-right\">\n                <span className=\"text-[9px] font-mono text-gray-400 uppercase tracking-widest\">TASK REGISTRY</span>\n                <h2 className=\"font-serif font-semibold text-gray-950 text-base flex items-center gap-2 mt-0.5\">\n                  <Briefcase className=\"w-4.5 h-4.5 text-[#0F6E56]\" />\n                  {t(\'taskInboxTitle\')}\n                </h2>\n              </div>\n\n              {/* Status Switcher Tabs */}\n              <div className=\"flex bg-[#F5F4EE] border border-[#CFCFC4] p-0.5 text-xs self-start\">\n                <button\n                  onClick={() => setActiveTaskTab(\'todo\')}\n                  className={`px-3 py-1.5 cursor-pointer font-mono text-[10px] uppercase transition tracking-wider ${activeTaskTab === \'todo\' ? \'bg-white text-gray-900 font-bold\' : \'text-gray-500 hover:text-gray-900\'}`}\n                >\n                  Todo ({proTasks.filter((t) => t.status === \'todo\').length})\n                </button>\n                <button\n                  onClick={() => setActiveTaskTab(\'in-progress\')}\n                  className={`px-3 py-1.5 cursor-pointer font-mono text-[10px] uppercase transition tracking-wider ${activeTaskTab === \'in-progress\' ? \'bg-white text-gray-900 font-bold\' : \'text-gray-500 hover:text-gray-900\'}`}\n                >\n                  Active ({proTasks.filter((t) => t.status === \'in-progress\').length})\n                </button>\n                <button\n                  onClick={() => setActiveTaskTab(\'done\')}\n                  className={`px-3 py-1.5 cursor-pointer font-mono text-[10px] uppercase transition tracking-wider ${activeTaskTab === \'done\' ? \'bg-white text-gray-900 font-bold\' : \'text-gray-500 hover:text-gray-900\'}`}\n                >\n                  Done ({proTasks.filter((t) => t.status === \'done\').length})\n                </button>\n              </div>\n            </div>\n\n            {/* Task rows */}\n            <div className=\"space-y-3\">\n              {pendingTasksList.length > 0 ? (\n                pendingTasksList.map((tk) => {\n                  const clientInfo = clients.find((c) => c.activeContracts.includes(tk.contractId));\n                  return (\n                    <div \n                      key={tk.id}\n                      className=\"border border-[#CFCFC4] p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-[#FAF9F5]/40 hover:border-[#0F6E56] transition text-left rtl:text-right\"\n                    >\n                      <div className=\"space-y-1\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"text-[9px] uppercase font-bold px-1.5 py-0.5 bg-white border border-[#CFCFC4] text-gray-500 font-mono\">\n                            {tk.type}\n                          </span>\n                          {clientInfo && (\n                            <span className=\"text-[10px] text-[#0F6E56] font-bold\">\n                              \360\237\217\242 {clientInfo.companyName}\n                            </span>\n                          )}\n                        </div>\n\n                        <p className=\"text-xs font-bold text-gray-900 font-serif\">\n                          {tObj(tk.title)}\n                        </p>\n\n                        <p className=\"text-[10px] text-gray-400 font-mono\">\n                          MILESTONE DUE: <strong className=\"text-gray-700\">{tk.deadline}</strong>\n                        </p>\n                      </div>\n\n                      {/* State transitions */}\n                      <div className=\"flex gap-1.5 text-xs font-mono\">\n                        {tk.status !== \'todo\' && (\n                          <button\n                            onClick={() => updateTaskStatus(tk.id, \'todo\')}\n                            className=\"px-2.5 py-1 bg-white border border-[#CFCFC4] hover:bg-gray-50 text-gray-600 font-bold text-[10px] cursor-pointer\"\n                          >\n                            Set Todo\n                          </button>\n                        )}\n                        {tk.status !== \'in-progress\' && (\n                          <button\n                            onClick={() => updateTaskStatus(tk.id, \'in-progress\')}\n                            className=\"px-2.5 py-1 bg-white border border-indigo-200 hover:bg-indigo-50 text-indigo-700 font-bold text-[10px] cursor-pointer\"\n                          >\n                            Set Active\n                          </button>\n                        )}\n                        {tk.status !== \'done\' && (\n                          <button\n                            onClick={() => updateTaskStatus(tk.id, \'done\')}\n                            className=\"px-2.5 py-1 bg-[#0F6E56] hover:bg-[#085041] text-white text-[10px] cursor-pointer font-bold\"\n                          >\n                            \342\234\223 Validate\n                          </button>\n                        )}\n                      </div>\n\n                    </div>\n                  );\n                })\n              ) : (\n                <div className=\"text-center py-10 border border-dashed border-[#CFCFC4] text-gray-400 font-mono\">\n                  <p className=\"text-xs leading-relaxed\">\n                    No matching filings currently recorded inside {activeTaskTab.toUpperCase()} section.\n                  </p>\n                </div>\n              )}\n            </div>\n\n          </div>\n\n        </div>\n\n        {/* Right Column (col-span-4) - Financial metrics progress */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          \n          {/* Custom monospaced earnings progression panel */}\n          <div className=\"bg-white border border-[#CFCFC4] p-6 space-y-4\">\n            <h2 className=\"font-serif font-semibold text-gray-950 text-sm flex items-center gap-2 pb-2 border-b border-[#EBEBE5]\">\n              <TrendingUp className=\"w-5 h-5 text-brand-primary shrink-0 text-[#0F6E56]\" />\n              {t(\'earningsBarChartTitle\')}\n            </h2>\n\n            <div className=\"space-y-4 pt-2\">\n              {monthlyEarningsProgress.map((m) => (\n                <div key={m.month} className=\"space-y-1\">\n                  <div className=\"flex justify-between items-center text-xs\">\n                    <span className={`font-semibold ${m.active ? \'text-[#0F6E56] font-bold\' : \'text-gray-500\'}`}>\n                      {m.month} {m.active && \'\342\200\242 Live\'}\n                    </span>\n                    <span className=\"font-mono font-bold text-gray-900\">{m.value.toLocaleString()} DZD</span>\n                  </div>\n                  \n                  {/* Precise Progress bar */}\n                  <div className=\"w-full bg-[#EBEBE5] h-2.5 overflow-hidden\">\n                    <div \n                      className={`h-full transition-all duration-300 ${m.active ? \'bg-[#0F6E56] animate-pulse\' : \'bg-gray-400\'}`}\n                      style={{ width: `${(m.value / m.max) * 100}%` }}\n                    ></div>\n                  </div>\n                </div>\n              ))}\n            </div>\n\n            <p className=\"text-[10px] text-gray-450 leading-relaxed font-sans border-t border-[#EBEBE5] pt-3 text-center\">\n              {t(\'earningsMockDisclaimer\')}\n            </p>\n          </div>\n\n          {/* Active SME Engagements */}\n          <div className=\"bg-white border border-[#CFCFC4] p-6 space-y-4\">\n            <h2 className=\"font-serif font-semibold text-gray-950 text-sm flex items-center gap-1.5\">\n              <Layers className=\"w-4.5 h-4.5 text-brand-primary shrink-0 text-[#0F6E56]\" />\n              Active SME Engagements\n            </h2>\n\n            <div className=\"space-y-3 text-xs text-left rtl:text-right\">\n              {proContracts.map((c) => {\n                const conClient = clients.find((cl) => cl.id === c.clientId);\n                return (\n                  <div key={c.id} className=\"p-3.5 bg-[#FAF9F5] border border-[#EBEBE5] space-y-2\">\n                    <div className=\"flex justify-between items-center\">\n                      <strong className=\"text-gray-900 font-serif text-xs\">{tObj(c.title).substring(0, 30)}...</strong>\n                      <span className=\"text-[8px] px-1.5 py-0.5 bg-teal-50 border border-teal-200 text-teal-800 font-bold font-mono uppercase\">\n                        {c.status}\n                      </span>\n                    </div>\n\n                    {conClient && (\n                      <p className=\"text-[11px] text-gray-505 font-sans\">\n                        Client: <strong className=\"text-gray-800\">{conClient.companyName}</strong> ({tObj(conClient.wilayaName)})\n                      </p>\n                    )}\n\n                    <div className=\"flex justify-between text-[9px] text-gray-400 font-mono border-t border-[#EBEBE5]/60 pt-2\">\n                      <span>VALUE: {c.value.toLocaleString()} DZD</span>\n                      <span>DATE: {c.startDate}</span>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
    }
