        lines {
          text: "          ar: \"\331\205\330\255\330\247\331\201\330\270 \330\255\330\263\330\247\330\250\330\247\330\252 \330\261\330\247\330\246\330\271 \331\210\330\257\331\202\331\212\331\202 \330\254\330\257\330\247\331\213. \331\203\330\264\331\201 \331\204\331\206\330\247 \330\247\331\204\330\271\330\257\331\212\330\257 \331\205\331\206 \331\205\331\210\330\247\330\267\331\206 \330\247\331\204\330\266\330\271\331\201 \331\201\331\212 \330\247\331\204\330\261\331\202\330\247\330\250\330\251 \330\247\331\204\330\257\330\247\330\256\331\204\331\212\330\251 \331\204\331\205\330\265\331\206\330\271\331\206\330\247 \331\210\331\202\330\257\331\205 \330\255\331\204\331\210\331\204\330\247\331\213 \330\271\331\205\331\204\331\212\330\251 \331\204\331\207\330\247.\","
