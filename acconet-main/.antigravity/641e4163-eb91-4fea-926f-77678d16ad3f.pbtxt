      replacement_content: "/* Animations and Utilities */\n@keyframes pulse-slow {\n  0%, 100% { opacity: 0.9; transform: scale(1); }\n  50% { opacity: 0.6; transform: scale(1.05); }\n}\n\n.pulse-accent {\n  animation: pulse-slow 3s infinite ease-in-out;\n}\n\n@utility glass {\n  background-color: rgba(255, 255, 255, 0.75);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid rgba(255, 255, 255, 0.5);\n  box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.02);\n}\n\n@utility glass-dark {\n  background-color: rgba(17, 24, 39, 0.75);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);\n}\n\n@utility glass-brand {\n  background-color: rgba(15, 110, 86, 0.08);\n  backdrop-filter: blur(8px);\n  -webkit-backdrop-filter: blur(8px);\n  border: 1px solid rgba(15, 110, 86, 0.15);\n}\n\n@utility shadow-classic {\n  box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.05), 0 4px 10px -3px rgba(0, 0, 0, 0.03);\n}\n\n@utility shadow-glow {\n  box-shadow: 0 10px 30px -10px rgba(15, 110, 86, 0.25);\n}\n\nbody {\n  background-color: var(--color-brand-surface);\n  color: var(--color-brand-neutral);\n  font-family: var(--font-sans);\n}"
