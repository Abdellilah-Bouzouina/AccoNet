        lines {
          text: "    bio: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ar: \"\330\256\330\250\331\212\330\261 \331\205\330\255\330\247\330\263\330\250 \331\205\330\271\330\252\331\205\330\257 \331\212\330\252\331\205\330\252\330\271 \330\250\330\243\331\203\330\253\330\261 \331\205\331\206 14 \330\271\330\247\331\205\331\213\330\247 \331\205\331\206 \330\247\331\204\330\256\330\250\330\261\330\251 \331\201\331\212 \331\205\330\261\330\247\331\201\331\202\330\251 \330\247\331\204\330\264\330\261\331\203\330\247\330\252 \330\247\331\204\331\206\330\247\330\264\330\246\330\251 \331\210\330\247\331\204\331\205\330\244\330\263\330\263\330\247\330\252 \330\247\331\204\330\265\330\272\331\212\330\261\330\251 \331\210\330\247\331\204\331\205\330\252\331\210\330\263\330\267\330\251 \331\201\331\212 \330\247\331\204\330\254\330\262\330\247\330\246\330\261 \330\247\331\204\330\271\330\247\330\265\331\205\330\251. \331\205\330\252\330\256\330\265\330\265 \331\201\331\212 \330\247\331\204\331\207\331\212\331\203\331\204\330\251 \330\247\331\204\330\254\330\250\330\247\330\246\331\212\330\251 \331\210\330\245\330\271\330\257\330\247\330\257 \330\247\331\204\331\205\331\212\330\262\330\247\331\206\331\212\330\247\330\252 \330\247\331\204\330\263\331\206\331\210\331\212\330\251.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      fr: \"Expert-comptable agr\303\251\303\251 avec plus de 14 ans d\'exp\303\251rience dans l\'accompagnement des startups et PME \303\240 Alger. Sp\303\251cialiste de la structuration fiscale et de la pr\303\251paration des bilans annuels.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      en: \"Certified Chartered Accountant with over 14 years of experience supporting startups and SMEs in Algiers. Specialist in tax structuring and annual balance sheet preparation.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
