        lines {
          text: "  howTitle: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ar: \"\331\203\331\212\331\201 \330\252\330\271\331\205\331\204 \331\205\331\206\330\265\330\251 \330\243\331\203\331\210\331\206\331\212\330\252\330\237\","
