  file_change {
    absolute_path_uri: "file:///src/pages/Login.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useNavigate, Link } from \'react-router-dom\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useApp } from \'../context/AppContext\';\nimport { \n  Lock, Mail, ArrowLeft, ArrowRight, ShieldCheck, \n  Building2, UserCheck, HelpCircle, Eye, EyeOff \n} from \'lucide-react\';\nimport { clients, professionals } from \'../data/mockData\';\n\nexport const Login: React.FC = () => {\n  const { t, direction } = useLanguage();\n  const { setUserRole, setCurrentClient, setCurrentProfessional, triggerNotification } = useApp();\n  const navigate = useNavigate();\n\n  // Standard login credentials state\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [showPass, setShowPass] = useState(false);\n\n  const handleStandardLoginSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!email || !password) return;\n\n    // Simulate logging in as active SME Client\n    setUserRole(\'client\');\n    setCurrentClient(clients[0]); // Default \"Dzair Tech Link\"\n    triggerNotification(\n      t(\'authSuccessHeading\'),\n      t(\'authSuccessMsg\') + \' (Assigned to SME Executive Profile)\'\n    );\n    navigate(\'/dashboard/client\');\n  };\n\n  // Direct fast demonstration triggers\n  const handleSimulateClientLogin = () => {\n    setUserRole(\'client\');\n    setCurrentClient(clients[0]); // Default Dzair Tech Link\n    triggerNotification(\n      t(\'authSuccessHeading\'),\n      \"Logged in as Client: Dzair Tech Link Sarl (Algiers)\"\n    );\n    navigate(\'/dashboard/client\');\n  };\n\n  const handleSimulateProLogin = () => {\n    setUserRole(\'professional\');\n    setCurrentProfessional(professionals[0]); // Default Sofiane Benamara\n    triggerNotification(\n      t(\'authSuccessHeading\'),\n      \"Logged in as Professional: Me. Sofiane Benamara (Certified Accountant)\"\n    );\n    navigate(\'/dashboard/professional\');\n  };\n\n  return (\n    <div className=\"min-h-[calc(100vh-4rem)] flex items-stretch\" id=\"login_viewport_split\">\n      \n      {/* LEFT SIDEBAR PANEL: POLISHED LOGO & BACKGROUND (col-span-12 md:flex-6) */}\n      <div className=\"hidden lg:flex lg:w-1/2 bg-brand-dark text-white p-16 flex-col justify-between relative overflow-hidden\">\n        \n        {/* Subtle decorative geometric overlay */}\n        <div className=\"absolute inset-0 opacity-10 pointer-events-none\">\n          <div className=\"absolute top-20 right-20 w-80 h-80 rounded-full border-12 border-brand-accent\"></div>\n          <div className=\"absolute bottom-20 left-20 w-48 h-48 rounded-full border-4 border-white\"></div>\n        </div>\n\n        <div className=\"space-y-2 relative z-10\">\n          <Link to=\"/\" className=\"flex items-center space-x-2.5 rtl:space-x-reverse\">\n            <span className=\"flex items-center justify-center w-10 h-10 rounded-xl bg-white text-brand-primary font-black text-xl shadow-md\">\n              \330\243\n            </span>\n            <span className=\"text-2xl font-bold tracking-tight text-white font-sans\">\n              AccoNet <span className=\"text-brand-accent\">\330\243\331\203\331\210\331\206\331\212\330\252</span>\n            </span>\n          </Link>\n          <p className=\"text-xs text-brand-light font-mono leading-none tracking-wider uppercase pt-1\">Algeria</p>\n        </div>\n\n        <div className=\"space-y-4 relative z-10\">\n          <h2 className=\"text-3xl font-extrabold leading-tight\">\n            Connecting companies with authorized financial leaders across Algerian territory.\n          </h2>\n          <p className=\"text-gray-300 text-xs leading-relaxed max-w-md\">\n            Easily manage quarterly VAT, trade declarations, social CNAS audits, and financial statements directly via an interactive trilingual dashboard.\n          </p>\n        </div>\n\n        <div className=\"text-xs text-brand-light/70 flex items-center gap-2 relative z-10\">\n          <ShieldCheck className=\"w-5 h-5 text-brand-accent\" />\n          <span>Legally complaint with the Algerian Ordre des Experts Comptables (ONEC)</span>\n        </div>\n\n      </div>\n\n      {/* RIGHT PANEL: MAIN FORM & QUICK LOGINS */}\n      <div className=\"w-full lg:w-1/2 bg-white flex flex-col justify-center px-6 py-12 sm:px-12 lg:px-20\">\n        \n        <div className=\"max-w-md w-full mx-auto space-y-8\">\n          \n          <div className=\"space-y-2\">\n            <h1 className=\"text-2xl font-black text-gray-950 font-sans tracking-tight\">\n              {t(\'loginTitle\')}\n            </h1>\n            <p className=\"text-xs text-gray-400 font-mono uppercase tracking-wider\">SECURE SHIELDED CONNECTION</p>\n          </div>\n\n          {/* Core Login form */}\n          <form onSubmit={handleStandardLoginSubmit} className=\"space-y-4\">\n            \n            {/* Email input field */}\n            <div className=\"space-y-1\">\n              <label className=\"text-xs font-bold text-gray-400 uppercase\">{t(\'fieldEmail\')}</label>\n              <div className=\"relative border border-gray-250 rounded-xl bg-gray-55/40 px-3.5 py-2.5 flex items-center gap-2.5 focus-within:border-brand-primary focus-within:bg-white focus-within:ring-2 focus-within:ring-brand-primary/15 transition duration-150\">\n                <Mail className=\"w-4 h-4 text-brand-primary shrink-0\" />\n                <input \n                  type=\"email\" \n                  required\n                  placeholder=\"name@business.dz\"\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none placeholder-gray-400 font-sans\"\n                  id=\"login_email_input\"\n                />\n              </div>\n            </div>\n\n            {/* Password Input field */}\n            <div className=\"space-y-1\">\n              <div className=\"flex justify-between items-center\">\n                <label className=\"text-xs font-bold text-gray-400 uppercase\">{t(\'fieldPassword\')}</label>\n                <span className=\"text-[10px] text-brand-primary font-bold hover:underline cursor-pointer\">Forgot?</span>\n              </div>\n              <div className=\"relative border border-gray-250 rounded-xl bg-gray-55/40 px-3.5 py-2.5 flex items-center gap-2.5 focus-within:border-brand-primary focus-within:bg-white focus-within:ring-2 focus-within:ring-brand-primary/15 transition duration-150\">\n                <Lock className=\"w-4 h-4 text-brand-primary shrink-0\" />\n                <input \n                  type={showPass ? \"text\" : \"password\"} \n                  required\n                  placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none placeholder-gray-400 font-mono\"\n                  id=\"login_password_input\"\n                />\n                \n                <button\n                  type=\"button\"\n                  onClick={() => setShowPass(!showPass)}\n                  className=\"p-0.5 text-gray-400 hover:text-brand-primary focus:outline-none cursor-pointer\"\n                >\n                  {showPass ? <EyeOff className=\"w-4 h-4\" /> : <Eye className=\"w-4 h-4\" />}\n                </button>\n              </div>\n            </div>\n\n            {/* Submit btn */}\n            <button\n              type=\"submit\"\n              className=\"w-full py-3 bg-brand-primary hover:bg-brand-dark text-white text-xs font-bold rounded-xl shadow-xs hover:shadow-md cursor-pointer transition flex items-center justify-center gap-1.5\"\n              id=\"login_submit_btn\"\n            >\n              <span>{t(\'loginLink\')}</span>\n              {direction === \'rtl\' ? <ArrowLeft className=\"w-4 h-4\" /> : <ArrowRight className=\"w-4 h-4\" />}\n            </button>\n\n          </form>\n\n          {/* REGISTER LINK */}\n          <p className=\"text-xs text-gray-500 text-center font-sans\">\n            {t(\'dontHaveAccount\')}{\' \'}\n            <Link to=\"/register\" className=\"text-brand-primary font-bold hover:underline\" id=\"login_to_register_link\">\n              {t(\'registerLink\')}\n            </Link>\n          </p>\n\n          {/* SIMULATED RAPID DEMONSTRATION LOGINS - EXTREMELY HELPFUL FOR DEMO ASSESSMENT */}\n          <div className=\"pt-6 border-t border-gray-150 space-y-3\">\n            <h3 className=\"text-center font-bold text-gray-400 text-[10px] uppercase tracking-wider flex items-center justify-center gap-1.5\">\n              <HelpCircle className=\"w-4 h-4 text-brand-primary shrink-0\" />\n              Instant Evaluation Logins\n            </h3>\n            \n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n              \n              <button\n                type=\"button\"\n                onClick={handleSimulateClientLogin}\n                className=\"p-3 bg-gray-50 hover:bg-brand-light hover:border-brand-primary/40 border border-gray-200 rounded-xl text-left rtl:text-right cursor-pointer transition flex items-center gap-2.5\"\n                id=\"login_demo_client_btn\"\n              >\n                <Building2 className=\"w-5 h-5 text-brand-primary shrink-0\" />\n                <div>\n                  <p className=\"text-[11px] font-bold text-gray-900 leading-tight\">SME Client Profile</p>\n                  <p className=\"text-[9px] text-gray-400\">Dzair Tech Link</p>\n                </div>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={handleSimulateProLogin}\n                className=\"p-3 bg-gray-50 hover:bg-brand-light hover:border-brand-primary/40 border border-gray-200 rounded-xl text-left rtl:text-right cursor-pointer transition flex items-center gap-2.5\"\n                id=\"login_demo_pro_btn\"\n              >\n                <UserCheck className=\"w-5 h-5 text-indigo-700 shrink-0\" />\n                <div>\n                  <p className=\"text-[11px] font-bold text-gray-901 leading-tight\">Pro Cabinet Profile</p>\n                  <p className=\"text-[9px] text-gray-400\">Me. Sofiane Benamara</p>\n                </div>\n              </button>\n\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
    }
