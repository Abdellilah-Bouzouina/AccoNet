    replacement_infos {
      original_chunk {
        target_content: "  seeDemoDashboard: {\n    ar: \"\330\262\331\212\330\247\330\261\330\251 \331\204\331\210\330\255\330\251 \330\247\331\204\330\271\331\205\331\204 \330\247\331\204\330\252\330\254\330\261\331\212\330\250\331\212\330\251\",\n    fr: \"Visiter l\'espace de d\303\251monstration\",\n    en: \"Visit Demo Workspace Dashboard\"\n  },\n  allRightsReserved: {\n    ar: \"\330\254\331\205\331\212\330\271 \330\247\331\204\330\255\331\202\331\210\331\202 \331\205\330\255\331\201\331\210\330\270\330\251. \330\252\331\205 \330\252\330\265\331\205\331\212\331\205\331\207 \330\250\331\203\331\204 \331\201\330\256\330\261 \331\204\330\256\330\257\331\205\330\251 \330\247\331\204\330\245\330\257\330\247\330\261\330\251 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212\330\251 \331\210\330\247\331\204\330\264\330\261\331\203\330\247\330\252 \330\247\331\204\330\265\330\247\330\271\330\257\330\251.\",\n    fr: \"Tous droits r\303\251serv\303\251s. Con\303\247u avec fiert\303\251 pour l\'administration et les PME en Alg\303\251rie.\",\n    en: \"All rights reserved. Styled with pride for Algerian entrepreneurs & finance agents.\"\n  }"
        replacement_content: "  seeDemoDashboard: {\n    ar: \"\330\262\331\212\330\247\330\261\330\251 \331\204\331\210\330\255\330\251 \330\247\331\204\330\271\331\205\331\204 \330\247\331\204\330\252\330\254\330\261\331\212\330\250\331\212\330\251\",\n    fr: \"Visiter l\'espace de d\303\251monstration\",\n    en: \"Visit Demo Workspace Dashboard\"\n  },\n  \n  // New Landing Page Keys\n  heroSlogan: {\n    ar: \"\330\261\330\250\330\267 \330\247\331\204\331\205\330\244\330\263\330\263\330\247\330\252 \330\250\330\243\331\201\330\266\331\204 \330\247\331\204\331\205\331\207\331\206\331\212\331\212\331\206 \330\247\331\204\331\205\330\271\330\252\331\205\330\257\331\212\331\206 \331\201\331\212 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\",\n    fr: \" \330\261\330\250\330\267 \330\247\331\204\331\205\330\244\330\263\330\263\330\247\330\252 \330\250\330\243\331\201\330\266\331\204 \330\247\331\204\331\205\331\207\331\206\331\212\331\212\331\206 \330\247\331\204\331\205\330\271\330\252\331\205\330\257\331\212\331\206 \331\201\331\212 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\",\n    en: \"Connecting enterprises with the best accredited professionals\"\n  },\n  heroBadgeText: {\n    ar: \"\331\205\331\206\330\265\330\251 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\330\251 \330\247\331\204\330\261\331\202\331\205\331\212\330\251 \330\247\331\204\330\243\331\210\331\204\331\211 \342\200\242 AccoNet\",\n    fr: \"1\303\250re Plateforme de Comptabilit\303\251 Digitale \342\200\242 AccoNet\",\n    en: \"First Digital Accounting Platform \342\200\242 AccoNet\"\n  },\n  heroConsultantCard: {\n    ar: \"\330\250\330\267\330\247\331\202\330\251 \330\247\331\204\330\256\330\250\331\212\330\261 \330\247\331\204\331\206\330\264\330\267\",\n    fr: \"Fiche du Consultant Actif\",\n    en: \"Active Consultant Card\"\n  },\n  availableImmediately: {\n    ar: \"\331\205\330\252\330\247\330\255 \331\201\331\210\330\261\330\247\331\213 \331\204