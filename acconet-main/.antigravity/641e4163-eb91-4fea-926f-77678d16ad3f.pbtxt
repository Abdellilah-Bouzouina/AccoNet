    replacement_chunks {
      replacement_content: "export interface TranslationDictionary {\n  [key: string]: {\n    ar: string;\n    fr: string;\n    en: string;\n  };\n}\n\nexport const specialtiesTranslations = {\n  \"chartered-accountant\": {\n    ar: \"\331\205\330\255\330\247\330\263\330\250 \331\205\330\271\330\252\331\205\330\257\",\n    fr: \"Comptable Agr\303\251\303\251\",\n    en: \"Certified Accountant\"\n  },\n  \"statutory-auditor\": {\n    ar: \"\331\205\330\255\330\247\331\201\330\270 \330\255\330\263\330\247\330\250\330\247\330\252\",\n    fr: \"Commissaire aux Comptes\",\n    en: \"Statutory Auditor\"\n  },\n  \"certified-accountant\": {\n    ar: \"\330\256\330\250\331\212\330\261 \331\205\330\255\330\247\330\263\330\250\",\n    fr: \"Expert-Comptable\",\n    en: \"Chartered Accountant\"\n  },\n  \"tax-consultant\": {\n    ar: \"\331\205\330\263\330\252\330\264\330\247\330\261 \330\254\330\250\330\247\330\246\331\212\",\n    fr: \"Conseiller Fiscal\",\n    en: \"Tax Consultant\"\n  },\n  \"judicial-expert\": {\n    ar: \"\330\256\330\250\331\212\330\261 \331\202\330\266\330\247\330\246\331\212\",\n    fr: \"Expert Judiciaire\",\n    en: \"Judicial Expert\"\n  }\n};\n\nexport const translations: TranslationDictionary = {\n  // Navigation / AccoNet Brand\n  brandName: {\n    ar: \"\330\243\331\203\331\210\331\206\331\212\330\252\",\n    fr: \"AccoNet\",\n    en: \"AccoNet\"\n  },\n  brandSlogan: {\n    ar: \"\330\243\331\210\331\204 \331\205\331\206\330\265\330\251 \330\261\331\202\331\205\331\212\330\251 \331\204\331\205\331\207\331\206\331\212\331\212 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\330\251 \331\210\330\247\331\204\330\254\330\250\330\247\331\212\330\251 \331\201\331\212 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\",\n    fr: \"1\303\250re plateforme des professionnels du chiffre et de la fiscalit\303\251 en Alg\303\251rie\",\n    en: \"Algeria\'s 1st digital network for accounting & tax professionals\"\n  },\n  findProButton: {\n    ar: \"\330\245\331\212\330\254\330\247\330\257 \330\256\330\250\331\212\330\261\",\n    fr: \"Trouver un Expert\",\n    en: \"Find an Expert\"\n  },\n  joinAsProButton: {\n    ar: \"\330\247\331\206\330\266\331\205\330\247\331\205 \331\203\330\256\330\250\331\212\330\261\",\n    fr: \"Rejoindre comme Pro\",\n    en: \"Join as Pro\"\n  },\n  toolsLink: {\n    ar: \"\330\247\331\204\330\243\330\257\331\210\330\247\330\252 \330\247\331\204\330\260\331\203\331\212\330\251\",\n    fr: \"Outils Intelligents\",\n    en: \"AI Tools\"\n  },\n  searchLink: {\n    ar: \"\330\250\330\255\330\253\",\n    fr: \"Recherche\",\n    en: \"Search\"\n  },\n  loginLink: {\n    ar: \"\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\257\330\256\331\210\331\204\",\n    fr: \"Connexion\",\n    en: \"Log In\"\n  },\n  registerLink: {\n    ar: \"\331\201\330\252\330\255 \330\255\330\263\330\247\330\250\",\n    fr: \"Inscription\",\n    en: \"Register\"\n  },\n  logout: {\n    ar: \"\330\252\330\263\330\254\331\212\331\204 \330\247\331\204\330\256\330\261\331\210\330\254\",\n    fr: \"D\303\251connexion\",\n    en: \"Log Out\"\n  },\n  about: {\n    ar: \"\330\255\331\210\331\204\",\n    fr: \"\303\200 propos\",\n    en: \"About\"\n  },\n\n  // Landing Page Hero\n  heroTitle: {\n    ar: \"\330\254\330\257 \330\243\331\201\330\266\331\204 \330\247\331\204\330\264\330\261\331\203\330\247\330\241 \330\247\331\204\331\205\330\247\331\204\331\212\331\212\331\212\331\206 \331\210\330\247\331\204\331\205\330\255\330\247\330\263\330\250\331\212\331\212\331\206 \331\204\330\264\330\261\331\203\330\252\331\203 \331\201\331\212 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\",\n    fr: \"Trouvez le meilleur partenaire comptable & fiscal pour votre entreprise en Alg\303\251rie\",\n    en: \"Find the Best Accounting & Tax Partners for Your Business in Algeria\"\n  },\n  heroSubtitle: {\n    ar: \"\331\205\331\206\330\265\330\251 \330\252\330\261\330\250\330\267 \330\250\331\212\331\206 \330\247\331\204\331\205\330\265\330\247\331\206\330\271\330\214 \330\247\331\204\331\205\330\244\330\263\330\263\330\247\330\252 \330\247\331\204\331\206\330\247\330\264\330\246\330\251 \331\210\330\247\331\204\331\205\330\265\330\247\331\204\330\255 \330\247\331\204\330\255\330\261\330\251 \331\205\330\271 \331\205\331\203\330\247\330\252\330\250 \330\256\330\250\330\261\330\251 \331\205\330\255\330\247\330\263\330\250\331\212\330\251 \331\210\331\205\330\263\330\252\330\264\330\247\330\261\331\212\331\206 \330\254\330\250\330\247\330\246\331\212\331\212\331\206 \331\205\330\271\330\252\331\205\330\257\331\212\331\206 \330\271\330\250\330\261 48 \331\210\331\204\330\247\331\212\330\251.\",\n    fr: \"Une plateforme d\'\303\251lite reliant PME, startups et coop\303\251ratives avec des experts-comptables agr\303\251\303\251s et conseillers fiscaux sur les 48 wilayas.\",\n    en: \"An elite platform connecting SMEs, startups, and agricultural coops with certified chartered accountants and tax advisers across all 48 wilayas.\"\n  },\n  heroSearchPlaceholder: {\n    ar: \"\331\205\330\253\330\247\331\204: \331\205\331\212\330\262\330\247\331\206\331\212\330\251 \330\263\331\206\331\210\331\212\330\251\330\214 G50\330\214 \330\243\330\263\330\271\330\247\330\261 \330\252\330\255\331\210\331\212\331\204...\",\n    fr: \"Ex: bilan annuel, audit, d\303\251claration G50...\",\n    en: \"Ex: annual balance sheet, G50, transfer pricing...\"\n  },\n  allWilayas: {\n    ar: \"\331\203\331\204 \330\247\331\204\331\210\331\204\330\247\331\212\330\247\330\252\",\n    fr: \"Toutes les Wilayas\",\n    en: \"All Wilayas\"\n  },\n  allSpecialties: {\n    ar: \"\331\203\331\204 \330\247\331\204\330\252\330\256\330\265\330\265\330\247\330\252\",\n    fr: \"Toutes les Sp\303\251cialit\303\251s\",\n    en: \"All Specialties\"\n  },\n  searchBtn: {\n    ar: \"\330\247\330\250\330\255\330\253 \330\247\331\204\330\242\331\206\",\n    fr: \"Rechercher\",\n    en: \"Search Now\"\n  },\n\n  // Stats Counters\n  statPros: {\n    ar: \"+120 \330\256\330\250\331\212\330\261 \331\205\330\271\330\252\331\205\330\257\",\n    fr: \"+120 Experts Agr\303\251\303\251s\",\n    en: \"+120 Approved Experts\"\n  },\n  statProsSub: {\n    ar: \"\331\205\330\263\330\254\331\204\331\212\331\206 \331\201\331\212 \330\247\331\204\331\205\331\206\330\270\331\205\330\247\330\252 \330\247\331\204\331\210\330\267\331\206\331\212\330\251\",\n    fr: \"Inscrits aux conseils nationaux\",\n    en: \"Registered in national boards\"\n  },\n  statWilayas: {\n    ar: \"48 \331\210\331\204\330\247\331\212\330\251 \331\205\330\272\330\267\330\247\330\251\",\n    fr: \"48 Wilayas Couvertes\",\n    en: \"48 Wilayas Covered\"\n  },\n  statWilayasSub: {\n    ar: \"\331\205\331\206 \330\247\331\204\330\271\330\247\330\265\331\205\330\251 \330\245\331\204\331\211 \330\252\331\205\331\206\330\261\330\247\330\263\330\252\",\n    fr: \"D\'Alger \303\240 Tamanrasset\",\n    en: \"From Algiers to Tamanrasset\"\n  },\n  statBusinesses: {\n    ar: \"+450 \330\264\330\261\331\203\330\251 \331\205\330\263\330\252\331\201\331\212\330\257\330\251\",\n    fr: \"+450 PME Accompagn\303\251es\",\n    en: \"+450 Supported SMEs\"\n  },\n  statBusinessesSub: {\n    ar: \"\330\264\330\261\331\203\330\247\330\252 \330\252\331\203\331\206\331\210\331\204\331\210\330\254\331\212\330\251 \331\210\331\205\330\244\330\263\330\263\330\247\330\252 \330\265\331\206\330\247\330\271\331\212\330\251\",\n    fr: \"Startups et industries majeures\",\n    en: \"SaaS startups and manufacturers\"\n  },\n\n  // Featured Pros\n  featuredTitle: {\n    ar: \"\330\243\330\250\330\261\330\262 \330\247\331\204\330\256\330\250\330\261\330\247\330\241 \330\247\331\204\331\205\330\252\330\247\330\255\331\212\331\206 \331\207\330\260\330\247 \330\247\331\204\330\243\330\263\330\250\331\210\330\271\",\n    fr: \"Experts vedettes disponibles cette semaine\",\n    en: \"Featured Available Experts of the Week\"\n  },\n  featuredSubtitle: {\n    ar: \"\331\205\331\204\331\201\330\247\330\252 \330\264\330\256\330\265\331\212\330\251 \330\252\331\205 \330\247\331\204\330\252\330\255\331\202\331\202 \331\205\331\206 \330\243\330\263\331\205\330\247\330\246\331\207\330\247\330\214 \330\243\330\261\331\202\330\247\331\205 \330\247\330\271\330\252\331\205\330\247\330\257\331\207\330\247\330\214 \331\210\330\252\331\202\331\212\331\212\331\205\330\247\330\252\331\207\330\247 \330\247\331\204\330\255\331\202\331\212\331\202\331\212\330\251 \331\205\331\206 \330\267\330\261\331\201 \331\205\330\257\330\261\330\247\330\241 \330\264\330\261\331\203\330\247\330\252 \330\254\330\262\330\247\330\246\330\261\331\212\330\251.\",\n    fr: \"Profils v\303\251rifi\303\251s avec num\303\251ro d\'agr\303\251ment officiel et notes authentiques \303\251mises par des chefs d\'entreprise.\",\n    en: \"Verified profiles with official accreditation number and genuine ratings from local company executives.\"\n  },\n\n  // How it works\n  howTitle: {\n    ar: \"\331\203\331\212\331\201 \330\252\330\271\331\205\331\204 \331\205\331\206\330\265\330\251 \330\243\331\203\331\210\331\206\331\212\330\252\330\237\",\n    fr: \"Comment fonctionne AccoNet ?\",\n    en: \"How does AccoNet work?\"\n  },\n  howStep1Title: {\n    ar: \"1. \330\255\330\257\330\257 \330\247\330\255\330\252\331\212\330\247\330\254\331\203 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\331\212\",\n    fr: \"1. D\303\251crivez votre besoin\",\n    en: \"1. Describe Your Accounting Need\"\n  },\n  howStep1Desc: {\n    ar: \"\330\247\330\256\330\252\330\261 \331\206\331\210\330\271 \330\247\331\204\330\256\330\257\331\205\330\251 \330\247\331\204\330\252\331\212 \330\252\330\250\330\255\330\253 \330\271\331\206\331\207\330\247: \330\252\330\271\330\250\330\246\330\251 G50 \330\264\331\207\330\261\331\212\330\251\330\214 \330\252\330\257\331\202\331\212\331\202 \330\255\330\263\330\247\330\250\330\247\330\252\330\214 \330\243\331\210 \331\205\330\261\330\247\331\201\331\202\330\251 \330\254\330\250\330\247\330\246\331\212\330\251 \331\210\331\202\330\247\331\206\331\210\331\206\331\212\330\251.\",\n    fr: \"Choisissez le service requis: tenue de comptes, liasse fiscale, r\303\251gularisation d\'imp\303\264ts.\",\n    en: \"Select the required services: monthly bookkeeping, final fiscal return, tax regularizations.\"\n  },\n  howStep2Title: {\n    ar: \"2. \331\202\330\247\330\261\331\206 \330\250\331\212\331\206 \330\247\331\204\330\256\330\250\330\261\330\247\330\241 \330\247\331\204\331\205\330\271\330\252\331\205\330\257\331\212\331\206\",\n    fr: \"2. Comparez les experts\",\n    en: \"2. Compare Verified Experts\"\n  },\n  howStep2Desc: {\n    ar: \"\330\252\330\265\331\201\330\255 \331\205\331\203\330\247\330\252\330\250 \330\247\331\204\330\256\330\250\330\261\330\251 \330\247\331\204\330\255\331\202\331\212\331\202\331\212\330\251\330\214 \331\202\330\247\330\261\331\206 \330\252\331\203\331\204\331\201\330\251 \330\247\331\204\330\263\330\247\330\271\330\251\330\214 \330\263\331\206\331\210\330\247\330\252 \330\247\331\204\330\256\330\250\330\261\330\251\330\214 \330\247\331\204\331\205\330\261\330\247\330\254\330\271\330\247\330\252\330\214 \331\210\330\243\330\271\330\257\330\247\330\257 \331\205\331\204\331\201\330\247\330\252 \330\247\331\204\330\271\331\205\331\204\330\247\330\241 \330\247\331\204\330\263\330\247\330\250\331\202\330\251.\",\n    fr: \"Parcourez les agr\303\251ments r\303\251els, les tarifs horaires, les ann\303\251es d\'exp\303\251rience et les avis de clients.\",\n    en: \"Browse verified credentials, hourly rates, years in practice, and real client reviews.\"\n  },\n  howStep3Title: {\n    ar: \"3. \330\252\330\271\330\247\331\202\330\257 \331\203\331\204\331\212\330\247\331\213 \330\250\330\243\331\205\330\247\331\206\",\n    fr: \"3. Cr\303\251ez un contrat transparent\",\n    en: \"3. Lock in Secure Contracts\"\n  },\n  howStep3Desc: {\n    ar: \"\331\210\331\201\330\261\331\206\330\247 \330\250\331\212\330\246\330\251 \330\261\331\202\331\205\331\212\330\251 \331\204\330\265\331\212\330\247\330\272\330\251 \330\255\330\257\331\210\330\257 \330\247\331\204\331\205\331\207\330\247\331\205 \331\210\330\252\331\210\331\202\331\212\330\252\331\207\330\247 \331\210\330\247\331\204\330\247\331\204\330\252\330\262\330\247\331\205\330\247\330\252 \330\247\331\204\331\205\330\247\331\204\331\212\330\251 \330\250\330\264\331\203\331\204 \330\261\330\263\331\205\331\212 \331\210\331\205\330\253\330\250\330\252.\",\n    fr: \"Nous g\303\251n\303\251rons des contrats types s\303\251curis\303\251s avec livrables, jalons et budgets clairs.\",\n    en: \"We deploy standard digital engagement letters with unambiguous scopes, deadlines, and project fees.\"\n  },\n  howStep4Title: {\n    ar: \"4. \330\252\330\252\330\250\330\271 \330\247\331\204\330\245\331\206\330\254\330\247\330\262 \331\210\330\247\330\257\331\201\330\271 \330\250\330\263\331\207\331\210\331\204\330\251\",\n    fr: \"4. Suivez et collaborez\",\n    en: \"4. Track Progress & Collaborate\"\n  },\n  howStep4Desc: {\n    ar: \"\330\261\330\247\331\202\330\250 \330\263\331\212\330\261 \330\252\330\263\331\204\331\212\331\205 \330\247\331\204\330\252\330\265\330\261\331\212\330\255\330\247\330\252 \331\202\330\250\331\204 \330\247\331\206\331\202\330\266\330\247\330\241 \330\247\331\204\331\205\331\210\330\247\330\271\331\212\330\257 \330\247\331\204\330\254\330\250\330\247\330\246\331\212\330\251 \330\271\330\250\330\261 \331\204\331\210\330\255\330\251 \330\252\330\252\330\250\330\271 \330\252\331\201\330\247\330\271\331\204\331\212\330\251 \331\201\331\212 \330\272\330\247\331\212\330\251 \330\247\331\204\330\250\330\263\330\247\330\267\330\251 \331\210\330\247\331\204\330\260\331\203\330\247\330\241.\",\n    fr: \"Visualisez les \303\251tapes cl\303\251s et \303\251ch\303\251ances CNAS/G50 via votre tableau de bord interactif.\",\n    en: \"Preview critical milestones, tax due dates, and CNAS filings through your shared smart dashboard.\"\n  },\n\n  // AI Tools Teaser\n  toolsTitle: {\n    ar: \"\330\243\330\257\331\210\330\247\330\252 \330\247\331\204\330\260\331\203\330\247\330\241 \330\247\331\204\330\247\330\265\330\267\331\206\330\247\330\271\331\212 \331\210\330\247\331\204\331\205\330\255\330\247\330\263\330\250\330\251 \330\247\331\204\330\260\331\203\331\212\330\251\",\n    fr: \"Outils Intelligents & Simulateurs de Gestion\",\n    en: \"Smart Tools & Tax Simulators\"\n  },\n  toolsSubtitle: {\n    ar: \"\331\210\331\201\330\261\331\206\330\247 \331\204\331\203 \330\243\330\257\331\210\330\247\330\252 \331\205\330\252\330\267\331\210\330\261\330\251 \331\204\330\252\330\250\330\263\331\212\330\267 \330\247\331\204\331\205\331\207\330\247\331\205 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\331\212\330\251 \330\247\331\204\331\212\331\210\331\205\331\212\330\251 \331\205\330\255\331\204\331\212\330\247\331\213. \330\254\330\261\330\250 \331\205\330\255\330\247\331\203\330\247\330\251 \330\247\331\204\330\252\330\265\330\261\331\212\330\255\330\247\330\252 \331\210\331\201\330\255\330\265 \330\247\331\204\331\210\330\253\330\247\330\246\331\202 \331\201\331\210\330\261\331\212\330\247\331\213.\",\n    fr: \"D\303\251couvrez nos d\303\251monstrations d\'automatisation comptable adapt\303\251es \303\240 la r\303\251glementation alg\303\251rienne.\",\n    en: \"Explore custom interactive tools tuned to Algerian regulations, available exclusively online.\"\n  },\n  tryToolBtn: {\n    ar: \"\330\252\330\254\330\261\330\250\330\251 \330\247\331\204\330\243\330\257\330\247\330\251 \330\247\331\204\330\252\331\201\330\247\330\271\331\204\331\212\330\251\",\n    fr: \"D\303\251marrer l\'outil Interactif\",\n    en: \"Try Interactive Tool\"\n  },\n\n  // Search screen\n  searchTitle: {\n    ar: \"\330\247\331\204\330\250\330\255\330\253 \330\271\331\206 \330\247\331\204\331\205\331\207\331\206\331\212\331\212\331\206 \331\210\330\247\331\204