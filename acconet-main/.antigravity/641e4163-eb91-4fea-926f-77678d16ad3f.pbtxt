        lines {
          text: "      quoteAR: \"\331\205\330\271 \330\255\330\265\331\210\331\204\331\212 \330\271\331\204\331\211 \330\250\330\267\330\247\331\202\330\251 \330\247\331\204\331\205\331\202\330\247\331\210\331\204 \330\247\331\204\330\260\330\247\330\252\331\212\330\214 \331\210\330\247\330\254\331\207\330\252\331\206\331\212 \330\252\330\263\330\247\330\244\331\204\330\247\330\252 \330\250\330\256\330\265\331\210\330\265 \330\247\331\204\330\266\330\261\331\212\330\250\330\251 \330\247\331\204\330\254\330\262\330\247\331\201\331\212\330\251 \330\247\331\204\331\210\330\255\331\212\330\257\330\251 (IFU) \330\247\331\204\331\205\331\202\330\257\330\261\330\251 \330\250\331\200 5\331\252. \331\210\330\254\331\207\331\206\331\212 \331\205\330\263\330\252\330\264\330\247\330\261 \330\254\330\250\330\247\330\246\331\212 \331\207\331\206\330\247 \331\210\330\265\330\255\330\255 \330\256\330\267\330\251 \330\247\331\204\330\252\330\265\330\261\331\212\330\255 \330\247\331\204\330\263\331\206\331\210\331\212.\","
