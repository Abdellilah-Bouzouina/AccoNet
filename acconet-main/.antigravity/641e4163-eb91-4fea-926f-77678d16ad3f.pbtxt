    replacement_infos {
      original_chunk {
        target_content: "    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\" id=\"tools_page_wrapper\">\n      \n      {/* Title Header */}\n      <div className=\"bg-white border border-gray-150 p-6 sm:p-8 rounded-3xl shadow-xs mb-10 text-center space-y-4\">\n        <div className=\"inline-flex items-center gap-1.5 px-3.5 py-1 text-xs font-semibold bg-brand-light text-brand-primary rounded-full uppercase\">\n          <Cpu className=\"w-4 h-4 animate-spin text-brand-primary\" />\n          <span>Interactive Sandbox</span>\n        </div>\n        <h1 className=\"text-2xl sm:text-3xl font-extrabold text-gray-950 font-sans tracking-tight\">\n          {t(\'aiToolsHeroTitle\')}\n        </h1>\n        <p className=\"text-sm text-gray-500 max-w-2xl mx-auto leading-relaxed\">\n          {t(\'aiToolsHeroSub\')}\n        </p>\n      </div>\n\n      {/* Grid Layout containing tools & live simulator outputs */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* Left Column (col-span-5) - The 6 Tool Cards */}\n        <div className=\"lg:col-span-5 space-y-3\">\n          {toolsList.map((tool) => {\n            const Icon = tool.icon;\n            const isExpanded = expandedTool === tool.id;\n\n            return (\n              <div \n                key={tool.id}\n                onClick={() => {\n                  setExpandedTool(tool.id);\n                  setSimulationResult(null); // Clear previous outputs to prompt action\n                }}\n                className={`border rounded-2xl p-5 cursor-pointer transition-all duration-150 ${isExpanded ? \'bg-white border-brand-primary shadow-sm ring-1 ring-brand-primary/15\' : \'bg-white border-gray-150 hover:bg-gray-55/40\'}`}\n              >\n                <div className=\"flex justify-between items-center mb-2\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className={`w-10 h-10 rounded-xl border flex items-center justify-center shrink-0 ${tool.color}`}>\n                      <Icon className=\"w-5 h-5\" />\n                    </div>\n                    <h3 className=\"font-bold text-gray-901 text-sm\">{tObj(tool.title)}</h3>\n                  </div>\n                  \n                  {isExpanded ? <ChevronUp className=\"w-4 h-4 text-brand-primary\" /> : <ChevronDown className=\"w-4 h-4 text-gray-400\" />}\n                </div>\n\n                <p className=\"text-gray-500 text-xs leading-normal\">\n                  {tObj(tool.desc)}\n                </p>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Right Column (col-span-7) - Live Simulation Interactive Control Window */}\n        <div className=\"lg:col-span-7 bg-white border border-gray-150 rounded-3xl p-6 sm:p-8 shadow-sm space-y-6 sticky top-20\">\n          \n          {expandedTool !== null ? (\n            <>\n              {/* Dynamic Action Header depending on tool */}\n              <div className=\"pb-4 border-b border-gray-100 flex items-center justify-between gap-3\">\n                <div>\n                  <h2 className=\"font-extrabold text-brand-primary text-base\">\n                    \342\232\231\357\270\217 Active Simulator: {tObj(toolsList[expandedTool].title)}\n                  </h2>\n                  <p className=\"text-[10px] text-gray-400 font-mono tracking-wider mt-0.5 uppercase\">ALGERIA COMPLIANCE sandbox</p>\n                </div>\n                <span className=\"text-xs bg-brand-light text-brand-primary px-2.5 py-1 rounded font-bold\">Simulator v2.1</span>\n              </div>\n\n              {/* Dynamic input widgets depending on selected tool */}"
        replacement_content: "    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\" id=\"tools_page_wrapper\">\n      \n      {/* Title Header */}\n      <div className=\"bg-white border border-[#CFCFC4] p-6 sm:p-8 rounded-none shadow-2xs mb-10 text-center space-y-4\">\n        <div className=\"inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono bg-brand-light text-brand-primary rounded-none uppercase tracking-wider\">\n          <Cpu className=\"w-4 h-4 animate-spin text-brand-primary\" />\n          <span>Interactive Sandbox</span>\n        </div>\n        <h1 className=\"text-2xl sm:text-3xl font-serif font-semibold text-gray-950 tracking-tight\">\n          {t(\'aiToolsHeroTitle\')}\n        </h1>\n        <p className=\"text-sm text-gray-500 max-w-2xl mx-auto leading-relaxed\">\n          {t(\'aiToolsHeroSub\')}\n        </p>\n      </div>\n\n      {/* Grid Layout containing tools & live simulator outputs */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* Left Column (col-span-5) - The 6 Tool Cards */}\n        <div className=\"lg:col-span-5 space-y-3\">\n          {toolsList.map((tool) => {\n            const Icon = tool.icon;\n            const isExpanded = expandedTool === tool.id;\n\n            return (\n              <div \n                key={tool.id}\n                onClick={() => {\n                  setExpandedTool(tool.id);\n                  setSimulationResult(null); // Clear previous outputs to prompt action\n                }}\n                className={`border rounded-none p-5 cursor-pointer transition-all duration-150 ${isExpanded ? \'bg-white border-brand-primary shadow-2xs ring-1 ring-brand-primary/15\' : \'bg-white border-[#CFCFC4] hover:bg-gray-50\'}`}\n              >\n                <div className=\"flex justify-between items-center mb-2\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className={`w-10 h-10 rounded-none border flex items-center justify-center shrink-0 ${tool.color}`}>\n                      <Icon className=\"w-5 h-5\" />\n                    </div>\n                    <h3 className=\"font-serif font-bold text-gray-900 text-sm\">{tObj(tool.title)}</h3>\n                  </div>\n                  \n                  {isExpanded ? <ChevronUp className=\"w-4 h-4 text-brand-primary\" /> : <ChevronDown className=\"w-4 h-4 text-gray-400\" />}\n                </div>\n\n                <p className=\"text-gray-500 text-xs leading-normal\">\n                  {tObj(tool.desc)}\n                </p>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Right Column (col-span-7) - Live Simulation Interactive Control Window */}\n        <div className=\"lg:col-span-7 bg-white border border-[#CFCFC4] rounded-none p-6 sm:p-8 shadow-2xs space-y-6 sticky top-20\">\n          \n          {expandedTool !== null ? (\n            <>\n              {/* Dynamic Action Header depending on tool */}\n              <div className=\"pb-4 border-b border-[#EBEBE5] flex items-center justify-between gap-3\">\n                <div>\n                  <h2 className=\"font-serif font-semibold text-brand-primary text-base\">\n                    \342\232\231\357\270\217 Active Simulator: {tObj(toolsList[expandedTool].title)}\n                  </h2>\n                  <p className=\"text-[10px] text-gray-400 font-mono tracking-wider mt-0.5 uppercase\">ALGERIA COMPLIANCE sandbox</p>\n                </div>\n                <span className=\"text-xs bg-brand-light text-brand-primary px-2.5 py-1 rounded-none font-mono tracking-wider\">v2.1</span>\n              </div>\n\n              {/* Dynamic input widgets depending on selected tool */}"
