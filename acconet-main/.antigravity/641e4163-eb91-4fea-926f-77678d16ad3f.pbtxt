    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Link } from \'react-router-dom\';\nimport { Professional } from \'../data/mockData\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { Star, ShieldCheck, MapPin, Award, ArrowLeft, ArrowRight, Gavel, Scale, NotebookTabs, Landmark } from \'lucide-react\';\n\ninterface ProfessionalCardProps {\n  professional: Professional;\n}\n\nexport const ProfessionalCard: React.FC<ProfessionalCardProps> = ({ professional }) => {\n  const { direction, t, tSpec, tObj, language } = useLanguage();\n\n  // Deduce specialty category variant\n  const isVariantA = professional.specialty === \'certified-accountant\' || professional.specialty === \'statutory-auditor\';\n  const isVariantB = professional.specialty === \'tax-consultant\' || professional.specialty === \'judicial-expert\';\n  const isVariantC = professional.specialty === \'chartered-accountant\'; // Comptroller Agr\303\251\303\251 / Comptable Agr\303\251\303\251\n\n  // Predefined service badges highlight lists\n  let serviceBadges: string[] = [\'Comptabilit\303\251 G\303\251n\303\251rale\', \'SCF Compliant\'];\n  let variantHeaderLabel = \'\';\n  let variantBadgeMarkup = null;\n\n  if (isVariantA) {\n    serviceBadges = language === \'ar\' \n      ? [\'\331\205\331\212\330\262\330\247\331\206\331\212\330\251 \331\205\330\254\331\205\330\271\330\251\', \'\330\247\331\204\331\205\330\255\330\247\331\201\330\270\330\251 \330\271\331\204\331\211 \330\247\331\204\330\255\330\263\330\247\330\250\330\247\330\252\', \'\330\252\330\265\330\261\331\212\330\255\330\247\330\252 SCF\']\n      : [\'Bilan Annuel\', \'Commissariat\', \'Liasse SCF\'];\n    variantHeaderLabel = language === \'ar\' \n      ? \'\342\232\234\357\270\217 \331\205\331\203\330\252\330\250 \331\205\330\271\330\252\331\205\330\257 \331\205\331\206 \330\247\331\204\331\207\331\212\330\246\330\251 \330\247\331\204\331\210\330\267\331\206\331\212\330\251 \331\204\331\204\331\206\331\202\330\247\330\250\330\251\'\n      : \"\342\232\234\357\270\217 Membre de l\'Ordre National\";\n    variantBadgeMarkup = (\n      <span className=\"inline-flex items-center gap-1 px-2 py-0.5 bg-indigo-50 border border-indigo-150 text-indigo-700 text-[9px] font-mono leading-none tracking-wider font-extrabold uppercase shrink-0\">\n        <Landmark className=\"w-2.5 h-2.5\" />\n        {professional.specialty === \'certified-accountant\' ? \'ONEC AGR\303\211\303\211\' : \'ONCC MEMBER\'}\n      </span>\n    );\n  } else if (isVariantB) {\n    serviceBadges = language === \'ar\'\n      ? [\'\330\247\330\263\330\252\330\264\330\247\330\261\330\247\330\252 \330\254\330\250\330\247\330\246\331\212\330\251\', \'\330\256\330\250\330\261\330\251 \331\202\330\266\330\247\330\246\331\212\330\251\', \'\331\206\330\262\330\247\330\271\330\247\330\252 \330\247\331\204\330\266\330\261\330\247\330\246\330\250\']\n      : [\'Conseil Fiscal\', \'Expertise Judiciaire\', \'Recours DGI\'];\n    variantHeaderLabel = language === \'ar\'\n      ? \'\342\232\226\357\270\217 \331\205\330\271\330\252\331\205\330\257 \331\204\330\257\331\211 \331\210\330\262\330\247\330\261\330\251 \330\247\331\204\330\271\330\257\331\204 \331\210\330\247\331\204\330\266\330\261\330\247\330\246\330\250\'\n      : \'\342\232\226\357\270\217 Minist\303\250re de la Justice / DGI\';\n    variantBadgeMarkup = (\n      <span className=\"inline-flex items-center gap-1 px-2 py-0.5 bg-amber-50 border border-amber-100 text-amber-800 text-[9px] font-mono leading-none font-bold uppercase shrink-0\">\n        <Gavel className=\"w-2.5 h-2.5\" />\n        DGI CERTIFI\303\211\n      </span>\n    );\n  } else if (isVariantC) {\n    serviceBadges = language === \'ar\' \n      ? [\'\331\205\330\263\331\203 \330\247\331\204\330\257\331\201\330\247\330\252\330\261\', \'\330\252\330\265\330\261\331\212\330\255\330\247\330\252 G50\', \'\330\247\331\204\330\266\331\205\330\247\331\206 \330\247\331\204\330\247\330\254\330\252\331\205\330\247\330\271\331\212 CNAS\']\n      : [\'Tenue Comptable\', \'D\303\251clarations G50\', \'CNAS & CASNOS\'];\n    variantHeaderLabel = language === \'ar\'\n      ? \'\360\237\222\274 \331\205\331\206\330\247\330\263\330\250 \331\204\331\204\331\205\330\244\330\263\330\263\330\247\330\252 \330\247\331\204\330\265\330\272\331\212\330\261\330\251 \331\210\330\247\331\204\331\205\330\252\331\210\330\263\330\267\330\251\'\n      : \'\360\237\237\242 Accessible PME / TPE\';\n    variantBadgeMarkup = (\n      <span className=\"inline-flex items-center gap-1 px-2 py-0.5 bg-emerald-50 border border-emerald-150 text-emerald-800 text-[9px] font-mono leading-none font-bold uppercase shrink-0\">\n        Accessible PME\n      </span>\n    );\n  }\n\n  return (\n    <div \n      className={`bg-white border rounded-none shadow-2xs hover:shadow-xs transition-all duration-300 p-5 flex flex-col justify-between relative ${\n        isVariantA \n          ? \'border-[#CFCFC4] hover:border-indigo-650 ring-1 ring-transparent hover:ring-indigo-750/15\' \n          : isVariantB \n            ? \'border-[#CFCFC4] hover:border-amber-600 ring-1 ring-transparent hover:ring-amber-500/10\'\n            : \'border-[#CFCFC4] hover:border-[#0F6E56]\'\n      }`}\n      id={`pro_card_${professional.id}`}\n    >\n      \n      {/* Editorial Variant Header Line */}\n      {variantHeaderLabel && (\n        <div className=\"absolute top-0 left-0 right-0 h-4 px-3 bg-[#FAF9F5] border-b border-[#EBEBE5] flex items-center justify-between\">\n          <span className=\"text-[8px] font-mono font-bold text-gray-400 uppercase tracking-widest leading-none\">\n            {variantHeaderLabel}\n          </span>\n          <span className=\"text-[8px] font-mono font-extrabold text-[#0F6E56] tracking-wide\">\n            ALGERIA SCF 2026\n          </span>\n        </div>\n      )}\n\n      <div className=\"pt-2\">\n        \n        {/* Header - Avatar & Status */}\n        <div className=\"flex justify-between items-start mb-3.5 pt-1.5\">\n          <div className=\"flex items-center gap-3\">\n            {/* Visual Avatar with initials */}\n            <div className={`w-11 h-11 rounded-none flex items-center justify-center font-bold text-xs tracking-widest shrink-0 border border-[#CFCFC4] ${professional.avatarBg}`}>\n              {professional.initials}\n            </div>\n            \n            <div className=\"space-y-0.5\">\n              <h3 className=\"font-serif font-black text-gray-901 text-sm sm:text-base leading-tight hover:text-brand-primary transition\">\n                {tObj(professional.name)}\n              </h3>\n              \n              <div className=\"flex items-center gap-1.5 flex-wrap\">\n                <p className=\"text-[11px] text-brand-primary font-bold leading-none\">\n                  {tSpec(professional.specialty)}\n                </p>\n                {variantBadgeMarkup}\n              </div>\n            </div>\n          </div>\n\n          {/* Availability Pulse Badge */}\n          {professional.available ? (\n            <span className=\"flex items-center gap-1 px-1.5 py-0.5 bg-teal-50 border border-teal-150 text-teal-800 text-[9px] font-mono leading-none uppercase shrink-0\">\n              <span className=\"w-1.5 h-1.5 bg-teal-600 rounded-full animate-pulse\"></span>\n              Disponible\n            </span>\n          ) : (\n            <span className=\"px-1.5 py-0.5 bg-gray-50 border border-gray-150 text-gray-450 text-[9px] font-mono leading-none uppercase shrink-0\">\n              Occup\303\251\n            </span>\n          )}\n        </div>\n\n        {/* Bio summary block */}\n        <p className=\"text-gray-500 text-[11px] leading-relaxed line-clamp-2 mb-3 h-8\" title={tObj(professional.bio)}>\n          {tObj(professional.bio)}\n        </p>\n\n        {/* Highlight Bullet Sub-Services */}\n        <div className=\"flex flex-wrap gap-1.5 mb-3.5\">\n          {serviceBadges.map((badge, idx) => (\n            <span \n              key={idx}\n              className={`text-[9px] font-mono px-2 py-0.5 border ${\n                isVariantA \n                  ? \'bg-indigo-50/30 text-indigo-805 border-indigo-150/40\' \n                  : isVariantB \n                    ? \'bg-amber-50/30 text-amber-805 border-amber-150/40\'\n                    : \'bg-[#FAF9F5] text-gray-600 border-[#EBEBE5]\'\n              }`}\n            >\n              \342\200\242 {badge}\n            </span>\n          ))}\n        </div>\n\n        {/* Essential Info Badges */}\n        <div className=\"grid grid-cols-2 gap-2 my-3 pt-3 border-t border-[#EBEBE5]/85\">\n          \n          {/* Wilaya location */}\n          <div className=\"flex items-center gap-1.5 text-xs text-gray-650\">\n            <MapPin className=\"w-3.5 h-3.5 text-brand-primary shrink-0\" />\n            <span className=\"hover:underline cursor-pointer truncate font-serif font-bold text-gray-700\">\n              {tObj(professional.wilayaName)}\n            </span>\n          </div>\n\n          {/* Years of Practice */}\n          <div className=\"flex items-center gap-1.5 text-xs text-gray-650 justify-end\">\n            <Award className=\"w-3.5 h-3.5 text-brand-primary shrink-0\" />\n            <span className=\"font-bold text-gray-700\">\n              {professional.yearsExperience} Ans exp.\n            </span>\n          </div>\n\n          {/* Stars & rating */}\n          <div className=\"flex items-center gap-1.5 text-xs text-gray-650 col-span-2 pt-2 border-t border-dashed border-gray-150\">\n            <div className=\"flex items-center gap-0.5 text-brand-accent\">\n              <Star className=\"w-3.5 h-3.5 fill-brand-accent text-brand-accent shrink-0\" />\n              <span className=\"font-bold text-gray-901 text-xs\">{professional.rating}</span>\n            </div>\n            <span className=\"text-[10px] text-gray-400 font-sans\">\n              ({professional.reviewCount} avis)\n            </span>\n            \n            <div className=\"ml-auto rtl:ml-0 rtl:mr-auto flex items-center text-[10px] text-gray-400 font-mono font-bold leading-none bg-[#FAF9F5] px-1.5 py-0.5 border border-gray-150\">\n              <ShieldCheck className=\"w-3 h-3 text-teal-600 mr-0.5 rtl:mr-0 rtl:ml-0.5 shrink-0\" />\n              <span>{professional.accreditationNumber.split(\' \')[0]}</span>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Button footer row */}\n      <div className=\"pt-3 border-t border-[#EBEBE5] flex items-center justify-between mt-1 select-none\">\n        <div className=\"flex flex-col\">\n          <span className=\"text-[8px] text-gray-400 font-mono uppercase tracking-wider leading-none\">HONORAIRES ESTIMATIFS</span>\n          <span className=\"text-sm font-bold text-[#0F6E56] font-mono mt-0.5\">\n            {professional.hourlyRate.toLocaleString()} <span className=\"text-[9px] font-sans text-gray-500 font-semibold\">DA / hr</span>\n          </span>\n        </div>\n\n        <Link \n          to={`/professional/${professional.id}`}\n          className=\"flex items-center gap-1 px-2.5 py-1.5 border border-brand-primary bg-transparent text-brand-primary hover:bg-brand-primary hover:text-white rounded-none text-[10px] font-mono uppercase tracking-widest transition\"\n          id={`view_profile_btn_${professional.id}`}\n        >\n          <span>Visualiser</span>\n          {direction === \'rtl\' ? <ArrowLeft className=\"w-3 h-3 shrink-0\" /> : <ArrowRight className=\"w-3 h-3 shrink-0\" />}\n        </Link>\n      </div>\n\n    </div>\n  );\n};\n"
    }
