          text: "    ar: \"\330\243\330\257\331\206\330\247\331\207 \331\206\331\205\331\210\330\260\330\254 \330\252\331\201\330\247\330\271\331\204\331\212 \331\204\330\243\330\257\331\210\330\247\330\252\331\206\330\247 \330\247\331\204\330\261\331\202\331\205\331\212\330\251 \330\247\331\204\331\205\330\257\331\205\330\254\330\251. \330\243\330\257\330\256\331\204 \331\205\330\271\330\267\331\212\330\247\330\252 \331\205\330\255\330\247\331\203\330\247\330\251 \331\204\330\252\330\254\330\261\330\250\330\251 \330\243\330\253\330\261 \330\247\331\204\330\260\331\203\330\247\330\241 \330\247\331\204\330\247\330\265\330\267\331\206\330\247\330\271\331\212 \331\205\330\271 \330\247\331\204\331\202\331\210\330\247\331\206\331\212\331\206 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212\330\251.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    fr: \"Ins\303\251rez de fausses variables pour ex\303\251cuter et tester notre d\303\251monstrateur d\'automatisation fiscale en temps r\303\251el.\","
