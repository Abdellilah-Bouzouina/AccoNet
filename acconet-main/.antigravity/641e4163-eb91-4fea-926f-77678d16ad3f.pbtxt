  file_change {
    absolute_path_uri: "file:///src/components/SearchFilters.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { wilayas } from \'../data/mockData\';\nimport { Sliders, RefreshCw, Star, Check } from \'lucide-react\';\n\ninterface SearchFiltersProps {\n  selectedWilaya: number;\n  setSelectedWilaya: (id: number) => void;\n  selectedSpecialty: string;\n  setSelectedSpecialty: (key: string) => void;\n  maxPrice: number;\n  setMaxPrice: (price: number) => void;\n  minRating: number;\n  setMinRating: (rating: number) => void;\n  onlyAvailable: boolean;\n  setOnlyAvailable: (avail: boolean) => void;\n  sortBy: string;\n  setSortBy: (val: string) => void;\n  onReset: () => void;\n}\n\nexport const SearchFilters: React.FC<SearchFiltersProps> = ({\n  selectedWilaya,\n  setSelectedWilaya,\n  selectedSpecialty,\n  setSelectedSpecialty,\n  maxPrice,\n  setMaxPrice,\n  minRating,\n  setMinRating,\n  onlyAvailable,\n  setOnlyAvailable,\n  sortBy,\n  setSortBy,\n  onReset\n}) => {\n  const { t, tSpec, tObj } = useLanguage();\n\n  const specialtiesList = [\n    \"chartered-accountant\",\n    \"statutory-auditor\",\n    \"certified-accountant\",\n    \"tax-consultant\",\n    \"judicial-expert\"\n  ];\n\n  return (\n    <div className=\"bg-white border border-[#CFCFC4] p-6 shadow-2xs sticky top-20 text-left rtl:text-right\" id=\"search_filters_sidebar\">\n      \n      {/* Filters Title & Reset */}\n      <div className=\"flex justify-between items-center pb-4 border-b border-[#EBEBE5] mb-6\">\n        <h3 className=\"font-serif font-bold text-gray-950 text-base flex items-center gap-2\">\n          <Sliders className=\"w-4.5 h-4.5 text-[#0F6E56]\" />\n          {t(\'filterBy\')}\n        </h3>\n        <button \n          onClick={onReset}\n          className=\"text-[10px] text-[#0F6E56] hover:text-[#085041] flex items-center gap-1 font-mono uppercase tracking-widest cursor-pointer transition-colors\"\n          id=\"btn_reset_filters\"\n        >\n          <RefreshCw className=\"w-3.5 h-3.5\" />\n          {t(\'resetFilters\').toUpperCase()}\n        </button>\n      </div>\n\n      <div className=\"space-y-6\">\n\n        {/* Sort Order Selector */}\n        <div className=\"space-y-1.5\">\n          <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n            {t(\'sortBy\')}\n          </label>\n          <select\n            value={sortBy}\n            onChange={(e) => setSortBy(e.target.value)}\n            className=\"w-full bg-[#FAF9F5] border border-[#CFCFC4] text-xs px-3 py-2 text-gray-800 focus:outline-none focus:border-brand-primary rounded-none font-sans cursor-pointer\"\n            id=\"sort_by_dropdown\"\n          >\n            <option value=\"rating\">{t(\'sortRating\')}</option>\n            <option value=\"price-asc\">{t(\'sortPriceAsc\')}</option>\n            <option value=\"price-desc\">{t(\'sortPriceDesc\')}</option>\n            <option value=\"experience\">{t(\'sortExperience\')}</option>\n          </select>\n        </div>\n\n        {/* 48 Wilayas Filter Dropdown */}\n        <div className=\"space-y-1.5\">\n          <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n            Algeria Wilaya\n          </label>\n          <select \n            value={selectedWilaya}\n            onChange={(e) => setSelectedWilaya(Number(e.target.value))}\n            className=\"w-full bg-[#FAF9F5] border border-[#CFCFC4] text-xs px-3 py-2 text-gray-808 focus:outline-none focus:border-brand-primary rounded-none font-sans cursor-pointer\"\n            id=\"filter_wilaya_select\"\n          >\n            <option value={0}>\360\237\223\215 {t(\'allWilayas\')}</option>\n            {wilayas.map((w) => (\n              <option key={w.id} value={w.id}>\n                {w.code} - {tObj(w.name)}\n              </option>\n            ))}\n          </select>\n        </div>\n\n        {/* Specialty Filter Panel */}\n        <div className=\"space-y-1.5\">\n          <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest mb-1\">\n            Specialty / Profession\n          </label>\n          <div className=\"space-y-1.5 max-h-[160px] overflow-y-auto pr-1\">\n            <button\n              onClick={() => setSelectedSpecialty(\"\")}\n              className={`w-full flex items-center justify-between text-left rtl:text-right text-xs px-3 py-2 rounded-none border transition ${selectedSpecialty === \"\" ? \'bg-brand-light border-brand-primary/40 text-brand-primary font-semibold\' : \'border-gray-200 hover:bg-gray-50 text-gray-600\'}`}\n            >\n              <span>{t(\'allSpecialties\')}</span>\n              {selectedSpecialty === \"\" && <Check className=\"w-3.5 h-3.5\" />}\n            </button>\n            {specialtiesList.map((spec) => (\n              <button\n                key={spec}\n                onClick={() => setSelectedSpecialty(spec)}\n                className={`w-full flex items-center justify-between text-left rtl:text-right text-xs px-3 py-2 rounded-none border transition ${selectedSpecialty === spec ? \'bg-brand-light border-brand-primary/40 text-brand-primary font-semibold\' : \'border-gray-200 hover:bg-gray-50 text-gray-600\'}`}\n              >\n                <span>{tSpec(spec)}</span>\n                {selectedSpecialty === spec && <Check className=\"w-3.5 h-3.5\" />}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Hourly Rate Price Slider */}\n        <div className=\"space-y-2\">\n          <div className=\"flex justify-between items-center\">\n            <label className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n              {t(\'priceRange\')}\n            </label>\n            <span className=\"text-xs font-mono font-bold text-brand-primary\">{maxPrice.toLocaleString()} DZD</span>\n          </div>\n          <input \n            type=\"range\" \n            min={3000} \n            max={10000} \n            step={500}\n            value={maxPrice} \n            onChange={(e) => setMaxPrice(Number(e.target.value))}\n            className=\"w-full accent-[#0F6E56] h-1.5 bg-[#EBEBE5] rounded-none cursor-pointer\"\n            id=\"price_range_slider\"\n          />\n          <div className=\"flex justify-between text-[10px] text-gray-400 font-mono\">\n            <span>3,000 DZD</span>\n            <span>10,000 DZD</span>\n          </div>\n        </div>\n\n        {/* Minimum rating */}\n        <div className=\"space-y-2\">\n          <label className=\"block text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n            {t(\'minRating\')}\n          </label>\n          <div className=\"grid grid-cols-5 gap-1\">\n            {[4.0, 4.5, 4.6, 4.7, 4.8].map((rating) => (\n              <button\n                key={rating}\n                onClick={() => setMinRating(rating)}\n                className={`py-2 border text-xs font-mono font-bold text-center cursor-pointer transition flex flex-col items-center justify-center rounded-none ${minRating === rating ? \'bg-brand-primary border-[#0F6E56] text-white\' : \'border-gray-250 hover:bg-gray-50 text-gray-600 bg-white\'}`}\n                title={`Show professionals rated ${rating}+`}\n              >\n                <Star className={`w-3 h-3 mb-0.5 ${minRating === rating ? \'fill-white text-white\' : \'text-brand-accent fill-brand-accent\'}`} />\n                <span>{rating}</span>\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Available Immediately toggle */}\n        <div className=\"pt-4 border-t border-[#EBEBE5]\">\n          <label className=\"flex items-center gap-3 cursor-pointer select-none\">\n            <input \n              type=\"checkbox\" \n              checked={onlyAvailable}\n              onChange={(e) => setOnlyAvailable(e.target.checked)}\n              className=\"w-4 h-4 text-brand-primary accent-brand-primary cursor-pointer border-[#CFCFC4]\"\n              id=\"filter_availability_checkbox\"\n            />\n            <span className=\"text-xs font-semibold text-gray-800\">\n              \342\232\241 {t(\'availabilityLabel\')}\n            </span>\n          </label>\n        </div>\n\n      </div>\n\n    </div>\n  );\n};\n"
    }
