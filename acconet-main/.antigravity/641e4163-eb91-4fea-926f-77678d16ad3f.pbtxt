          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ar: \"\330\247\330\256\330\252\330\261 \331\206\331\210\330\271 \330\247\331\204\330\256\330\257\331\205\330\251 \330\247\331\204\330\252\331\212 \330\252\330\250\330\255\330\253 \330\271\331\206\331\207\330\247: \330\252\330\271\330\250\330\246\330\251 G50 \330\264\331\207\330\261\331\212\330\251\330\214 \330\252\330\257\331\202\331\212\331\202 \330\255\330\263\330\247\330\250\330\247\330\252\330\214 \330\243\331\210 \331\205\330\261\330\247\331\201\331\202\330\251 \330\254\330\250\330\247\330\246\331\212\330\251 \331\210\331\202\330\247\331\206\331\210\331\206\331\212\330\251.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
