        lines {
          text: "      quoteAR: \"\331\210\331\201\331\202\330\247\331\213 \331\204\331\205\331\202\330\252\330\266\331\212\330\247\330\252 \331\202\330\247\331\206\331\210\331\206 \330\247\331\204\330\254\331\205\330\271\331\212\330\247\330\252 12-06\330\214 \331\203\330\247\331\206 \331\205\331\206 \330\247\331\204\330\266\330\261\331\210\330\261\331\212 \330\252\330\271\331\212\331\212\331\206 \331\205\330\255\330\247\331\201\330\270 \330\255\330\263\330\247\330\250\330\247\330\252 \331\204\331\204\331\205\330\265\330\247\330\257\331\202\330\251 \330\271\331\204\331\211 \331\205\331\212\330\262\330\247\331\206\331\212\330\252\331\206\330\247 \331\210\330\247\331\204\331\205\330\263\330\247\330\271\330\257\330\247\330\252. \331\210\330\254\330\257\331\206\330\247 \331\205\330\257\331\202\331\202\330\247\331\213 \331\205\330\271\330\252\331\205\330\257\330\247\331\213 \331\201\331\212 \331\210\331\207\330\261\330\247\331\206 \330\250\331\203\331\204 \330\263\331\204\330\247\330\263\330\251.\","
