    instruction: "Refactor Hero Section Layout and Typography for an Editorial Aesthetic"
    replacement_infos {
      original_chunk {
        target_content: "      {/* 1. HERO SECTION WITH ARABIC ALGERIA DESIGNS */}\n      <section className=\"relative overflow-hidden bg-gradient-to-b from-brand-light/70 via-white to-brand-surface py-20 px-4 sm:px-6 lg:px-8\">\n        \n        {/* Subtle geometric pattern */}\n        <div className=\"absolute inset-0 opacity-[0.03] pointer-events-none\">\n          <div className=\"absolute top-10 left-10 w-48 h-48 rounded-full border-4 border-brand-primary\"></div>\n          <div className=\"absolute bottom-10 right-10 w-96 h-96 rounded-full border-12 border-brand-primary\"></div>\n        </div>\n\n        <div className=\"max-w-5xl mx-auto text-center space-y-8 relative z-10\">\n          \n          {/* Badge */}\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-primary/10 border border-brand-primary/20 text-brand-primary text-xs font-bold font-sans\">\n            <span className=\"flex h-2 w-2 rounded-full bg-brand-accent pulse-accent\"></span>\n            {t(\'brandSlogan\')}\n          </div>\n\n          <h1 className=\"text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-950 font-sans tracking-tight leading-tight max-w-4xl mx-auto\">\n            {t(\'heroTitle\')}\n          </h1>\n\n          <p className=\"text-base sm:text-lg text-gray-600 max-w-2xl mx-auto font-sans leading-relaxed\">\n            {t(\'heroSubtitle\')}\n          </p>\n\n          {/* Interactive Search Tool Bar */}\n          <form \n            onSubmit={handleSearchSubmit}\n            className=\"bg-white p-2.5 sm:p-4 rounded-2xl sm:rounded-full shadow-lg border border-gray-150 max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-3\"\n            id=\"hero_search_form\"\n          >\n            {/* Keyword Input */}\n            <div className=\"md:col-span-5 flex items-center gap-2 px-3 border-b md:border-b-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-gray-100 pb-3 md:pb-0\">\n              <Search className=\"w-5 h-5 text-brand-primary shrink-0\" />\n              <input \n                type=\"text\" \n                placeholder={t(\'heroSearchPlaceholder\')}\n                value={keyword}\n                onChange={(e) => setKeyword(e.target.value)}\n                className=\"w-full text-sm text-gray-700 bg-transparent focus:outline-none placeholder-gray-400\"\n                id=\"hero_keyword_input\"\n              />\n            </div>\n\n            {/* Wilaya Filter Dropdown */}\n            <div className=\"md:col-span-3 flex items-center gap-2 px-3 border-b md:border-b-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-gray-100 pb-3 md:pb-0\">\n              <MapPin className=\"w-4 h-4 text-brand-primary shrink-0\" />\n              <select\n                value={selectedWilaya}\n                onChange={(e) => setSelectedWilaya(e.target.value)}\n                className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none\"\n                id=\"hero_wilaya_input\"\n              >\n                <option value=\"0\">\360\237\223\215 {t(\'allWilayas\')}</option>\n                {wilayas.map((w) => (\n                  <option key={w.id} value={w.id}>{w.code} - {tObj(w.name)}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Specialty Filter Dropdown */}\n            <div className=\"md:col-span-2 flex items-center gap-2 px-3 pb-3 md:pb-0\">\n              <span className=\"text-sm\">\360\237\222\274</span>\n              <select\n                value={selectedSpecialty}\n                onChange={(e) => setSelectedSpecialty(e.target.value)}\n                className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none\"\n                id=\"hero_specialty_input\"\n              >\n                <option value=\"\">{t(\'allSpecialties\')}</option>\n                {specialtiesList.map((s) => (\n                  <option key={s.key} value={s.key}>{tSpec(s.key)}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Direct Submit Action Button */}\n            <button \n              type=\"submit\"\n              className=\"md:col-span-2 w-full py-3 bg-brand-primary hover:bg-brand-dark text-white text-sm font-semibold rounded-xl sm:rounded-full shadow-xs hover:shadow-md transition cursor-pointer flex items-center justify-center gap-1.5\"\n              id=\"hero_search_btn\"\n            >\n              <span>{t(\'searchBtn\')}</span>\n              {direction === \'rtl\' ? <ArrowLeft className=\"w-4 h-4\" /> : <ArrowRight className=\"w-4 h-4\" />}\n            </button>\n          </form>\n\n          {/* Core CTAs for Non-Search Path Navigation */}\n          <div className=\"flex flex-wrap justify-center gap-4 pt-4\">\n            <button \n              onClick={() => navigate(\'/search\')}\n              className=\"px-6 py-3 border-2 border-brand-primary text-brand-primary rounded-xl text-sm font-bold hover:bg-brand-light transition duration-150 cursor-pointer\"\n            >\n              \360\237\232\200 {t(\'findProButton\')}\n            </button>\n            <button \n              onClick={() => navigate(\'/register\')}\n              className=\"px-6 py-3 bg-brand-primary text-white hover:bg-brand-dark rounded-xl text-sm font-bold shadow-xs hover:shadow-md hover:-translate-y-0.5 transition cursor-pointer\"\n            >\n              \360\237\222\274 {t(\'joinAsProButton\')}\n            </button>\n          </div>\n\n        </div>\n      </section>"
        replacement_content: "      {/* 1. HERO SECTION WITH ARABIC ALGERIA DESIGNS - EDITORIAL AESTHETIC */}\n      <section className=\"relative overflow-hidden bg-[#FBFBF8] border-b border-[#EBEBE5] py-20 md:py-28 px-4 sm:px-6 lg:px-8\">\n        \n        {/* Elegant traditional geometric watermark */}\n        <div className=\"absolute inset-0 opacity-[0.02] pointer-events-none\">\n          <div className=\"absolute top-10 left-10 w-64 h-64 rounded-full border-2 border-brand-primary\"></div>\n          <div className=\"absolute bottom-10 right-10 w-96 h-96 rounded-full border-8 border-brand-primary\"></div>\n          <div className=\"absolute top-1/2 left-1/3 w-32 h-32 rotate-45 border border-brand-primary\"></div>\n        </div>\n\n        <div className=\"max-w-5xl mx-auto text-center space-y-8 relative z-10\">\n          \n          {/* Badge */}\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-none bg-[#F3F3ED] border border-[#D5D5CD] text-brand-primary text-xs font-mono uppercase tracking-widest\">\n            <span className=\"flex h-2 w-2 rounded-full bg-brand-accent pulse-accent\"></span>\n            {t(\'brandSlogan\')}\n          </div>\n\n          <h1 className=\"text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-serif font-medium text-gray-950 tracking-tight leading-[1.1] max-w-4xl mx-auto\">\n            {t(\'heroTitle\')}\n          </h1>\n\n          <p className=\"text-base sm:text-lg text-gray-600 max-w-3xl mx-auto font-sans leading-relaxed tracking-wide\">\n            {t(\'heroSubtitle\')}\n          </p>\n\n          <hr className=\"border-t border-[#EAEAE0] max-w-xs mx-auto my-6\" />\n\n          {/* Interactive Search Tool Bar - Editorial Box */}\n          <form \n            onSubmit={handleSearchSubmit}\n            className=\"bg-white p-3 rounded-none border border-[#CFCFC4] max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-3 shadow-xs\"\n            id=\"hero_search_form\"\n          >\n            {/* Keyword Input */}\n            <div className=\"md:col-span-5 flex items-center gap-2 px-3 border-b md:border-b-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-[#EAEAE0] pb-3 md:pb-0\">\n              <Search className=\"w-4 h-4 text-brand-primary shrink-0\" />\n              <input \n                type=\"text\" \n                placeholder={t(\'heroSearchPlaceholder\')}\n                value={keyword}\n                onChange={(e) => setKeyword(e.target.value)}\n                className=\"w-full text-sm text-gray-700 bg-transparent focus:outline-none placeholder-gray-450\"\n                id=\"hero_keyword_input\"\n              />\n            </div>\n\n            {/* Wilaya Filter Dropdown */}\n            <div className=\"md:col-span-3 flex items-center gap-2 px-3 border-b md:border-b-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-[#EAEAE0] pb-3 md:pb-0\">\n              <MapPin className=\"w-4 h-4 text-brand-primary shrink-0\" />\n              <select\n                value={selectedWilaya}\n                onChange={(e) => setSelectedWilaya(e.target.value)}\n                className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none cursor-pointer\"\n                id=\"hero_wilaya_input\"\n              >\n                <option value=\"0\">\360\237\223\215 {t(\'allWilayas\')}</option>\n                {wilayas.map((w) => (\n                  <option key={w.id} value={w.id}>{w.code} - {tObj(w.name)}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Specialty Filter Dropdown */}\n            <div className=\"md:col-span-2 flex items-center gap-2 px-3 pb-3 md:pb-0\">\n              <span className=\"text-xs\">\360\237\222\274</span>\n              <select\n                value={selectedSpecialty}\n                onChange={(e) => setSelectedSpecialty(e.target.value)}\n                className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none cursor-p