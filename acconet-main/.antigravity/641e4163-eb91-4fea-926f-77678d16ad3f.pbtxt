        }
        lines {
          text: "    ar: \"\331\205\331\204\331\201\330\247\330\252 \330\264\330\256\330\265\331\212\330\251 \330\252\331\205 \330\247\331\204\330\252\330\255\331\202\331\202 \331\205\331\206 \330\243\330\263\331\205\330\247\330\246\331\207\330\247\330\214 \330\243\330\261\331\202\330\247\331\205 \330\247\330\271\330\252\331\205\330\247\330\257\331\207\330\247\330\214 \331\210\330\252\331\202\331\212\331\212\331\205\330\247\330\252\331\207\330\247 \330\247\331\204\330\255\331\202\331\212\331\202\331\212\330\251 \331\205\331\206 \330\267\330\261\331\201 \331\205\330\257\330\261\330\247\330\241 \330\264\330\261\331\203\330\247\330\252 \330\254\330\262\330\247\330\246\330\261\331\212\330\251.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
