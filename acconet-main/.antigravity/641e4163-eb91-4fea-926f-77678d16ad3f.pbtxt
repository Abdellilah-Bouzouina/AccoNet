        target_content: "      {/* 1. STATE EMBLEM REGULATORY BANNER */}\n      <div className=\"bg-[#0B1A16] border-y-4 border-[#F59E0B] p-6 sm:p-8 text-white relative\">\n        <div className=\"absolute top-0 right-0 w-64 h-full bg-[#0F6E56]/10 filter blur-3xl pointer-events-none\"></div>\n        \n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 relative z-10 text-left rtl:text-right\">\n          <div className=\"space-y-1\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"px-2.5 py-0.5 bg-[#F59E0B]/20 border border-[#F59E0B] text-[#F59E0B] text-[9px] font-mono uppercase tracking-widest\">\n                National Audit Authority\n              </span>\n              <span className=\"text-[10px] font-mono text-gray-400 font-bold\">DGI SUPERVISOR STATUS: INTERNAL AUDITOR</span>\n            </div>\n            \n            <h1 className=\"text-2xl sm:text-3xl font-serif font-black tracking-tight text-white leading-tight\">\n              Algeria Financial Compliance Gateway <span className=\"text-brand-accent font-normal italic\">\330\243\331\203\331\210\331\206\331\212\330\252 \330\247\331\204\330\245\330\257\330\247\330\261\330\251</span>\n            </h1>\n            \n            <p className=\"text-xs text-gray-300 font-sans leading-relaxed max-w-2xl\">\n              Supervising chartered legal cabinets, statutory auditors (Commissaires aux comptes), and validating professional credentials against the national ONCC registrar for live SCF reporting.\n            </p>\n          </div>\n\n          <div className=\"px-5 py-3 bg-white/5 border border-white/10 flex items-center gap-2.5\">\n            <span className=\"w-2.5 h-2.5 bg-brand-accent rounded-full animate-pulse\"></span>\n            <span className=\"text-gray-200 font-mono text-[10px] tracking-widest uppercase font-bold\">BOARD CONTROL ONLINE</span>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. CORE STATS MATRIX ROW */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\" id=\"admin_matrix_metrics\">\n        \n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <p className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider font-bold\">Registered Cabinets</p>\n            <p className=\"text-2xl font-serif font-black text-brand-primary font-mono\">{cabinetList.length}</p>\n            <p className=\"text-[9px] text-gray-400 font-mono\">ONCC REGISTERED</p>\n          </div>\n          <Building2 className=\"w-8 h-8 text-[#0F6E56]/30\" />\n        </div>\n\n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <p className=\"text-[10px] font-[#CFCFC4] block text-xs font-mono font-bold text-gray-400 uppercase tracking-wider\">National SME Enrolment</p>\n            <p className=\"text-2xl font-serif font-black text-indigo-950 font-mono\">1,845</p>\n            <p className=\"text-[9px] text-gray-400 font-mono\">ACTIVE ENTITIES</p>\n          </div>\n          <Users className=\"w-8 h-8 text-indigo-900/30\" />\n        </div>\n\n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <p className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider\">G50 Submission Compliance</p>\n            <p className=\"text-2xl font-serif font-black text-amber-900 font-mono\">94.2%</p>\n            <p className=\"text-[9px] text-gray-400 font-mono\">MONTHLY PENETRATION</p>\n          </div>\n          <TrendingUp className=\"w-8 h-8 text-amber-700/30\" />\n        </div>\n\n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <p className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider\">System Trust Index</p>\n            <p className=\"text-2xl font-serif font-black text-emerald-800 font-mono\">100%</p>\n            <p className=\"text-[9px] text-gray-400 font-mono\">SECURE TRIPLE-ENCRYPTED</p>\n          </div>\n          <ShieldCheck className=\"w-8 h-8 text-emerald-800/30\" />\n        </div>\n\n      </div>"
        replacement_content: "      {/* 1. STATE EMBLEM REGULATORY BANNER */}\n      <div className=\"bg-[#0B1A16] border-y-4 border-[#F59E0B] p-6 sm:p-8 text-white relative\">\n        <div className=\"absolute top-0 right-0 w-64 h-full bg-[#0F6E56]/10 filter blur-3xl pointer-events-none\"></div>\n        \n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 relative z-10 text-left rtl:text-right\">\n          <div className=\"space-y-1\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"px-2.5 py-0.5 bg-[#F59E0B]/20 border border-[#F59E0B] text-[#F59E0B] text-[9px] font-mono uppercase tracking-widest\">\n                {t(\'nationalAuditAuthority\')}\n              </span>\n              <span className=\"text-[10px] font-mono text-gray-400\">{t(\'dgiSupervisorStatus\').toUpperCase()}: INTERNAL AUDITOR</span>\n            </div>\n            \n            <h1 className=\"text-2xl sm:text-3xl font-serif font-black tracking-tight text-white leading-tight\">\n              {t(\'algeriaComplianceGateway\')} <span className=\"text-brand-accent font-normal italic\">\330\243\331\203\331\210\331\206\331\212\330\252 \330\247\331\204\330\245\330\257\330\247\330\261\330\251</span>\n            </h1>\n            \n            <p className=\"text-xs text-gray-300 font-sans leading-relaxed max-w-2xl\">\n              {t(\'supervisingCharteredCabinets\')}\n            </p>\n          </div>\n\n          <div className=\"px-5 py-3 bg-white/5 border border-white/10 flex items-center gap-2.5\">\n            <span className=\"w-2.5 h-2.5 bg-brand-accent rounded-full animate-pulse\"></span>\n            <span className=\"text-gray-200 font-mono text-[10px] tracking-widest uppercase\">{t(\'boardControlOnline\')}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* 2. CORE STATS MATRIX ROW */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\" id=\"admin_matrix_metrics\">\n        \n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <p className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider\">{t(\'registeredCabinets\')}</p>\n            <p className=\"text-2xl font-serif font-black text-brand-primary font-mono\">{cabinetList.length}</p>\n            <p className=\"text-[9px] text-gray-400 font-mono\">{t(\'onccRegistered\')}</p>\n          </div>\n          <Building2 className=\"w-8 h-8 text-[#0F6E56]/30\" />\n        </div>\n\n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <p className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider\">{t(\'nationalSmeEnrolment\')}</p>\n            <p className=\"text-2xl font-serif font-black text-indigo-950 font-mono\">1,845</p>\n            <p className=\"text-[9px] text-gray-400 font-mono\">{t(\'activeEntities\')}</p>\n          </div>\n          <Users className=\"w-8 h-8 text-indigo-900/30\" />\n        </div>\n\n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <p className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider\">{t(\'g50SubmissionCompliance\')}</p>\n            <p className=\"text-2xl font-serif font-black text-amber-900 font-mono\">94.2%</p>\n            <p className=\"text-[9px] text-gray-400 font-mono\">{t(\'monthlyPenetration\')}</p>\n          </div>\n          <TrendingUp className=\"w-8 h-8 text-amber-700/30\" />\n        </div>\n\n        <div className=\"bg-white border border-[#CFCFC4] p-5 shadow-2xs flex items-center justify-between\">\n          <div className=\"space-y-1 text-left rtl:text-right\">\n            <p className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-wider\">{t(\'systemTrustIndex\')}</p>\n            <p className=\"text-2xl font-serif font-black text-emerald-800 font-mono\">100%</p>\n            <p className=\"text-[9px] text-gray-400 font-mono\">{t(\'secureTripleEncrypted\')}</p>\n          </div>\n          <ShieldCheck className=\"w-8 h-8 text-emerald-800/30\" />\n        </div>\n\n      </div>"
      }
