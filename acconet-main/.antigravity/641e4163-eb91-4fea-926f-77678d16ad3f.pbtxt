    replacement_infos {
      original_chunk {
        target_content: "        {/* RIGHT COLUMN (col-span-4): REGULATORY FORM CONFIGURATIONS */}\n        <div className=\"lg:col-span-4 bg-white border border-[#CFCFC4] p-6 shadow-3xs space-y-6 text-left rtl:text-right\">\n          \n          <div className=\"pb-4 border-b border-[#EBEBE5]\">\n            <span className=\"text-[9px] font-mono text-gray-400 uppercase tracking-widest\">National Registry Configuration</span>\n            <h2 className=\"font-serif font-semibold text-gray-910 text-sm mt-1 flex items-center gap-1.5\">\n              <Sliders className=\"w-4 h-4 text-brand-primary\" />\n              G50 & IBS Formula Parameters\n            </h2>\n          </div>\n\n          <form onSubmit={handleApplyGlobalParameters} className=\"space-y-4 text-xs font-sans\">\n            \n            <div className=\"space-y-1.5\">\n              <div className=\"flex justify-between items-center text-[9px] font-mono\">\n                <label className=\"font-bold text-gray-400 uppercase\">Default TAP Rate Levy (%)</label>\n                <span className=\"font-mono font-bold text-brand-primary\">{tapRate}%</span>\n              </div>\n              <input \n                type=\"range\" \n                min={0} \n                max={5} \n                step={0.1}\n                value={tapRate} \n                onChange={(e) => setTapRate(Number(e.target.value))}\n                className=\"w-full accent-brand-primary h-1 bg-[#EBEBE5] rounded-none outline-none appearance-none cursor-pointer\"\n              />\n              <span className=\"text-[9px] text-gray-400 font-mono text-right block\">Includes 1% default trade discount index limit</span>\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <label className=\"block text-[9px] font-mono font-bold text-gray-400 uppercase tracking-widest text-left\">Standard IBS Corporate Tax Rate (%)</label>\n              <select\n                value={ibsRate}\n                onChange={(e) => setIbsRate(Number(e.target.value))}\n                className=\"w-full border border-[#CFCFC4] px-2 py-1.5 bg-[#FAF9F5] focus:outline-none focus:border-brand-primary font-mono cursor-pointer\"\n              >\n                <option value={19}>19% - Produce Transformation Sector</option>\n                <option value={23}>23% - Building, Tourism, Transport Sector</option>\n                <option value={26}>26% - General Trade & Capital Resales</option>\n              </select>\n            </div>\n\n            <div className=\"space-y-1\">\n              <span className=\"block text-[9px] font-mono font-bold text-gray-400 uppercase tracking-widest\">Regulatory Board Directives</span>\n              <div className=\"p-3 bg-[#FAF9F5] border border-[#CFCFC4] text-[10px] text-gray-600 space-y-1.5 leading-normal\">\n                <p>\342\234\223 All computations adhere to general Algerian Tax Code (CIDTA).</p>\n                <p>\342\234\223 Startup labeled units bypass the 1.5% TAP levy automatically.</p>\n              </div>\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full py-2.5 bg-brand-primary hover:bg-[#085041] hover:scale-[1.01] text-white text-[10px] font-mono uppercase tracking-widest transition cursor-pointer flex items-center justify-center gap-1 shadow-xs\"\n            >\n              <Settings className=\"w-3.5 h-3.5\" />\n              <span>Apply National Adjustments</span>\n            </button>\n\n          </form>\n\n          {/* Audit telemetry report */}\n          <div className=\"pt-6 border-t border-[#EBEBE5] space-y-2.5\">\n            <h3 className=\"text-[10px] font-mono font-bold text-gray-400 uppercase tracking-widest\">Active Server Audit Logs</h3>\n            \n            <div className=\"bg-gray-950 text-emerald-400 text-[10px] font-mono p-4 rounded-none leading-relaxed overflow-x-auto text-left space-y-1 border border-gray-800\">\n              <p 