        lines {
          text: "      needed: \"Quarterly G50 & CNAS\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      quoteFR: \"Gr\303\242ce \303\240 notre comptable agr\303\251\303\251 trouv\303\251 sur AccoNet, l\'\303\251tablissement trimestriel de nos G50 et d\303\251clarations de chantiers CNAS est devenu un processus fluide. Z\303\251ro retard de cotisation.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      quoteAR: \"\330\250\331\201\330\266\331\204 \330\247\331\204\331\205\330\255\330\247\330\263\330\250 \330\247\331\204\331\205\330\271\330\252\331\205\330\257 \330\247\331\204\330\260\331\212 \331\210\330\254\330\257\331\206\330\247\331\207 \331\201\331\212 \330\243\331\203\331\210\331\206\331\212\330\252\330\214 \330\243\330\265\330\250\330\255 \330\245\330\271\330\257\330\247\330\257 \330\252\330\265\330\261\331\212\330\255\330\247\330\252 G50 \331\210\330\247\331\204\330\247\330\264\330\252\330\261\330\247\331\203\330\247\330\252 \330\247\331\204\330\263\331\206\331\210\331\212\330\251 \331\204\331\204\330\266\331\205\330\247\331\206 \330\247\331\204\330\247\330\254\330\252\331\205\330\247\330\271\331\212 \331\204\331\204\330\271\331\205\330\247\331\204 \331\210\330\247\331\204\331\210\330\261\330\264\330\247\330\252 \331\205\330\263\330\252\331\202\330\261\330\247\331\213 \331\210\330\256\330\247\331\204\331\212\330\247\331\213 \331\205\331\206 \330\243\331\212 \330\272\330\261\330\247\331\205\330\247\330\252 \330\252\330\243\330\267\331\212\330\261.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
