    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useApp } from \'../context/AppContext\';\nimport { ProfessionalCard } from \'../components/ProfessionalCard\';\nimport { wilayas } from \'../data/mockData\';\nimport { \n  Building2, Users, Search, HelpCircle, ArrowLeft, ArrowRight, \n  MapPin, ClipboardCheck, ArrowUpRight, Check, Quote, Star, \n  Sparkles, FileText, Calendar, CloudLightning, ShieldCheck, Cpu,\n  BookmarkCheck, Activity, GraduationCap\n} from \'lucide-react\';\n\nexport const Landing: React.FC = () => {\n  const { t, tSpec, tObj, direction, language } = useLanguage();\n  const { allProfessionals } = useApp();\n  const navigate = useNavigate();\n\n  // Search form state\n  const [keyword, setKeyword] = useState(\'\');\n  const [selectedWilaya, setSelectedWilaya] = useState(\'0\');\n  const [selectedSpecialty, setSelectedSpecialty] = useState(\'\');\n\n  // Interactive Live Ledger State\n  const [ledgerVerified, setLedgerVerified] = useState(true);\n  const [activeFilingTab, setActiveFilingTab] = useState<\'G50\' | \'IBS\' | \'Liasse\'>(\'G50\');\n  const [liveCheckCount, setLiveCheckCount] = useState(0);\n\n  useEffect(() => {\n    const timer = setInterval(() => {\n      setLiveCheckCount((prev) => (prev + 1) % 6);\n    }, 4000);\n    return () => clearInterval(timer);\n  }, []);\n\n  const handleSearchSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    navigate(`/search?keyword=${encodeURIComponent(keyword)}&wilaya=${selectedWilaya}&specialty=${selectedSpecialty}`);\n  };\n\n  const featuredPros = allProfessionals.slice(0, 4);\n\n  const specialtiesList = [\n    { key: \"certified-accountant\", icon: \"\360\237\222\216\" },\n    { key: \"chartered-accountant\", icon: \"\360\237\217\233\357\270\217\" },\n    { key: \"statutory-auditor\", icon: \"\360\237\223\221\" },\n    { key: \"tax-consultant\", icon: \"\342\232\226\357\270\217\" },\n    { key: \"judicial-expert\", icon: \"\360\237\224\216\" }\n  ];\n\n  const toolsTeaser = [\n    { key: \"ocrTitle\", desc: \"ocrDesc\", icon: Sparkles, color: \"bg-teal-50/50 text-brand-primary border-teal-200\" },\n    { key: \"g50SimTitle\", desc: \"g50SimDesc\", icon: FileText, color: \"bg-indigo-50/50 text-indigo-700 border-indigo-200\" },\n    { key: \"auditSimTitle\", desc: \"auditSimDesc\", icon: ClipboardCheck, color: \"bg-amber-50/50 text-amber-700 border-amber-200\" }\n  ];\n\n  const testimonialsList = [\n    { name: \"\330\261\331\212\330\247\330\266 \330\250\331\206 \331\212\330\271\331\202\331\210\330\250\", company: \"Dzair Tech Link LLC\", wil: { ar: \"\330\247\331\204\330\254\330\262\330\247\330\246\330\261\", fr: \"Alger\", en: \"Algiers\" }, rating: 5, comment: \"t1\" },\n    { name: \"\331\212\330\247\330\263\331\205\331\212\331\206 \330\250\331\204\331\202\330\247\330\263\331\205\", company: \"Belgourmet Bio Sarl\", wil: { ar: \"\330\247\331\204\330\250\331\204\331\212\330\257\330\251\", fr: \"Blida\", en: \"Blida\" }, rating: 5, comment: \"t2\" },\n    { name: \"\330\245\330\250\330\261\330\247\331\207\331\212\331\205 \330\250\331\210\330\247\331\204\330\264\330\271\331\212\330\261\", company: \"Pharmalife Est\", wil: { ar: \"\331\202\330\263\331\206\330\267\331\212\331\206\330\251\", fr: \"Constantine\", en: \"Constantine\" }, rating: 5, comment: \"t3\" },\n    { name: \"\330\263\331\205\331\212\330\261 \330\255\331\205\331\210\330\264\", company: \"Oran Logistique Express\", wil: { ar: \"\331\210\331\207\330\261\330\247\331\206\", fr: \"Oran\", en: \"Oran\" }, rating: 4.8, comment: \"t4\" },\n    { name: \"\331\206\330\254\331\212\330\250 \330\250\331\210\330\263\330\247\331\204\331\205\", company: \"S\303\251tif Plast Industrielle\", wil: { ar: \"\330\263\330\267\331\212\331\201\", fr: \"S\303\251tif\", en: \"S\303\251tif\" }, rating: 4.9, comment: \"t5\" },\n    { name: \"\331\201\330\247\330\267\331\205\330\251 \330\247\331\204\330\262\331\207\330\261\330\247\330\241 \330\271\331\212\330\263\331\211\", company: \"Kabylie Olive Agronome\", wil: { ar: \"\330\252\331\212\330\262\331\212 \331\210\330\262\331\210\", fr: \"Tizi Ouzou\", en: \"Tizi Ouzou\" }, rating: 5, comment: \"t6\" }\n  ];\n\n  return (\n    <div className=\"space-y-16 md:space-y-24 pb-20 bg-[#FAF9F5]\" id=\"landing_page_viewport\">\n      \n      {/* 1. ASYMMETRIC PREMIUM HERO SECTION */}\n      <section className=\"relative overflow-hidden bg-[#F5F4EE] border-b border-[#D5D5CD] py-14 md:py-24 px-4 sm:px-6 lg:px-8\">\n        \n        {/* Subtle architectural background canvas grids */}\n        <div className=\"absolute inset-0 opacity-[0.03] pointer-events-none\">\n          <div className=\"absolute top-0 left-0 w-full h-full bg-[linear-gradient(to_right,#0F6E56_1px,transparent_1px),linear-gradient(to_bottom,#0F6E56_1px,transparent_1px)] bg-[size:4rem_4rem]\"></div>\n        </div>\n\n        <div className=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center relative z-10\">\n          \n          {/* Main Typography Column */}\n          <div className=\"lg:col-span-7 space-y-6 md:space-y-8 text-left rtl:text-right\">\n            \n            {/* Algerian Localization Tag */}\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-white border border-[#CFCFC4] text-[#0F6E56] text-[10px] sm:text-xs font-mono uppercase tracking-widest shadow-2xs\">\n              <span className=\"flex h-2 w-2 rounded-none bg-brand-accent animate-pulse shrink-0\"></span>\n              <span>Algerian SCF 2026 Compliant \342\200\242 National Network</span>\n            </div>\n\n            {/* Editorial Title - Balancing serif header hierarchy */}\n            <h1 className=\"text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif font-semibold text-gray-950 tracking-tight leading-[1.12]\">\n              {language === \'ar\' ? (\n                <>\n                  \330\254\330\257 \330\243\331\201\330\266\331\204 <span className=\"italic font-normal text-[#0F6E56] underline decoration-brand-accent/50 underline-offset-8\">\330\247\331\204\330\264\330\261\331\203\330\247\330\241 \330\247\331\204\331\205\330\247\331\204\331\212\331\212\331\206</span> \331\210\330\247\331\204\331\205\330\255\330\247\330\263\330\250\331\212\331\212\331\206 \331\204\330\264\330\261\331\203\330\252\331\203 \331\201\331\212 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\n                </>\n              ) : (\n                <>\n                  Find the Finest <span className=\"italic font-normal text-[#0F6E56]\">Accounting Partners</span> for Your Enterprise in Algeria\n                </>\n              )}\n            </h1>\n\n            <p className=\"text-sm sm:text-base text-gray-700 max-w-2xl font-sans leading-relaxed tracking-wide\">\n              {t(\'heroSubtitle\')}\n            </p>\n\n            {/* Asymmetric Structural Search Console */}\n            <div className=\"bg-white border border-[#CFCFC4] p-2.5 shadow-xs relative max-w-3xl\">\n              <div className=\"absolute -top-3 left-4 rtl:left-auto rtl:right-4 bg-gray-950 px-2 py-0.5 text-[9px] font-mono text-[#E1F5EE] uppercase tracking-wider\">\n                Partner Search Terminal\n              </div>\n              \n              <form \n                onSubmit={handleSearchSubmit}\n                className=\"grid grid-cols-1 md:grid-cols-12 gap-2\"\n                id=\"hero_search_form\"\n              >\n                {/* Keyword Search Input */}\n                <div className=\"md:col-span-5 flex items-center gap-2 px-2.5 py-2 border-b md:border-b-0 border-[#EBEBE5]\">\n                  <Search className=\"w-4 h-4 text-[#0F6E56] shrink-0\" />\n                  <input \n                    type=\"text\" \n                    placeholder={t(\'heroSearchPlaceholder\')}\n                    value={keyword}\n                    onChange={(e) => setKeyword(e.target.value)}\n                    className=\"w-full text-xs text-gray-800 bg-transparent focus:outline-none placeholder-gray-450\"\n                    id=\"hero_keyword_input\"\n                  />\n                </div>\n\n                {/* Wilaya Picker */}\n                <div className=\"md:col-span-3 flex items-center gap-1.5 px-2.5 py-2 border-b md:border-b-0 md:border-l rtl:md:border-l-0 rtl:md:border-r border-[#EBEBE5]\">\n                  <MapPin className=\"w-3.5 h-3.5 text-[#0F6E56] shrink-0\" />\n                  <select\n                    value={selectedWilaya}\n                    onChange={(e) => setSelectedWilaya(e.target.value)}\n                    className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none cursor-pointer font-sans\"\n                    id=\"hero_wilaya_input\"\n                  >\n                    <option value=\"0\">\360\237\223\215 {t(\'allWilayas\')}</option>\n                    {wilayas.map((w) => (\n                      <option key={w.id} value={w.id}>{w.code} - {tObj(w.name)}</option>\n                    ))}\n                  </select>\n                </div>\n\n                {/* Specialty Dropdown */}\n                <div className=\"md:col-span-2 flex items-center gap-1.5 px-2.5 py-2\">\n                  <span className=\"text-xs shrink-0 select-none\">\360\237\222\274</span>\n                  <select\n                    value={selectedSpecialty}\n                    onChange={(e) => setSelectedSpecialty(e.target.value)}\n                    className=\"w-full text-xs text-gray-700 bg-transparent focus:outline-none cursor-pointer\"\n                    id=\"hero_specialty_input\"\n                  >\n                    <option value=\"\">{t(\'allSpecialties\')}</option>\n                    {specialtiesList.map((s) => (\n                      <option key={s.key} value={s.key}>{tSpec(s.key)}</option>\n                    ))}\n                  </select>\n                </div>\n\n                {/* Direct Action */}\n                <button \n                  type=\"submit\"\n                  className=\"md:col-span-2 w-full py-2.5 bg-brand-primary hover:bg-[#085041] hover:scale-[1.01] text-white text-[10px] font-mono uppercase tracking-widest transition cursor-pointer flex items-center justify-center gap-1\"\n                  id=\"hero_search_btn\"\n                >\n                  <span>{t(\'searchBtn\').toUpperCase()}</span>\n                  {direction === \'rtl\' ? <ArrowLeft className=\"w-3.5 h-3.5\" /> : <ArrowRight className=\"w-3.5 h-3.5\" />}\n                </button>\n              </form>\n            </div>\n\n            {/* Clickable Quick Specialty Badges */}\n            <div className=\"flex flex-wrap items-center gap-2 pt-2 text-xs\">\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-gray-400\">{direction === \'rtl\' ? \'\330\252\330\265\331\201\330\255 \330\263\330\261\331\212\330\271:\' : \'Quick Query:\'}</span>\n              {specialtiesList.slice(0, 3).map((spec) => (\n                <button\n                  key={spec.key}\n                  onClick={() => {\n                    setSelectedSpecialty(spec.key);\n                    navigate(`/search?specialty=${spec.key}`);\n                  }}\n                  className=\"px-2.5 py-1 bg-[#EBEBE5] hover:bg-[#D5D5CD] transition text-gray-700 font-sans text-[11px] flex items-center gap-1 border border-[#D5D5CD]\"\n                >\n                  <span>{spec.icon}</span>\n                  <span>{tSpec(spec.key)}</span>\n                </button>\n              ))}\n            </div>\n\n          </div>\n\n          {/* Asymmetric Interactive Live Preview Product Card Column */}\n          <div className=\"lg:col-span-5 bg-white border border-[#CFCFC4] p-5 shadow-sm space-y-4 relative\">\n            <div className=\"absolute top-2.5 right-3 rtl:left-3 rtl:right-auto flex items-center gap-1 text-[9px] font-mono text-[#0F6E56]\">\n              <span className=\"w-1.5 h-1.5 bg-[#0F6E56] rounded-none animate-ping\"></span>\n              SECURE LEDGER ENVIRONMENT\n            </div>\n\n            <div className=\"pb-3 border-b border-[#EBEBE5] space-y-0.5 text-left rtl:text-right\">\n              <p className=\"text-[10px] font-mono text-gray-400 uppercase tracking-widest\">ALGERIA NATIONAL TAX GATEWAY</p>\n              <h3 className=\"font-serif font-bold text-gray-950 text-sm\">AccoNet Compliance Engine</h3>\n            </div>\n\n            {/* Quick simulated tabs for different document modules */}\n            <div className=\"grid grid-cols-3 gap-1 bg-[#F5F4EE] p-0.5 border border-[#CFCFC4]\">\n              {[\'G50\', \'IBS\', \'Liasse\'].map((tab) => (\n                <button\n                  key={tab}\n                  onClick={() => setActiveFilingTab(tab as any)}\n                  className={`py-1 text-[10px] font-mono uppercase tracking-wider transition cursor-pointer ${activeFilingTab === tab ? \'bg-white text-gray-900 font-bold shadow-2xs\' : \'text-gray-500 hover:text-gray-900\'}`}\n                >\n                  {tab} Simulator\n                </button>\n              ))}\n            </div>\n\n            {/* Dynamic ledger entries showing real compliance states */}\n            {activeFilingTab === \'G50\' && (\n              <div className=\"space-y-2.5\">\n                <div className=\"flex justify-between items-center bg-[#FBFBF8] border border-[#EBEBE5] p-3 text-xs\">\n                  <div>\n                    <span className=\"text-[8px] font-mono text-gray-400 block\">MAY 2026 STATEMENT</span>\n                    <strong className=\"text-gray-900 font-sans\">G50 Bis Filing Checklist</strong>\n                  </div>\n                  <span className=\"px-1.5 py-0.5 bg-teal-50 text-teal-800 border border-teal-200 text-[9px] font-mono\">\n                    READY FOR CABINET\n                  </span>\n                </div>\n\n                <div className=\"grid grid-cols-2 gap-2 text-[11px] font-mono text-gray-600\">\n                  <div className=\"bg-[#FAF9F5] p-2 border border-[#EBEBE5]\">\n                    <span className=\"text-gray-400 block text-[9px]\">TAP (Taxe l\'Activit\303\251)</span>\n                    <span className=\"text-gray-900 font-bold\">1.5% - 240,500 DZD</span>\n                  </div>\n                  <div className=\"bg-[#FAF9F5] p-2 border border-[#EBEBE5]\">\n                    <span className=\"text-gray-400 block text-[9px]\">IRG Retenue</span>\n                    <span className=\"text-gray-900 font-bold\">Scale 2026 - Pass</span>\n                  </div>\n                </div>\n              </div>\n            )}\n\n            {activeFilingTab === \'IBS\' && (\n              <div className=\"space-y-2 text-xs\">\n                <p className=\"text-gray-500 leading-normal text-[11px]\">\n                  Simulate the 19% or 26% Corporate IBS schedules directly referenced on raw transaction logs under Algerian Fiscal framework 2026.\n                </p>\n                <div className=\"bg-gray-950 font-mono text-[10px] text-emerald-400 p-2.5 border border-gray-800\">\n                  {`$ acconet-cli ibs-assess --wilaya-code=16\n> Parsing Balance Sheet... OK\n> Base Imposable calculated: 4,850,000 DZD\n> Pro-rated IBS liability verified.`}\n                </div>\n              </div>\n            )}\n\n            {activeFilingTab === \'Liasse\' && (\n              <div className=\"space-y-3\">\n                <div className=\"flex items-center gap-2 text-xs\">\n                  <BookmarkCheck className=\"w-4 h-4 text-[#0F6E56]\" />\n                  <span className=\"font-semibold text-gray-800\">Tableaux 1-20 Financial Statements</span>\n                </div>\n                <div className=\"w-full bg-[#EBEBE5] h-1.5 rounded-none overflow-hidden\">\n                  <div className=\"bg-[#0F6E56] h-full\" style={{ width: \'85%\' }}></div>\n                </div>\n                <div className=\"flex justify-between items-center text-[10px] font-mono text-gray-400\">\n                  <span>SYSTEM AUDITING: 17/20 TABLEAUX READY</span>\n                  <span className=\"text-[#0F6E56] font-bold\">85% COMPLETE</span>\n                </div>\n              </div>\n            )}\n\n            {/* Simulated Live Auditors checklist */}\n            <div className=\"pt-3 border-t border-[#EBEBE5] space-y-2\">\n              <div className=\"flex justify-between items-center text-xs text-gray-500 font-mono\">\n                <span>SCF ENGINE AUDITS</span>\n                <span className=\"text-[10px] bg-[#E1F5EE] text-[#0F6E56] px-1 font-bold\">LIVE METRIC</span>\n              </div>\n              <ul className=\"text-[11px] font-sans text-gray-600 space-y-1.5\">\n                <li className=\"flex items-center gap-2\">\n                  <span className={`w-2 h-2 shrink-0 ${liveCheckCount >= 1 ? \'bg-[#0F6E56]\' : \'bg-gray-300\'}`}></span>\n                  <span>Cross-check G50 Bis ledger limits against revenue logs</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <span className={`w-2 h-2 shrink-0 ${liveCheckCount >= 3 ? \'bg-[#0F6E56]\' : \'bg-gray-300\'}`}></span>\n                  <span>Validate compliance of Transfer Pricing values (NIF checked)</span>\n                </li>\n                <li className=\"flex items-center gap-2\">\n                  <span className={`w-2 h-2 shrink-0 ${liveCheckCount >= 5 ? \'bg-[#0F6E56]\' : \'bg-gray-300\'}`}></span>\n                  <span>Secure sign-off from approved ONCC chartered auditor</span>\n                </li>\n              </ul>\n            </div>\n\n            {/* Quick Simulation Link */}\n            <div className=\"bg-[#FAF9F5] border border-[#CFCFC4] p-3 text-xs flex justify-between items-center\">\n              <div className=\"flex items-center gap-2\">\n                <Cpu className=\"w-4 h-4 text-brand-primary animate-spin\" />\n                <span className=\"font-mono text-[10px] text-gray-450 uppercase tracking-widest\">Active simulation environment</span>\n              </div>\n              <button \n                onClick={() => navigate(\'/tools\')}\n                className=\"text-brand-primary font-mono text-[11px] font-bold underline hover:text-[#085041]\"\n              >\n                Access Sandbox \342\206\222\n              </button>\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      {/* 2. INSTITUTIONAL TRUST & DATA MATRIX STRIP */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center space-y-2 mb-8\">\n          <p className=\"text-[11px] font-mono tracking-widest uppercase text-gray-400\">AccorNet Network Coverage Statistics</p>\n          <hr className=\"w-12 border-t-2 border-[#0F6E56] mx-auto\" />\n        </div>\n        \n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 text-center bg-[#FBFBF8] p-8 border border-[#CFCFC4]\">\n          <div className=\"space-y-1 py-4 md:py-2\">\n            <span className=\"text-[11px] font-mono uppercase tracking-widest text-[#0F6E56] block\">APPROVED CABINETS</span>\n            <p className=\"text-3xl sm:text-4xl font-serif font-black text-gray-950\">120+</p>\n            <p className=\"text-xs text-gray-500\">{t(\'statProsSub\')}</p>\n          </div>\n          <div className=\"space-y-1 py-4 md:py-2 border-t md:border-t-0 md:border-l md:border-r border-[#CFCFC4]\">\n            <span className=\"text-[11px] font-mono uppercase tracking-widest text-[#0F6E56] block\">WILAYAS WITH CHARGES</span>\n            <p className=\"text-3xl sm:text-4xl font-serif font-black text-gray-950\">48</p>\n            <p className=\"text-xs text-gray-500\">{t(\'statWilayasSub\')}</p>\n          </div>\n          <div className=\"space-y-1 py-4 md:py-2 border-t md:border-t-0\">\n            <span className=\"text-[11px] font-mono uppercase tracking-widest text-[#0F6E56] block\">SUPPORTED INTEGRATIONS</span>\n            <p className=\"text-3xl sm:text-4xl font-serif font-black text-gray-950\">450+</p>\n            <p className=\"text-xs text-gray-500\">{t(\'statBusinessesSub\')}</p>\n          </div>\n        </div>\n      </section>\n\n      {/* 3. FEATURED ACCOUNTING SPECIALISTS */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-10 text-left rtl:text-right\">\n          <div>\n            <span className=\"text-[10px] font-mono uppercase tracking-wider text-gray-400\">Cabinet Directory</span>\n            <h2 className=\"text-2xl sm:text-3xl font-serif font-semibold text-gray-950 tracking-tight mt-1\">\n              {t(\'featuredTitle\')}\n            </h2>\n          </div>\n          <p className=\"text-xs sm:text-sm text-gray-500 max-w-lg\">\n            {t(\'featuredSubtitle\')}\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {featuredPros.map((pro) => (\n            <ProfessionalCard key={pro.id} professional={pro} />\n          ))}\n        </div>\n\n        {/* Crisp Button row */}\n        <div className=\"text-center mt-12\">\n          <button \n            onClick={() => navigate(\'/search\')}\n            className=\"inline-flex items-center gap-2 px-6 py-3.5 bg-brand-primary text-white font-mono text-[11px] uppercase tracking-widest border border-[#0F6E56] hover:bg-[#085041] transition-all cursor-pointer shadow-xs\"\n          >\n            <span>{t(\'findProButton\')}</span>\n            {direction === \'rtl\' ? <ArrowLeft className=\"w-4 h-4 text-white\" /> : <ArrowRight className=\"w-4 h-4 text-white\" />}\n          </button>\n        </div>\n      </section>\n\n      {/* 4. ASYMMETRIC ALTERNATING EDITORIAL CONTENT PIPELINE */}\n      <section className=\"bg-white border-y border-[#CFCFC4] py-16 md:py-24\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 md:space-y-24\">\n          \n          <div className=\"text-center space-y-3 max-w-2xl mx-auto\">\n            <span className=\"text-[10px] font-mono text-gray-400 uppercase tracking-widest\">HOW ACCONET OPERATES</span>\n            <h2 className=\"text-2xl sm:text-3xl font-serif font-semibold text-gray-950 tracking-tight\">\n              {t(\'howTitle\')}\n            </h2>\n            <p className=\"text-xs text-gray-500\">\n              Transforming accounting from manual paper filings into a secure digital workflow built for modern Algerian companies.\n            </p>\n          </div>\n\n          {/* Alternating Step 1 & 2 Grid */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center\">\n            \n            {/* Step 1 Graphic Placeholder */}\n            <div className=\"lg:col-span-5 bg-[#FAF9F5] border border-[#CFCFC4] p-6 space-y-4\">\n              <span className=\"text-[10px] font-mono uppercase tracking-widest text-gray-400 block\">PIPELINE PHASE 01</span>\n              <h4 className=\"font-serif font-bold text-gray-905 text-lg\">{t(\'howStep1Title\')}</h4>\n              <p className=\"text-xs text-gray-650 leading-relaxed font-sans\">{t(\'howStep1Desc\')}</p>\n              \n              <div className=\"p-3.5 bg-white border border-[#EBEBE5] text-[11px] font-mono space-y-1\">\n                <span className=\"text-gray-400 block text-[9px]\">WIDGET: INTERACTIVE CONTRACT DEFINITION</span>\n                <p className=\"text-gray-800\">Targeting: <strong>G50 Corporate Filing & IRG Scale audits</strong></p>\n                <p className=\"text-[#0F6E56] font-bold\">Simulated Fee bracket: Balanced Rate</p>\n              </div>\n            </div>\n\n            {/* Step 2 Display Content */}\n            <div className=\"lg:col-span-7 space-y-4 text-left rtl:text-right\">\n              <span className=\"text-4xl font-serif text-[#0F6E56] font-semibold\">01</span>\n              <h3 className=\"text-xl font-serif font-bold text-gray-950\">{t(\'howStep2Title\')}</h3>\n              <p className=\"text-xs sm:text-sm text-gray-600 leading-relaxed font-sans\">\n                {t(\'howStep2Desc\')}\n              </p>\n              <ul className=\"text-xs text-gray-600 space-y-1 font-sans\">\n                <li>\342\200\242 Real reviews from company directors across the 48 wilayas</li>\n                <li>\342\200\242 Approved registration details mapped with CNEC, ONA rules</li>\n                <li>\342\200\242 Fully customized hourly rate and contract yield estimators</li>\n              </ul>\n            </div>\n\n          </div>\n\n          {/* Alternating Step 3 & 4 Grid */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-center\">\n            \n            {/* Step 3 Display Content */}\n            <div className=\"lg:col-span-7 space-y-4 text-left rtl:text-right order-last lg:order-first\">\n              <span className=\"text-4xl font-serif text-[#0F6E56] font-semibold\">02</span>\n              <h3 className=\"text-xl font-serif font-bold text-gray-950\">{t(\'howStep3Title\')}</h3>\n              <p className=\"text-xs sm:text-sm text-gray-600 leading-relaxed font-sans\">\n                {t(\'howStep3Desc\')} {t(\'howStep4Desc\')}\n              </p>\n              <div className=\"flex gap-4 pt-2\">\n                <div className=\"flex items-center gap-1.5 text-xs text-gray-650 font-mono\">\n                  <ShieldCheck className=\"w-4 h-4 text-[#0F6E56]\" />\n                  <span>State-Authorized Contracts</span>\n                </div>\n                <div className=\"flex items-center gap-1.5 text-xs text-gray-650 font-mono\">\n                  <Activity className=\"w-4 h-4 text-[#0F6E56]\" />\n                  <span>Live Filing Milestones</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Step 4 Graphic Placeholder */}\n            <div className=\"lg:col-span-5 bg-[#FAF9F5] border border-[#CFCFC4] p-6 space-y-4\">\n              <span className=\"text-[10px] font-mono uppercase tracking-widest text-[#0F6E56] block\">SECURE DELIVERABLES</span>\n              <h4 className=\"font-serif font-bold text-gray-950 text-sm\">Engagement Letters & Legal Escrow</h4>\n              <p className=\"text-xs text-gray-500\">\n                Generate and authorize Standardized Engagement Letters (Lettres de Mission) with clear, legally binding schedules.\n              </p>\n              <div className=\"bg-white border border-[#CFCFC4] p-3 text-[11px] space-y-1.5\">\n                <div className=\"flex justify-between font-mono text-[9px] text-[#0F6E56]\">\n                  <span>CONTRACT ENVELOPE</span>\n                  <span>APPROVED BY ONCC</span>\n                </div>\n                <strong className=\"text-gray-900 block text-xs font-sans\">AccoNet Authorized Statement of Work</strong>\n                <span className=\"text-xs text-gray-500 block\">Deliverable due monthly: G50 Validation, IRS declaration, statutory balance sheets.</span>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      {/* 5. LOCALLY AUTHENTIC ALGERIAN LOCALIZATION BANNER - EMERALD GREEN */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-[#073A2F] text-white p-8 sm:p-12 border border-[#0F6E56]/40 relative\">\n          \n          <div className=\"absolute right-0 top-0 w-32 h-32 bg-[#F59E0B] rounded-full filter blur-3xl opacity-10\"></div>\n\n          <div className=\"lg:col-span-5 space-y-5 text-left rtl:text-right\">\n            <div className=\"inline-flex items-center gap-1.5 px-3 py-1 bg-white/5 text-brand-accent text-[10px] font-mono uppercase tracking-wider border border-white/15\">\n              <CloudLightning className=\"w-3.5 h-3.5 text-brand-accent animate-pulse\" />\n              <span>Algerian Compliance Core</span>\n            </div>\n            \n            <h2 className=\"text-2xl sm:text-3xl font-serif font-semibold tracking-tight leading-tight\">\n              {t(\'toolsTitle\')}\n            </h2>\n            \n            <p className=\"text-gray-300 text-xs leading-relaxed font-sans\">\n              {t(\'toolsSubtitle\')}\n            </p>\n\n            <button \n              onClick={() => navigate(\'/tools\')}\n              className=\"px-5 py-3 bg-[#0F6E56] hover:bg-[#085041] border border-transparent text-white text-xs font-mono uppercase tracking-widest transition cursor-pointer flex items-center gap-1.5\"\n            >\n              <span>{t(\'tryToolBtn\').toUpperCase()}</span>\n              {direction === \'rtl\' ? <ArrowLeft className=\"w-4 h-4\" /> : <ArrowRight className=\"w-4 h-4\" />}\n            </button>\n          </div>\n\n          <div className=\"lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-4\">\n            {toolsTeaser.map((tool) => {\n              const Icon = tool.icon;\n              return (\n                <div \n                  key={tool.key}\n                  onClick={() => navigate(\'/tools\')}\n                  className=\"bg-white/5 border border-white/10 hover:border-[#0F6E56] p-5 space-y-3 cursor-pointer hover:-translate-y-1 transition duration-200\"\n                >\n                  <div className=\"w-10 h-10 bg-white/5 flex items-center justify-center border border-white/10\">\n                    <Icon className=\"w-5 h-5 text-brand-accent\" />\n                  </div>\n                  <h3 className=\"font-mono text-white text-xs tracking-wider uppercase font-semibold\">{t(tool.key)}</h3>\n                  <p className=\"text-[10px] text-gray-300 leading-normal line-clamp-3\">{t(tool.desc)}</p>\n                </div>\n              );\n            })}\n          </div>\n\n        </div>\n      </section>\n\n      {/* 6. MAGAZINE-style TESTIMONIALS SECTION */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        <div className=\"text-center space-y-2 mb-12\">\n          <span className=\"text-[10px] font-mono tracking-widest text-gray-400 uppercase\">EXPERTISE MATTERS</span>\n          <h2 className=\"text-2xl sm:text-3xl font-serif font-semibold text-gray-950 tracking-tight\">\n            \342\255\220 {t(\'tabReviews\')}\n          </h2>\n          <p className=\"text-xs sm:text-sm text-gray-500 max-w-2xl mx-auto font-sans leading-relaxed\">\n            Algerian corporate ventures, food cooperatives, and industrial providers write about their partnership compliance journeys with AccoNet.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 divide-y md:divide-y-0 md:divide-x rtl:md:divide-x-reverse divide-[#CFCFC4] border-t border-b border-[#CFCFC4] py-8\">\n          {testimonialsList.slice(0, 3).map((test) => (\n            <div \n              key={test.name}\n              className=\"p-6 space-y-4 text-left rtl:text-right\"\n            >\n              <div className=\"flex justify-between items-center\">\n                <div className=\"flex gap-0.5 text-brand-accent\">\n                  {[1, 2, 3, 4, 5].map((s) => (\n                    <Star key={s} className=\"w-3.5 h-3.5 fill-brand-accent text-brand-accent\" />\n                  ))}\n                </div>\n                <span className=\"text-xs text-gray-405 font-mono\">Vetted SME</span>\n              </div>\n\n              <p className=\"text-gray-700 text-xs sm:text-sm leading-relaxed italic\">\n                \"{t(test.comment)}\"\n              </p>\n\n              <div className=\"flex items-center gap-3 pt-4 border-t border-[#EBEBE5]/60\">\n                <div className=\"w-8 h-8 bg-[#E1F5EE] text-[#0F6E56] font-bold font-sans flex items-center justify-center text-xs\">\n                  {test.name[0]}\n                </div>\n                <div>\n                  <h4 className=\"font-serif font-bold text-gray-950 text-xs\">{test.name}</h4>\n                  <p className=\"text-[10px] text-gray-400 font-sans\">{test.company} \342\200\242 {tObj(test.wil)}</p>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n\n      </section>\n\n    </div>\n  );\n};\n"
    }
