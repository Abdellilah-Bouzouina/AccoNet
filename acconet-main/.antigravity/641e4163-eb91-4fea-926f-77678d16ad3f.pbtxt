    replacement_chunks {
      replacement_content: "export interface FiscalDeadline {\n  id: string;\n  label: string;\n  dueDay?: number;\n  dueMonth?: number;\n  dueMonths?: number[];\n  frequency: \"monthly\" | \"quarterly\" | \"annual\" | \"social\";\n  description: string;\n  penalty: string;\n}\n\nexport const algerianFiscalDeadlines: FiscalDeadline[] = [\n  // Monthly\n  {\n    id: \'g50-jan\',\n    label: \'G50 \342\200\224 D\303\251claration mensuelle TVA + TAP\',\n    dueDay: 20,\n    frequency: \'monthly\',\n    description: \'Taxe sur la Valeur Ajout\303\251e (19% taux normal, 9% r\303\251duit) + Taxe sur l\\\'Activit\303\251 Professionnelle (1.5% commerce/services, 0.5% production).\',\n    penalty: \'10% du montant + 3% par mois de retard (Art. 193 CPF)\'\n  },\n  // Quarterly\n  {\n    id: \'irg-acompte\',\n    label: \'IRG / IBS \342\200\224 Acomptes provisionnels\',\n    dueMonths: [3, 6, 9],\n    dueDay: 20,\n    frequency: \'quarterly\',\n    description: \'30% de l\\\'IRG/IBS de l\\\'exercice pr\303\251c\303\251dent \303\227 3.\',\n    penalty: \'Majoration 10% + int\303\251r\303\252ts de retard 3%/mois\'\n  },\n  // Annual\n  {\n    id: \'bilan\',\n    label: \'D\303\251p\303\264t du Bilan Fiscal + Liasse fiscale\',\n    dueMonth: 4,\n    dueDay: 30,\n    frequency: \'annual\',\n    description: \'Bilan SCF + Compte de r\303\251sultat + Tableau des flux + Annexes. R\303\251f\303\251rence: SCF (Syst\303\250me Comptable Financier, d\303\251cret 08-156).\',\n    penalty: \'Amende 100.000 DA \303\240 500.000 DA (Art. 194 CPF)\'\n  },\n  {\n    id: \'ifu\',\n    label: \'IFU \342\200\224 Imp\303\264t Forfaitaire Unique (Auto-entrepreneurs)\',\n    dueMonth: 2,\n    dueDay: 28,\n    frequency: \'annual\',\n    description: \'Taux: 5% sur CA global. Seuil: CA < 30M DA/an (LF 2020).\',\n    penalty: \'Majoration 25%\'\n  },\n  // Social\n  {\n    id: \'cnas-t1\',\n    label: \'CNAS \342\200\224 Cotisations sociales T1\',\n    dueMonth: 4,\n    dueDay: 30,\n    frequency: \'social\',\n    description: \'Cotisations employeur (26%) + salari\303\251 (9%) sur salaire brut. D\303\251claration sur imprim\303\251 CNAS-DAS.\',\n    penalty: \'Majoration 10% + astreinte journali\303\250re\'\n  },\n  {\n    id: \'casnos\',\n    label: \'CASNOS \342\200\224 Non-salari\303\251s\',\n    dueMonth: 3,\n    dueDay: 31,\n    frequency: \'social\',\n    description: \'Cotisation forfaitaire annuelle ou proportionnelle. Obligatoire pour commer\303\247ants, artisans, professions lib\303\251rales.\',\n    penalty: \'Exclusion des prestations sociales\'\n  },\n  {\n    id: \'tap-annuel\',\n    label: \'TAP \342\200\224 D\303\251claration annuelle\',\n    dueMonth: 4,\n    dueDay: 30,\n    frequency: \'annual\',\n    description: \'Taxe sur l\\\'Activit\303\251 Professionnelle. Taux: 1.5% (commerce/services), 0.5% (production). Base: CA TTC.\',\n    penalty: \'Redressement fiscal + p\303\251nalit\303\251s 40%\'\n  }\n];\n"
    }
