          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ar: \"\330\252\330\265\331\201\330\255 \331\205\331\203\330\247\330\252\330\250 \330\247\331\204\330\256\330\250\330\261\330\251 \330\247\331\204\330\255\331\202\331\212\331\202\331\212\330\251\330\214 \331\202\330\247\330\261\331\206 \330\252\331\203\331\204\331\201\330\251 \330\247\331\204\330\263\330\247\330\271\330\251\330\214 \330\263\331\206\331\210\330\247\330\252 \330\247\331\204\330\256\330\250\330\261\330\251\330\214 \330\247\331\204\331\205\330\261\330\247\330\254\330\271\330\247\330\252\330\214 \331\210\330\243\330\271\330\257\330\247\330\257 \331\205\331\204\331\201\330\247\330\252 \330\247\331\204\330\271\331\205\331\204\330\247\330\241 \330\247\331\204\330\263\330\247\330\250\331\202\330\251.\","
