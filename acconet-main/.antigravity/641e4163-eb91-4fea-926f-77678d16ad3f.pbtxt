  file_change {
    absolute_path_uri: "file:///src/pages/Register.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useNavigate, Link } from \'react-router-dom\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useApp, UserRole } from \'../context/AppContext\';\nimport { wilayas } from \'../data/mockData\';\nimport { \n  Building2, UserCheck, ShieldCheck, Mail, Lock, \n  MapPin, Award, ArrowLeft, ArrowRight, X, UserPlus\n} from \'lucide-react\';\n\nexport const Register: React.FC = () => {\n  const { t, tSpec, tObj, direction } = useLanguage();\n  const { setUserRole, setCurrentClient, setCurrentProfessional, triggerNotification } = useApp();\n  const navigate = useNavigate();\n\n  // Active path: client vs professional\n  const [regRole, setRegRole] = useState<\'client\' | \'professional\'>(\'client\');\n\n  // Multi-fields State variables\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [entityName, setEntityName] = useState(\'\');\n  const [selectedWilaya, setSelectedWilaya] = useState<number>(16); // Algiers\n\n  // Professional Additional Fields\n  const [specialty, setSpecialty] = useState(\'certified-accountant\');\n  const [accreditNum, setAccreditNum] = useState(\'\');\n\n  const handleRegisterSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!email || !password || !entityName) return;\n\n    if (regRole === \'client\') {\n      setUserRole(\'client\');\n      setCurrentClient({\n        id: `c_custom_reg_${Date.now()}`,\n        companyName: entityName,\n        sector: { ar: \"\330\256\330\257\331\205\330\247\330\252 \330\252\330\254\330\247\330\261\331\212\330\251 \331\210\331\205\331\202\330\247\331\210\331\204\330\247\330\252\", fr: \"Services commerciaux\", en: \"Commercial services\" },\n        wilayaId: selectedWilaya,\n        wilayaName: wilayas.find((w) => w.id === selectedWilaya)?.name || { ar: \"\330\247\331\204\330\254\330\262\330\247\330\246\330\261\", fr: \"Alger\", en: \"Algiers\" },\n        logoInitials: entityName.substring(0, 2).toUpperCase(),\n        avatarBg: \"bg-teal-700 text-white\",\n        NIF: \"0019\" + Math.floor(Math.random() * 10000000000), // Random NIF code\n        RC: \"16/00-\" + Math.floor(Math.random() * 100000) + \"B26\",\n        activeContracts: [],\n        pendingTasks: []\n      });\n\n      triggerNotification(\n        t(\'authSuccessHeading\'),\n        `Successfully registered as Business SME: ${entityName}. Welcome to AccoNet!`\n      );\n      navigate(\'/dashboard/client\');\n    } else {\n      setUserRole(\'professional\');\n      setCurrentProfessional({\n        id: `p_custom_reg_${Date.now()}`,\n        name: { ar: entityName, fr: entityName, en: entityName },\n        initials: entityName.substring(0, 2).toUpperCase(),\n        avatarBg: \"bg-indigo-800 text-white\",\n        specialty: specialty as any,\n        wilayaId: selectedWilaya,\n        wilayaName: wilayas.find((w) => w.id === selectedWilaya)?.name || { ar: \"\330\247\331\204\330\254\330\262\330\247\330\246\330\261\", fr: \"Alger\", en: \"Algiers\" },\n        rating: 5.0,\n        reviewCount: 0,\n        hourlyRate: 5000,\n        available: true,\n        yearsExperience: 5,\n        accreditationNumber: accreditNum || \"CNEC/2026/001\",\n        completionRate: 100,\n        clientsServed: 0,\n        bio: {\n          ar: `\331\205\331\203\330\252\330\250 \330\247\331\204\330\256\330\250\331\212\330\261 ${entityName} \331\205\330\271\330\252\331\205\330\257 \331\204\331\205\330\267\330\247\330\250\331\202\330\251 \330\247\331\204\331\204\331\210\330\247\330\246\330\255 \330\247\331\204\331\202\330\247\331\206\331\210\331\206\331\212\330\251 \331\210\330\247\331\204\330\266\330\261\330\247\330\246\330\250 \331\201\331\212 \331\210\331\204\330\247\331\212\330\251 ${selectedWilaya}.`,\n          fr: `Cabinet de Me. ${entityName} agr\303\251\303\251 par le conseil national pour vos liasses de cl\303\264ture fiscales.`,\n          en: `Professional office of Mr/Ms ${entityName} accredited by the board. Specialized in local compliance.`\n        },\n        services: [],\n        reviews: [],\n        history: []\n      });\n\n      triggerNotification(\n        t(\'authSuccessHeading\'),\n        `Successfully registered as ${tSpec(specialty)}: Me. ${entityName}. Welcome to AccoNet!`\n      );\n      navigate(\'/dashboard/professional\');\n    }\n  };\n\n  return (\n    <div className=\"min-h-[calc(100vh-4rem)] flex items-stretch\" id=\"register_panel_viewport\">\n      \n      {/* LEFT STATIC PANEL - SPLIT THEME */}\n      <div className=\"hidden lg:flex lg:w-1/2 bg-[#0B1A16] text-white p-16 flex-col justify-between relative overflow-hidden border-r border-[#0F6E56]/30\">\n        \n        {/* Subtle decorative geometric overlay */}\n        <div className=\"absolute inset-0 opacity-[0.03] pointer-events-none\">\n          <div className=\"absolute top-0 left-0 w-full h-full bg-[linear-gradient(to_right,#0F6E56_1px,transparent_1px),linear-gradient(to_bottom,#0F6E56_1px,transparent_1px)] bg-[size:3rem_3rem]\"></div>\n        </div>\n\n        <div className=\"space-y-1 relative z-10 text-left\">\n          <Link to=\"/\" className=\"flex items-center space-x-2.5 rtl:space-x-reverse\">\n            <span className=\"flex items-center justify-center w-8 h-8 rounded-none bg-white text-brand-primary font-bold text-lg border border-[#CFCFC4]\">\n              \330\243\n            </span>\n            <span className=\"text-xl font-serif font-semibold tracking-tight text-white animate-pulse\">\n              AccoNet <span className=\"text-brand-accent\">\330\243\331\203\331\210\331\206\331\212\330\252</span>\n            </span>\n          </Link>\n          <p className=\"text-[9px] text-[#E1F5EE] font-mono tracking-widest uppercase\">National Gateway Platform</p>\n        </div>\n\n        <div className=\"space-y-4 relative z-10 text-left\">\n          <h2 className=\"text-3xl font-serif font-bold leading-tight\">\n            Connecting companies with authorized financial leaders across Algerian territory.\n          </h2>\n          <p className=\"text-gray-300 text-xs leading-relaxed max-w-sm font-sans\">\n            Easily manage quarterly VAT, trade declarations, social CNAS audits, and financial statements directly via an interactive trilingual dashboard.\n          </p>\n        </div>\n\n        <div className=\"text-xs text-[#F59E0B] flex items-center gap-2 relative z-10 font-mono\">\n          <ShieldCheck className=\"w-5 h-5 text-[#F59E0B] shrink-0\" />\n          <span>ONCC REGISTERED AUDITING REGULATION FRAMEWORK</span>\n        </div>\n\n      </div>\n\n      {/* RIGHT REGISTER DYNAMIC FORM PANEL */}\n      <div className=\"w-full lg:w-1/2 bg-[#FAF9F5] flex flex-col justify-center px-6 py-10 sm:px-12 lg:px-20 overflow-y-auto border-l border-[#CFCFC4]\">\n        <div className=\"max-w-md w-full mx-auto space-y-6 text-left rtl:text-right\">\n          \n          <div className=\"space-y-1\">\n            <h1 className=\"text-2xl sm:text-3xl font-serif font-black text-gray-950 tracking-tight\">\n              {t(\'registerTitle\')}\n            </h1>\n            <p className=\"text-[10px] text-gray-400 font-mono uppercase tracking-widest font-bold\">CREATING NEW DIGITAL CREDENTIALS</p>\n          </div>\n\n          {/* TWO PATHWAYS SELECTOR SWITCH TABS */}\n          <div className=\"space-y-2\">\n            <label className=\"text-[9px] font-mono font-bold text-gray-400 uppercase tracking-widest\">{t(\'accountTypeLabel\')}</label>\n            <div className=\"grid grid-cols-2 gap-2 bg-[#FAF9F5] border border-[#CFCFC4] p-1 text-center rounded-none\">\n              \n              <button\n                type=\"button\"\n                onClick={() => setRegRole(\'client\')}\n                className={`py-2.5 cursor-pointer text-xs font-bold transition duration-150 flex flex-col items-center justify-center gap-1.5 rounded-none ${regRole === \'client\' ? \'bg-white text-brand-primary font-bold border border-[#CFCFC4]\' : \'text-gray-500 hover:text-gray-950\'}`}\n              >\n                <Building2 className=\"w-4 h-4 text-[#0F6E56]\" />\n                <span className=\"leading-tight text-[11px]\">{t(\'isClientLabel\').split(\' \')[0]}</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setRegRole(\'professional\')}\n                className={`py-2.5 cursor-pointer text-xs font-bold transition duration-150 flex flex-col items-center justify-center gap-1.5 rounded-none ${regRole === \'professional\' ? \'bg-white text-indigo-700 font-bold border border-[#CFCFC4]\' : \'text-gray-500 hover:text-gray-950\'}`}\n              >\n                <UserCheck className=\"w-4 h-4 text-indigo-700\" />\n                <span className=\"leading-tight text-[11px]\">{t(\'isProLabel\').split(\' \')[0]}</span>\n              </button>\n\n            </div>\n          </div>\n\n          {/* REGISTER ACTION FORM */}\n          <form onSubmit={handleRegisterSubmit} className=\"space-y-3\">\n            \n            {/* Business owner or Expert Name */}\n            <div className=\"space-y-1.5\">\n              <label className=\"block text-[9px] font-mono font-bold text-gray-400 uppercase tracking-widest\">\n                {regRole === \'client\' ? t(\'fieldCompanyName\') : \"Full Name / Office Name\"}\n              </label>\n              <input \n                type=\"text\" \n                required\n                placeholder={regRole === \'client\' ? \"e.g. Sarl Chlef Agro Services\" : \"e.g. Me. Yazid Harbi\"}\n                value={entityName}\n                onChange={(e) => setEntityName(e.target.value)}\n                className=\"w-full border border-[#CFCFC4] rounded-none px-3 py-2 text-xs text-gray-800 bg-white focus:outline-none focus:border-brand-primary\"\n                id=\"reg_name_input\"\n              />\n            </div>\n\n            {/* Email Address */}\n            <div className=\"space-y-1.5\">\n              <label className=\"block text-[9px] font-mono font-bold text-gray-400 uppercase tracking-widest\">{t(\'fieldEmail\')}</label>\n              <div className=\"relative border border-[#CFCFC4] rounded-none bg-white px-3 py-2 flex items-center gap-2 focus-within:border-brand-primary transition\">\n                <Mail className=\"w-4 h-4 text-[#0F6E56] shrink-0\" />\n                <input \n                  type=\"email\" \n                  required\n                  placeholder=\"admin@cabinet.dz\"\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  className=\"w-full text-xs text-gray-750 bg-transparent focus:outline-none\"\n                  id=\"reg_email_input\"\n                />\n              </div>\n            </div>\n\n            {/* Password */}\n            <div className=\"space-y-1.5\">\n              <label className=\"block text-[9px] font-mono font-bold text-gray-400 uppercase tracking-widest\">{t(\'fieldPassword\')}</label>\n              <div className=\"relative border border-[#CFCFC4] rounded-none bg-white px-3 py-2 flex items-center gap-2 focus-within:border-brand-primary transition\">\n                <Lock className=\"w-4 h-4 text-[#0F6E56] shrink-0\" />\n                <input \n                  type=\"password\" \n                  required\n                  placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  className=\"w-full text-xs text-gray-750 bg-transparent focus:outline-none\"\n                  id=\"reg_password_input\"\n                />\n              </div>\n            </div>\n\n            {/* Wilaya Picker */}\n            <div className=\"space-y-1.5\">\n              <label className=\"block text-[9px] font-mono font-bold text-gray-400 uppercase tracking-widest\">{t(\'fieldWilaya\')}</label>\n              <div className=\"relative border border-[#CFCFC4] rounded-none bg-white px-3 py-2 flex items-center gap-2 focus-within:border-brand-primary transition\">\n                <MapPin className=\"w-4 h-4 text-[#0F6E56] shrink-0\" />\n                <select\n                  value={selectedWilaya}\n                  onChange={(e) => setSelectedWilaya(Number(e.target.value))}\n                  className=\"w-full bg-transparent text-xs text-gray-750 focus:outline-none cursor-pointer\"\n                  id=\"reg_wilaya_input\"\n                >\n                  {wilayas.map((w) => (\n                    <option key={w.id} value={w.id}>{w.code} - {tObj(w.name)}</option>\n                  ))}\n                </select>\n              </div>\n            </div>\n\n            {/* ADDITIONAL FIELDS FOR THE PROFESSIONAL ROLE FORM */}\n            {regRole === \'professional\' && (\n              <div className=\"space-y-3.5 p-4 bg-white border border-[#CFCFC4] rounded-none animate-fade-in\" id=\"pro_additional_reg_fields\">\n                <p className=\"text-[9px] uppercase font-bold text-indigo-700 tracking-widest font-mono\">Specialist Credentials</p>\n                \n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3.5\">\n                  <div className=\"space-y-1\">\n                    <label className=\"block text-[9px] font-mono font-bold text-gray-400 uppercase tracking-widest\">{t(\'fieldSpecialty\')}</label>\n                    <select\n                      value={specialty}\n                      onChange={(e) => setSpecialty(e.target.value)}\n                      className=\"w-full border border-[#CFCFC4] rounded-none p-2 bg-white text-xs text-gray-750 focus:outline-none focus:border-brand-primary cursor-pointer\"\n                    >\n                      <option value=\"certified-accountant\">{tSpec(\"certified-accountant\")}</option>\n                      <option value=\"chartered-accountant\">{tSpec(\"chartered-accountant\")}</option>\n                      <option value=\"statutory-auditor\">{tSpec(\"statutory-auditor\")}</option>\n                      <option value=\"tax-consultant\">{tSpec(\"tax-consultant\")}</option>\n                      <option value=\"judicial-expert\">{tSpec(\"judicial-expert\")}</option>\n                    </select>\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <label className=\"block text-[9px] font-mono font-bold text-gray-400 uppercase tracking-widest\">{t(\'fieldAccreditation\')}</label>\n                    <div className=\"relative border border-[#CFCFC4] rounded-none bg-white p-2 flex items-center gap-1.5 focus-within:border-brand-primary\">\n                      <Award className=\"w-4 h-4 text-indigo-750 shrink-0\" />\n                      <input \n                        type=\"text\" \n                        required\n                        placeholder={t(\'accNumPlaceholder\')}\n                        value={accreditNum}\n                        onChange={(e) => setAccreditNum(e.target.value)}\n                        className=\"w-full text-xs text-gray-750 bg-transparent focus:outline-none\"\n                      />\n                    </div>\n                  </div>\n                </div>\n              </div>\n            )}\n\n            {/* Submit button */}\n            <button\n              type=\"submit\"\n              className=\"w-full py-3 bg-brand-primary hover:bg-[#085041] hover:scale-[1.01] text-white text-[10px] font-mono uppercase tracking-widest transition cursor-pointer flex items-center justify-center gap-1.5 shadow-xs\"\n              id=\"reg_submit_btn\"\n            >\n              <span>{t(\'registerLink\').toUpperCase()}</span>\n              {direction === \'rtl\' ? <ArrowLeft className=\"w-4 h-4\" /> : <ArrowRight className=\"w-4 h-4\" />}\n            </button>\n\n          </form>\n\n          {/* BACK TO LOGIN */}\n          <p className=\"text-xs text-gray-505 text-center font-sans\">\n            {t(\'alreadyHaveAccount\')}{\' \'}\n            <Link to=\"/login\" className=\"text-brand-primary font-bold hover:underline\" id=\"reg_to_login_link\">\n              {t(\'loginLink\')}\n            </Link>\n          </p>\n\n        </div>\n      </div>\n\n    </div>\n  );\n};\n"
