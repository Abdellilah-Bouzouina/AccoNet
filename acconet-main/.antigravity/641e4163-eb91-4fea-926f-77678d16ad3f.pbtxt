          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ar: \"\331\210\331\201\330\261\331\206\330\247 \330\250\331\212\330\246\330\251 \330\261\331\202\331\205\331\212\330\251 \331\204\330\265\331\212\330\247\330\272\330\251 \330\255\330\257\331\210\330\257 \330\247\331\204\331\205\331\207\330\247\331\205 \331\210\330\252\331\210\331\202\331\212\330\252\331\207\330\247 \331\210\330\247\331\204\330\247\331\204\330\252\330\262\330\247\331\205\330\247\330\252 \330\247\331\204\331\205\330\247\331\204\331\212\330\251 \330\250\330\264\331\203\331\204 \330\261\330\263\331\205\331\212 \331\210\331\205\330\253\330\250\330\252.\","
