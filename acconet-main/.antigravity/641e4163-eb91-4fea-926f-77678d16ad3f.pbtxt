  file_change {
    absolute_path_uri: "file:///src/index.css"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "@theme {\n  --font-sans: \"Inter\", \"Cairo\", system-ui, sans-serif;\n  --font-serif: \"Playfair Display\", \"Amiri\", Georgia, serif;\n  --font-mono: \"JetBrains Mono\", monospace;\n  \n  --color-brand-primary: #0F6E56;\n  --color-brand-light: #E1F5EE;\n  --color-brand-dark: #085041;\n  --color-brand-accent: #F59E0B;\n  --color-brand-neutral: #1F2937;\n  --color-brand-surface: #F9FAFB;\n}\n\n/* Animations and Utilities */\n@keyframes pulse-slow {\n  0%, 100% { opacity: 0.9; transform: scale(1); }\n  50% { opacity: 0.6; transform: scale(1.05); }\n}\n\n.pulse-accent {\n  animation: pulse-slow 3s infinite ease-in-out;\n}\n\n@utility glass {\n  background-color: rgba(255, 255, 255, 0.75);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid rgba(255, 255, 255, 0.5);\n  box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.02);\n}\n\n@utility glass-dark {\n  background-color: rgba(17, 24, 39, 0.75);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);\n}\n\n@utility glass-brand {\n  background-color: rgba(15, 110, 86, 0.08);\n  backdrop-filter: blur(8px);\n  -webkit-backdrop-filter: blur(8px);\n  border: 1px solid rgba(15, 110, 86, 0.15);\n}\n\n@utility shadow-classic {\n  box-shadow: 0 12px 30px -8px rgba(0, 0, 0, 0.05), 0 4px 10px -3px rgba(0, 0, 0, 0.03);\n}\n\n@utility shadow-glow {\n  box-shadow: 0 10px 30px -10px rgba(15, 110, 86, 0.25);\n}\n\nbody {\n  background-color: var(--color-brand-surface);\n  color: var(--color-brand-neutral);\n  font-family: var(--font-sans);\n}"
      replacement_content: "@theme {\n  --font-sans: \"Inter\", \"Cairo\", system-ui, sans-serif;\n  --font-serif: \"Playfair Display\", \"Amiri\", Georgia, serif;\n  --font-mono: \"JetBrains Mono\", monospace;\n  \n  --color-brand-primary: #14B8A6;       /* Premium accent teal */\n  --color-brand-light: rgba(20, 184, 166, 0.08); /* Transparent glow background */\n  --color-brand-dark: #0D9488;          /* Accent hover */\n  --color-brand-accent: #14B8A6;        /* Primary accent icon/highlight */\n  --color-brand-neutral: #F1F5F9;       /* Light typography */\n  --color-brand-surface: #0B1020;       /* Prime Background */\n  --color-brand-bg-darker: #070A13;     /* Ultra dark layout mask */\n  --color-brand-secondary: #12182B;     /* Secondary container background */\n  --color-brand-tertiary: #151C31;      /* Tertiary elevated background */\n}\n\n/* Animations and Utilities */\n@keyframes pulse-slow {\n  0%, 100% { opacity: 0.9; transform: scale(1); }\n  50% { opacity: 0.6; transform: scale(1.02); }\n}\n\n.pulse-accent {\n  animation: pulse-slow 3s infinite ease-in-out;\n}\n\n@utility glass {\n  background-color: rgba(18, 24, 43, 0.70);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.4);\n}\n\n@utility glass-dark {\n  background-color: rgba(7, 10, 19, 0.85);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(255, 255, 255, 0.04);\n  box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.6);\n}\n\n@utility glass-teal {\n  background-color: rgba(20, 184, 166, 0.03);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(20, 184, 166, 0.12);\n}\n\n@utility shadow-classic {\n  box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5), 0 1px 3px rgba(255, 255, 255, 0.02);\n}\n\n@utility shadow-glow {\n  box-shadow: 0 0 30px -5px rgba(20, 184, 166, 0.15), 0 15px 35px -10px rgba(0, 0, 0, 0.4);\n}\n\n@utility border-subtle {\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n\nbody {\n  background-color: #0B1020;\n  color: #F8FAFC;\n  font-family: var(--font-sans);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n/* Scrollbar styling for modern dark layout */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #0B1020;\n}\n::-webkit-scrollbar-thumb {\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(20, 184, 166, 0.3);\n}"
    }
