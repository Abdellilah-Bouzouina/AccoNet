        replacement_content: "                    {cabinet.approvedStatus === \'active\' ? (\n                      <span className=\"flex items-center gap-1.5 px-2 py-1 bg-emerald-50 border border-emerald-250 text-emerald-800 text-[9px] font-mono font-bold uppercase tracking-wide\">\n                        <BadgeCheck className=\"w-3.5 h-3.5 text-emerald-700 shrink-0\" />\n                        {t(\'stateCabinetApprovedStatus\').replace(\'\360\237\233\241\357\270\217 \', \'\')}\n                      </span>\n                    ) : (\n                      <span className=\"flex items-center gap-1.5 px-2 py-1 bg-amber-50 border border-amber-250 text-amber-800 text-[9px] font-mono font-bold uppercase tracking-wide\">\n                        <ShieldAlert className=\"w-3.5 h-3.5 text-amber-700 shrink-0\" />\n                        {t(\'stateCabinetPendingStatus\')}\n                      </span>\n                    )}\n\n                    <button\n                      onClick={() => handleToggleStatus(cabinet.id, cabinet.approvedStatus)}\n                      className={`px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider cursor-pointer border ${\n                        cabinet.approvedStatus === \'active\' \n                          ? \'border-red-300 text-red-600 hover:bg-red-50 bg-white\' \n                          : \'border-brand-primary text-brand-primary hover:bg-brand-light bg-white font-bold\'\n                      }`}\n                    >\n                      {cabinet.approvedStatus === \'active\' ? t(\'suspendCabinetButton\') : t(\'approvalsAcquiesceButton\')}\n                    </button>"
