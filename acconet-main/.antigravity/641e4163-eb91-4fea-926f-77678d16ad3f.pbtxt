        lines {
          text: "      ar: \"\331\205\330\255\330\247\330\263\330\250\330\251 \331\205\330\271\330\252\331\205\330\257\330\251 \330\250\330\256\330\250\330\261\330\251 \331\210\330\247\330\263\330\271\330\251 \331\210\331\205\330\252\331\205\331\212\330\262\330\251 \331\201\331\212 \331\205\330\263\330\247\330\271\330\257\330\251 \330\247\331\204\331\205\330\244\330\263\330\263\330\247\330\252 \330\247\331\204\331\201\331\204\330\247\330\255\331\212\330\251 \331\210\330\247\331\204\330\252\330\271\330\247\331\210\331\206\331\212\330\247\330\252 \331\210\330\247\331\204\330\245\331\206\330\252\330\247\330\254 \330\247\331\204\331\205\330\255\331\204\331\212 \330\250\331\205\331\206\330\267\331\202\330\251 \330\252\331\212\330\262\331\212 \331\210\330\262\331\210 \331\210\330\247\331\204\330\250\331\210\331\212\330\261\330\251 \331\210\331\205\331\210\331\205\330\261\330\257\330\247\330\263. \331\206\330\256\330\257\331\205\331\203\331\205 \330\250\330\247\331\204\330\260\331\203\330\247\330\241 \331\210\330\247\331\204\330\264\331\201\330\247\331\201\331\212\330\251 \330\247\331\204\330\252\330\247\331\205\330\251.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      fr: \"Comptable agr\303\251\303\251e sp\303\251cialis\303\251e dans l\'accompagnement des coop\303\251ratives agricoles, PME et producteurs locaux en Kabylie (Tizi Ouzou, Bouira). Transparence et rigueur garanties.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
