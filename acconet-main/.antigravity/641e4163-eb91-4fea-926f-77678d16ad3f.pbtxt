ssName=\"grid grid-cols-2 gap-2 my-4 pt-4 border-t border-gray-50\">\n          \n          {/* Wilaya location */}\n          <div className=\"flex items-center gap-1.5 text-xs text-gray-650\">\n            <MapPin className=\"w-4 h-4 text-brand-primary shrink-0\" />\n            <span className=\"hover:underline cursor-pointer\">{tObj(professional.wilayaName)}</span>\n          </div>\n\n          {/* Years of Practice */}\n          <div className=\"flex items-center gap-1.5 text-xs text-gray-650\">\n            <Award className=\"w-4 h-4 text-brand-primary shrink-0\" />\n            <span>\n              {professional.yearsExperience} {t(\'expYears\')}\n            </span>\n          </div>\n\n          {/* Stars & rating */}\n          <div className=\"flex items-center gap-1.5 text-xs text-gray-650 col-span-2\">\n            <div className=\"flex items-center gap-0.5 text-brand-accent\">\n              <Star className=\"w-4 h-4 fill-brand-accent\" />\n              <span className=\"font-bold text-gray-900 text-xs\">{professional.rating}</span>\n            </div>\n            <span className=\"text-gray-450 font-sans\">\n              ({professional.reviewCount} reviews)\n            </span>\n            <div className=\"ml-auto rtl:ml-0 rtl:mr-auto flex items-center text-[10px] text-gray-400 border border-[#EBEBE5] rounded-none px-1.5 font-mono uppercase\">\n              <ShieldCheck className=\"w-3 h-3 text-teal-600 mr-0.5 rtl:mr-0 rtl:ml-0.5 shrink-0\" />\n              <span>{professional.accreditationNumber.split(\'/\')[0]}</span>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Button footer row */}\n      <div className=\"pt-4 border-t border-[#EBEBE5] flex items-center justify-between\">\n        <div className=\"flex flex-col\">\n          <span className=\"text-[10px] text-gray-400 leading-none\">{t(\'profileHourlyRateSpec\')}</span>\n          <span className=\"text-sm font-bold text-brand-primary font-mono mt-0.5\">\n            {professional.hourlyRate.toLocaleString()} DZD <span className=\"text-[10px] font-sans font-normal text-gray-500\">/hr</span>\n          </span>\n        </div>\n\n        <Link \n          to={`/professional/${professional.id}`}\n          className=\"flex items-center gap-1 px-4 py-2 bg-brand-light hover:bg-brand-primary text-brand-primary hover:text-white rounded-xl text-xs font-bold transition-all duration-200\"\n          id={`view_profile_btn_${professional.id}`}\n        >\n          <span>{t(\'viewProfile\')}</span>\n          {direction === \'rtl\' ? <ArrowLeft className=\"w-3.5 h-3.5\" /> : <ArrowRight className=\"w-3.5 h-3.5\" />}\n        </Link>\n      </div>"
      replacement_content: "    <div \n      className=\"bg-white border border-[#CFCFC4] rounded-none shadow-2xs hover:shadow-sm transition-all duration-200 p-5 flex flex-col justify-between hover:border-brand-primary/50 relative\"\n      id={`pro_card_${professional.id}`}\n    >\n      <div>\n        \n        {/* Header - Avatar & Status */}\n        <div className=\"flex justify-between items-start mb-4\">\n          <div className=\"flex items-center gap-3\">\n            {/* Visual Avatar with initials */}\n            <div className={`w-12 h-12 rounded-none flex items-center justify-center font-bold text-sm tracking-widest shrink-0 ${professional.avatarBg}`}>\n              {professional.initials}\n            </div>\n            \n            <div>\n              <h3 className=\"font-serif font-semibold text-gray-900 text-base tracking-tight hover:text-brand-primary transition\">\n                {tObj(professional.name)}\n              </h3>\n              <p className=\"text-xs text-brand-primary font-bold\">\n                {tSpec(professional.specialty)}\n              </p>\n            </div>\n          </div>\n\n          {/* Availability Pulse Badge */}\n          {professional.available ? (\n            <span className=\"flex items-center gap-1.5 px-2 py-0.5 bg-teal-50 border border-teal-200 text-teal-800 text-[10px] font-mono rounded-none\">\n              <span className=\"w-1.5 h-1.5 bg-teal-600 rounded-full animate-pulse\"></span>\n              {t(\'availableStatus\').toUpperCase()}\n            </span>\n          ) : (\n            <span className=\"px-2 py-0.5 bg-gray-50 border border-gray-200 text-gray-400 text-[10px] font-mono rounded-none\">\n              {t(\'busyStatus\').toUpperCase()}\n            </span>\n          )}\n        </div>\n\n        {/* Bio summary block */}\n        <p className=\"text-gray-550 text-xs leading-relaxed line-clamp-2 mb-4 h-8\" title={tObj(professional.bio)}>\n          {tObj(professional.bio)}\n        </p>\n\n        {/* Essential Info Badges */}\n        <div className=\"grid grid-cols-2 gap-2 my-4 pt-4 border-t border-[#EBEBE5]\">\n          \n          {/* Wilaya location */}\n          <div className=\"flex items-center gap-1.5 text-xs text-gray-650\">\n            <MapPin className=\"w-4 h-4 text-brand-primary shrink-0\" />\n            <span className=\"hover:underline cursor-pointer\">{tObj(professional.wilayaName)}</span>\n          </div>\n\n          {/* Years of Practice */}\n          <div className=\"flex items-center gap-1.5 text-xs text-gray-650\">\n            <Award className=\"w-4 h-4 text-brand-primary shrink-0\" />\n            <span>\n              {professional.yearsExperience} {t(\'expYears\')}\n            </span>\n          </div>\n\n          {/* Stars & rating */}\n          <div className=\"flex items-center gap-1.5 text-xs text-gray-650 col-span-2\">\n            <div className=\"flex items-center gap-0.5 text-brand-accent\">\n              <Star className=\"w-4 h-4 fill-brand-accent\" />\n              <span className=\"font-bold text-gray-900 text-xs\">{professional.rating}</span>\n            </div>\n            <span className=\"text-gray-450 font-sans\">\n              ({professional.reviewCount} reviews)\n            </span>\n            <div className=\"ml-auto rtl:ml-0 rtl:mr-auto flex items-center text-[10px] text-gray-400 border border-[#EBEBE5] rounded-none px-1.5 font-mono uppercase\">\n              <ShieldCheck className=\"w-3 h-3 text-teal-600 mr-0.5 rtl:mr-0 rtl:ml-0.5 shrink-0\" />\n              <span>{professional.accreditationNumber.split(\'/\')[0]}</span>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* Button footer row */}\n      <div className=\"pt-4 border-t border-[#EBEBE5] flex items-center justify-between\">\n        <div className=\"flex flex-col\">\n          <span className=\"text-[10px] text-gray-400 font-mono uppercase tracking-wider leading-none\">{t(\'profileHourlyRateSpec\')}</span>\n          <span className=\"text-sm font-bold text-brand-primary font-mono mt-1\">\n            {professional.hourlyRate.toLocaleString()} <span className=\"text-[10px] text-gray-500\">DZD / hr</span>\n          </span>\n        </div>\n\n        <Link \n          to={`/professional/${professional.id}`}\n          className=\"flex items-center gap-1.5 px-3.5 py-1.5 border border-brand-primary bg-transparent text-brand-primary hover:bg-brand-primary hover:text-white rounded-none text-[11px] font-mono uppercase tracking-wider transition-all duration-200\"\n          id={`view_profile_btn_${professional.id}`}\n        >\n          <span>{t(\'viewProfile\')}</span>\n          {direction === \'rtl\' ? <ArrowLeft className=\"w-3.5 h-3.5\" /> : <ArrowRight className=\"w-3.5 h-3.5\" />}\n        </Link>\n      </div>"
