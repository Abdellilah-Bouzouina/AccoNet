30\252\330\262\330\247\331\205 \330\247\331\204\330\252\330\247\331\205 \330\250\330\247\331\204\331\206\330\270\330\247\331\205 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\331\212 \330\247\331\204\331\205\330\247\331\204\331\212 (SCF)\",\n    fr: \"Syst\303\250me Comptable Financier respect\303\251\",\n    en: \"Financial Accounting System (SCF) respected\"\n  },\n  certifiedAdmission: {\n    ar: \"\330\245\331\212\330\257\330\247\330\271 \331\205\331\204\331\201\330\247\330\252 \330\242\331\205\331\206 \331\210\331\205\330\264\331\201\330\261\",\n    fr: \"D\303\251p\303\264t s\303\251curis\303\251 (Art. 222)\",\n    en: \"Encrypted file backups\"\n  },\n  certifiedAdmissionSub: {\n    ar: \"\330\255\331\205\330\247\331\212\330\251 \330\252\330\247\331\205\330\251 \331\204\330\263\330\261\331\212\330\251 \330\247\331\204\330\250\331\212\330\247\331\206\330\247\330\252 \331\210\330\247\331\204\331\205\331\210\330\247\330\262\331\206\330\247\330\252\",\n    fr: \"Dossiers d\'agr\303\251ment int\303\250gres crypt\303\251s\",\n    en: \"Fully secure audit files handling\"\n  },\n  searchTerminalHeading: {\n    ar: \"\330\247\331\204\330\250\330\255\330\253 \330\271\331\206 \330\264\330\261\331\212\331\203 \331\202\330\266\330\247\330\246\331\212 / \330\254\330\250\330\247\330\246\331\212 / \331\205\330\255\330\247\330\263\330\250\331\212\",\n    fr: \"Recherche de Partenaire Judiciaire / Fiscal / Comptable\",\n    en: \"Search for Judicial / Fiscal / Accounting Partner\"\n  },\n  searchPlaceholderInput: {\n    ar: \"\331\205\330\253\330\247\331\204 : G50 \330\214 \331\205\331\212\330\262\330\247\331\206\331\212\330\251 SCF \330\214 \331\204\331\202\331\205\330\251 \331\205\330\247\331\204\331\212\330\251...\",\n    fr: \"ex : G50, bilan SCF, liasse fiscale...\",\n    en: \"ex: G50, SCF balance sheet, fiscal return...\"\n  },\n  searchBtnText: {\n    ar: \"\330\247\330\250\330\255\330\253\",\n    fr: \"Rechercher\",\n    en: \"Search\"\n  },\n  featuredProsHeading: {\n    ar: \"\330\247\331\204\331\205\331\204\331\201\330\247\330\252 \330\247\331\204\330\250\330\247\330\261\330\262\330\251 \331\204\331\204\330\254\330\257\331\210\331\204 \330\247\331\204\331\210\330\267\331\206\331\212\",\n    fr: \"Profils Vedettes de l\'Ordre National\",\n    en: \"Featured National Order Profiles\"\n  },\n  featuredProsSub: {\n    ar: \"\330\243\330\271\330\266\330\247\330\241 \331\206\330\264\330\267\331\210\331\206 \331\205\330\271\330\252\331\205\330\257\331\210\331\206. \331\212\330\252\331\210\331\201\330\261 \331\203\331\204 \330\256\330\250\331\212\330\261 \330\271\331\204\331\211 \331\205\331\204\331\201 \330\252\330\271\330\261\331\212\331\201 \331\205\330\261\330\256\330\265 \331\205\330\271 \330\261\331\202\331\205 \330\247\331\204\330\252\331\210\330\253\331\212\331\202 \331\210\330\271\331\212\331\206\330\247\330\252 \331\205\330\261\330\247\330\254\330\271\330\247\330\252 \330\243\330\265\330\255\330\247\330\250 \330\247\331\204\330\243\330\271\331\205\330\247\331\204 \330\247\331\204\330\265\330\247\330\271\330\257\330\251.\",\n    fr: \"Membres actifs confirm\303\251s. Chaque professionnel dispose d\'un profil d\'exercice avec num\303\251ro d\'accr\303\251ditation v\303\251rifi\303\251 et avis d\'entrepreneurs locaux.\",\n    en: \"Confirmed active professional members. Each expert has a licensed practicing profile with a verified accreditation number and client reviews.\"\n  },\n  feedbackLocalEntities: {\n    ar: \"\330\252\331\202\331\212\331\212\331\205\330\247\330\252 \331\205\331\203\330\247\330\252\330\250 \331\210\331\205\330\244\330\263\330\263\330\247\330\252 \331\206\330\263\331\212\330\254\331\206\330\247 \330\247\331\204\330\247\331\202\330\252\330\265\330\247\330\257\331\212\",\n    fr: \"Retour d\'exp\303\251rience des structures locales\",\n    en: \"Feedback from Local Algerian SME Entities\"\n  },\n  testimonialsEditoHeading: {\n    ar: \"\330\264\331\207\330\247\330\257\330\247\330\252 \330\255\331\212\330\251 \331\210\330\255\330\247\331\204\330\247\330\252 \330\271\331\205\331\204\331\212\330\251 \331\204\331\204\330\247\330\263\330\252\330\271\331\205\330\247\331\204\",\n    fr: \"T\303\251moignages et cas d\'usage r\303\251glementaires\",\n    en: \"Testimonials and Regulatory Use Cases\"\n  },\n  testimonialsEditoSub: {\n    ar: \"\331\205\331\206 \330\247\331\204\330\252\330\257\331\202\331\212\331\202 \330\247\331\204\330\245\331\204\330\262\330\247\331\205\331\212 \331\204\330\254\331\205\330\271\331\212\330\247\330\252 \331\210\331\207\330\261\330\247\331\206 \330\245\331\204\331\211 \330\254\330\250\330\247\331\212\330\251 \330\247\331\204\330\264\330\261\331\203\330\247\330\252 \330\247\331\204\331\206\330\247\330\264\330\246\330\251 \330\250\330\247\331\204\330\271\330\247\330\265\331\205\330\251. \330\252\330\271\330\261\331\201 \330\271\331\204\331\211 \330\263\330\250\330\250 \330\253\331\202\330\251 \330\247\331\204\331\205\330\244\330\263\330\263\330\247\330\252.\",\n    fr: \"De l\'audit obligatoire des associations sportives \303\240 Oran, \303\240 la fiscalit\303\251 des startups labellis\303\251es \303\240 Alger. D\303\251couvrez pourquoi les entreprises alg\303\251riennes font confiance \303\240 nos partenaires.\",\n    en: \"From mandatory audits of sports associations in Oran, to startup tax certifications in Algiers. Discover why Algerian companies trust AccoNet.\"\n  },\n  verifiedContractLabel: {\n    ar: \"\330\271\331\202\330\257 \330\243\331\203\331\210\331\206\331\212\330\252 \331\205\330\244\331\203\330\257\",\n    fr: \"Contrat AccoNet V\303\251rifi\303\251\",\n    en: \"Verified AccoNet Contract\"\n  },\n  sandboxHeading: {\n    ar: \"\330\247\331\204\331\205\330\255\330\247\331\203\330\247\330\251 \331\210\330\247\331\204\330\250\331\212\330\247\331\206 \330\247\331\204\330\254\330\250\330\247\330\246\331\212 \330\247\331\204\330\252\330\254\330\261\331\212\330\250\331\212 \342\200\224 \330\250\330\247\331\202\330\251 \330\247\331\204\330\252\330\254\330\261\331\212\330\250\",\n    fr: \"Simulations fiscales alg\303\251riennes \342\200\224 Bac \303\240 Sable\",\n    en: \"Algerian Fiscal Simulations \342\200\224 Sandbox Showcase\"\n  },\n  sandboxMainHeading: {\n    ar: \"\330\247\330\255\330\263\330\250 \331\205\330\250\330\247\331\204\330\272 \330\247\331\204\330\266\330\261\330\247\330\246\330\250 TVA \331\210 TAP \331\210\331\207\331\212\331\203\331\204 \330\252\330\250\331\212\331\212\330\252 SCF\",\n    fr: \"Simulez des calculations TVA, TAP et liasse SCF\",\n    en: \"Simulate Tax Outflows: VAT, TAP, and SCF Ledgers\"\n  },\n  sandboxSubHeading: {\n    ar: \"\330\252\330\255\331\202\331\202 \331\205\331\206 \330\263\331\204\330\247\331\205\330\251 \330\247\331\204\331\205\331\212\330\262\330\247\331\206\331\212\330\251 \330\247\331\204\330\257\331\201\330\252\330\261\331\212\330\251 \330\243\331\205\330\247\331\205 \331\205\330\252\330\267\331\204\330\250\330\247\330\252 \330\247\331\204\331\205\331\206\330\270\331\205\330\251 \330\247\331\204\331\210\330\267\331\206\331\212\330\251 \330\247\331\204\330\254\330\262\330\247\330\246\330\261\331\212\330\251 \331\204\331\204\331\205\330\255\330\247\330\263\330\250\330\251 \331\210\330\247\330\255\330\263\330\250 \331\205\330\250\330\247\331\204\330\272 \330\247\331\204\330\261\330\263\331\210\331\205 \330\250\331\206\331\202\330\261\330\251 \331\210\330\247\330\255\330\257\330\251.\",\n    fr: \"V\303\251rifiez la conformit\303\251 de votre balance comptable face aux exigences du Syst\303\250me Comptable Financier (SCF) et g\303\251n\303\251rez des estimations de droits d\'enregistrement.\",\n    en: \"Assess compliance of your financial balance against the national Finance Act guidelines instantly through our tools.\"\n  },\n  sandboxButton: {\n    ar: \"\330\247\331\204\330\257\330\256\331\210\331\204 \330\245\331\204\331\211 \330\243\330\257\331\210\330\247\330\252 \330\247\331\204\331\205\330\255\330\247\331\203\330\247\330\251 \342\206\220\",\n    fr: \"Acc\303\251der aux simulateurs \342\206\222\",\n    en: \"Open Sandbox Simulators \342\206\222\"\n  },\n  widgetSmeHeading: {\n    ar: \"\330\243\330\257\330\247\330\251: \330\252\331\202\330\257\331\212\330\261 \331\205\330\263\330\252\330\255\331\202\330\247\330\252 \330\247\331\204\330\254\330\250\330\247\331\212\330\251 \331\210\330\261\330\265\331\212\330\257 \330\247\331\204\331\205\331\210\330\247\330\262\331\206\330\251 \331\204\331\204\330\264\330\261\331\203\330\247\330\252\",\n    fr: \"WIDGET: ESTIMATEUR DE RETRACTATION JIBAYATIC\",\n    en: \"WIDGET: JIBAYATIC TAX LIABILITY ESTIMATOR\"\n  },\n  sandboxActiveLabel: {\n    ar: \"\331\205\330\255\330\247\331\203\330\247\330\251 \331\206\330\264\330\267\330\251\",\n    fr: \"SANDBOX ACTIVE\",\n    en: \"SANDBOX ACTIVE\"\n  },\n  baseTapText: {\n    ar: \"\331\210\330\271\330\247\330\241 \330\254\330\250\330\247\331\212\330\251 TAP: \330\261\331\202\331\205 \330\243\330\271\331\205\330\247\331\204 \331\205\331\205\330\247\330\261\330\263\330\251 \330\247\331\204\331\206\330\264\330\247\330\267 \330\256\330\247\330\261\330\254 \330\247\331\204\330\261\330\263\331\210\331\205\",\n    fr: \"Base d\'assiette TAP : CA TTC du mois d\'exercice\",\n    en: \"TAP turnover tax base: Gross monthly revenue from exercise\"\n  },\n  vtaStandardText: {\n    ar: \"\331\205\330\271\330\257\331\204 \330\247\331\204\331\202\331\212\331\205\330\251 \330\247\331\204\331\205\330\266\330\247\331\201\330\251 TVA \330\247\331\204\331\205\330\267\330\250\331\202: 19% (\330\247\331\204\331\206\330\263\330\250\330\251 \330\247\331\204\330\271\330\247\331\205\330\251 \331\204\331\204\330\256\330\257\331\205\330\247\330\252)\",\n    fr: \"TVA standard : 19% (Taux normal d\'importation/services)\",\n    en: \"Standard VAT rate: 19% (Regular bracket for imports/services)\"\n  },\n  penaltyText: {\n    ar: \"\330\247\331\204\330\272\330\261\330\247\331\205\330\247\330\252 \330\247\331\204\331\205\330\263\330\25