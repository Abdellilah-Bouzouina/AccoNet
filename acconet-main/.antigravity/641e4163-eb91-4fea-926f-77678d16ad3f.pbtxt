          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ar: \"1. \330\255\330\257\330\257 \330\247\330\255\330\252\331\212\330\247\330\254\331\203 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\331\212\","
