    instruction: "Apply Editorial Aesthetic styling to Footer element and simulation control deck"
    replacement_infos {
      original_chunk {
        target_content: "    <footer className=\"bg-brand-dark text-white border-t border-brand-primary/40 pt-16 pb-8\" id=\"main_footer\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Main Footer Links */}\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-white/10\">\n          \n          {/* Brand Info */}\n          <div className=\"md:col-span-2 space-y-4\">\n            <div className=\"flex items-center space-x-2 rtl:space-x-reverse\">\n              <span className=\"flex items-center justify-center w-8 h-8 rounded-lg bg-white text-brand-primary font-black text-lg shadow-sm\">\n                \330\243\n              </span>\n              <span className=\"text-xl font-bold tracking-tight text-white font-sans\">\n                {t(\'brandName\')} <span className=\"text-brand-accent\">\330\243\331\203\331\210\331\206\331\212\330\252</span>\n              </span>\n            </div>\n            \n            <p className=\"text-gray-300 text-sm leading-relaxed max-w-sm\">\n              {t(\'brandSlogan\')}\n            </p>\n            \n            <div className=\"flex items-center space-x-2 rtl:space-x-reverse text-xs text-brand-light font-medium bg-brand-primary/40 px-3 py-2 rounded-lg inline-block\">\n              <ShieldAlert className=\"w-4 h-4 text-brand-accent shrink-0\" />\n              <span>Algerian SCF 2026 Compatible \342\200\242 48 Wilayas</span>\n            </div>\n          </div>\n\n          {/* Quick links */}\n          <div>\n            <h3 className=\"text-brand-accent font-bold text-sm tracking-widest uppercase mb-4\">\n              {t(\'brandName\')} Platform\n            </h3>\n            <ul className=\"space-y-2 text-sm text-gray-300\">\n              <li>\n                <Link to=\"/search\" className=\"hover:text-brand-accent transition\">{t(\'findProButton\')}</Link>\n              </li>\n              <li>\n                <Link to=\"/tools\" className=\"hover:text-brand-accent transition\">{t(\'toolsLink\')}</Link>\n              </li>\n              <li>\n                <Link to=\"/login\" className=\"hover:text-brand-accent transition\">{t(\'loginLink\')}</Link>\n              </li>\n              <li>\n                <Link to=\"/register\" className=\"hover:text-brand-accent transition\">{t(\'registerLink\')}</Link>\n              </li>\n            </ul>\n          </div>\n\n          {/* About Algerie accounting info */}\n          <div>\n            <h3 className=\"text-brand-accent font-bold text-sm tracking-widest uppercase mb-4\">\n              Algeria Compliance\n            </h3>\n            <ul className=\"space-y-2 text-xs text-gray-300 font-sans\">\n              <li>\342\200\242 Syst\303\250me Comptable Financier (SCF)</li>\n              <li>\342\200\242 D\303\251claration Mensuelle G50 & G50 bis</li>\n              <li>\342\200\242 Imp\303\264ts sur le Revenu Global (IRG)</li>\n              <li>\342\200\242 Bureau National de l\'Ordre (ONEC)</li>\n              <li>\342\200\242 Chambre Nationale des Commissaires (CNCC)</li>\n            </ul>\n          </div>\n\n        </div>\n\n        {/* DEMO SWITCHER CONTROL DECK - HIGHLY POLISHED & EXPLAINED */}\n        <div className=\"my-8 p-4 bg-black/20 rounded-xl border border-white/5 flex flex-col md:flex-row items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-2.5\">\n            <RefreshCw className=\"w-5 h-5 text-brand-accent pulse-accent shrink-0\" />\n            <div>\n              <p className=\"text-sm font-semibold text-white flex items-center gap-1\">\n                <span>AccoNet Simulation Control Deck</span>\n                <span className=\"px-1.5 py-0.5 bg-brand-primary text-[10px] uppercase font-bold text-white rounded\">Prototype Mode</span>\n              </p>\n              <p className=\"text-xs text-gray-300\">\n                Switch profiles to immediately view the corresponding interactive workspaces, mock contracts, and tax tasks.\n              </p>\n            </div>\n          </div>\n          \n          <div className=\"flex flex-wrap gap-2\">\n            <button\n              onClick={() => handleSimulateSelect(\'guest\')}\n              className={`px-3 py-1.5 text-xs font-semibold rounded-lg cursor-pointer transition ${userRole === \'guest\' ? \'bg-white text-brand-dark\' : \'bg-white/10 text-white hover:bg-white/20\'}`}\n            >\n              Guest View\n            </button>\n            <button\n              onClick={() => handleSimulateSelect(\'client\')}\n              className={`px-3 py-1.5 text-xs font-semibold rounded-lg cursor-pointer transition ${userRole === \'client\' ? \'bg-brand-primary text-white border border-brand-accent\' : \'bg-white/10 text-white hover:bg-white/20\'}`}\n            >\n              SME Client Dashboard (Dzair Tech)\n            </button>\n            <button\n              onClick={() => handleSimulateSelect(\'professional\')}\n              className={`px-3 py-1.5 text-xs font-semibold rounded-lg cursor-pointer transition ${userRole === \'professional\' ? \'bg-brand-primary text-white border border-brand-accent\' : \'bg-white/10 text-white hover:bg-white/20\'}`}\n            >\n              Pro Accountant Dashboard (Me. Benamara)\n            </button>\n          </div>\n        </div>"
        replacement_content: "    <footer className=\"bg-[#083A2F] text-white border-t border-[#0F6E56]/35 pt-16 pb-8\" id=\"main_footer\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Main Footer Links */}\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-white/10\">\n          \n          {/* Brand Info */}\n          <div className=\"md:col-span-2 space-y-4\">\n            <div className=\"flex items-center space-x-2 rtl:space-x-reverse\">\n              <span className=\"flex items-center justify-center w-8 h-8 rounded-none bg-white text-brand-primary font-black text-lg shadow-sm\">\n                \330\243\n              </span>\n              <span className=\"text-xl font-bold tracking-tight text-white font-serif\">\n                {t(\'brandName\')} <span className=\"text-brand-accent italic font-normal\">\330\243\331\203\331\210\331\206\331\212\330\252</span>\n              </span>\n            </div>\n            \n            <p className=\"text-gray-300 text-sm leading-relaxed max-w-sm\">\n              {t(\'brandSlogan\')}\n            </p>\n            \n            <div className=\"flex items-center space-x-2 rtl:space-x-reverse text-xs text-brand-light font-medium bg-white/5 px-3 py-2 rounded-none border border-white/10 inline-block\">\n              <ShieldAlert className=\"w-4 h-4 text-brand-accent shrink-0\" />\n              <span>Algerian SCF 2026 Compatible \342\200\242 48 Wilayas</span>\n            </div>\n          </div>\n\n          {/* Quick links */}\n          <div>\n            <h3 className=\"text-brand-accent font-mono text-xs tracking-widest uppercase mb-4\">\n              {t(\'brandName\')} Platform\n            </h3>\n            <ul className=\"space-y-2 text-sm text-gray-300\">\n              <li>\n                <Link to=\"/search\" className=\"hover:text-brand-accent transition\">{t(\'findProButton\')}</Link>\n              </li>\n              <li>\n                <Link to=\"/tools\" className=\"hover:text-brand-accent transition\">{t(\'toolsLink\')}</Link>\n              </li>\n              <li>\n                <Link to=\"/login\" className=\"hover:text-brand-accent transition\">{t(\'loginLink\')}</Link>\n              </li>\n              <li>\n                <Link to=\"/register\" className=\"hover:text-brand-accent transition\">{t(\'registerLink\')}</Link>\n              </li>\n            </ul>\n          </div>\n\n          {/* About Algerie accounting info */}\n          <div>\n            <h3 className=\"text-brand-accent font-mono text-xs tracking-widest uppercase mb-4\">\n              Algeria Compliance\n            </h3>\n            <ul className=\"space-y-2 text-xs text-gray-400 font-sans\">\n              <li>\342\200\242 Syst\303\250me Comptable Financier (SCF)</li>\n              <li>\342\200\242 D\303\251claration Mensuelle G50 & G50 bis</li>\n              <li>\342\200\242 Imp\303\264ts sur le Revenu Global (IRG)</li>\n              <li>\342\200\242 Bureau National de l\'Ordre (ONEC)</li>\n              <li>\342\200\242 Chambre Nationale des Commissaires (CNCC)</li>\n            </ul>\n          </div>\n\n        </div>\n\n        {/* DEMO SWITCHER CONTROL DECK - EDITORIAL AESTHETIC */}\n        <div className=\"my-8 p-5 bg-black/25 rounded-none border border-white/10 flex flex-col md:flex-row items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <RefreshCw className=\"w-5 h-5 text-brand-accent pulse-accent shrink-0\" />\n            <div>\n              <p className=\"text-xs font-mono uppercase tracking-wider text-white flex items-center gap-2\">\n                <span>AccoNet Simulation Control Deck</span>\n                <span className=\"px-1.5 py-0.5 bg-[#0F6E56] text-[9px] uppercase tracking-widest font-mono text-white\">Prototype Mode</span>\n              </p>\n              <p className=\"text-xs text-gray-300 mt-1 max-w-xl\">\n                Switch profiles to immediately view the corresponding interactive workspaces, mock contracts, and tax tasks.\n              </p>\n            </div>\n          </div>\n          \n          <div className=\"flex flex-wrap gap-2\">\n            <button\n              onClick={() => handleSimulateSelect(\'guest\')}\n              className={`px-3 py-2 text-xs font-mono uppercase tracking-wider cursor-pointer transition rounded-none ${userRole === \'guest\' ? \'bg-white text-brand-dark\' : \'bg-white/5 text-white border border-white/10 hover:bg-white/10\'}`}\n            >\n              Guest View\n            </button>\n            <button\n              onClick={() => handleSimulateSelect(\'client\')}\n              className={`px-3 py-2 text-xs font-mono uppercase tracking-wider cursor-pointer transition rounded-none ${userRole === \'client\' ? \'bg-brand-primary text-white border border-brand-accent\' : \'bg-white/5 text-white border border-white/10 hover:bg-white/10\'}`}\n            >\n              SME Client (Dzair Tech)\n            </button>\n            <button\n              onClick={() => handleSimulateSelect(\'professional\')}\n              className={`px-3 py-2 text-xs font-mono uppercase tracking-wider cursor-pointer transition rounded-none ${userRole === \'professional\' ? \'bg-brand-primary text-white border border-brand-accent\' : \'bg-white/5 text-white border border-white/10 hover:bg-white/10\'}`}\n            >\n              Pro Accountant (Benamara)\n            </button>\n          </div>\n        </div>"
