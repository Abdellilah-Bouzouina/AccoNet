    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useParams, useNavigate } from \'react-router-dom\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useApp } from \'../context/AppContext\';\nimport { Contract } from \'../data/mockData\';\nimport { \n  Star, MapPin, Award, CheckCircle, Mail, DollarSign, \n  ChevronRight, Calendar, UserCheck, MessageSquare, AlertCircle, X \n} from \'lucide-react\';\n\nexport const ProfessionalProfile: React.FC = () => {\n  const { id } = useParams<{ id: string }>();\n  const navigate = useNavigate();\n  const { t, tSpec, tObj, direction } = useLanguage();\n  const { \n    allProfessionals, addContract, \n    triggerNotification, currentClient \n  } = useApp();\n\n  const pro = allProfessionals.find((p) => p.id === id);\n\n  // Active Tab state\n  const [activeTab, setActiveTab] = useState<\'about\' | \'services\' | \'reviews\' | \'experience\'>(\'about\');\n\n  // Modal trigger states\n  const [hireModalOpen, setHireModalOpen] = useState(false);\n  const [msgModalOpen, setMsgModalOpen] = useState(false);\n\n  // Interactive Hire Input Form\n  const [contractTitle, setContractTitle] = useState(\'\');\n  const [proposedBudget, setProposedBudget] = useState(\'\');\n  const [scopeDetails, setScopeDetails] = useState(\'\');\n\n  // Interactive MessageBox State\n  const [msgText, setMsgText] = useState(\'\');\n\n  if (!pro) {\n    return (\n      <div className=\"max-w-7xl mx-auto px-4 py-20 text-center space-y-4\">\n        <AlertCircle className=\"w-12 h-12 text-red-500 mx-auto\" />\n        <h2 className=\"font-bold text-xl text-gray-900\">Expert not found</h2>\n        <button \n          onClick={() => navigate(\'/search\')}\n          className=\"px-4 py-2 bg-brand-primary text-white rounded-lg text-xs\"\n        >\n          Return to search\n        </button>\n      </div>\n    );\n  }\n\n  const handleHireSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!contractTitle) return;\n\n    // Build static contract instance\n    const newContractVal: Contract = {\n      id: `ct_custom_${Date.now()}`,\n      professionalId: pro.id,\n      clientId: currentClient?.id || \'c1\',\n      title: { ar: contractTitle, fr: contractTitle, en: contractTitle },\n      status: \'active\',\n      startDate: new Date().toISOString().split(\'T\')[0],\n      endDate: \'2026-12-31\',\n      value: Number(proposedBudget) || (pro.hourlyRate * 30),\n      scopeDescription: {\n        ar: scopeDetails || \"\331\205\330\261\330\247\331\201\331\202\330\251 \331\205\330\255\330\247\330\263\330\250\331\212\330\251 \330\257\331\210\330\261\331\212\330\251 \331\205\330\255\330\257\330\257\330\251\",\n        fr: scopeDetails || \"Prestations de services comptables sur-mesure\",\n        en: scopeDetails || \"Bespoke professional financial advisory\"\n      }\n    };\n\n    addContract(newContractVal);\n    setHireModalOpen(false);\n\n    // Trigger sweet success overlay message\n    triggerNotification(\n      t(\'alertHireSuccessTitle\'),\n      `${t(\'alertHireSuccessBody\')} (Expert: ${tObj(pro.name)})`\n    );\n\n    // Redirect to Client Dashboard to instantly view the new active contract!\n    navigate(\'/dashboard/client\');\n  };\n\n  const handleMsgSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setMsgModalOpen(false);\n    setMsgText(\'\');\n    triggerNotification(\n      t(\'alertMessageSuccessTitle\'),\n      t(\'alertMessageSuccessBody\')\n    );\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10\" id=\"profile_page_container\">\n      \n      {/* 1. LAYOUT GRID */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        \n        {/* LEFT & CENTER BODY PANELS (col-span-8) */}\n        <div className=\"lg:col-span-8 space-y-6\">\n          \n          {/* Main Professional Header block */}\n          <div className=\"bg-white border border-gray-150 rounded-2xl p-6 sm:p-8 shadow-xs relative\">\n            <div className=\"flex flex-col sm:flex-row gap-6 items-start sm:items-center\">\n              \n              {/* Visual avatar circle */}\n              <div className={`w-20 h-20 rounded-2xl flex items-center justify-center font-extrabold text-2xl tracking-widest ${pro.avatarBg} shrink-0 shadow-sm`}>\n                {pro.initials}\n              </div>\n\n              {/* Bio & names */}\n              <div className=\"space-y-2 flex-1\">\n                <div className=\"flex flex-wrap items-center gap-3\">\n                  <h1 className=\"text-2xl font-black text-gray-950 font-sans tracking-tight\">\n                    {tObj(pro.name)}\n                  </h1>\n                  \n                  {pro.available ? (\n                    <span className=\"flex items-center gap-1.5 px-3 py-1 bg-teal-50 border border-teal-200 text-teal-700 text-[10px] font-bold rounded-full animate-pulse\">\n                      {t(\'availableStatus\')}\n                    </span>\n                  ) : (\n                    <span className=\"px-3 py-1 bg-gray-50 border border-gray-200 text-gray-400 text-[10px] font-bold rounded-full\">\n                      {t(\'busyStatus\')}\n                    </span>\n                  )}\n                </div>\n\n                <div className=\"flex flex-wrap items-center gap-4 text-xs text-gray-500\">\n                  <span className=\"px-2.5 py-1 bg-brand-light text-brand-primary font-bold rounded-lg text-[10px]\">\n                    {tSpec(pro.specialty)}\n                  </span>\n                  <div className=\"flex items-center gap-1\">\n                    <MapPin className=\"w-4 h-4 text-brand-primary\" />\n                    <span>{tObj(pro.wilayaName)} (Algeria)</span>\n                  </div>\n                  <div className=\"flex items-center gap-1 font-mono text-[11px] text-gray-400\">\n                    <Award className=\"w-4 h-4 text-brand-primary\" />\n                    <span>{pro.accreditationNumber}</span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-1 text-sm pt-2\">\n                  <Star className=\"w-4.5 h-4.5 text-brand-accent fill-brand-accent shrink-0\" />\n                  <span className=\"font-extrabold text-gray-950\">{pro.rating}</span>\n                  <span className=\"text-xs text-gray-400\">({pro.reviewCount} verified ratings)</span>\n                </div>\n\n              </div>\n\n            </div>\n          </div>\n\n          {/* TAB TRIGGERS BAR */}\n          <div className=\"border-b border-gray-250 flex space-x-6 rtl:space-x-reverse text-sm font-semibold\">\n            <button\n              onClick={() => setActiveTab(\'about\')}\n              className={`pb-3 relative transition-all cursor-pointer ${activeTab === \'about\' ? \'text-brand-primary border-b-2 border-brand-primary font-bold\' : \'text-gray-500 hover:text-brand-primary\'}`}\n            >\n              {t(\'tabAbout\')}\n            </button>\n            <button\n              onClick={() => setActiveTab(\'services\')}\n              className={`pb-3 relative transition-all cursor-pointer ${activeTab === \'services\' ? \'text-brand-primary border-b-2 border-brand-primary font-bold\' : \'text-gray-500 hover:text-brand-primary\'}`}\n            >\n              {t(\'tabServices\')} ({pro.services.length})\n            </button>\n            <button\n              onClick={() => setActiveTab(\'reviews\')}\n              className={`pb-3 relative transition-all cursor-pointer ${activeTab === \'reviews\' ? \'text-brand-primary border-b-2 border-brand-primary font-bold\' : \'text-gray-500 hover:text-brand-primary\'}`}\n            >\n              {t(\'tabReviews\')} ({pro.reviews.length})\n            </button>\n            <button\n              onClick={() => setActiveTab(\'experience\')}\n              className={`pb-3 relative transition-all cursor-pointer ${activeTab === \'experience\' ? \'text-brand-primary border-b-2 border-brand-primary font-bold\' : \'text-gray-500 hover:text-brand-primary\'}`}\n            >\n              {t(\'tabExperience\')}\n            </button>\n          </div>\n\n          {/* TAB DETAILED CONTENTS */}\n          <div className=\"bg-white border border-gray-150 rounded-2xl p-6 shadow-xs min-h-[300px]\">\n            \n            {/* ABOUT TAB */}\n            {activeTab === \'about\' && (\n              <div className=\"space-y-6\" id=\"tab_content_about\">\n                <div className=\"space-y-2\">\n                  <h3 className=\"font-bold text-gray-901 text-sm uppercase tracking-wider text-brand-primary\">Corporate Bio</h3>\n                  <p className=\"text-gray-600 text-sm leading-relaxed whitespace-pre-line\">\n                    {tObj(pro.bio)}\n                  </p>\n                </div>\n\n                {/* Local statistics grid */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-gray-100\">\n                  <div className=\"bg-gray-50 p-4 rounded-xl text-center\">\n                    <p className=\"text-2xl font-black text-brand-primary font-mono\">{pro.yearsExperience}+</p>\n                    <p className=\"text-[10px] text-gray-400 uppercase font-sans mt-1\">{t(\'expYears\').split(\' \')[1]} of practice</p>\n                  </div>\n                  <div className=\"bg-gray-50 p-4 rounded-xl text-center\">\n                    <p className=\"text-2xl font-black text-brand-primary font-mono\">{pro.clientsServed}</p>\n                    <p className=\"text-[10px] text-gray-400 uppercase font-sans mt-1\">{t(\'profileStatsServed\')}</p>\n                  </div>\n                  <div className=\"bg-gray-50 p-4 rounded-xl text-center\">\n                    <p className=\"text-2xl font-black text-brand-primary font-mono\">{pro.completionRate}%</p>\n                    <p className=\"text-[10px] text-gray-400 uppercase font-sans mt-1\">{t(\'profileStatsCompleted\')}</p>\n                  </div>\n                </div>\n              </div>\n            )}\n\n            {/* SERVICES & FLAT BUDGET RATES */}\n            {activeTab === \'services\' && (\n              <div className=\"space-y-6 inline-block w-full\" id=\"tab_content_services\">\n                <p className=\"text-xs text-gray-400 font-mono uppercase tracking-wider\">OFFERED ENGAGEMENTS & STANDARD ESTIMATES</p>\n                \n                {pro.services.length > 0 ? (\n                  <div className=\"space-y-4\">\n                    {pro.services.map((ser, sIdx) => (\n                      <div key={sIdx} className=\"border border-gray-150 rounded-xl p-4 hover:border-brand-primary transition\">\n                        <div className=\"flex flex-col sm:flex-row justify-between items-start gap-2 mb-2\">\n                          <h4 className=\"font-bold text-gray-900 text-sm\">\n                            {tObj(ser.title)}\n                          </h4>\n                          <span className=\"px-3 py-1 bg-brand-light text-brand-primary font-mono text-xs font-bold rounded-lg shrink-0\">\n                            {ser.price}\n                          </span>\n                        </div>\n                        <p className=\"text-gray-500 text-xs leading-relaxed\">\n                          {tObj(ser.description)}\n                        </p>\n                      </div>\n                    ))}\n                  </div>\n                ) : (\n                  <div className=\"text-center py-10 text-gray-450\">\n                    <p className=\"text-xs\">No explicit service templates listed. Contact directly for custom quotes.</p>\n                  </div>\n                )}\n              </div>\n            )}\n\n            {/* HISTORIC VERIFIED REVIEWS */}\n            {activeTab === \'reviews\' && (\n              <div className=\"space-y-6\" id=\"tab_content_reviews\">\n                {pro.reviews.length > 0 ? (\n                  <div className=\"space-y-4 divide-y divide-gray-100\">\n                    {pro.reviews.map((rev) => (\n                      <div key={rev.id} className=\"pt-4 first:pt-0 space-y-2\">\n                        <div className=\"flex justify-between items-center\">\n                          <div>\n                            <h4 className=\"font-bold text-gray-900 text-xs\">{rev.clientName}</h4>\n                            <p className=\"text-[10px] text-gray-400 font-mono\">{rev.date}</p>\n                          </div>\n                          \n                          <div className=\"flex gap-0.5 text-brand-accent\">\n                            {Array.from({ length: rev.rating }).map((_, i) => (\n                              <Star key={i} className=\"w-3.5 h-3.5 fill-brand-accent text-brand-accent\" />\n                            ))}\n                          </div>\n                        </div>\n\n                        <p className=\"text-gray-600 text-xs leading-relaxed italic\">\n                          \"{tObj(rev.comment)}\"\n                        </p>\n                      </div>\n                    ))}\n                  </div>\n                ) : (\n                  <div className=\"text-center py-12 text-gray-400 space-y-2\">\n                    <p className=\"text-sm\">\342\255\220</p>\n                    <p className=\"text-xs leading-relaxed\">\n                      {t(\'reviewsPlaceholderNoReviews\')}\n                    </p>\n                  </div>\n                )}\n              </div>\n            )}\n\n            {/* EXPERIENCE PORTFOLIO HISTORY TIMELINE */}\n            {activeTab === \'experience\' && (\n              <div className=\"space-y-6\" id=\"tab_content_experience\">\n                <p className=\"text-xs text-gray-400 font-mono uppercase tracking-wider\">OFFICIAL RECOGNITIONS & CAREER TIMELINE</p>\n                \n                {pro.history.length > 0 ? (\n                  <div className=\"relative border-l rtl:border-l-0 rtl:border-r border-gray-200 mt-2 space-y-6 pl-4 rtl:pl-0 rtl:pr-4\">\n                    {pro.history.map((hist, hIdx) => (\n                      <div key={hIdx} className=\"relative\">\n                        {/* Timeline dot */}\n                        <div className=\"absolute -left-6 rtl:-right-6 top-1.5 w-3.5 h-3.5 rounded-full bg-brand-primary border-4 border-white\"></div>\n                        \n                        <span className=\"text-[10px] font-bold text-brand-primary font-mono bg-brand-light px-2 py-0.5 rounded\">\n                          {hist.year}\n                        </span>\n                        \n                        <h4 className=\"font-bold text-gray-900 text-xs mt-2\">\n                          {tObj(hist.title)}\n                        </h4>\n                        \n                        <p className=\"text-gray-500 text-xs mt-1\">\n                          {tObj(hist.description)}\n                        </p>\n                      </div>\n                    ))}\n                  </div>\n                ) : (\n                  <div className=\"text-center py-12 text-gray-400 space-y-2\">\n                    <p className=\"text-xs\">\n                      Accreditation register CNEC/DGI confirms over {pro.yearsExperience} years of continuous compliant operations in Algeria.\n                    </p>\n                  </div>\n                )}\n              </div>\n            )}\n\n          </div>\n\n        </div>\n\n        {/* RIGHT SIDEBAR PANEL / ACTION CARD (col-span-4) */}\n        <div className=\"lg:col-span-4 sticky top-20 space-y-6\">\n          <div className=\"bg-white border border-gray-150 rounded-2xl p-6 shadow-xs space-y-5 text-center\">\n            \n            <div className=\"text-xs font-mono text-gray-400 uppercase\">REFERENCE PRICING</div>\n            \n            <div className=\"space-y-1\">\n              <span className=\"text-3xl font-black text-brand-primary font-mono\">\n                {pro.hourlyRate.toLocaleString()} DZD\n              </span>\n              <p className=\"text-xs text-gray-500\">{t(\'perHour\')}</p>\n            </div>\n\n            <div className=\"p-3 bg-gray-50 text-xs rounded-xl text-gray-600 font-sans leading-relaxed\">\n              \360\237\222\241 {t(\'contactToDiscuss\')}\n            </div>\n\n            <div className=\"space-y-2 pt-2\">\n              <button \n                onClick={() => setHireModalOpen(true)}\n                className=\"w-full py-3 bg-brand-primary hover:bg-brand-dark text-white text-xs font-bold rounded-xl shadow-xs hover:shadow-md cursor-pointer transition flex items-center justify-center gap-1.5\"\n                id=\"profile_hire_now_btn\"\n              >\n                <UserCheck className=\"w-4 h-4\" />\n                {t(\'hireMeNow\')}\n              </button>\n\n              <button \n                onClick={() => setMsgModalOpen(true)}\n                className=\"w-full py-3 bg-white border border-gray-200 hover:bg-gray-55 text-gray-700 text-xs font-semibold rounded-xl cursor-pointer transition flex items-center justify-center gap-1.5\"\n                id=\"profile_send_message_btn\"\n              >\n                <MessageSquare className=\"w-4 h-4 text-brand-primary\" />\n                {t(\'sendMessage\')}\n              </button>\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n\n      {/* 2. LIVE MODAL DIALOGS */}\n      \n      {/* HIRE NOW ATTACH CONTRACT FORM */}\n      {hireModalOpen && (\n        <div className=\"fixed inset-0 bg-black/60 z-50 flex items-center justify-center px-4\" id=\"hire_contract_modal\">\n          <div className=\"bg-white rounded-2xl max-w-lg w-full overflow-hidden shadow-2xl border border-gray-100 flex flex-col justify-between\">\n            \n            {/* Modal Header */}\n            <div className=\"bg-brand-primary text-white p-5 flex justify-between items-center\">\n              <div>\n                <h3 className=\"font-extrabold text-sm\">{t(\'hireMeNow\')}</h3>\n                <p className=\"text-[10px] text-brand-light font-mono mt-0.5\">CONTRACT DECK FOR {currentClient?.companyName || \'Dzair Tech Link\'}</p>\n              </div>\n              <button \n                onClick={() => setHireModalOpen(false)}\n                className=\"text-white hover:text-brand-accent cursor-pointer rounded-full p-1\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <form onSubmit={handleHireSubmit} className=\"p-6 space-y-4\">\n              \n              <div>\n                <label className=\"block text-xs font-bold text-gray-400 uppercase mb-1\">Contract / Project Title</label>\n                <input \n                  type=\"text\" \n                  required\n                  placeholder=\"e.g. 2026 Monthly VAT filing & Ledger Auditing\"\n                  value={contractTitle}\n                  onChange={(e) => setContractTitle(e.target.value)}\n                  className=\"w-full border border-gray-250 rounded-xl px-3 py-2 text-xs text-gray-700 bg-gray-50 focus:outline-none focus:border-brand-primary focus:bg-white\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-gray-400 uppercase mb-1\">Total Allocated Budget (DZD)</label>\n                <input \n                  type=\"number\" \n                  placeholder={`Standard DZD ${(pro.hourlyRate * 30).toLocaleString()}`}\n                  value={proposedBudget}\n                  onChange={(e) => setProposedBudget(e.target.value)}\n                  className=\"w-full border border-gray-250 rounded-xl px-3 py-2 text-xs font-mono text-gray-700 bg-gray-50 focus:outline-none focus:border-brand-primary focus:bg-white\"\n                />\n                <span className=\"text-[10px] text-gray-400 leading-none\">Leave blank to use recommended flat monthly estimates.</span>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-gray-400 uppercase mb-1\">Detailed Work Scope Parameters</label>\n                <textarea \n                  rows={3}\n                  placeholder=\"Specify list of deliverables like CNAS, monthly G50 filings etc.\"\n                  value={scopeDetails}\n                  onChange={(e) => setScopeDetails(e.target.value)}\n                  className=\"w-full border border-gray-250 rounded-xl px-3 py-2 text-xs text-gray-700 bg-gray-50 focus:outline-none focus:border-brand-primary focus:bg-white resize-none\"\n                />\n              </div>\n\n              <div className=\"bg-teal-50 p-3 rounded-xl flex gap-2 text-[10px] text-teal-800 leading-normal\">\n                <CheckCircle className=\"w-4 h-4 text-brand-primary shrink-0 mt-0.5\" />\n                <span>By submitting, you declare a draft proposal. It immediately appends to your contracts feed so you can preview operations. No real fund transfers or legal liabilities are created during showcase.</span>\n              </div>\n\n              <div className=\"pt-2 flex justify-end gap-2\">\n                <button \n                  type=\"button\" \n                  onClick={() => setHireModalOpen(false)}\n                  className=\"px-4 py-2 hover:bg-gray-100 rounded-lg text-xs font-semibold text-gray-500 cursor-pointer\"\n                >\n                  Cancel\n                </button>\n                <button \n                  type=\"submit\" \n                  className=\"px-5 py-2 bg-brand-primary hover:bg-brand-dark text-white rounded-lg text-xs font-semibold cursor-pointer\"\n                  id=\"confirm_hire_modal_btn\"\n                >\n                  Confirm Hire Agreement\n                </button>\n              </div>\n\n            </form>\n\n          </div>\n        </div>\n      )}\n\n      {/* SEND MESSAGE DIALOG FORM */}\n      {msgModalOpen && (\n        <div className=\"fixed inset-0 bg-black/60 z-50 flex items-center justify-center px-4\" id=\"message_sender_modal\">\n          <div className=\"bg-white rounded-2xl max-w-md w-full overflow-hidden shadow-2xl border border-gray-100\">\n            \n            <div className=\"bg-brand-primary text-white p-5 flex justify-between items-center\">\n              <div>\n                <h3 className=\"font-extrabold text-sm\">{t(\'sendMessage\')}</h3>\n                <p className=\"text-[10px] text-brand-light font-sans mt-0.5\">Direct chat with {tObj(pro.name)}</p>\n              </div>\n              <button onClick={() => setMsgModalOpen(false)} className=\"text-white hover:text-brand-accent cursor-pointer\">\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <form onSubmit={handleMsgSubmit} className=\"p-6 space-y-4\">\n              \n              <div>\n                <label className=\"block text-xs font-bold text-gray-400 uppercase mb-2\">Write Your Question / Inquest</label>\n                <textarea \n                  required\n                  rows={4}\n                  placeholder={`e.g. Salam, we are starting a small manufacture in ${tObj(pro.wilayaName)}. What are the exact G50 requirements?`}\n                  value={msgText}\n                  onChange={(e) => setMsgText(e.target.value)}\n                  className=\"w-full border border-gray-250 rounded-xl p-3 text-xs text-gray-700 bg-gray-50 focus:outline-none focus:border-brand-primary focus:bg-white resize-none\"\n                />\n              </div>\n\n              <div className=\"pt-2 flex justify-end gap-2\">\n                <button \n                  type=\"button\" \n                  onClick={() => setMsgModalOpen(false)}\n                  className=\"px-4 py-2 hover:bg-gray-100 rounded-lg text-xs font-semibold text-gray-500 cursor-pointer\"\n                >\n                  Cancel\n                </button>\n                <button \n                  type=\"submit\" \n                  className=\"px-5 py-2 bg-brand-primary hover:bg-brand-dark text-white rounded-lg text-xs font-semibold cursor-pointer\"\n                  id=\"confirm_message_modal_btn\"\n                >\n                  Send Query\n                </button>\n              </div>\n\n            </form>\n\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
    }
