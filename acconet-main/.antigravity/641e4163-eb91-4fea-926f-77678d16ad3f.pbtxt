      replacement_content: "export interface PriceRange {\n  min: number;\n  max: number;\n  unit: string;\n}\n\nexport interface ServiceRate {\n  description: string;\n  priceRange: PriceRange;\n  basedOn?: string;\n  legalRef: string;\n}\n\nexport const algerianServiceRates: Record<string, ServiceRate> = {\n  \'Tenue de comptabilit\303\251 mensuelle\': {\n    description: \'Saisie des pi\303\250ces comptables, lettrage, rapprochements bancaires selon le PCN/SCF\',\n    priceRange: { min: 15000, max: 80000, unit: \'DA/mois\' },\n    basedOn: \'Volume des \303\251critures + taille de l\\\'entreprise\',\n    legalRef: \'D\303\251cret 08-156 portant SCF\'\n  },\n  \'\303\211tablissement G50 mensuel\': {\n    description: \'D\303\251claration TVA, TAP, IRG/retenues \303\240 la source. D\303\251p\303\264t en ligne via Jibayatic (portail DGI)\',\n    priceRange: { min: 3000, max: 15000, unit: \'DA/mois\' },\n    legalRef: \'Art. 76 et suivants du CPF\'\n  },\n  \'\303\211tablissement bilan annuel + liasse fiscale\': {\n    description: \'Bilan SCF complet (actif/passif), compte de r\303\251sultat, tableau de flux de tr\303\251sorerie, notes annexes, tableaux fiscaux (G4, G6, G11, G50 annuel)\',\n    priceRange: { min: 50000, max: 300000, unit: \'DA/an\' },\n    legalRef: \'SCF \342\200\224 Arr\303\252t\303\251 du 26 juillet 2008\'\n  },\n  \'Commissariat aux comptes\': {\n    description: \'Audit l\303\251gal obligatoire pour SPA, SARL > 10M DA CA, associations (Art. 715 bis du Code de Commerce)\',\n    priceRange: { min: 150000, max: 800000, unit: \'DA/exercice\' },\n    legalRef: \'Code de Commerce Art. 715 bis 4\'\n  },\n  \'Conseil fiscal et optimisation\': {\n    description: \'Strat\303\251gie fiscale, choix du r\303\251gime, conventions fiscales (Algeria-France, Algeria-Maroc, etc.), recours gracieux DGI\',\n    priceRange: { min: 20000, max: 100000, unit: \'DA/dossier\' },\n    legalRef: \'CPF + Conventions fiscales internationales\'\n  },\n  \'D\303\251claration CNAS/CASNOS\': {\n    description: \'\303\211tablissement DAS, calcul cotisations, r\303\251gularisation annuelle, gestion des dossiers affili\303\251s\',\n    priceRange: { min: 5000, max: 25000, unit: \'DA/trimestre\' },\n    legalRef: \'Loi 83-14 + D\303\251cret 96-430\'\n  },\n  \'Domiciliation comptable\': {\n    description: \'R\303\251ception et conservation des pi\303\250ces comptables, archivage l\303\251gal 10 ans (Art. 30 du CCF)\',\n    priceRange: { min: 8000, max: 30000, unit: \'DA/mois\' },\n    legalRef: \'Art. 30 du Code du Commerce\'\n  },\n  \'Expertise judiciaire comptable\': {\n    description: \'\303\211valuation d\\\'entreprise, expertise dans le cadre de litiges, rapport d\\\'expertise judiciaire\',\n    priceRange: { min: 100000, max: 500005, unit: \'DA/mission\' },\n    legalRef: \'Loi 04-09 relative \303\240 l\\\'expertise judiciaire\'\n  }\n};\n\nexport interface OrderDetail {\n  fullName: string;\n  fullNameAR: string;\n  website?: string;\n  legalBasis: string;\n  memberCount: string;\n  badgeColor: string;\n  verificationURL?: string;\n}\n\nexport const professionalOrders: Record<string, OrderDetail> = {\n  \'ONEC\': {\n    fullName: \'Ordre National des Experts Comptables\',\n    fullNameAR: \'\330\247\331\204\331\207\331\212\330\246\330\251 \330\247\331\204\331\210\330\267\331\206\331\212\330\251 \331\204\331\204\330\256\330\250\330\261\330\247\330\241 \330\247\331\204\331\205\330\255\330\247\330\263\330\250\331\212\331\206\',\n    website: \'www.onec.dz\',\n    legalBasis: \'Loi 10-01 du 29 juin 2010\',\n    memberCount: \'~4,500 membres\',\n    badgeColor: \'#0F6E56\',\n    verificationURL: \'www.onec.dz/tableau-national\'\n  },\n  \'ONCC\': {\n    fullName: \'Ordre National des Commissaires aux Comptes\',\n    fullNameAR: \'\330\247\331\204\331\207\331\212\330\246\330\251 \330\247\331\204\331\210\330\267\331\206\331\212\330\251 \331\204\331\205\330\255\330\247\331\201\330\270\331\212 \330\247\331\204\330\255\330\263\330\247\330\2