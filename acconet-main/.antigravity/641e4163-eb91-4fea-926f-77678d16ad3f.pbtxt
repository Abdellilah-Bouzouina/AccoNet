        lines {
          text: "    ar: \"\331\205\331\206 \330\247\331\204\330\252\330\257\331\202\331\212\331\202 \330\247\331\204\330\245\331\204\330\262\330\247\331\205\331\212 \331\204\330\254\331\205\330\271\331\212\330\247\330\252 \331\210\331\207\330\261\330\247\331\206 \330\245\331\204\331\211 \330\254\330\250\330\247\331\212\330\251 \330\247\331\204\330\264\330\261\331\203\330\247\330\252 \330\247\331\204\331\206\330\247\330\264\330\246\330\251 \330\250\330\247\331\204\330\271\330\247\330\265\331\205\330\251. \330\252\330\271\330\261\331\201 \330\271\331\204\331\211 \330\263\330\250\330\250 \330\253\331\202\330\251 \330\247\331\204\331\205\330\244\330\263\330\263\330\247\330\252.\","
